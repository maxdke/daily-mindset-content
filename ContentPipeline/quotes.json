{
  "generatedAt": "2026-11-04",
  "quotes": [
    {
      "id": "mindset-2026-11-04-0",
      "text": "Disziplin ist der Zins, den du heute zahlst für die Freiheit von morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-1",
      "text": "Dein Kopf glaubt jede Ausrede, die du ihm lang genug erzählst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-2",
      "text": "Comfort Zones haben keine Fenster – du siehst nicht, was draußen wartet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-3",
      "text": "Motivation ist ein Funke. Disziplin ist das Feuer, das brennt, wenn keiner zuschaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-4",
      "text": "Wer auf den perfekten Moment wartet, verpasst den einzig echten: jetzt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-5",
      "text": "Dein Gehirn optimiert auf Sicherheit. Du musst auf Wachstum optimieren.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-6",
      "text": "Schwache Tage sind kein Beweis für Schwäche, sondern der Preis für Fortschritt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-7",
      "text": "Niemand sieht die 5 Uhr morgens, aber jeder sieht das Ergebnis.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-8",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht über deine Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-9",
      "text": "Du wirst nicht durch Inspiration stark, sondern durch Wiederholung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-10",
      "text": "Die Stimme, die sagt 'hör auf', lügt öfter als du denkst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-11",
      "text": "Mentale Stärke ist kein Talent, sondern eine tägliche Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-12",
      "text": "Wer sich selbst führen kann, braucht niemanden, der ihn antreibt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-13",
      "text": "Dein Limit ist meistens nur die Grenze deiner letzten Ausrede.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-14",
      "text": "Unbequeme Entscheidungen bauen bequeme Zukünfte.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-15",
      "text": "Druck zerbricht nur das, was innen schon hohl war.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-16",
      "text": "Du verhandelst nicht mit deinem inneren Schweinehund – du führst ihn.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-17",
      "text": "Der Unterschied zwischen Träumern und Machern ist ein einziger Tag Vorsprung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-18",
      "text": "Resilienz entsteht nicht im Erfolg, sondern in der Wiederholung des Aufstehens.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-19",
      "text": "Dein größter Konkurrent schläft nicht länger als du – er denkt nur schneller um.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-20",
      "text": "Klarheit schlägt Motivation jeden Tag der Woche.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-21",
      "text": "Wer ständig auf Zeichen wartet, übersieht die Chance direkt vor sich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-22",
      "text": "Starke Gedanken bauen starke Routinen, keine starken Gefühle.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-23",
      "text": "Du bist nicht müde von der Arbeit, sondern vom Zögern davor.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-24",
      "text": "Fokus ist die Fähigkeit, laute Ablenkung leise zu ignorieren.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-25",
      "text": "Dein zukünftiges Ich zahlt den Preis für jede heutige Bequemlichkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-26",
      "text": "Angst vor Fehlern ist teurer als jeder Fehler selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-27",
      "text": "Wachstum fühlt sich nie bequem an – genau deshalb ist es Wachstum.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-28",
      "text": "Du brauchst keine perfekte Strategie, nur die Bereitschaft weiterzumachen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-29",
      "text": "Dein Kopf ist der erste Ort, an dem du gewinnst oder verlierst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-11-04-0",
      "text": "Disziplin schlägt Motivation, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-1",
      "text": "Dein Kalender zeigt, was dir wichtig ist – nicht deine Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-2",
      "text": "Während andere Serien schauen, baust du dein Imperium.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-3",
      "text": "Komfort ist der leise Killer jeder großen Idee.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-4",
      "text": "Wer um 6 Uhr aufsteht, hat um 9 Uhr schon gewonnen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-5",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Faulheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-6",
      "text": "Umsatz ist Applaus, Gewinn ist das Ergebnis.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-7",
      "text": "Niemand fragt nach Ausreden, wenn das Konto leer ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-8",
      "text": "Du brauchst keine Motivation, du brauchst ein System.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-9",
      "text": "Arbeite, wenn andere schlafen, lebe, wenn andere arbeiten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-10",
      "text": "Dein Netzwerk ist dein Nettovermögen – pflege es täglich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-11",
      "text": "Erfolg ist kein Zufall, sondern eine wiederholte Entscheidung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-12",
      "text": "Jede verschwendete Stunde ist ein verlorener Kunde.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-13",
      "text": "Baue dein Geschäft so, als würde morgen alles verschwinden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-14",
      "text": "Risiko ist nicht gefährlich, Stillstand schon.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-15",
      "text": "Zeig mir deine Prioritäten, nicht deine Pläne.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-16",
      "text": "Dein Gehalt ist das Ergebnis deines Denkens, nicht deiner Zeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-17",
      "text": "Wer auf den perfekten Moment wartet, wartet für immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-18",
      "text": "Kleine Schritte täglich schlagen große Pläne einmal im Jahr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-19",
      "text": "Konsequenz ist die Währung, mit der du Freiheit kaufst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-20",
      "text": "Dein größter Konkurrent ist deine Komfortzone.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-21",
      "text": "Baue Vermögen, nicht nur ein Gehalt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-22",
      "text": "Fokus ist das neue Kapital.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-23",
      "text": "Wer nicht investiert, zahlt doppelt – mit Zeit und Geld.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-24",
      "text": "Erfolg sieht langweilig aus, bevor er beeindruckend wird.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-25",
      "text": "Dein Business wächst nur so schnell wie du selbst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-26",
      "text": "Handle heute, als gäbe es morgen keine zweite Chance.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-27",
      "text": "Produktivität ist die Kunst, Ausreden zu eliminieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-28",
      "text": "Geld folgt Wert, nicht Wünschen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-29",
      "text": "Scroll weniger, skaliere mehr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-11-04-0",
      "text": "Motivation ist ein Gefühl. Disziplin ist eine Entscheidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-1",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-2",
      "text": "Disziplin ist der Unterschied zwischen Wünschen und Haben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-3",
      "text": "Keine Ausreden. Nur Ergebnisse.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-4",
      "text": "Der Moment, in dem es wehtut durchzuhalten, verändert dich.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-5",
      "text": "Deine Komfortzone zahlt dir keine Zukunft aus.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-6",
      "text": "Jeden Tag ein bisschen weiter - das ist der ganze Trick.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-7",
      "text": "Wer aufgibt, behält recht. Wer weitermacht, verändert sein Leben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-8",
      "text": "Disziplin schlägt Talent, wenn Talent sich nicht anstrengt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-9",
      "text": "Du brauchst keine Motivation. Du brauchst ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-10",
      "text": "Mach weiter, auch wenn gerade niemand hinsieht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-11",
      "text": "Die harten Tage formen die stabilen Menschen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-12",
      "text": "Erfolg ist das, was passiert, wenn du trotzdem weitermachst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-13",
      "text": "Konsequenz schlägt Intensität, jedes Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-14",
      "text": "Heute unbequem, morgen unaufhaltbar.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-15",
      "text": "Disziplin ist Freiheit, die noch nicht erkannt wurde.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-16",
      "text": "Wer zu müde für Disziplin ist, wird zu müde für Erfolg sein.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-17",
      "text": "Du wirst nicht jeden Tag Lust haben. Mach es trotzdem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-18",
      "text": "Gewohnheiten liefern das, was Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-19",
      "text": "Es gibt keinen Zufall. Nur Wiederholung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-20",
      "text": "Disziplin ist leise. Ergebnisse sind laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-21",
      "text": "Zwischen Aufgeben und Durchbruch liegt nur ein weiterer Versuch.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-22",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-23",
      "text": "Niemand merkt den Tag, an dem du aufhörst zu geben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-24",
      "text": "Disziplin ist der Preis, den du für spätere Freiheit zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-25",
      "text": "Wiederholung ist die Mutter jeder Veränderung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-26",
      "text": "Du bist nicht müde vom Arbeiten. Du bist müde vom Zweifeln.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-27",
      "text": "Starte nicht mit Motivation. Starte mit einem Plan.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-28",
      "text": "Disziplin fragt nicht nach Lust. Sie fragt nach Ergebnissen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-29",
      "text": "Zwischen dir und deinem Ziel steht nur das Durchhalten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-11-04-0",
      "text": "Dein Körper ist der einzige Ort, aus dem du nicht kündigen kannst – also investier in ihn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-1",
      "text": "Energie ist keine Glückssache, sie ist das Resultat deines letzten Workouts.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-2",
      "text": "Wer seinen Körper trainiert, trainiert seinen Kopf gleich mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-3",
      "text": "Müdigkeit ist oft nur ein Mangel an Bewegung, keine Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-4",
      "text": "Dein Puls entscheidet, wie klar dein Kopf heute denkt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-5",
      "text": "Disziplin im Training ist Disziplin im Leben – nur mit Schweiß.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-6",
      "text": "Ein starker Körper verhandelt nicht mit Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-7",
      "text": "Bewegung ist der Kaffee, den dein Körper wirklich braucht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-8",
      "text": "Wer heute schwitzt, denkt morgen schärfer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-9",
      "text": "Dein Energielevel ist kein Zufall, sondern eine Entscheidung von heute Morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-10",
      "text": "Muskeln wachsen im Schlaf, Disziplin wächst beim Training.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-11",
      "text": "Ein Workout verschoben ist Energie, die du nie bekommst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-12",
      "text": "Dein Körper merkt sich jede Ausrede, die du ihm gibst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-13",
      "text": "Stärke beginnt dort, wo die Motivation aufhört.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-14",
      "text": "Fitness ist der Zinseszins für deinen zukünftigen Fokus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-15",
      "text": "Wer sich bewegt, bewegt auch seine Gedanken aus dem Stillstand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-16",
      "text": "Ein kurzer Lauf schlägt jede lange Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-17",
      "text": "Dein Körper ist dein erstes Tool – halt es scharf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-18",
      "text": "Kraft im Körper ist Ruhe im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-19",
      "text": "Training ist die günstigste Therapie, die du nie in Anspruch nimmst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-20",
      "text": "Wer seine Grenzen im Gym verschiebt, verschiebt sie überall.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-21",
      "text": "Energie tankst du nicht, du erzeugst sie – durch Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-22",
      "text": "Ein trainierter Körper lügt nicht über harte Arbeit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-23",
      "text": "Bewegung ist der Neustart-Knopf für einen trägen Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-24",
      "text": "Jedes Workout ist eine Einzahlung auf dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-25",
      "text": "Schwäche ist meist nur ein Mangel an Bewegung, kein Charakterzug.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-26",
      "text": "Dein Körper ist das Fundament – alles andere baust du darauf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-27",
      "text": "Ausdauer im Training zeigt sich später als Ausdauer im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-28",
      "text": "Wer früh schwitzt, muss abends nicht hoffen, sondern weiß.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-29",
      "text": "Energie ist ansteckend – fang bei dir selbst an, sie zu erzeugen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-11-04-0",
      "text": "Dankbarkeit ist der einzige Zinssatz, der sofort ausgezahlt wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-1",
      "text": "Du vergleichst dein Kapitel 3 mit fremdem Kapitel 20. Hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-2",
      "text": "Zufriedenheit ist kein Ziel, sondern eine tägliche Entscheidung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-3",
      "text": "Wer nichts schätzt, was er hat, verdient auch nichts Neues.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-4",
      "text": "Dein Leben jetzt war mal dein Wunschtraum von vor fünf Jahren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-5",
      "text": "Erfolg ohne Dankbarkeit ist nur lauter Lärm.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-6",
      "text": "Du jagst dem Nächsten hinterher und übersiehst, was du schon erreicht hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-7",
      "text": "Zufriedenheit macht dich nicht faul, sie macht dich stabil.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-8",
      "text": "Dankbarkeit ist das leiseste Mindset-Upgrade mit der größten Wirkung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-9",
      "text": "Wer ständig mehr will, verpasst das, was schon da ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-10",
      "text": "Dein Gehirn merkt sich Mängel. Trainiere es um, Fülle zu sehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-11",
      "text": "Nicht jeder Tag ist gut, aber in jedem Tag steckt etwas Gutes.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-12",
      "text": "Zufriedenheit ist der Boden, auf dem echter Ehrgeiz wächst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-13",
      "text": "Du musst nicht alles neu haben wollen, um dankbar zu sein für das Jetzige.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-14",
      "text": "Wer das Kleine nicht feiert, wird das Große nicht genießen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-15",
      "text": "Dankbarkeit kostet nichts und verändert alles.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-16",
      "text": "Du bist weiter, als du denkst, und undankbarer, als dir bewusst ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-17",
      "text": "Zufriedene Menschen arbeiten ruhiger, nicht langsamer.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-18",
      "text": "Schreib dir auf, was heute lief. Es ist mehr, als du glaubst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-19",
      "text": "Dankbarkeit ist kein Stillstand, sie ist Treibstoff mit Haltung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-20",
      "text": "Du willst mehr erreichen, aber hast nie gewürdigt, was schon steht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-21",
      "text": "Zufriedenheit heißt nicht aufhören, sondern anders weitermachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-22",
      "text": "Dein größter Luxus heute: Dinge, über die andere früher nur geträumt haben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-23",
      "text": "Wer dankbar lebt, verhandelt nicht mehr mit dem Schicksal.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-24",
      "text": "Nicht jede Ruhe ist Rückschritt. Manche ist verdiente Ernte.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-25",
      "text": "Du bist nicht im Rückstand. Du bist mitten im eigenen Tempo.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-26",
      "text": "Dankbarkeit macht aus Zufall ein Geschenk.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-27",
      "text": "Zufriedenheit ist der stille Beweis, dass du schon viel richtig gemacht hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-28",
      "text": "Du brauchst keinen Grund zur Freude. Du brauchst nur den Blick dafür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-29",
      "text": "Wer heute dankbar ist, startet morgen mit einem Vorsprung im Kopf.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    }
  ]
}