{
  "generatedAt": "2026-11-11",
  "quotes": [
    {
      "id": "mindset-2026-11-11-0",
      "text": "Disziplin ist die Entscheidung, die du triffst, wenn Motivation schon schläft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-1",
      "text": "Dein Kopf kapituliert immer vor deinem Körper – trainier beide.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-2",
      "text": "Schwache Gedanken bauen keine starken Leben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-3",
      "text": "Du verlierst nicht gegen andere, du verlierst gegen deine Ausreden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-4",
      "text": "Komfort ist der Ort, an dem Träume leise sterben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-5",
      "text": "Mentale Stärke zeigt sich nicht laut, sondern in stillen Entscheidungen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-6",
      "text": "Wer sich selbst führt, braucht niemanden, der ihn antreibt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-7",
      "text": "Zweifel sind Mieter in deinem Kopf – kündige ihnen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-8",
      "text": "Dein Limit ist meistens nur eine Geschichte, die du dir erzählst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-9",
      "text": "Stärke beginnt dort, wo deine Ausrede endet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-10",
      "text": "Du wirst nicht motiviert geboren, du wirst diszipliniert gemacht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-11",
      "text": "Jeder Tag, an dem du durchhältst, ist ein Beweis gegen dein altes Ich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-12",
      "text": "Resilienz ist kein Talent, sondern eine tägliche Wiederholung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-13",
      "text": "Dein größter Gegner trägt dein Gesicht und flüstert leise.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-14",
      "text": "Wer im Kopf aufgibt, hat schon verloren, bevor der Körper es merkt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-15",
      "text": "Stille Stärke schlägt lauten Zweifel jedes Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-16",
      "text": "Du musst nicht motiviert sein, du musst nur weitermachen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-17",
      "text": "Mentale Klarheit entsteht, wenn du aufhörst, dich zu rechtfertigen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-18",
      "text": "Gewohnheiten formen Charakter schneller als Gedanken.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-19",
      "text": "Dein Verstand testet dich, bevor er dir vertraut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-20",
      "text": "Wachstum fühlt sich nie bequem an – das ist der Beweis, dass es passiert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-21",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-22",
      "text": "Die stärkste Version von dir wartet hinter dem Widerstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "mindset-2026-12-04-23",
      "text": "Kontrolle über deine Gedanken ist die einzige Freiheit, die zählt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-04"
    },
    {
      "id": "mindset-2026-12-05-24",
      "text": "Disziplin fühlt sich erst schwer an, dann wird sie zur Identität.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-05"
    },
    {
      "id": "mindset-2026-12-06-25",
      "text": "Du brauchst keine Inspiration, du brauchst ein System.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-06"
    },
    {
      "id": "mindset-2026-12-07-26",
      "text": "Mentale Stärke ist die Fähigkeit, unbequem zu bleiben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-07"
    },
    {
      "id": "mindset-2026-12-08-27",
      "text": "Dein innerer Dialog entscheidet, wie weit du gehst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-08"
    },
    {
      "id": "mindset-2026-12-09-28",
      "text": "Wer sich selbst nicht fordert, bleibt für immer derselbe.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-09"
    },
    {
      "id": "mindset-2026-12-10-29",
      "text": "Stärke ist kein Gefühl, sie ist eine Entscheidung, die du wiederholst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-10"
    },
    {
      "id": "business-2026-11-11-0",
      "text": "Motivation ist unzuverlässig. Disziplin zeigt auch dann auf, wenn du keine Lust hast.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-1",
      "text": "Deine Ausreden klingen gut. Dein Kontostand hört trotzdem nicht zu.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-2",
      "text": "Während andere Serien schauen, baust du dein Imperium. Das ist der Unterschied.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-3",
      "text": "Zeit ist die einzige Währung, die du nicht nachdrucken kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-4",
      "text": "Wer immer erst bereit sein will, wartet sein ganzes Leben.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-5",
      "text": "Dein Umsatz wächst nicht durch Wunschdenken, sondern durch Taten vor dem Frühstück.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-6",
      "text": "Erfolg fragt nicht nach deiner Stimmung. Er fragt nach deinem Output.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-7",
      "text": "Jeder Tag ohne Fortschritt ist eine stille Entscheidung gegen dich selbst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-8",
      "text": "Reich wird man nicht durch Zufall, sondern durch Entscheidungen, die niemand sieht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-9",
      "text": "Du musst nicht motiviert sein. Du musst nur anfangen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-10",
      "text": "Komfort ist der teuerste Kredit, den du je aufgenommen hast.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-11",
      "text": "Die Konkurrenz schläft nicht, aber du scrollst gerade.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-12",
      "text": "Baue heute Systeme, die morgen ohne dich funktionieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-13",
      "text": "Dein zukünftiges Ich zahlt den Preis für die Ausreden von heute.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-14",
      "text": "Niemand merkt deinen Fleiß, bis die Zahlen sprechen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-15",
      "text": "Kleine Entscheidungen, hundertmal wiederholt, bauen Imperien.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-16",
      "text": "Wer auf den perfekten Moment wartet, verpasst jeden einzelnen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-17",
      "text": "Dein Netzwerk ist dein Nettovermögen, aber nur wenn du es pflegst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-18",
      "text": "Fokus schlägt Talent, wenn Talent sich selbst im Weg steht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-19",
      "text": "Arbeite, als ob dein Wettbewerb genau jetzt losläuft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-20",
      "text": "Ausreden sind billig. Ergebnisse sind es nicht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-21",
      "text": "Dein Business wächst im Tempo deiner unbequemen Entscheidungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-22",
      "text": "Du verhandelst nicht mit der Realität, du passt deinen Plan an.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-12-04-23",
      "text": "Wer nur über Ideen redet, hat noch keine davon umgesetzt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-04"
    },
    {
      "id": "business-2026-12-05-24",
      "text": "Die ersten Kunden kommen nicht durch Glück, sondern durch Beharrlichkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-05"
    },
    {
      "id": "business-2026-12-06-25",
      "text": "Dein Kalender zeigt, ob deine Ziele echt sind oder nur Wünsche.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-06"
    },
    {
      "id": "business-2026-12-07-26",
      "text": "Zinseszins gilt auch für Gewohnheiten, nicht nur für Geld.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-07"
    },
    {
      "id": "business-2026-12-08-27",
      "text": "Du brauchst keinen Plan B. Du brauchst Commitment zu Plan A.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-08"
    },
    {
      "id": "business-2026-12-09-28",
      "text": "Produktivität beginnt genau da, wo deine Ausreden enden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-09"
    },
    {
      "id": "business-2026-12-10-29",
      "text": "Wer heute bequem ist, finanziert morgen die Bequemlichkeit anderer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-10"
    },
    {
      "id": "discipline-2026-11-11-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-1",
      "text": "Motivation checkt aus, Disziplin bleibt bis zum Ende der Schicht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-2",
      "text": "Du brauchst keine Inspiration, du brauchst einen Plan und die Konsequenz, ihn durchzuziehen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-3",
      "text": "Jeden Tag, an dem du dranbleibst, schickst du eine Ausrede in Rente.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-4",
      "text": "Durchhalten ist der Skill, den keiner zeigt, aber jeder braucht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-5",
      "text": "Dein Comeback beginnt genau dann, wenn du keine Lust mehr hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-6",
      "text": "Konsequenz schlägt Talent, wenn Talent nicht konsequent ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-7",
      "text": "Die Ausrede von heute ist der Grund, warum du in einem Jahr noch hier stehst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-8",
      "text": "Disziplin fühlt sich wie Freiheit an, nur zwei Jahre zu spät.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-9",
      "text": "Wer dranbleibt, wenn's unsexy wird, gewinnt, wenn's zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-10",
      "text": "Dein zukünftiges Ich zahlt heute die Rechnung für deine Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-11",
      "text": "Nicht jeder Tag fühlt sich gut an, aber jeder Tag zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-12",
      "text": "Du musst dich nicht motiviert fühlen, du musst nur zeigen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-13",
      "text": "Disziplin ist leise. Sie postet nicht, sie liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-14",
      "text": "Gewohnheiten bauen das Leben, das Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-15",
      "text": "Der Unterschied zwischen Wunsch und Ziel ist ein Kalender voller Wiederholungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-16",
      "text": "Du überspringst nicht den Tag, du überspringst die Version von dir, die du sein wolltest.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-17",
      "text": "Stärke ist nicht, keine Zweifel zu haben, sondern trotzdem zu liefern.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-18",
      "text": "Jeder Tag Disziplin ist ein Investment, das niemand sieht, bis es explodiert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-19",
      "text": "Durchhalten heißt, weiterzumachen, wenn der Applaus längst verstummt ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-20",
      "text": "Dein System schlägt deine Stimmung, jeden Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-21",
      "text": "Disziplin ist der Unterschied zwischen Wollen und Werden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-22",
      "text": "Wer aufhört, wenn's schwer wird, bleibt für immer dort stehen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-12-04-23",
      "text": "Die Wiederholung ist langweilig, das Ergebnis nicht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-04"
    },
    {
      "id": "discipline-2026-12-05-24",
      "text": "Du bist nicht müde von der Arbeit, du bist müde von der Debatte davor.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-05"
    },
    {
      "id": "discipline-2026-12-06-25",
      "text": "Disziplin ist der Preis, Reue ist die Rechnung ohne Rabatt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-06"
    },
    {
      "id": "discipline-2026-12-07-26",
      "text": "Kleine Taten, oft wiederholt, schlagen große Pläne, selten begonnen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-07"
    },
    {
      "id": "discipline-2026-12-08-27",
      "text": "Niemand sieht die 5-Uhr-Alarme, alle sehen das Ergebnis danach.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-08"
    },
    {
      "id": "discipline-2026-12-09-28",
      "text": "Konsistenz ist unsichtbar, bis sie unübersehbar wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-09"
    },
    {
      "id": "discipline-2026-12-10-29",
      "text": "Du musst nicht schneller sein, du musst nur länger durchhalten als dein Zweifel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-10"
    },
    {
      "id": "fitness-2026-11-11-0",
      "text": "Dein Körper ist der Zinseszins deiner Disziplin.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-1",
      "text": "Energie ist die einzige Währung, die du nicht leihen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-2",
      "text": "Wer seinen Körper vernachlässigt, verliert sein bestes Investment.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-3",
      "text": "Schwitzen ist die Steuer, die du für klare Gedanken zahlst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-4",
      "text": "Dein Training heute ist der Vorsprung von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-5",
      "text": "Müdigkeit lügt, Bewegung sagt die Wahrheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-6",
      "text": "Ein starker Körper verhandelt bessere Deals mit dem Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-7",
      "text": "Du trainierst nicht für den Spiegel, sondern für die nächsten 50 Jahre.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-8",
      "text": "Wer sich bewegt, bewegt auch seine Gedanken.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-9",
      "text": "Disziplin im Training ist Disziplin im Leben – nur lauter.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-10",
      "text": "Dein Körper merkt sich jede Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-11",
      "text": "Bewegung ist das günstigste Antidepressivum, das niemand nimmt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-12",
      "text": "Wer im Gym kämpft, kapituliert im Alltag seltener.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-13",
      "text": "Dein Energielevel entscheidet, wer du um 18 Uhr noch bist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-14",
      "text": "Schlaf ist dein Trainingspartner, nicht dein Feind.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-15",
      "text": "Du bist nicht müde, du bist unbewegt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-16",
      "text": "Körperliche Stärke ist die Basiswährung für alles andere.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-17",
      "text": "Jeder Satz Wiederholungen ist eine Einzahlung auf dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-18",
      "text": "Wer aufhört sich zu bewegen, fängt an zu rosten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-19",
      "text": "Dein Puls ist der ehrlichste Indikator für dein Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-20",
      "text": "Ausdauer im Training ist Ausdauer im Business.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-21",
      "text": "Ein Tag ohne Bewegung ist ein Tag im Minus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-22",
      "text": "Dein Körper ist dein erstes Büro – halt es in Ordnung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-12-04-23",
      "text": "Stärke baust du nicht im Spiegel, sondern in der Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-04"
    },
    {
      "id": "fitness-2026-12-05-24",
      "text": "Wer seine Energie managt, braucht keine Motivation.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-05"
    },
    {
      "id": "fitness-2026-12-06-25",
      "text": "Bewegung schlägt Kaffee – jedes Mal.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-06"
    },
    {
      "id": "fitness-2026-12-07-26",
      "text": "Dein Immunsystem kennt deine Ausreden nicht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-07"
    },
    {
      "id": "fitness-2026-12-08-27",
      "text": "Trainiere, als würde dein 40-jähriges Ich zuschauen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-08"
    },
    {
      "id": "fitness-2026-12-09-28",
      "text": "Ein müder Kopf wohnt oft in einem unbewegten Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-09"
    },
    {
      "id": "fitness-2026-12-10-29",
      "text": "Kraft ist das einzige Kapital, das mit Nutzung wächst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-10"
    },
    {
      "id": "gratitude-2026-11-11-0",
      "text": "Dankbarkeit ist der Zinseszins der Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-1",
      "text": "Wer das Jetzt wertschätzt, braucht kein Morgen zur Flucht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-2",
      "text": "Zufriedenheit ist kein Ziel, sie ist eine tägliche Entscheidung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-3",
      "text": "Du besitzt mehr, als dein Vergleich dir zeigt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-4",
      "text": "Dankbarkeit kostet nichts und zahlt sich sofort aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-5",
      "text": "Wer dankbar lebt, verliert die Angst vor Verlust.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-6",
      "text": "Zufriedenheit beginnt da, wo der Vergleich aufhört.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-7",
      "text": "Was du heute hast, war gestern noch dein Traum.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-8",
      "text": "Dankbarkeit ist die stille Schwester des Erfolgs.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-9",
      "text": "Genug ist ein Gefühl, kein Kontostand.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-10",
      "text": "Wer dankbar beginnt, endet selten enttäuscht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-11",
      "text": "Zufriedenheit ist der Luxus, den Geld nicht kauft.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-12",
      "text": "Dankbarkeit macht aus wenig genug und aus genug mehr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-13",
      "text": "Du jagst dem Mehr hinterher und übersiehst das Genug.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-14",
      "text": "Wertschätzung ist die Währung der Zufriedenen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-15",
      "text": "Dankbar sein heißt, im Jetzt reich sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-16",
      "text": "Zufriedenheit wächst dort, wo Neid verwelkt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-17",
      "text": "Dein Leben ist kein Entwurf, es ist bereits ein Werk.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-18",
      "text": "Dankbarkeit verwandelt Besitz in Bedeutung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-19",
      "text": "Wer zählt, was er hat, hört auf zu vergleichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-20",
      "text": "Zufriedenheit ist stiller Wohlstand.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-21",
      "text": "Dankbarkeit ist der kürzeste Weg zur inneren Ruhe.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-22",
      "text": "Du musst nicht mehr werden, um genug zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-12-04-23",
      "text": "Zufrieden sein heißt nicht stehen bleiben, sondern angekommen sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-04"
    },
    {
      "id": "gratitude-2026-12-05-24",
      "text": "Dankbarkeit sieht, was Ehrgeiz oft übersieht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-05"
    },
    {
      "id": "gratitude-2026-12-06-25",
      "text": "Das Leben, das du hast, war nie selbstverständlich.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-06"
    },
    {
      "id": "gratitude-2026-12-07-26",
      "text": "Wer dankbar ist, verschwendet keine Energie an Neid.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-07"
    },
    {
      "id": "gratitude-2026-12-08-27",
      "text": "Zufriedenheit ist die Belohnung für echte Klarheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-08"
    },
    {
      "id": "gratitude-2026-12-09-28",
      "text": "Dankbarkeit macht aus einem Tag ein Geschenk.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-09"
    },
    {
      "id": "gratitude-2026-12-10-29",
      "text": "Genug zu haben ist die unterschätzteste Form von Reichtum.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-10"
    }
  ]
}