{
  "generatedAt": "2026-10-17",
  "quotes": [
    {
      "id": "mindset-2026-10-17-0",
      "text": "Deine Ausreden sind lauter als dein Wille. Dreh die Lautstärke um.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-1",
      "text": "Motivation ist ein Gast. Disziplin zahlt die Miete.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-2",
      "text": "Du musst dich nicht gut fühlen, um anzufangen. Du fühlst dich gut, weil du angefangen hast.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-3",
      "text": "Dein Kopf verhandelt. Lass ihn nicht gewinnen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-4",
      "text": "Schwache Momente sind normal. Schwache Entscheidungen sind eine Wahl.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-5",
      "text": "Niemand rettet dich vor dir selbst. Übernimm den Job.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-6",
      "text": "Komfort ist der leiseste Dieb deiner Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-7",
      "text": "Du willst Ergebnisse, aber verhandelst mit dem Prozess. Hör auf damit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-8",
      "text": "Dein innerer Kritiker hat keine Beweise, nur Angst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-9",
      "text": "Stärke zeigt sich nicht im Erfolg, sondern im Montagmorgen nach der Niederlage.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-10",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-11",
      "text": "Mentale Stärke heißt: trotzdem, obwohl keine Lust.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-12",
      "text": "Dein Verstand testet dich jeden Tag. Besteh die Prüfung leise.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-13",
      "text": "Wer auf perfekte Bedingungen wartet, wartet für immer.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-14",
      "text": "Disziplin ist das, was übrig bleibt, wenn Motivation geht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-15",
      "text": "Du verlierst nicht gegen andere. Du verlierst gegen deine Snooze-Taste.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-16",
      "text": "Harte Tage bauen den Charakter, den leichte Tage nur zeigen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-17",
      "text": "Dein Gehirn will Sicherheit. Dein Ziel braucht Risiko. Entscheide dich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-18",
      "text": "Zweifel ist kein Signal zum Aufhören. Es ist ein Zeichen, dass es zählt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-19",
      "text": "Du musst nicht motiviert sein. Du musst nur konsequent sein.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-20",
      "text": "Der Widerstand, den du spürst, ist der Beweis, dass du wachsen würdest.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-21",
      "text": "Starke Menschen fühlen auch Angst. Sie handeln trotzdem zuerst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-22",
      "text": "Du bist nicht blockiert. Du vermeidest Unbehagen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-23",
      "text": "Die Stimme, die sagt morgen, ist derselbe Grund, warum gestern nichts passiert ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-24",
      "text": "Mentale Stärke ist unspektakulär. Sie sieht aus wie Routine an einem schlechten Tag.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-25",
      "text": "Du kontrollierst nicht, was passiert. Du kontrollierst, wie oft du aufstehst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-26",
      "text": "Dein zukünftiges Ich bezahlt für die Bequemlichkeit, die du dir heute gönnst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-27",
      "text": "Nicht jeder Gedanke verdient eine Reaktion. Manche verdienen nur Stille.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-28",
      "text": "Du brauchst keinen perfekten Plan. Du brauchst den Mut, den ersten Schritt zu versauen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-29",
      "text": "Wachstum fühlt sich an wie Unsicherheit mit Zielrichtung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-10-17-0",
      "text": "Motivation ist unzuverlässig. Baue Systeme, die auch ohne sie funktionieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-1",
      "text": "Deine Ausreden sind gut. Nur leider nicht profitabel.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-2",
      "text": "Wer auf den perfekten Moment wartet, zahlt Miete in der Warteschlange.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-3",
      "text": "Konsequenz schlägt Talent, wenn Talent sich nicht bewegt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-4",
      "text": "Zeit ist das einzige Investment, das keine zweite Chance kennt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-5",
      "text": "Erfolg ist kein Zufall, er ist eine Rechnung mit vielen kleinen Posten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-6",
      "text": "Wer immer nur plant, hat noch nie wirklich angefangen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-7",
      "text": "Dein Umsatz kennt deine Ausreden nicht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-8",
      "text": "Komfort ist der leiseste Weg in die Bedeutungslosigkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-9",
      "text": "Jeder Tag ohne Fortschritt ist ein verkaufter Tag deiner Zukunft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-10",
      "text": "Disziplin ist das Kapital, das dir niemand abnehmen kann.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-11",
      "text": "Wachstum passiert nicht im Kopf, sondern in der Wiederholung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-12",
      "text": "Du brauchst keine Inspiration. Du brauchst einen Kalender.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-13",
      "text": "Wer ständig Optionen offenhält, trifft nie eine Entscheidung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-14",
      "text": "Dein Netzwerk ist nur so stark wie dein letzter Wertbeitrag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-15",
      "text": "Risiko ist nur ein anderes Wort für ungenutzte Chance.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-16",
      "text": "Niemand bezahlt dich für Pläne. Man bezahlt für Ergebnisse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-17",
      "text": "Fokus ist die Fähigkeit, gute Ideen bewusst zu ignorieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-18",
      "text": "Dein Wecker entscheidet nicht über deinen Erfolg. Deine erste Stunde schon.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-19",
      "text": "Wer alles kontrollieren will, baut nie etwas Großes.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-20",
      "text": "Geld folgt Klarheit, nicht Fleiß allein.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-21",
      "text": "Kleine Entscheidungen heute sind die Bilanz von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-22",
      "text": "Du skalierst nicht dein Business. Du skalierst deine Gewohnheiten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-23",
      "text": "Perfektion ist der Luxus, den sich niemand im Wettbewerb leisten kann.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-24",
      "text": "Wer wartet, bis er bereit ist, wartet für immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-25",
      "text": "Dein größter Konkurrent ist dein gestriges Ich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-26",
      "text": "Arbeit ohne Richtung ist nur Bewegung, kein Fortschritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-27",
      "text": "Jede verschobene Aufgabe zahlt Zinsen – gegen dich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-28",
      "text": "Baue, während andere noch diskutieren, ob es funktioniert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-29",
      "text": "Dein Standard von heute ist dein Limit von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-10-17-0",
      "text": "Disziplin ist der Zinseszins der Gewohnheiten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-1",
      "text": "Motivation lädt dich ein, Disziplin bringt dich hin.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-2",
      "text": "Du musst nicht jeden Tag wollen, nur jeden Tag machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-3",
      "text": "Konsequenz schlägt Intensität – jedes Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-4",
      "text": "Der Widerstand heute ist der Vorsprung von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-5",
      "text": "Wer aufhört, wenn es schwer wird, fängt nie wirklich an.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-6",
      "text": "Disziplin ist die Sprache, die dein zukünftiges Ich versteht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-7",
      "text": "Deine Comfort Zone bezahlt keine Rechnungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-8",
      "text": "Kleine Wiederholungen bauen große Resultate.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-9",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-10",
      "text": "Zeig auf, auch wenn niemand klatscht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-11",
      "text": "Disziplin fühlt sich erst nach Freiheit an, wenn du durchhältst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-12",
      "text": "Ausreden sind gut geschriebene Lügen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-13",
      "text": "Dein Durchhaltevermögen entscheidet, wie weit dein Talent reicht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-14",
      "text": "Nicht die Idee zählt, sondern der Tag danach.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-15",
      "text": "Wiederhole den Prozess, nicht die Ausrede.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-16",
      "text": "Jeder Tag ohne Abkürzung ist ein Tag mehr Fundament.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-17",
      "text": "Disziplin ist leise, Ergebnisse sind laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-18",
      "text": "Du trainierst nicht den Körper, du trainierst den Willen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-19",
      "text": "Stillstand fühlt sich sicher an – genau deshalb ist er gefährlich.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-20",
      "text": "Mach es, bevor du Lust dazu hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-21",
      "text": "Dein System schlägt deine Stimmung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-22",
      "text": "Disziplin ist der Unterschied zwischen Plan und Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-23",
      "text": "Du scheiterst nicht am Ziel, du scheiterst an der Routine.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-24",
      "text": "Durchhalten ist unsichtbar, bis es sichtbar wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-25",
      "text": "Wer Pausen sammelt, sammelt keine Erfolge.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-26",
      "text": "Disziplin ist Selbstliebe in Aktion.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-27",
      "text": "Du brauchst keine Motivation, du brauchst einen Termin mit dir selbst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-28",
      "text": "Der Unterschied zwischen Traum und Ziel ist ein Datum und Disziplin.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-29",
      "text": "Konstanz ist das stille Superpower der Erfolgreichen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-10-17-0",
      "text": "Dein Körper ist dein Investment-Portfolio – niemand sonst zahlt die Dividende.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-1",
      "text": "Energie ist die einzige Währung, die du dir nicht leihen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-2",
      "text": "Jedes Workout ist eine Einzahlung auf dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-3",
      "text": "Müdigkeit lügt öfter als dein innerer Schweinehund.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-4",
      "text": "Wer seinen Körper vernachlässigt, verliert Rendite auf jedes andere Ziel.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-5",
      "text": "Bewegung ist der Zinseszins der Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-6",
      "text": "Du brauchst keine Motivation, du brauchst Sneaker und zehn Minuten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-7",
      "text": "Dein Puls ist der ehrlichste Indikator dafür, wie ernst du es meinst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-8",
      "text": "Schlaf ist kein Luxus, sondern deine Erholungs-Strategie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-9",
      "text": "Stärke baust du nicht im Kopf, sondern im Wiederholen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-10",
      "text": "Disziplin im Training ist der Vorgeschmack auf Disziplin im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-11",
      "text": "Dein Körper merkt sich jede Ausrede, die du ihm erzählst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-12",
      "text": "Wer morgens schwitzt, denkt mittags klarer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-13",
      "text": "Kraft ist kein Zufall, sondern ein Abo, das du täglich verlängerst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-14",
      "text": "Ein müder Körper produziert müde Entscheidungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-15",
      "text": "Bewegung ist das billigste Antidepressivum, das du nie einlöst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-16",
      "text": "Du optimierst deinen Kalender, aber ignorierst deine Erholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-17",
      "text": "Jeder Schritt heute ist Kapital für den Marathon deines Lebens.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-18",
      "text": "Dein Energielevel entscheidet, wie groß dein Tag werden darf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-19",
      "text": "Fitness ist kein Ziel, sondern das Fundament für alle anderen Ziele.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-20",
      "text": "Wer seinen Körper trainiert, trainiert automatisch seinen Willen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-21",
      "text": "Die beste Zeit zu trainieren war gestern, die zweitbeste ist jetzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-22",
      "text": "Dein Körper ist das einzige Büro, das du nie kündigen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-23",
      "text": "Kalte Duschen lügen nicht – sie zeigen, wie wach du wirklich bist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-24",
      "text": "Ausdauer im Training ist Ausdauer im Leben – nur schneller sichtbar.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-25",
      "text": "Du kannst keine Höchstleistung von einem erschöpften System erwarten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-26",
      "text": "Jede Bewegung heute spart dir Arztkosten von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-27",
      "text": "Dein Körper ist die Hardware – vernachlässige sie nicht für Software-Updates.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-28",
      "text": "Wer sich täglich bewegt, verhandelt nicht mehr mit seiner Faulheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-29",
      "text": "Energie tankst du nicht im Schlaf allein, sondern im Tun.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-10-17-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist die Basis für den nächsten Move.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-1",
      "text": "Du checkst dein Konto öfter als dein Glück - dreh das um.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-2",
      "text": "Dankbarkeit ist der günstigste Produktivitäts-Hack, den es gibt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-3",
      "text": "Wer nie zufrieden ist mit dem Status quo, verpasst den Moment, in dem er lebt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-4",
      "text": "Erfolg ohne Dankbarkeit ist nur ein leeres Konto mit vielen Nullen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-5",
      "text": "Du vergleichst dein Jetzt mit dem Highlight-Reel von anderen - hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-6",
      "text": "Dankbarkeit kostet nichts und bringt mehr Rendite als jedes Investment.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-7",
      "text": "Wer das Jetzt nicht wertschätzt, wird auch das Später nicht genießen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-8",
      "text": "Zufriedenheit ist nicht das Gegenteil von Ambition - sie ist ihr Fundament.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-9",
      "text": "Du grindest für ein Leben, das du gerade schon führst - schau genauer hin.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-10",
      "text": "Dankbarkeit ist der Zinseszins für dein Mindset.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-11",
      "text": "Mehr haben wollen ist okay. Weniger wertschätzen nicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-12",
      "text": "Dein Jetzt war mal dein Wunschtraum von vor drei Jahren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-13",
      "text": "Zufriedenheit ist kein Stillstand, sie ist dein Checkpoint vor dem nächsten Level.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-14",
      "text": "Du optimierst deinen Tag, aber nie deinen Blick auf das, was schon läuft.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-15",
      "text": "Dankbarkeit macht aus genug ein gutes Leben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-16",
      "text": "Wer nie ankommt, vergisst auch nie zu genießen, wo er gerade steht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-17",
      "text": "Dein größtes Investment heute: fünf Minuten Dankbarkeit statt Doomscrolling.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-18",
      "text": "Zufriedenheit ist der stille Flex, den keiner sieht, aber jeder spürt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-19",
      "text": "Du jagst Meilensteine und verpasst die Straße dazwischen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-20",
      "text": "Dankbarkeit ist kein Soft-Skill, sie ist dein mentaler Puffer gegen Burnout.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-21",
      "text": "Was du heute selbstverständlich findest, war früher dein großes Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-22",
      "text": "Zufriedenheit bremst dich nicht, sie gibt dir den Grund weiterzumachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-23",
      "text": "Du trackst jede Ausgabe, aber nie die Momente, die sich gelohnt haben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-24",
      "text": "Dankbarkeit ist die einzige Währung, die mit Teilen mehr wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-25",
      "text": "Wachstum ohne Dankbarkeit ist nur Bewegung ohne Richtung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-26",
      "text": "Dein Umfeld, deine Gesundheit, dein Start - das war nie selbstverständlich.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-27",
      "text": "Zufriedenheit heute ist der Treibstoff für den Hustle von morgen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-28",
      "text": "Du willst mehr erreichen und vergisst, was du schon überstanden hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-29",
      "text": "Dankbarkeit ist der Unterschied zwischen Erfolg haben und Erfolg spüren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    }
  ]
}