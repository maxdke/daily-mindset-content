{
  "generatedAt": "2026-10-04",
  "quotes": [
    {
      "id": "mindset-2026-10-04-0",
      "text": "Disziplin ist der Zinseszins der Persönlichkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-04"
    },
    {
      "id": "mindset-2026-10-05-1",
      "text": "Deine Ausreden klingen besser als dein Ergebnis. Tausch das.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-05"
    },
    {
      "id": "mindset-2026-10-06-2",
      "text": "Schwache Momente sind keine Charakterfehler, nur Entscheidungspunkte.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-06"
    },
    {
      "id": "mindset-2026-10-07-3",
      "text": "Comfort ist der leiseste Dieb deiner Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-07"
    },
    {
      "id": "mindset-2026-10-08-4",
      "text": "Du musst nicht motiviert sein, du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-08"
    },
    {
      "id": "mindset-2026-10-09-5",
      "text": "Mentale Stärke zeigt sich dort, wo niemand zuschaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-09"
    },
    {
      "id": "mindset-2026-10-10-6",
      "text": "Dein Kopf gibt auf, lange bevor dein Körper es tut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-10"
    },
    {
      "id": "mindset-2026-10-11-7",
      "text": "Wer ständig Energie sucht, hat noch kein Ziel gefunden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-11"
    },
    {
      "id": "mindset-2026-10-12-8",
      "text": "Stillstand fühlt sich sicher an und kostet trotzdem alles.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-12"
    },
    {
      "id": "mindset-2026-10-13-9",
      "text": "Belohnung kommt nach der Arbeit, nicht als Ersatz dafür.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-13"
    },
    {
      "id": "mindset-2026-10-14-10",
      "text": "Du verhandelst nicht mit deinem inneren Schweinehund, du überstimmst ihn.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-14"
    },
    {
      "id": "mindset-2026-10-15-11",
      "text": "Resilienz ist kein Talent, sondern eine tägliche Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-15"
    },
    {
      "id": "mindset-2026-10-16-12",
      "text": "Dein Durchschnitt heute entscheidet über dein Maximum morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-16"
    },
    {
      "id": "mindset-2026-10-17-13",
      "text": "Null Tage frei bedeutet nicht null Pausen, sondern null Ausreden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-14",
      "text": "Wachstum fühlt sich wie Unbehagen an, bevor es sich wie Stolz anfühlt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-15",
      "text": "Du bist nicht müde, du bist unklar über dein Warum.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-16",
      "text": "Die stärkste Version von dir trainiert gerade jetzt in Gedanken.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-17",
      "text": "Perfektion ist die teuerste Form der Prokrastination.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-18",
      "text": "Deine Grenzen sind Verhandlungssache, dein Fokus nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-19",
      "text": "Gewohnheiten schlagen Motivation, jedes einzelne Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-20",
      "text": "Du brauchst keinen perfekten Plan, du brauchst den ersten Schritt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-21",
      "text": "Mentale Stärke ist der Unterschied zwischen aufgeben und aushalten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-22",
      "text": "Selbstdisziplin ist Freiheit in Verkleidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-23",
      "text": "Dein zukünftiges Ich zahlt für die Entscheidungen von heute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-24",
      "text": "Es gibt keine schlechten Tage, nur unterschätzte Chancen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-25",
      "text": "Konsequenz schlägt Intensität, langfristig immer.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-26",
      "text": "Du bist der Engpass und die Lösung zugleich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-27",
      "text": "Klarheit entsteht im Handeln, nicht im Nachdenken.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-28",
      "text": "Dein Standard ist das, was du wiederholt tolerierst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-29",
      "text": "Wachsen heißt, öfter unbequem zu sein als nötig.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-10-04-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-04"
    },
    {
      "id": "business-2026-10-05-1",
      "text": "Wer jeden Tag 1% besser wird, überholt in einem Jahr die ganze Konkurrenz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-05"
    },
    {
      "id": "business-2026-10-06-2",
      "text": "Motivation ist der Trigger, System ist der Motor.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-06"
    },
    {
      "id": "business-2026-10-07-3",
      "text": "Deine Ausreden haben einen Marktwert von null.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-07"
    },
    {
      "id": "business-2026-10-08-4",
      "text": "Erfolg ist kein Zufall, sondern eine tägliche Entscheidung mit Zinseszins.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-08"
    },
    {
      "id": "business-2026-10-09-5",
      "text": "Wer wartet, bis er bereit ist, verpasst das Fenster für immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-09"
    },
    {
      "id": "business-2026-10-10-6",
      "text": "Zeit ist die einzige Währung, die du nicht nachdrucken kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-10"
    },
    {
      "id": "business-2026-10-11-7",
      "text": "Komfortzonen sind die teuersten Mieten, die du zahlst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-11"
    },
    {
      "id": "business-2026-10-12-8",
      "text": "Wer aufhört zu lernen, hat sein Kapital bereits verloren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-12"
    },
    {
      "id": "business-2026-10-13-9",
      "text": "Plane wie ein Stratege, handle wie ein Besessener.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-13"
    },
    {
      "id": "business-2026-10-14-10",
      "text": "Dein Netzwerk ist dein Net Worth – aber nur, wenn du lieferst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-14"
    },
    {
      "id": "business-2026-10-15-11",
      "text": "Perfektion ist der Feind von Umsatz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-15"
    },
    {
      "id": "business-2026-10-16-12",
      "text": "Jede ungenutzte Stunde ist eine stille Rechnung an dein zukünftiges Scheitern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-16"
    },
    {
      "id": "business-2026-10-17-13",
      "text": "Baue, während andere noch diskutieren, ob es sich lohnt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-14",
      "text": "Reich wird, wer Probleme löst, bevor sie laut werden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-15",
      "text": "Dein Kalender zeigt, was dir wirklich wichtig ist – nicht dein Mund.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-16",
      "text": "Ausreden sind die billigste Investition mit der höchsten Verlustquote.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-17",
      "text": "Fokus schlägt Talent, wenn Talent sich selbst überschätzt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-18",
      "text": "Wer heute bequem ist, finanziert morgen den Erfolg anderer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-19",
      "text": "Dein größter Konkurrent ist die Version von dir, die aufgibt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-20",
      "text": "Umsatz folgt Konsequenz, nicht Inspiration.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-21",
      "text": "Baue dein Business wie ein Fundament, nicht wie ein Feuerwerk.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-22",
      "text": "Risiko ist nur gefährlich, wenn du unvorbereitet bist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-23",
      "text": "Wer nicht skaliert, stagniert – und Stagnation kostet mehr als Wachstum.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-24",
      "text": "Dein Output von heute ist dein Gehalt von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-25",
      "text": "Kleine Deadlines bauen große Imperien.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-26",
      "text": "Verkaufe Ergebnisse, nicht Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-27",
      "text": "Wer früh Verantwortung übernimmt, bekommt später die Freiheit dafür.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-28",
      "text": "Dein Start-up stirbt nicht an der Konkurrenz, sondern an deiner Zögerlichkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-29",
      "text": "Konsequenz ist das stille Kapital der Erfolgreichen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-10-04-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-04"
    },
    {
      "id": "discipline-2026-10-05-1",
      "text": "Motivation kommt und geht. Disziplin bleibt und liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-05"
    },
    {
      "id": "discipline-2026-10-06-2",
      "text": "Du musst keine Lust haben. Du musst nur anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-06"
    },
    {
      "id": "discipline-2026-10-07-3",
      "text": "Durchhalten ist die Abkürzung, die niemand sehen will.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-07"
    },
    {
      "id": "discipline-2026-10-08-4",
      "text": "Dein Komfort von heute ist die Rechnung von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-08"
    },
    {
      "id": "discipline-2026-10-09-5",
      "text": "Wer aufhört, wenn es wehtut, bleibt für immer auf diesem Level.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-09"
    },
    {
      "id": "discipline-2026-10-10-6",
      "text": "Disziplin ist leise. Ergebnisse sind laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-10"
    },
    {
      "id": "discipline-2026-10-11-7",
      "text": "Die Ausrede klingt immer besser als das Ergebnis, das du verpasst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-11"
    },
    {
      "id": "discipline-2026-10-12-8",
      "text": "Du trainierst nicht deinen Körper, du trainierst dein Durchhalten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-12"
    },
    {
      "id": "discipline-2026-10-13-9",
      "text": "Jeder Tag ohne Ausnahme ist ein Tag mehr Vorsprung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-13"
    },
    {
      "id": "discipline-2026-10-14-10",
      "text": "Disziplin fragt nicht nach deiner Stimmung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-14"
    },
    {
      "id": "discipline-2026-10-15-11",
      "text": "Konsequenz schlägt Talent, wenn Talent sich nicht anstrengt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-15"
    },
    {
      "id": "discipline-2026-10-16-12",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-16"
    },
    {
      "id": "discipline-2026-10-17-13",
      "text": "Das Ziel bleibt gleich. Deine Ausreden wechseln nur die Form.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-14",
      "text": "Wer Disziplin outsourct, bekommt nie geliefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-15",
      "text": "Durchhalten heißt: weitermachen, wenn niemand mehr zuschaut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-16",
      "text": "Dein zukünftiges Ich zahlt heute die Rechnung deiner Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-17",
      "text": "Disziplin ist der Unterschied zwischen Wollen und Werden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-18",
      "text": "Kein Tag ist zu klein für Fortschritt, nur dein Anspruch ist zu groß.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-19",
      "text": "Du brauchst keinen Plan B, du brauchst mehr Disziplin für Plan A.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-20",
      "text": "Die Wiederholung ist langweilig. Das Ergebnis nicht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-21",
      "text": "Disziplin ist Selbstrespekt in Aktion.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-22",
      "text": "Wer immer erst wartet, bis er bereit ist, wartet sein Leben lang.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-23",
      "text": "Durchhalten bedeutet, dem alten Ich eine Absage zu erteilen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-24",
      "text": "Dein Durchbruch liegt hinter dem Tag, an dem du aufgeben wolltest.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-25",
      "text": "Disziplin macht aus Zielen Termine.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-26",
      "text": "Du verlierst nicht an einem schlechten Tag, du verlierst, wenn du aufhörst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-27",
      "text": "Konstanz schlägt Intensität, jedes einzelne Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-28",
      "text": "Disziplin ist, was übrig bleibt, wenn die Begeisterung geht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-29",
      "text": "Wer durchzieht, obwohl es sich sinnlos anfühlt, gewinnt am Ende doppelt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-10-04-0",
      "text": "Dein Körper ist kein Projekt, das du abschließt. Er ist das System, das alles andere trägt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-04"
    },
    {
      "id": "fitness-2026-10-05-1",
      "text": "Energie kannst du nicht kaufen, nur erarbeiten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-05"
    },
    {
      "id": "fitness-2026-10-06-2",
      "text": "Wer seinen Körper vernachlässigt, verliert die Basis für jeden anderen Erfolg.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-06"
    },
    {
      "id": "fitness-2026-10-07-3",
      "text": "Schwache Disziplin im Training zeigt sich überall sonst im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-07"
    },
    {
      "id": "fitness-2026-10-08-4",
      "text": "Dein Limit von heute ist dein Warm-up von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-08"
    },
    {
      "id": "fitness-2026-10-09-5",
      "text": "Bewegung ist die billigste Therapie, die du dir trotzdem verweigerst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-09"
    },
    {
      "id": "fitness-2026-10-10-6",
      "text": "Wer müde ist, braucht keine Pause. Er braucht Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-10"
    },
    {
      "id": "fitness-2026-10-11-7",
      "text": "Dein Körper merkt sich jede Ausrede, die du ihm erzählst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-11"
    },
    {
      "id": "fitness-2026-10-12-8",
      "text": "Kraft baut man nicht im Kopf auf. Man baut sie im Widerstand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-12"
    },
    {
      "id": "fitness-2026-10-13-9",
      "text": "Die Version von dir, die du sein willst, trainiert bereits.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-13"
    },
    {
      "id": "fitness-2026-10-14-10",
      "text": "Niemand wird stark durch Zuschauen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-14"
    },
    {
      "id": "fitness-2026-10-15-11",
      "text": "Schlaf ist das günstigste Leistungsmittel, das du ignorierst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-15"
    },
    {
      "id": "fitness-2026-10-16-12",
      "text": "Dein Puls lügt nicht. Er zeigt, wie ernst du es meinst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-16"
    },
    {
      "id": "fitness-2026-10-17-13",
      "text": "Jeder Satz, den du auslässt, ist ein Gespräch mit deiner schwächeren Version.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-14",
      "text": "Fitness ist kein Ziel. Es ist die Infrastruktur für alles andere.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-15",
      "text": "Du verhandelst nicht mit Muskelkater. Du gehst durch ihn durch.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-16",
      "text": "Wer seine Energie managt, braucht keine Motivation mehr.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-17",
      "text": "Dein Körper ist der einzige Ort, den du nie verlassen kannst. Behandle ihn so.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-18",
      "text": "Bewegung erzeugt Klarheit, die kein Kaffee ersetzen kann.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-19",
      "text": "Stärke ist leise. Sie zeigt sich nicht, sie trägt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-20",
      "text": "Wer heute trainiert, kauft sich morgen Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-21",
      "text": "Dein Körper führt Protokoll über jede Entscheidung, die du triffst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-22",
      "text": "Schwitzen ist die Quittung für ein ehrliches Training.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-23",
      "text": "Ausdauer im Sport ist Ausdauer im Leben. Dasselbe Muskelgedächtnis.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-24",
      "text": "Wer nie an seine Grenze geht, kennt sie nicht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-25",
      "text": "Dein Körper verzeiht Pausen. Er verzeiht keine Stagnation.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-26",
      "text": "Energie ist keine Stimmung. Sie ist eine Entscheidung am Morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-27",
      "text": "Bewege dich, bevor dein Kopf Ausreden findet.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-28",
      "text": "Kraft ist das Nebenprodukt von Konsequenz, nicht von Talent.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-29",
      "text": "Dein zukünftiges Ich trainiert gerade in deiner Vorstellung. Mach es real.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-10-04-0",
      "text": "Dankbarkeit ist dein günstigster Produktivitäts-Hack.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-04"
    },
    {
      "id": "gratitude-2026-10-05-1",
      "text": "Zufrieden sein und trotzdem wachsen wollen – kein Widerspruch, sondern Reife.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-05"
    },
    {
      "id": "gratitude-2026-10-06-2",
      "text": "Wer nie dankbar ist, wird auch mit mehr nie genug haben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-06"
    },
    {
      "id": "gratitude-2026-10-07-3",
      "text": "Dein jetziges Leben war mal dein Wunschtraum vor zwei Jahren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-07"
    },
    {
      "id": "gratitude-2026-10-08-4",
      "text": "Zufriedenheit ist kein Ziel, sondern eine Entscheidung, die du heute triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-08"
    },
    {
      "id": "gratitude-2026-10-09-5",
      "text": "Vergleich frisst Dankbarkeit – lösch die App, nicht das Gefühl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-09"
    },
    {
      "id": "gratitude-2026-10-10-6",
      "text": "Du jagst die nächste Stufe und vergisst, wie weit du schon gekommen bist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-10"
    },
    {
      "id": "gratitude-2026-10-11-7",
      "text": "Dankbarkeit macht aus genug ein Gefühl, nicht aus mehr eine Pflicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-11"
    },
    {
      "id": "gratitude-2026-10-12-8",
      "text": "Wer das Kleine nicht wertschätzt, verdient das Große nicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-12"
    },
    {
      "id": "gratitude-2026-10-13-9",
      "text": "Zufriedenheit ist der Boden, auf dem echter Erfolg erst wächst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-13"
    },
    {
      "id": "gratitude-2026-10-14-10",
      "text": "Dankbar sein kostet nichts und verändert alles.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-14"
    },
    {
      "id": "gratitude-2026-10-15-11",
      "text": "Du brauchst keinen Grund zur Freude – du brauchst den Blick dafür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-15"
    },
    {
      "id": "gratitude-2026-10-16-12",
      "text": "Erfolg ohne Dankbarkeit ist nur Lärm.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-13",
      "text": "Dein Konto ist leer, dein Leben nicht – sortier deine Prioritäten neu.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-14",
      "text": "Zufriedenheit ist nicht Stillstand, sondern dein Ruhepuls beim Sprinten.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-15",
      "text": "Du hast heute geatmet, gegessen, gelebt – das ist kein Standard, das ist Glück.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-16",
      "text": "Dankbarkeit ist die einzige Investition ohne Risiko.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-17",
      "text": "Wer ständig mehr will, verpasst, was er längst hat.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-18",
      "text": "Zufriedenheit schlägt jeden Trend, der dir das Gegenteil verkaufen will.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-19",
      "text": "Dein größter Luxus ist, dass du wählen darfst, wofür du dankbar bist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-20",
      "text": "Nicht jeder Tag ist gut, aber in jedem Tag steckt etwas Gutes.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-21",
      "text": "Dankbarkeit verwandelt Druck in Perspektive.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-22",
      "text": "Du musst nicht alles haben, um alles zu fühlen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-23",
      "text": "Zufriedenheit ist stiller Stolz auf das, was du nicht mehr beweisen musst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-24",
      "text": "Mehr Geld löst selten das Problem, das fehlende Dankbarkeit verursacht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-25",
      "text": "Du wachst auf, atmest, lebst – der Rest ist Bonus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-26",
      "text": "Dankbarkeit ist die Abkürzung zur inneren Ruhe.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-27",
      "text": "Sei stolz auf das Jetzt, bevor du nach dem Nächsten greifst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-28",
      "text": "Zufriedenheit ist keine Schwäche – sie ist der Beweis, dass du angekommen bist, wo du sein wolltest.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-29",
      "text": "Dankbarkeit macht aus einem normalen Tag einen guten.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    }
  ]
}