{
  "generatedAt": "2026-10-07",
  "quotes": [
    {
      "id": "mindset-2026-10-07-0",
      "text": "Disziplin ist der Moment, in dem du trotzdem lieferst, obwohl keiner zuschaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-07"
    },
    {
      "id": "mindset-2026-10-08-1",
      "text": "Dein Kopf gibt zuerst auf, nicht dein Körper. Trainier beides.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-08"
    },
    {
      "id": "mindset-2026-10-09-2",
      "text": "Comfort Zones zahlen keine Rechnungen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-09"
    },
    {
      "id": "mindset-2026-10-10-3",
      "text": "Motivation ist ein Gast, Disziplin wohnt bei dir.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-10"
    },
    {
      "id": "mindset-2026-10-11-4",
      "text": "Du musst nicht bereit sein, du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-11"
    },
    {
      "id": "mindset-2026-10-12-5",
      "text": "Schwache Momente sind keine Charakterfehler, sie sind Trainingstage.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-12"
    },
    {
      "id": "mindset-2026-10-13-6",
      "text": "Wer auf perfekte Bedingungen wartet, wartet für immer.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-13"
    },
    {
      "id": "mindset-2026-10-14-7",
      "text": "Dein größter Konkurrent schläft gerade nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-14"
    },
    {
      "id": "mindset-2026-10-15-8",
      "text": "Ausreden sind gut formulierte Niederlagen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-15"
    },
    {
      "id": "mindset-2026-10-16-9",
      "text": "Stärke zeigt sich nicht im Erfolg, sondern danach, wenn du weitermachst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-16"
    },
    {
      "id": "mindset-2026-10-17-10",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-11",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-12",
      "text": "Kleine Disziplin heute spart große Reue morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-13",
      "text": "Niemand rettet dich. Das ist die gute Nachricht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-14",
      "text": "Dein Mindset ist der einzige Rohstoff, der nie ausgeht, wenn du ihn pflegst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-15",
      "text": "Komfort fühlt sich gut an und bringt dich nirgendwohin.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-16",
      "text": "Du wächst nicht trotz Widerstand, sondern durch ihn.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-17",
      "text": "Stillstand fühlt sich sicher an und kostet dich alles.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-18",
      "text": "Wer immer erst die Lust abwartet, wartet sein Leben lang.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-19",
      "text": "Dein zukünftiges Ich zahlt für die Ausreden von heute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-20",
      "text": "Fokus schlägt Talent, wenn Talent sich nicht fokussiert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-21",
      "text": "Du bist das Ergebnis dessen, was du wiederholst, nicht was du willst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-22",
      "text": "Der Widerstand, den du spürst, ist der Beweis, dass es zählt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-23",
      "text": "Mentale Stärke ist kein Gefühl, sie ist eine Entscheidung vor dem Gefühl.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-24",
      "text": "Du scheiterst nicht am Ziel, du scheiterst am Durchhalten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-25",
      "text": "Niemand sieht die Reps, die du nicht gemacht hast, außer du.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-26",
      "text": "Dein Limit ist meistens nur deine letzte schlechte Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-27",
      "text": "Unbequem ist der Preis für ein Leben, das sich lohnt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-28",
      "text": "Wer auf Motivation wartet, verpasst die Arbeit, die sie erzeugt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-29",
      "text": "Du verhandelst nicht mit dir selbst, du lieferst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-10-07-0",
      "text": "Dein Kontostand ist nur ein Nebeneffekt deiner Disziplin.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-07"
    },
    {
      "id": "business-2026-10-08-1",
      "text": "Wer um 9 Uhr noch plant, hat um 18 Uhr nichts gebaut.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-08"
    },
    {
      "id": "business-2026-10-09-2",
      "text": "Produktivität schlägt Motivation, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-09"
    },
    {
      "id": "business-2026-10-10-3",
      "text": "Du verhandelst nicht mit dem Markt, du passt dich an oder gehst unter.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-10"
    },
    {
      "id": "business-2026-10-11-4",
      "text": "Dein Business wächst genau so schnell wie deine Geduld.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-11"
    },
    {
      "id": "business-2026-10-12-5",
      "text": "Ausreden sind die teuerste Währung, die du besitzt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-12"
    },
    {
      "id": "business-2026-10-13-6",
      "text": "Wer jeden Tag 1% besser wird, baut in einem Jahr ein Imperium.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-13"
    },
    {
      "id": "business-2026-10-14-7",
      "text": "Dein Umsatz kennt deine Ausreden nicht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-14"
    },
    {
      "id": "business-2026-10-15-8",
      "text": "Fokus ist das neue Kapital.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-15"
    },
    {
      "id": "business-2026-10-16-9",
      "text": "Wer wartet, bis es perfekt ist, verliert an den, der längst startet.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-16"
    },
    {
      "id": "business-2026-10-17-10",
      "text": "Dein Kalender zeigt, wie ernst du es wirklich meinst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-11",
      "text": "Kunden kaufen Klarheit, nicht Chaos.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-12",
      "text": "Dein größter Konkurrent ist dein gestriges Ich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-13",
      "text": "Cashflow ist ehrlicher als jede Pitch-Deck-Folie.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-14",
      "text": "Wer heute aufschiebt, finanziert morgen die Schulden von gestern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-15",
      "text": "Systeme schlagen Willenskraft, jedes Mal.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-16",
      "text": "Dein Netzwerk ist dein Nettovermögen von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-17",
      "text": "Risiko ist der Preis, den Wachstum verlangt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-18",
      "text": "Wer nie verhandelt, zahlt den Preis des Schweigens.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-19",
      "text": "Dein Business stirbt nicht durch Konkurrenz, sondern durch Stillstand.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-20",
      "text": "Zeit ist das einzige Investment, das du nie zurückbekommst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-21",
      "text": "Wer skaliert, bevor er versteht, baut auf Sand.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-22",
      "text": "Dein erster Kunde ist dein wichtigster Investor.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-23",
      "text": "Disziplin ist die Brücke zwischen Idee und Imperium.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-24",
      "text": "Wer jede Entscheidung aufschiebt, trifft am Ende keine.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-25",
      "text": "Dein Pitch ist nur so gut wie dein letzter Beweis.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-26",
      "text": "Gewinn ist die Quittung für gelöste Probleme.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-27",
      "text": "Wer nicht rechnet, träumt nur mit offenen Augen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-28",
      "text": "Dein Momentum ist wertvoller als dein Masterplan.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-29",
      "text": "Baue, während andere noch diskutieren, ob es sich lohnt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-10-07-0",
      "text": "Disziplin ist der Unterschied zwischen dem, was du willst, und dem, was du tust.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-07"
    },
    {
      "id": "discipline-2026-10-08-1",
      "text": "Motivation ist ein Gast. Disziplin bleibt, wenn alle anderen gehen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-08"
    },
    {
      "id": "discipline-2026-10-09-2",
      "text": "Du musst keine Lust haben. Du musst nur anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-09"
    },
    {
      "id": "discipline-2026-10-10-3",
      "text": "Konsequenz schlägt Talent, wenn Talent sich nicht durchhält.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-10"
    },
    {
      "id": "discipline-2026-10-11-4",
      "text": "Jeder Tag, an dem du durchhältst, widerlegt deine eigenen Ausreden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-11"
    },
    {
      "id": "discipline-2026-10-12-5",
      "text": "Disziplin ist leise. Sie schreit nicht, sie liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-12"
    },
    {
      "id": "discipline-2026-10-13-6",
      "text": "Du wirst nicht an deinem besten Tag gemessen, sondern an deinem schlechtesten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-13"
    },
    {
      "id": "discipline-2026-10-14-7",
      "text": "Das gute Gefühl kommt nach der Handlung, nie davor.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-14"
    },
    {
      "id": "discipline-2026-10-15-8",
      "text": "Wer auf Motivation wartet, verliert gegen den, der einfach anfängt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-15"
    },
    {
      "id": "discipline-2026-10-16-9",
      "text": "Durchhalten heißt: weitermachen, obwohl niemand zuschaut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-16"
    },
    {
      "id": "discipline-2026-10-17-10",
      "text": "Disziplin ist die Entscheidung, die du triffst, bevor jemand fragt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-11",
      "text": "Deine Komfortzone ist kein Zuhause, sie ist eine Sackgasse.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-12",
      "text": "Kleine Schritte, jeden Tag, schlagen große Pläne, die nie starten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-13",
      "text": "Wer aufgibt, wenn es schwer wird, hat nie wirklich angefangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-14",
      "text": "Disziplin kostet heute wenig und zahlt morgen alles aus.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-15",
      "text": "Du brauchst keine perfekten Umstände, nur den nächsten Schritt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-16",
      "text": "Konstanz wirkt langweilig. Erfolg sieht genauso aus.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-17",
      "text": "Die Ausrede von heute ist die Reue von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-18",
      "text": "Niemand sieht die Tage, an denen du trotzdem weitergemacht hast, außer du.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-19",
      "text": "Disziplin ist Respekt vor deinem zukünftigen Ich.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-20",
      "text": "Du entscheidest dich nicht einmal. Du entscheidest dich jeden Tag neu.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-21",
      "text": "Härte gegen dich selbst heute ist Freiheit morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-22",
      "text": "Wer wartet, bis er bereit ist, wartet für immer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-23",
      "text": "Der Unterschied liegt nicht im Ziel, sondern im Montagmorgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-24",
      "text": "Disziplin fühlt sich selten gut an. Nur die Ergebnisse.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-25",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-26",
      "text": "Durchhaltevermögen ist der Mut, konsequent langweilig zu sein.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-27",
      "text": "Jeder Rückschlag lädt dich zum Aufgeben ein. Lehn ab.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-28",
      "text": "Disziplin ist der Preis, den Freiheit verlangt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-29",
      "text": "Wer stoppt, sobald es wehtut, bleibt für immer an derselben Stelle stehen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-10-07-0",
      "text": "Dein Körper ist der einzige Ort, aus dem du nie ausziehen kannst – halt ihn in Schuss.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-07"
    },
    {
      "id": "fitness-2026-10-08-1",
      "text": "Energie ist eine Währung. Jedes Training ist eine Einzahlung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-08"
    },
    {
      "id": "fitness-2026-10-09-2",
      "text": "Müde Beine bauen starke Köpfe.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-09"
    },
    {
      "id": "fitness-2026-10-10-3",
      "text": "Du verhandelst nicht mit Faulheit, du überschreibst sie mit Wiederholungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-10"
    },
    {
      "id": "fitness-2026-10-11-4",
      "text": "Disziplin wiegt mehr als jede Hantel.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-11"
    },
    {
      "id": "fitness-2026-10-12-5",
      "text": "Dein Puls ist der Zinssatz deiner Zukunft.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-12"
    },
    {
      "id": "fitness-2026-10-13-6",
      "text": "Wer seinen Körper vernachlässigt, finanziert seine eigene Schwäche.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-13"
    },
    {
      "id": "fitness-2026-10-14-7",
      "text": "Schweiß ist die Quittung für harte Arbeit an dir selbst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-14"
    },
    {
      "id": "fitness-2026-10-15-8",
      "text": "Kein Meeting schlägt dein Workout – es ist dein wichtigster Termin.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-15"
    },
    {
      "id": "fitness-2026-10-16-9",
      "text": "Dein Körper merkt sich jede Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-16"
    },
    {
      "id": "fitness-2026-10-17-10",
      "text": "Stärke wird nicht gekauft, sie wird trainiert.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-11",
      "text": "Bewegung ist das günstigste Antidepressivum, das du kennst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-12",
      "text": "Du bist nicht müde, du bist unterfordert.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-13",
      "text": "Fitness ist der Zinseszins der Gesundheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-14",
      "text": "Jeder Schritt heute ist ein Kredit an dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-15",
      "text": "Dein Energielevel entscheidet, wer du heute wirklich bist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-16",
      "text": "Kraft ist kein Talent, sie ist eine Entscheidung mit Wiederholungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-17",
      "text": "Bevor du dein Business optimierst, optimiere deinen Puls.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-18",
      "text": "Ein starker Körper verhandelt bessere Deals mit dem Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-19",
      "text": "Schlaf ist dein Trainingsplan für das Gehirn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-20",
      "text": "Du kannst keine Höchstleistung aus einem leeren Akku abrufen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-21",
      "text": "Bewegung ist das günstigste Investment mit der höchsten Rendite.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-22",
      "text": "Dein Körper ist das einzige Asset, das du niemals verkaufen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-23",
      "text": "Müdigkeit ist oft nur schlecht verwaltete Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-24",
      "text": "Wer sich selbst überwindet, braucht keine Motivation mehr.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-25",
      "text": "Dein Workout ist der Zins, den du auf dein Durchhaltevermögen zahlst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-26",
      "text": "Kraft zeigt sich nicht im Spiegel, sondern im Alltag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-27",
      "text": "Dein Körper führt Protokoll über jede verpasste Chance.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-28",
      "text": "Ausdauer ist die stille Währung der Erfolgreichen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-29",
      "text": "Du trainierst nicht für den Sommer, du trainierst für dein ganzes Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-10-07-0",
      "text": "Zufriedenheit ist kein Ziel, das du erreichst, sondern eine Entscheidung, die du täglich triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-07"
    },
    {
      "id": "gratitude-2026-10-08-1",
      "text": "Du jagst dem nächsten Level hinterher und übersiehst, dass du schon auf einem stehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-08"
    },
    {
      "id": "gratitude-2026-10-09-2",
      "text": "Dankbarkeit ist der Zinseszins der Zufriedenheit – kleine Beträge, große Wirkung über Zeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-09"
    },
    {
      "id": "gratitude-2026-10-10-3",
      "text": "Wer nie stehen bleibt, um zu zählen was er hat, merkt nie, wann genug erreicht ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-10"
    },
    {
      "id": "gratitude-2026-10-11-4",
      "text": "Vergleich ist der Dieb, der dir dein heutiges Glück für morgen verkauft.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-11"
    },
    {
      "id": "gratitude-2026-10-12-5",
      "text": "Dein Leben in drei Jahren wird aus dem gebaut, was du heute schon übersiehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-12"
    },
    {
      "id": "gratitude-2026-10-13-6",
      "text": "Zufriedenheit ist kein Stillstand – sie ist der ruhige Boden, von dem aus du wächst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-13"
    },
    {
      "id": "gratitude-2026-10-14-7",
      "text": "Du willst mehr, bevor du gezählt hast, was schon da ist. Das ist das eigentliche Problem.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-14"
    },
    {
      "id": "gratitude-2026-10-15-8",
      "text": "Dankbarkeit kostet nichts und zahlt sich trotzdem jeden Tag aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-15"
    },
    {
      "id": "gratitude-2026-10-16-9",
      "text": "Wer ständig optimiert, vergisst manchmal zu würdigen, was schon funktioniert.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-10",
      "text": "Zufriedenheit ist der stille Erfolg, über den niemand postet.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-11",
      "text": "Du hast heute mehr erreicht, als dein Ich von vor fünf Jahren sich erträumt hat.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-12",
      "text": "Dankbar sein heißt nicht aufhören zu wollen – es heißt aufhören zu leiden, während du wartest.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-13",
      "text": "Die besten Investitionen zahlen sich erst in Ruhe aus. Genau wie Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-14",
      "text": "Du optimierst deinen Tag bis ins Detail, aber ignorierst das Gute, das schon da war.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-15",
      "text": "Nicht jeder Moment muss produktiv sein. Manche dürfen einfach gut sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-16",
      "text": "Dankbarkeit ist die einzige Währung, die wertvoller wird, je öfter du sie ausgibst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-17",
      "text": "Wer immer nur das Ziel sieht, verpasst den Weg, auf dem er längst gewinnt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-18",
      "text": "Zufriedenheit ist kein Luxus für später – sie ist der Treibstoff für jetzt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-19",
      "text": "Du brauchst nicht mehr Glück. Du brauchst mehr Momente, in denen du es bemerkst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-20",
      "text": "Erfolg ohne Dankbarkeit ist nur ein lauteres Leeregefühl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-21",
      "text": "Dein größter Wettbewerbsvorteil ist, zufrieden zu sein, während andere noch vergleichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-22",
      "text": "Du hast gestern um das gekämpft, was du heute als selbstverständlich ansiehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-23",
      "text": "Manche Ziele erreichst du erst, wenn du aufhörst, ständig das nächste zu brauchen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-24",
      "text": "Dankbarkeit macht aus genug ein Gefühl, nicht aus einer Zahl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-25",
      "text": "Du musst nicht alles erreicht haben, um stolz auf das zu sein, was du schon aufgebaut hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-26",
      "text": "Zufriedenheit ist der Moment, in dem Ambition und Frieden sich kurz die Hand geben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-27",
      "text": "Wer dankbar lebt, verliert weniger Zeit damit, sich mit anderen zu vergleichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-28",
      "text": "Du bist weiter, als du denkst – du hast nur vergessen, zurückzuschauen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-29",
      "text": "Zufriedenheit ist keine Schwäche. Sie ist der Beweis, dass du verstanden hast, was zählt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    }
  ]
}