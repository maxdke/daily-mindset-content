{
  "generatedAt": "2026-10-12",
  "quotes": [
    {
      "id": "mindset-2026-10-12-0",
      "text": "Motivation ist ein Gast. Disziplin zieht bei dir ein.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-12"
    },
    {
      "id": "mindset-2026-10-13-1",
      "text": "Dein Kopf lügt dir am meisten, wenn du müde bist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-13"
    },
    {
      "id": "mindset-2026-10-14-2",
      "text": "Comfort Zone ist kein Ort. Es ist eine Entscheidung, die du täglich triffst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-14"
    },
    {
      "id": "mindset-2026-10-15-3",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-15"
    },
    {
      "id": "mindset-2026-10-16-4",
      "text": "Schmerz ist Information, keine Instruktion zum Aufhören.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-16"
    },
    {
      "id": "mindset-2026-10-17-5",
      "text": "Wer auf perfekte Bedingungen wartet, wartet sein ganzes Leben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-6",
      "text": "Deine Ausreden sind gut. Deine Ergebnisse trotzdem schlecht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-7",
      "text": "Stärke entsteht nicht im Gym, sondern in dem Moment davor, wo du keine Lust hast.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-8",
      "text": "Niemand rettet dich. Das ist die schlechte und die beste Nachricht zugleich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-9",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-10",
      "text": "Du bist nicht gescheitert. Du hast nur eine Methode gefunden, die nicht funktioniert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-11",
      "text": "Dein zukünftiges Ich bezahlt die Rechnung für das, was dein heutiges Ich nicht tut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-12",
      "text": "Mentale Stärke heißt nicht, nichts zu fühlen. Es heißt, trotzdem zu handeln.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-13",
      "text": "Du trainierst nicht für heute. Du trainierst dafür, dass du dir nicht mehr ausweichst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-14",
      "text": "Überforderung ist oft nur ein zu großer To-Do-Zettel mit zu wenig Fokus.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-15",
      "text": "Der Widerstand, den du spürst, zeigt genau, wo das Wachstum liegt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-16",
      "text": "Du brauchst keine Motivation. Du brauchst ein System, das ohne sie funktioniert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-17",
      "text": "Vergleich ist Diebstahl an deiner eigenen Energie.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-18",
      "text": "Disziplin ist die Sprache, in der dein Unterbewusstsein Respekt versteht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-19",
      "text": "Die Version von dir, die du werden willst, würde heute nicht aufgeben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-20",
      "text": "Kleine Schritte schlagen große Pläne, die nie starten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-21",
      "text": "Dein Gehirn sucht den leichten Weg. Du entscheidest, ob du ihm folgst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-22",
      "text": "Unsicherheit ist der Preis für alles, was noch wachsen kann.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-23",
      "text": "Du musst nicht motiviert sein. Du musst nur konsequent sein.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-24",
      "text": "Wer ständig Ausnahmen macht, hat keine Regel, sondern eine Ausrede.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-25",
      "text": "Belastbarkeit wird nicht gewünscht, sie wird gebaut, Tag für Tag.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-26",
      "text": "Du bist nicht zu langsam. Du vergleichst dich nur mit dem falschen Zeitpunkt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-27",
      "text": "Das Gefühl der Überforderung verschwindet, sobald du den ersten Schritt machst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-28",
      "text": "Dein innerer Kritiker hat keine Beweise. Nur Angst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-29",
      "text": "Fortschritt fühlt sich selten gut an. Er fühlt sich nach Arbeit an.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-10-12-0",
      "text": "Disziplin ist der Zinseszins der Produktivität.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-12"
    },
    {
      "id": "business-2026-10-13-1",
      "text": "Wer auf Motivation wartet, verpasst das Meeting mit dem Erfolg.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-13"
    },
    {
      "id": "business-2026-10-14-2",
      "text": "Dein Kalender zeigt, wer du wirklich bist – nicht deine Ziele.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-14"
    },
    {
      "id": "business-2026-10-15-3",
      "text": "Ausreden haben keine Umsatzbeteiligung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-15"
    },
    {
      "id": "business-2026-10-16-4",
      "text": "Jede verschobene Aufgabe zahlt Zinsen – gegen dich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-16"
    },
    {
      "id": "business-2026-10-17-5",
      "text": "Komfortzonen bringen keine Kunden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-6",
      "text": "Erfolg ist ein Nebenprodukt von Konsequenz, nicht von Inspiration.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-7",
      "text": "Deine To-do-Liste interessiert sich nicht für deine Laune.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-8",
      "text": "Wer morgens plant, führt abends Bilanz statt Buße.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-9",
      "text": "Zeit ist dein einziges unkopierbares Asset – investiere sie wie eins.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-10",
      "text": "Networking ohne Substanz ist nur Smalltalk mit Visitenkarten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-11",
      "text": "Wachstum passiert außerhalb des Status-quo-Kontos.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-12",
      "text": "Ein Plan ohne Deadline ist nur ein Wunsch mit Datum.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-13",
      "text": "Produktivität schlägt Perfektion – jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-14",
      "text": "Wer alles selbst macht, skaliert nichts außer Stress.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-15",
      "text": "Dein Umsatz kennt keine Ausreden, nur Ergebnisse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-16",
      "text": "Fokus ist die Währung, die niemand drucken kann.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-17",
      "text": "Risiko ohne Vorbereitung ist nur Glücksspiel mit Anzug.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-18",
      "text": "Jede Stunde Prokrastination kostet dich einen Konkurrenten voraus.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-19",
      "text": "Erfolgreiche Menschen managen Energie, nicht nur Zeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-20",
      "text": "Dein Netzwerk wächst nicht durch Likes, sondern durch Leistung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-21",
      "text": "Wer über Strategie redet statt sie umzusetzen, verliert leise.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-22",
      "text": "Gewohnheiten bauen das Business, das Visionen nur versprechen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-23",
      "text": "Konsequenz ist die unsexy Schwester des Erfolgs – aber die zuverlässigere.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-24",
      "text": "Wachstum beginnt dort, wo Bequemlichkeit endet.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-25",
      "text": "Dein größter Konkurrent ist dein gestriges Ich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-26",
      "text": "Cashflow lügt nicht – Ausreden schon.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-27",
      "text": "Wer Systeme baut, schläft ruhiger als der, der nur hofft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-28",
      "text": "Klarheit schlägt Motivation in jeder Disziplin.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-29",
      "text": "Jedes Nein zu Ablenkung ist ein Ja zu deinem Ziel.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-10-12-0",
      "text": "Motivation ist ein Gast. Disziplin wohnt bei dir.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-12"
    },
    {
      "id": "discipline-2026-10-13-1",
      "text": "Du musst nicht wollen. Du musst nur machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-13"
    },
    {
      "id": "discipline-2026-10-14-2",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-14"
    },
    {
      "id": "discipline-2026-10-15-3",
      "text": "Konsequenz schlägt Talent, wenn Talent sich nicht anstrengt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-15"
    },
    {
      "id": "discipline-2026-10-16-4",
      "text": "Jeder Tag, den du durchziehst, ist ein Vertrag mit dir selbst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-16"
    },
    {
      "id": "discipline-2026-10-17-5",
      "text": "Disziplin ist leise. Ausreden sind laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-6",
      "text": "Du trainierst nicht deinen Körper. Du trainierst deine Entscheidungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-7",
      "text": "Null Bock ist kein Zustand, der zählt. Nur Ergebnisse zählen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-8",
      "text": "Wer auf Gefühle wartet, wartet ein Leben lang.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-9",
      "text": "Deine Routine entscheidet, nicht deine Stimmung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-10",
      "text": "Stop. Fühlen. Trotzdem machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-11",
      "text": "Comfort ist der Ort, an dem Ziele sterben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-12",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-13",
      "text": "Kleine Pflichten heute verhindern große Reue morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-14",
      "text": "Disziplin fragt nicht nach Lust. Sie liefert trotzdem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-15",
      "text": "Wer jeden Tag ein bisschen durchhält, gewinnt am Ende alles.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-16",
      "text": "Dein Durchhaltevermögen ist dein unfairer Vorteil.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-17",
      "text": "Es fühlt sich nie richtig an. Mach es trotzdem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-18",
      "text": "Du verlierst nicht, wenn du scheiterst. Du verlierst, wenn du aufhörst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-19",
      "text": "Harte Tage bauen die Version von dir, die du werden willst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-20",
      "text": "Disziplin ist die Brücke zwischen Plan und Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-21",
      "text": "Du brauchst keine Inspiration. Du brauchst einen Plan und Sturheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-22",
      "text": "Jede Ausnahme ist ein Vertrag mit der Mittelmäßigkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-23",
      "text": "Zeig auf, auch wenn niemand klatscht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-24",
      "text": "Deine Zukunft wird heute entschieden, nicht in der Theorie.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-25",
      "text": "Mach weiter, wenn der Anfang nicht mehr zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-26",
      "text": "Durchhalten ist unsichtbar, bis es sichtbar wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-27",
      "text": "Wer sich selbst treu bleibt, wenn es unbequem wird, gewinnt am Ende.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-28",
      "text": "Nicht die Startlinie zählt. Die tausend Tage danach zählen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-29",
      "text": "Disziplin ist der Unterschied zwischen Wunsch und Wirklichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-10-12-0",
      "text": "Dein Körper ist das einzige Büro, das du nie kündigen kannst – pfleg es.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-12"
    },
    {
      "id": "fitness-2026-10-13-1",
      "text": "Energie kommt nicht vom Kaffee, sondern vom Training, das du heute übersprungen hast.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-13"
    },
    {
      "id": "fitness-2026-10-14-2",
      "text": "Disziplin im Gym ist Disziplin im Kopf – beides trainierst du gleichzeitig.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-14"
    },
    {
      "id": "fitness-2026-10-15-3",
      "text": "Wer seinen Körper vernachlässigt, verliert still auf jedem anderen Spielfeld.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-15"
    },
    {
      "id": "fitness-2026-10-16-4",
      "text": "20 Minuten Bewegung schlagen 2 Stunden Grübeln – jedes Mal.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-16"
    },
    {
      "id": "fitness-2026-10-17-5",
      "text": "Schwache Energie ist selten Veranlagung, meistens ein verpasstes Workout.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-6",
      "text": "Dein Puls von heute Morgen entscheidet über deine Entscheidungen heute Abend.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-7",
      "text": "Muskeln vergisst man nicht, Ausreden schon gar nicht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-8",
      "text": "Du willst mehr Fokus? Fang mit mehr Schweiß an.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-9",
      "text": "Bewegung ist der billigste Produktivitäts-Hack, den du ignorierst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-10",
      "text": "Dein schlechtester Tag im Gym schlägt deinen besten Tag auf der Couch.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-11",
      "text": "Energie ist ein Muskel – trainier sie, sonst verkümmert sie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-12",
      "text": "Kein Mindset-Trick ersetzt einen Körper, der mitspielt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-13",
      "text": "Wer müde ist, hat meistens zu wenig trainiert, nicht zu viel gearbeitet.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-14",
      "text": "Dein Körper merkt sich jede Couch-Entscheidung – und rechnet irgendwann ab.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-15",
      "text": "Erfolg fühlt sich leichter an, wenn dein Körper nicht gegen dich arbeitet.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-16",
      "text": "Stärke baust du nicht im Kopf auf, sondern Wiederholung für Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-17",
      "text": "Ein starker Körper lügt nicht – er zeigt, wie ernst du es meinst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-18",
      "text": "Wer heute trainiert, kauft sich morgen mehr Energie auf Kredit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-19",
      "text": "Dein Körper ist dein erstes Investment – alles andere kommt danach.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-20",
      "text": "Schlaf, Bewegung, Fokus – wer eins sabotiert, verliert meist alle drei.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-21",
      "text": "Du brauchst keine Motivation, du brauchst einen Puls über 120.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-22",
      "text": "Die beste Pause vom Bildschirm ist eine, die schwitzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-23",
      "text": "Jeder Satz im Training ist ein Investment in den nächsten klaren Gedanken.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-24",
      "text": "Ausdauer im Sport ist der Vorname von Ausdauer im Business.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-25",
      "text": "Dein Körper verhandelt nicht – entweder du bewegst ihn, oder er bremst dich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-26",
      "text": "Klarer Kopf beginnt mit einem Satz Kniebeugen, nicht mit einem Kaffee.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-27",
      "text": "Wer seinen Körper trainiert, trainiert seine Willenskraft gleich mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-28",
      "text": "Das Workout, das du überspringst, rächt sich als Nachmittagstief.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-29",
      "text": "Kraft ist kein Zufall – sie ist das Ergebnis von Wiederholung, die wehtut.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-10-12-0",
      "text": "Zufriedenheit ist kein Ziel, sondern eine tägliche Entscheidung vor dem ersten Kaffee.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-12"
    },
    {
      "id": "gratitude-2026-10-13-1",
      "text": "Dankbarkeit ist der günstigste Flex, den du dir leisten kannst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-13"
    },
    {
      "id": "gratitude-2026-10-14-2",
      "text": "Wer das Jetzt nicht wertschätzt, verpasst auch den Erfolg von morgen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-14"
    },
    {
      "id": "gratitude-2026-10-15-3",
      "text": "Dein Konto wächst schneller, wenn dein Kopf zufrieden ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-15"
    },
    {
      "id": "gratitude-2026-10-16-4",
      "text": "Gratitude ist dein unsichtbarer Zinseszins fürs Mindset.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-5",
      "text": "Du checkst dein Depot täglich - check auch mal dein Glück.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-6",
      "text": "Zufriedenheit schlägt jeden Bonus, den dir dein Chef zahlen kann.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-7",
      "text": "Dankbarkeit kostet nichts und bringt mehr als jedes Investment.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-8",
      "text": "Wer dankbar lebt, braucht keine Likes zur Bestätigung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-9",
      "text": "Dein bestes Investment heute: drei Minuten Dankbarkeit statt Doomscrolling.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-10",
      "text": "Zufriedenheit ist der Zinseszins der kleinen Momente.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-11",
      "text": "Du vergleichst dein Gehalt - vergleich lieber dein Glück.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-12",
      "text": "Dankbarkeit ist die Steuer, die du gern bezahlst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-13",
      "text": "Erfolg ohne Dankbarkeit ist nur Lärm auf hohem Niveau.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-14",
      "text": "Dein Mindset braucht kein Update - nur mehr Dankbarkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-15",
      "text": "Zufriedenheit ist das einzige Asset, das nie an Wert verliert.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-16",
      "text": "Wer dankbar startet, performt den ganzen Tag besser.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-17",
      "text": "Dein Erfolg bedeutet nichts, wenn du ihn nie genießt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-18",
      "text": "Dankbarkeit ist dein Cheat-Code für ein ruhigeres Leben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-19",
      "text": "Du optimierst deinen Tag - optimier auch deine Dankbarkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-20",
      "text": "Zufriedenheit ist der Bonus, den sich niemand auszahlen lässt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-21",
      "text": "Dankbarkeit macht aus genug ein richtig viel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-22",
      "text": "Dein Kontostand sagt nichts über deine Zufriedenheit aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-23",
      "text": "Wer das Jetzt schätzt, braucht die Zukunft nicht zu fürchten.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-24",
      "text": "Dankbarkeit ist die einzige Währung, die immer stabil bleibt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-25",
      "text": "Zufriedenheit beginnt da, wo der Vergleich aufhört.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-26",
      "text": "Dein bestes Portfolio: Gesundheit, Zeit und ein dankbarer Kopf.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-27",
      "text": "Dankbarkeit ist der stille Flex der wirklich Erfolgreichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-28",
      "text": "Zufriedenheit ist Erfolg, den keiner sehen muss.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-29",
      "text": "Wer heute dankbar ist, verliert morgen nicht den Fokus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    }
  ]
}