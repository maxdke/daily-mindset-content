{
  "generatedAt": "2026-11-15",
  "quotes": [
    {
      "id": "mindset-2026-11-15-0",
      "text": "Disziplin ist der Zins, den dein Zukunfts-Ich dir dankt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-1",
      "text": "Du brauchst keine Motivation. Du brauchst eine Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-2",
      "text": "Komfort ist der leiseste Weg in die Bedeutungslosigkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-3",
      "text": "Dein Kopf lügt dir jeden Morgen etwas von Müdigkeit vor. Glaub ihm nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-4",
      "text": "Stärke entsteht nicht im Erfolg, sondern im Moment davor, wo du fast aufgibst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-5",
      "text": "Du bist nicht zu wenig. Du gibst nur zu früh auf.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-6",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht über deine Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-7",
      "text": "Wer ständig auf den perfekten Moment wartet, verpasst alle anderen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-8",
      "text": "Dein Mindset ist kein Zufall. Es ist eine tägliche Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-9",
      "text": "Schmerz heute ist der Preis für Stolz morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-10",
      "text": "Niemand sieht die hundert Tage davor. Alle sehen nur den einen Erfolg.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-11",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-12",
      "text": "Dein größter Feind trägt deinen Namen und flüstert dir Ausreden zu.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-13",
      "text": "Fortschritt fühlt sich selten gut an. Das ist der Beweis, dass er echt ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-14",
      "text": "Wer leicht aufgibt, hat sein Ziel nie wirklich gewollt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-15",
      "text": "Du wirst nicht über Nacht stark. Du wirst es durch tausend Nächte wie diese.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-16",
      "text": "Dein Ziel interessiert sich nicht für deine Laune heute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-17",
      "text": "Mentale Stärke heißt, weiterzumachen, obwohl dein Kopf laut nein sagt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-18",
      "text": "Du verlierst nicht, wenn du scheiterst. Du verlierst, wenn du aufhörst zu versuchen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "mindset-2026-12-04-19",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Durchhalten, nicht Talent.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-04"
    },
    {
      "id": "mindset-2026-12-05-20",
      "text": "Dein Verstand testet dich jeden Tag. Besteh den Test, bevor du frühstückst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-05"
    },
    {
      "id": "mindset-2026-12-06-21",
      "text": "Unsicherheit ist kein Stoppschild, sie ist nur eine Ampel auf Gelb.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-06"
    },
    {
      "id": "mindset-2026-12-07-22",
      "text": "Du musst nicht alles fühlen wollen, du musst es nur tun wollen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-07"
    },
    {
      "id": "mindset-2026-12-08-23",
      "text": "Harte Tage bauen die Version von dir, die du bewunderst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-08"
    },
    {
      "id": "mindset-2026-12-09-24",
      "text": "Deine Zweifel haben noch nie etwas erreicht. Warum hörst du ihnen zu?",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-09"
    },
    {
      "id": "mindset-2026-12-10-25",
      "text": "Stärke ist leise. Sie zeigt sich nicht, sie liefert einfach ab.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-10"
    },
    {
      "id": "mindset-2026-12-11-26",
      "text": "Du bist nicht müde. Du bist unmotiviert. Das ist ein großer Unterschied.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-11"
    },
    {
      "id": "mindset-2026-12-12-27",
      "text": "Disziplin fühlt sich nach Freiheit an, sobald du sie lang genug durchhältst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-12"
    },
    {
      "id": "mindset-2026-12-13-28",
      "text": "Dein Ziel wartet nicht auf deine gute Laune, also warte auch du nicht darauf.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-13"
    },
    {
      "id": "mindset-2026-12-14-29",
      "text": "Jeder Tag, an dem du durchhältst, ist ein Tag, den dein altes Ich nicht geschafft hätte.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-14"
    },
    {
      "id": "business-2026-11-15-0",
      "text": "Deine To-Do-Liste interessiert niemanden. Dein Ergebnis schon.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-1",
      "text": "Disziplin ist der Zins, den du heute zahlst, für die Freiheit von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-2",
      "text": "Wer auf Motivation wartet, verliert gegen den, der einfach anfängt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-3",
      "text": "Dein Umsatz wächst nicht durch Pläne, sondern durch ausgeführte Pläne.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-4",
      "text": "Ausreden sind der teuerste Luxus, den du dir leisten kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-5",
      "text": "Erfolg ist kein Zufall, er ist das Protokoll deiner Gewohnheiten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-6",
      "text": "Niemand bewundert deinen Fleiß, bevor er dein Ergebnis sieht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-7",
      "text": "Du musst nicht motiviert sein. Du musst nur konsequent sein.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-8",
      "text": "Kleine Schritte heute schlagen große Pläne für irgendwann.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-9",
      "text": "Dein größter Konkurrent ist die Version von dir, die aufgegeben hat.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-10",
      "text": "Zeit ist dein einziges unwiederbringliches Kapital. Investiere sie.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-11",
      "text": "Comfort Zone und Wachstum teilen sich nie dieselbe Adresse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-12",
      "text": "Wer jeden Tag ein bisschen besser wird, braucht keine Abkürzungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-13",
      "text": "Dein Business wächst in dem Tempo, in dem du dich selbst weiterentwickelst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-14",
      "text": "Perfektion ist der Feind des fertigen Projekts.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-15",
      "text": "Du verhandelst nicht mit deiner Zukunft, wenn du heute schon aufgibst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-16",
      "text": "Fokus schlägt Talent, wenn Talent nicht fokussiert ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-17",
      "text": "Jede ungenutzte Stunde ist eine stille Investition in die Konkurrenz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-18",
      "text": "Du baust kein Imperium mit der Energie von gestern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-12-04-19",
      "text": "Konsequenz ist unsexy, aber sie ist die einzige Abkürzung, die funktioniert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-04"
    },
    {
      "id": "business-2026-12-05-20",
      "text": "Wachstum fühlt sich nie bequem an, solange es echt ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-05"
    },
    {
      "id": "business-2026-12-06-21",
      "text": "Dein Kalender zeigt, was dir wirklich wichtig ist, nicht deine Worte.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-06"
    },
    {
      "id": "business-2026-12-07-22",
      "text": "Wer Ausreden sammelt, wird nie Ergebnisse präsentieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-07"
    },
    {
      "id": "business-2026-12-08-23",
      "text": "Risiko ist der Preis, Stillstand ist die Rechnung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-08"
    },
    {
      "id": "business-2026-12-09-24",
      "text": "Du wirst nicht reich durch Ideen, sondern durch ihre Umsetzung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-09"
    },
    {
      "id": "business-2026-12-10-25",
      "text": "Jeder Tag ohne Fortschritt ist ein Tag, den dein Wettbewerb nutzt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-10"
    },
    {
      "id": "business-2026-12-11-26",
      "text": "Dein Mindset entscheidet, bevor dein Business überhaupt startet.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-11"
    },
    {
      "id": "business-2026-12-12-27",
      "text": "Handeln schlägt Hoffen in jeder einzigen Disziplin.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-12"
    },
    {
      "id": "business-2026-12-13-28",
      "text": "Du brauchst keine perfekten Bedingungen, du brauchst den ersten Schritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-13"
    },
    {
      "id": "business-2026-12-14-29",
      "text": "Erfolg beginnt dort, wo deine Ausreden enden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-14"
    },
    {
      "id": "discipline-2026-11-15-0",
      "text": "Disziplin ist der Moment, in dem du trotzdem aufstehst, obwohl keiner zusieht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-1",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-2",
      "text": "Du musst es nicht fühlen, du musst es nur tun.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-3",
      "text": "Die Ausrede von heute ist die Niederlage von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-4",
      "text": "Konsequenz schlägt Intensität – jeden einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-5",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-6",
      "text": "Disziplin ist die Brücke zwischen Zielen und Ergebnissen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-7",
      "text": "Wer aufhört, wenn es schwer wird, hat nie angefangen zu wollen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-8",
      "text": "Du wirst nicht aus Zufall besser, sondern aus Wiederholung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-9",
      "text": "Kleine Schritte, täglich wiederholt, schlagen große Pläne, nie begonnen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-10",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Durchhalten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-11",
      "text": "Schmerz ist temporär, Aufgeben ist permanent.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-12",
      "text": "Du trainierst nicht deinen Körper, du trainierst deinen Willen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-13",
      "text": "Disziplin fühlt sich nie gut an – bis sie dein Leben verändert hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-14",
      "text": "Mach weiter, wenn andere längst aufgehört haben zu zählen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-15",
      "text": "Deine Comfort Zone ist der teuerste Ort, an dem du wohnen kannst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-16",
      "text": "Wer täglich liefert, braucht keine Motivation mehr.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-17",
      "text": "Disziplin ist leise – sie schreit nicht, sie liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-18",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-12-04-19",
      "text": "Erfolg ist das, was übrig bleibt, wenn die Ausreden aufgebraucht sind.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-04"
    },
    {
      "id": "discipline-2026-12-05-20",
      "text": "Halte durch, wenn niemand klatscht – genau da entsteht der Unterschied.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-05"
    },
    {
      "id": "discipline-2026-12-06-21",
      "text": "Disziplin kauft dir die Freiheit, die Motivation dir nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-06"
    },
    {
      "id": "discipline-2026-12-07-22",
      "text": "Du verlierst nicht, wenn du scheiterst – du verlierst, wenn du aufhörst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-07"
    },
    {
      "id": "discipline-2026-12-08-23",
      "text": "Jeder Tag, den du durchziehst, ist ein Beweis gegen deine Zweifel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-08"
    },
    {
      "id": "discipline-2026-12-09-24",
      "text": "Konstanz ist das Talent, das niemand sehen will, aber jeder braucht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-09"
    },
    {
      "id": "discipline-2026-12-10-25",
      "text": "Die Regel ist einfach: weitermachen, wenn es unbequem wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-10"
    },
    {
      "id": "discipline-2026-12-11-26",
      "text": "Du brauchst keine perfekte Stimmung, nur einen festen Plan.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-11"
    },
    {
      "id": "discipline-2026-12-12-27",
      "text": "Was du heute durchziehst, trägt dich morgen weiter als jede Idee.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-12"
    },
    {
      "id": "discipline-2026-12-13-28",
      "text": "Disziplin ist die Entscheidung, die du triffst, bevor der Tag dich trifft.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-13"
    },
    {
      "id": "discipline-2026-12-14-29",
      "text": "Wer durchhält, wenn es unspektakulär wird, gewinnt, wenn es zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-14"
    },
    {
      "id": "fitness-2026-11-15-0",
      "text": "Dein Körper ist dein teuerstes Asset. Investier täglich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-1",
      "text": "Energie leihst du dir nicht, die trainierst du dir.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-2",
      "text": "Schwache Routine, schwacher Output. So einfach ist das.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-3",
      "text": "Du willst Fokus? Dann bewegt sich zuerst dein Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-4",
      "text": "Disziplin im Training ist Disziplin im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-5",
      "text": "Müdigkeit ist oft nur Bewegungsmangel mit Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-6",
      "text": "Dein Puls heute entscheidet über deine Klarheit morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-7",
      "text": "Kein Motivationsgefühl nötig. Nur ein Start reicht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-8",
      "text": "Wer seinen Körper vernachlässigt, bremst sein Potenzial aus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-9",
      "text": "Stärke ist kein Zufall, sondern ein tägliches Investment.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-10",
      "text": "Dein Körper merkt sich jede Ausrede, die du ihm gibst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-11",
      "text": "Bewegung ist das günstigste Update für deine Leistung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-12",
      "text": "Kraft im Körper zahlt sich im Kopf aus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-13",
      "text": "Wer sich körperlich fordert, denkt mental schärfer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-14",
      "text": "Du trainierst nicht für später. Du trainierst für heute Abend.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-15",
      "text": "Energie ist kein Zustand, den du wartest, sondern erzeugst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-16",
      "text": "Dein Körper ist dein Werkzeug. Halt es scharf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-17",
      "text": "Null Bewegung heute heißt null Power morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-18",
      "text": "Schwitzen schlägt Zweifeln. Immer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-12-04-19",
      "text": "Du bist nicht müde. Du bist unbewegt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-04"
    },
    {
      "id": "fitness-2026-12-05-20",
      "text": "Jede Wiederholung baut mehr als nur Muskeln auf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-05"
    },
    {
      "id": "fitness-2026-12-06-21",
      "text": "Ein starker Körper verzeiht einen schwachen Tag leichter.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-06"
    },
    {
      "id": "fitness-2026-12-07-22",
      "text": "Bewegung ist die billigste Form von Selbstrespekt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-07"
    },
    {
      "id": "fitness-2026-12-08-23",
      "text": "Dein Limit von gestern ist dein Warm-up von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-08"
    },
    {
      "id": "fitness-2026-12-09-24",
      "text": "Erst der Körper in Bewegung, dann der Kopf in Form.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-09"
    },
    {
      "id": "fitness-2026-12-10-25",
      "text": "Wer sich körperlich fordert, braucht weniger Kaffee im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-10"
    },
    {
      "id": "fitness-2026-12-11-26",
      "text": "Stillstand im Training ist Rückschritt im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-11"
    },
    {
      "id": "fitness-2026-12-12-27",
      "text": "Dein Nervensystem liebt Bewegung mehr als Netflix.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-12"
    },
    {
      "id": "fitness-2026-12-13-28",
      "text": "Kraft kommt nicht über Nacht, aber jede Nacht zählt mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-13"
    },
    {
      "id": "fitness-2026-12-14-29",
      "text": "Du schuldest deinem Körper keine Ausrede, sondern Einsatz.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-14"
    },
    {
      "id": "gratitude-2026-11-15-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist die Basis, von der aus du wächst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-1",
      "text": "Wer dankbar ist für das Jetzt, verschwendet keine Energie an das Gestern.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-2",
      "text": "Dankbarkeit ist der Zinseszins der Gefühle.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-3",
      "text": "Du musst nicht glücklich sein über alles, aber dankbar für das meiste.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-4",
      "text": "Zufriedenheit schlägt jeden Vergleich mit fremden Highlight-Reels.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-5",
      "text": "Dankbarkeit kostet nichts und bringt mehr als jede Abkürzung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-6",
      "text": "Wer das Kleine wertschätzt, verpasst das Große nicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-7",
      "text": "Dein Fortschritt zählt mehr als der Vergleich mit fremden Timelines.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-8",
      "text": "Zufriedenheit ist der stille Antrieb hinter jedem nachhaltigen Erfolg.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-9",
      "text": "Dankbarkeit macht aus Druck Perspektive.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-10",
      "text": "Du bist weiter, als du denkst. Erkenne es an.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-11",
      "text": "Nicht jeder Tag muss produktiv sein, manche dürfen einfach gut sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-12",
      "text": "Zufriedenheit ist kein Rückschritt, sie ist dein Checkpoint.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-13",
      "text": "Dankbar sein heißt nicht aufhören zu wollen, sondern anfangen zu sehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-14",
      "text": "Vergleich stiehlt Freude, Dankbarkeit gibt sie zurück.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-15",
      "text": "Dein heutiges Normal war mal dein größtes Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-16",
      "text": "Zufriedenheit ist der Soundtrack zu einem Leben ohne ständige Eile.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-17",
      "text": "Wer dankbar lebt, muss nicht jedes Level sofort erreichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-18",
      "text": "Dankbarkeit ist die Pause, die dich nicht zurückwirft, sondern trägt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-12-04-19",
      "text": "Du musst nicht alles haben, um schon viel zu besitzen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-04"
    },
    {
      "id": "gratitude-2026-12-05-20",
      "text": "Zufriedenheit beginnt da, wo der Vergleich aufhört.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-05"
    },
    {
      "id": "gratitude-2026-12-06-21",
      "text": "Dankbarkeit ist unsichtbares Kapital, das sich immer auszahlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-06"
    },
    {
      "id": "gratitude-2026-12-07-22",
      "text": "Das Leben, das du hast, war für jemand anderen ein Traum.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-07"
    },
    {
      "id": "gratitude-2026-12-08-23",
      "text": "Zufriedenheit ist nicht Faulheit, sie ist gewonnene Klarheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-08"
    },
    {
      "id": "gratitude-2026-12-09-24",
      "text": "Dankbarkeit macht aus genug wieder genug.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-09"
    },
    {
      "id": "gratitude-2026-12-10-25",
      "text": "Du jagst dem Mehr hinterher und übersiehst das Genug.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-10"
    },
    {
      "id": "gratitude-2026-12-11-26",
      "text": "Zufriedenheit ist die Entscheidung, heute schon zu gewinnen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-11"
    },
    {
      "id": "gratitude-2026-12-12-27",
      "text": "Dankbar für das, was war. Bereit für das, was kommt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-12"
    },
    {
      "id": "gratitude-2026-12-13-28",
      "text": "Nicht jeder Erfolg braucht ein nächstes Ziel. Manche dürfen bleiben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-13"
    },
    {
      "id": "gratitude-2026-12-14-29",
      "text": "Zufriedenheit ist der Moment, in dem Ehrgeiz kurz durchatmet.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-14"
    }
  ]
}