{
  "generatedAt": "2026-10-29",
  "quotes": [
    {
      "id": "mindset-2026-10-29-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-1",
      "text": "Deine Ausreden klingen gut, aber sie bezahlen keine Rechnungen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-2",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-3",
      "text": "Du musst nicht bereit sein, du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-4",
      "text": "Schwache Momente entscheiden, wer du in starken wirst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-5",
      "text": "Komfortzone ist nur ein anderes Wort für Stillstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-6",
      "text": "Dein Kopf gibt auf, bevor dein Körper es tut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-7",
      "text": "Niemand rettet dich – das ist die beste Nachricht des Tages.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-8",
      "text": "Wer auf Gefühle wartet, wartet sein Leben lang.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-9",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-10",
      "text": "Schmerz ist temporär, Aufgeben wird für immer gespeichert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-11",
      "text": "Kleine Disziplin heute ist große Freiheit morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-12",
      "text": "Dein größter Gegner trägt deine eigenen Schuhe.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-13",
      "text": "Stärke entsteht nicht im Kopf, sondern in der Wiederholung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-14",
      "text": "Zweifel sind laut, aber sie haben nie recht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-15",
      "text": "Du wächst nicht durch Komfort, sondern durch Widerstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-16",
      "text": "Das Leben belohnt keine Gedanken, nur Taten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-17",
      "text": "Wer immer eine Ausrede findet, findet nie ein Ergebnis.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-18",
      "text": "Dein Mindset ist die einzige Variable, die du komplett kontrollierst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-19",
      "text": "Angst ist nur ein schlechter Ratgeber mit lauter Stimme.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-20",
      "text": "Disziplin fühlt sich nie gut an – bis sie dein Leben verändert hat.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-21",
      "text": "Du scheiterst nicht am Ziel, du scheiterst an deinem inneren Dialog.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-22",
      "text": "Konsequenz schlägt Talent, jedes einzelne Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-23",
      "text": "Wer stark aussehen will, muss zuerst schwach sein dürfen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-24",
      "text": "Dein zukünftiges Ich beobachtet gerade, was du heute tust.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-25",
      "text": "Die größte Lüge ist: Morgen bin ich motivierter.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-26",
      "text": "Unbequem ist der Preis für ein Leben, das sich lohnt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-27",
      "text": "Du verlierst nicht gegen andere, du verlierst gegen deinen inneren Schweinehund.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-28",
      "text": "Wachstum tut weh, Stillstand tut mehr weh – nur später.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-29",
      "text": "Dein Standard entscheidet, nicht deine Stimmung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-10-29-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-1",
      "text": "Wer auf Motivation wartet, verpasst das Fenster für Ergebnisse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-2",
      "text": "Dein Kalender verrät mehr über deine Ziele als dein Mund.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-3",
      "text": "Output schlägt Intention – jeden Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-4",
      "text": "Comfort Zones zahlen keine Rechnungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-5",
      "text": "Du skalierst kein Business mit dem Mindset von gestern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-6",
      "text": "Jede ungenutzte Stunde ist ein verlorener Investor.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-7",
      "text": "Konsequenz ist die unsichtbare Abkürzung zum Erfolg.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-8",
      "text": "Wachstum passiert nicht im Warteraum.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-9",
      "text": "Dein Umsatz ist die Quittung deiner Gewohnheiten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-10",
      "text": "Wer Ausreden sammelt, baut kein Vermögen auf.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-11",
      "text": "Fokus ist die neue Währung der Macher.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-12",
      "text": "Erfolg flüstert nicht – er zeigt sich in Zahlen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-13",
      "text": "Dein Netzwerk ist dein Nettovermögen von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-14",
      "text": "Zeit verhandelst du nicht – du investierst sie.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-15",
      "text": "Wer nur plant, hat noch nichts gebaut.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-16",
      "text": "Risiko ist der Preis für Relevanz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-17",
      "text": "Deine To-Do-Liste lügt nicht über deine Prioritäten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-18",
      "text": "Stillstand ist die teuerste Entscheidung im Business.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-19",
      "text": "Wachstum beginnt dort, wo Ausreden enden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-20",
      "text": "Dein Pitch ist nur so gut wie deine letzte Ausführung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-21",
      "text": "Kapital folgt Klarheit, nicht Chaos.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-22",
      "text": "Wer null Risiko will, bekommt null Rendite.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-23",
      "text": "Jede Deadline ist ein Testlauf für deine Disziplin.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-24",
      "text": "Dein Mindset ist die erste Firma, die du führen musst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-25",
      "text": "Produktivität ist kein Zufall – sie ist Architektur.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-26",
      "text": "Wer nicht skaliert, stagniert mit Stil.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-27",
      "text": "Dein Momentum stirbt in jeder Ausrede, die du fütterst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-28",
      "text": "Erfolgreiche Menschen verhandeln mit der Zeit, nicht mit der Angst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-29",
      "text": "Dein nächster Umsatzsprung beginnt mit dem nächsten Fokus-Block.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-10-29-0",
      "text": "Motivation ist der Startschuss, Disziplin ist die Ziellinie.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-1",
      "text": "Du musst nicht wollen, du musst nur machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-2",
      "text": "Disziplin ist der Moment, in dem Ausreden ihre Macht verlieren.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-3",
      "text": "Jeder Tag ohne Durchhalten ist ein Tag, den du nie zurückbekommst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-4",
      "text": "Gewohnheiten schlagen Gefühle, jedes verdammte Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-5",
      "text": "Dein zukünftiges Ich zahlt für jede Ausrede von heute.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-6",
      "text": "Konsequenz ist lauter als Talent.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-7",
      "text": "Wer auf Lust wartet, wartet ein Leben lang.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-8",
      "text": "Disziplin fühlt sich nie gut an, bevor sie sich gut anfühlt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-9",
      "text": "Du trainierst nicht deinen Körper, du trainierst deinen Willen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-10",
      "text": "Keine Ausnahmen. Keine Abkürzungen. Kein Zurück.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-11",
      "text": "Der Unterschied zwischen Träumen und Zielen heißt Durchhalten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-12",
      "text": "Mach es auch dann, wenn keiner zusieht und nichts dich zwingt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-13",
      "text": "Disziplin ist die Sprache, die dein Ziel versteht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-14",
      "text": "Kleine Pflichten heute verhindern große Reue morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-15",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-16",
      "text": "Stillstand fühlt sich sicher an und kostet dich trotzdem alles.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-17",
      "text": "Wer jeden Tag ein bisschen durchhält, braucht nie wieder neu anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-18",
      "text": "Deine Komfortzone zahlt keine Rechnungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-19",
      "text": "Disziplin ist Liebe zu deinem zukünftigen Leben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-20",
      "text": "Niemand sieht die 5 Uhr Morgens, aber jeder sieht das Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-21",
      "text": "Du verlierst nicht an einem schlechten Tag, du verlierst an tausend Ausreden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-22",
      "text": "Zieh durch, auch wenn die Motivation schon zu Hause geblieben ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-23",
      "text": "Wer aufgibt, weil es schwer wird, war nie wirklich im Spiel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-24",
      "text": "Dein Durchhaltevermögen ist der Zinssatz auf deine Zukunft.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-25",
      "text": "Disziplin braucht keine gute Laune, nur eine klare Entscheidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-26",
      "text": "Du bist nicht zu schwach, du bist nur zu bequem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-27",
      "text": "Erfolg hat keinen Schalter für schlechte Tage.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-28",
      "text": "Jeder Tag, den du durchhältst, macht den nächsten leichter.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-29",
      "text": "Disziplin ist das stille Versprechen, das du dir jeden Morgen hältst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-10-29-0",
      "text": "Dein Körper ist der einzige Standort, den du nicht wechseln kannst. Investier rein.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-1",
      "text": "Disziplin im Training ist der Zinseszins für deine Energie im Alltag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-2",
      "text": "Müde Beine, klarer Kopf. Bewegung ist der Reset-Knopf für dein Gehirn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-3",
      "text": "Wer sich morgens quält, braucht abends keine Motivation mehr.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-4",
      "text": "Kein Mindset-Hack ersetzt einen Puls über 140.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-5",
      "text": "Du willst mehr Energie? Dann hör auf, danach zu suchen und fang an, sie zu erzeugen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-6",
      "text": "Schwitzen ist der Preis, den dein zukünftiges Ich nicht zahlen muss.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-7",
      "text": "Ein starker Körper verhandelt bessere Deals mit einem schwachen Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-8",
      "text": "Bewegung ist das günstigste Antidepressivum, das du nie eingelöst hast.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-9",
      "text": "Dein Workout heute ist der Vorsprung, den morgen niemand aufholt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-10",
      "text": "Wer seine Energie managt, braucht kein Zeitmanagement mehr.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-11",
      "text": "Faulheit fühlt sich gut an, bis sie zur Gewohnheit wird.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-12",
      "text": "Dein Körper merkt sich jede Ausrede, die du ihm erzählst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-13",
      "text": "Kraft kommt nicht vom Wollen, sondern vom Wiederholen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-14",
      "text": "Lauf nicht vor Problemen weg, lauf sie müde.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-15",
      "text": "Ein trainierter Körper ist das stillste Statussymbol.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-16",
      "text": "Du schuldest deinem Körper keine Entschuldigung, sondern Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-17",
      "text": "Erschöpfung nach dem Training schlägt Erschöpfung ohne Grund.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-18",
      "text": "Dein Energielevel ist kein Zufall, es ist eine Entscheidung von heute Morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-19",
      "text": "Wer stark werden will, muss zuerst unbequem werden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-20",
      "text": "Sport ist die einzige Sucht, die dein Leben verlängert statt verkürzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-21",
      "text": "Dein Körper ist das Werkzeug. Pflege es, bevor du es brauchst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-22",
      "text": "Bewegung schlägt jeden Kaffee, nur ohne Absturz danach.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-23",
      "text": "Du verhandelst nicht mit dem inneren Schweinehund, du trainierst ihn weg.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-24",
      "text": "Jeder Satz Wiederholungen ist ein Investment in Jahre, nicht Tage.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-25",
      "text": "Wer sich bewegt, denkt schneller. Wer sitzt, rechtfertigt sich langsamer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-26",
      "text": "Dein Durchhaltevermögen im Gym ist der Prototyp für alles andere im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-27",
      "text": "Energie tankt man nicht, man erzeugt sie durch Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-28",
      "text": "Ein Körper in Bewegung bleibt motiviert. Einer in Ruhe sucht Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-29",
      "text": "Trainiere, als würde dein zukünftiges Ich dir dabei zusehen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-10-29-0",
      "text": "Zufriedenheit ist kein Ziel, das du erreichst – sie ist eine Entscheidung, die du täglich triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-1",
      "text": "Wer dankbar ist für das, was er hat, verschwendet keine Energie an das, was fehlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-2",
      "text": "Dankbarkeit ist der leiseste Erfolgsfaktor, den niemand in seinem Pitch erwähnt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-3",
      "text": "Du kannst ehrgeizig sein und trotzdem zufrieden – das eine schließt das andere nicht aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-4",
      "text": "Vergleiche killen Zufriedenheit schneller als jeder Rückschlag.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-5",
      "text": "Wer morgens dankbar aufwacht, braucht abends keine Ausrede mehr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-6",
      "text": "Zufriedenheit ist kein Trostpreis für Leute ohne Ziele.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-7",
      "text": "Dankbarkeit kostet nichts und bringt mehr als jede Abkürzung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-8",
      "text": "Du musst nicht alles haben, um zufrieden zu sein – nur den Blick auf das, was zählt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-9",
      "text": "Erfolg ohne Dankbarkeit ist nur eine Zahl auf dem Konto.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-10",
      "text": "Zufriedenheit beginnt da, wo der Vergleich aufhört.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-11",
      "text": "Was du heute als selbstverständlich siehst, war vor fünf Jahren dein größter Wunsch.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-12",
      "text": "Dankbarkeit ist kein Rückblick, sie ist dein Mindset für heute.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-13",
      "text": "Wer zufrieden ist, verhandelt nicht mehr mit dem eigenen Ego.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-14",
      "text": "Mehr wollen und dankbar sein – das ist kein Widerspruch, das ist Reife.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-15",
      "text": "Zufriedenheit ist die Basis, von der aus echtes Wachstum überhaupt erst möglich wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-16",
      "text": "Du bist nicht im Rückstand – du bist genau da, wo deine Geschichte dich hinführt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-17",
      "text": "Dankbarkeit macht aus einem normalen Tag einen, an den du dich erinnerst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-18",
      "text": "Wer ständig mehr will, ohne zu würdigen, was er hat, bleibt für immer unzufrieden.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-19",
      "text": "Zufriedenheit ist der Treibstoff, der nicht ausbrennt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-20",
      "text": "Du jagst nicht dem Glück hinterher – du erkennst es, wenn du dankbar hinschaust.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-21",
      "text": "Dankbarkeit ist die einzige Investition ohne Risiko.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-22",
      "text": "Zufrieden sein heißt nicht aufhören zu kämpfen, sondern wissen, wofür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-23",
      "text": "Was dir heute selbstverständlich erscheint, ist für andere ein unerreichter Traum.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-24",
      "text": "Ambition ohne Dankbarkeit frisst dich irgendwann auf.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-25",
      "text": "Dankbarkeit ist der Moment, in dem Erfolg sich endlich wie Erfolg anfühlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-26",
      "text": "Zufriedenheit ist kein Zustand, den du erreichst, sondern eine Übung, die du machst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-27",
      "text": "Wer dankbar lebt, verliert nie das große Ganze aus den Augen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-28",
      "text": "Du musst nicht alles neu erreichen, um glücklich zu sein – manches darfst du einfach wertschätzen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-29",
      "text": "Zufriedenheit ist der stille Vorteil, den niemand auf LinkedIn postet.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    }
  ]
}