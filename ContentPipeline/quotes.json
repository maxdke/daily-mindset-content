{
  "generatedAt": "2026-11-12",
  "quotes": [
    {
      "id": "mindset-2026-11-12-0",
      "text": "Deine Gedanken sind kein Zufall - sie sind eine Entscheidung, die du jeden Tag neu triffst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-1",
      "text": "Schwache Momente sind keine Charakterfehler, sondern Tests, die du bestehen darfst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-2",
      "text": "Dein Kopf glaubt, was du ihm am häufigsten erzählst - erzähl ihm die richtige Geschichte.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-3",
      "text": "Mentale Stärke zeigt sich nicht im Erfolg, sondern in der fünften Minute, in der es wehtut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-4",
      "text": "Du verlierst nicht, wenn du scheiterst - du verlierst, wenn du aufhörst, es zu versuchen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-5",
      "text": "Unbehagen ist der Eintrittspreis für jede Version von dir, die du noch nicht kennst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-6",
      "text": "Niemand rettet dich vor deinem inneren Dialog - also führ ihn wie ein Champion.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-7",
      "text": "Disziplin ist leiser als Motivation, aber sie bleibt, wenn die Lust längst weg ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-8",
      "text": "Dein Limit liegt nicht in deinem Körper, sondern in dem Satz, den du dir gerade erzählst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-9",
      "text": "Stärke entsteht nicht durch das Fehlen von Zweifeln, sondern durch Handeln trotz ihnen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-10",
      "text": "Jede Ausrede, die du glaubst, kostet dich ein Stück der Zukunft, die du eigentlich willst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-11",
      "text": "Du bist nicht müde vom Tun - du bist müde vom ständigen Diskutieren mit dir selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-12",
      "text": "Klarheit kommt nicht vom Warten, sondern vom ersten unperfekten Schritt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-13",
      "text": "Dein Gehirn sucht Komfort - deine Zukunft braucht Reibung. Entscheide, wem du folgst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-14",
      "text": "Konsequenz schlägt Intensität - jeden Tag, jede Woche, jedes Jahr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-15",
      "text": "Wer ständig auf Motivation wartet, baut sein Leben auf Treibsand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-16",
      "text": "Der Unterschied zwischen dir und deinem Ziel ist die Ausrede, die du heute akzeptierst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-17",
      "text": "Mentale Stärke heißt, unangenehme Wahrheiten schneller zuzulassen als andere.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-18",
      "text": "Du musst nicht bereit sein - du musst nur anfangen, bereit zu werden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-19",
      "text": "Dein größter Gegner trägt dein Gesicht und flüstert dir Zweifel ins Ohr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-20",
      "text": "Fokus ist keine Fähigkeit, die du hast - es ist eine Entscheidung, die du stündlich triffst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-21",
      "text": "Wachstum fühlt sich nie nach Fortschritt an, solange du mitten drin steckst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "mindset-2026-12-04-22",
      "text": "Du kontrollierst nicht das Ergebnis, aber jede Sekunde deiner Reaktion darauf.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-04"
    },
    {
      "id": "mindset-2026-12-05-23",
      "text": "Vergleiche dich nur mit der Version von dir, die gestern noch aufgegeben hätte.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-05"
    },
    {
      "id": "mindset-2026-12-06-24",
      "text": "Druck zerstört nur die, die ihn als Feind sehen - nicht die, die ihn als Werkzeug nutzen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-06"
    },
    {
      "id": "mindset-2026-12-07-25",
      "text": "Dein Mindset ist kein Gefühl, das kommt und geht - es ist ein Muskel, den du trainierst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-07"
    },
    {
      "id": "mindset-2026-12-08-26",
      "text": "Die stärksten Menschen haben nicht weniger Angst - sie handeln einfach trotzdem.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-08"
    },
    {
      "id": "mindset-2026-12-09-27",
      "text": "Jeder unbequeme Moment, den du aushältst, ist ein Vorsprung, den niemand sieht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-09"
    },
    {
      "id": "mindset-2026-12-10-28",
      "text": "Du brauchst keine perfekte Strategie - du brauchst die Bereitschaft, unperfekt weiterzumachen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-10"
    },
    {
      "id": "mindset-2026-12-11-29",
      "text": "Dein Verstand testet dich immer zuerst - bestehe den Test, bevor du das Ziel erreichst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-11"
    },
    {
      "id": "business-2026-11-12-0",
      "text": "Output schlägt Intention – jeden Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-1",
      "text": "Deine Zukunft wird heute verhandelt, nicht morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-2",
      "text": "Komfort ist der teuerste Kredit, den du aufnimmst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-3",
      "text": "Wer wartet, zahlt Zinsen in verlorener Zeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-4",
      "text": "Fokus ist das neue Kapital.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-5",
      "text": "Dein Kalender zeigt, wie ernst du es meinst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-6",
      "text": "Ausreden sind Investments ohne Rendite.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-7",
      "text": "Geschwindigkeit schlägt Perfektion, fast immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-8",
      "text": "Wer nicht skaliert, bezahlt mit seiner Zeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-9",
      "text": "Disziplin ist der Zinseszins der Gewohnheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-10",
      "text": "Jede Stunde ohne Plan ist verschenktes Kapital.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-11",
      "text": "Dein Netzwerk ist dein unsichtbares Gehalt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-12",
      "text": "Risiko ist nur ungenaue Information, kein Schicksal.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-13",
      "text": "Wer zögert, finanziert die Konkurrenz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-14",
      "text": "Produktivität beginnt da, wo Motivation endet.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-15",
      "text": "Dein Umsatz folgt deiner Konsequenz, nicht deinen Ideen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-16",
      "text": "Kleine Entscheidungen bauen große Imperien.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-17",
      "text": "Wer alles kontrollieren will, skaliert nie.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-18",
      "text": "Zeit ist die einzige Währung ohne Nachdruck.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-19",
      "text": "System schlägt Talent, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-20",
      "text": "Dein Preis bestimmt sich durch dein Selbstbild.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-21",
      "text": "Wachstum tut weh, Stillstand tut mehr weh.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-12-04-22",
      "text": "Wer Prioritäten setzt, braucht keine Motivation.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-04"
    },
    {
      "id": "business-2026-12-05-23",
      "text": "Jeder Pitch beginnt mit Selbstüberzeugung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-05"
    },
    {
      "id": "business-2026-12-06-24",
      "text": "Dein Business ist nur so stark wie dein letzter Fokusblock.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-06"
    },
    {
      "id": "business-2026-12-07-25",
      "text": "Verträge werden im Kopf geschlossen, bevor sie unterschrieben sind.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-07"
    },
    {
      "id": "business-2026-12-08-26",
      "text": "Cashflow folgt Klarheit, nicht Hoffnung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-08"
    },
    {
      "id": "business-2026-12-09-27",
      "text": "Wer delegiert, multipliziert seine Zeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-09"
    },
    {
      "id": "business-2026-12-10-28",
      "text": "Dein größter Konkurrent ist dein gestriges Ich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-10"
    },
    {
      "id": "business-2026-12-11-29",
      "text": "Entscheidungen treffen kostet nichts, Unentschlossenheit alles.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-11"
    },
    {
      "id": "discipline-2026-11-12-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-1",
      "text": "Motivation ist Zufall. Disziplin ist ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-2",
      "text": "Du brauchst keine Lust. Du brauchst eine Routine.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-3",
      "text": "Durchhalten ist langweilig. Aufgeben ist bequem. Erfolg wählt das Langweilige.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-4",
      "text": "Dein Comfort Zone ist die teuerste Miete, die du zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-5",
      "text": "Wer auf Gefühle wartet, wartet ewig. Mach es trotzdem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-6",
      "text": "Disziplin schlägt Talent, wenn Talent keine Disziplin hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-7",
      "text": "Jeden Tag 1% mehr Disziplin, null Tage Ausreden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-8",
      "text": "Dein zukünftiges Ich dankt dir für die Entscheidung, die du heute hassen wirst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-9",
      "text": "Konsequenz ist die Sprache, die Erfolg versteht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-10",
      "text": "Du verhandelst nicht mit deiner Faulheit. Du führst sie.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-11",
      "text": "Der Unterschied zwischen Träumen und Zielen heißt Disziplin.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-12",
      "text": "Härte ist kein Zustand. Härte ist eine tägliche Entscheidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-13",
      "text": "Wer immer nur startet, wenn er motiviert ist, startet selten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-14",
      "text": "Dein Warum muss stärker sein als dein Montagmorgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-15",
      "text": "Disziplin ist unsichtbar, bis sie sichtbar wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-16",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-17",
      "text": "Erfolg hat keinen Urlaub. Also nimmst du auch keinen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-18",
      "text": "Systeme schlagen Stimmung. Jeden Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-19",
      "text": "Wiederholung ist die Mutter der Meisterschaft, nicht die Ausnahme.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-20",
      "text": "Du schuldest dir selbst mehr als eine gute Ausrede.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-21",
      "text": "Disziplin ist der Preis für Freiheit später.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-12-04-22",
      "text": "Kleine Schritte täglich schlagen große Pläne irgendwann.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-04"
    },
    {
      "id": "discipline-2026-12-05-23",
      "text": "Wer aufhört, wenn es wehtut, bleibt für immer da, wo es wehtut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-05"
    },
    {
      "id": "discipline-2026-12-06-24",
      "text": "Dein innerer Schweinehund zahlt keine Rechnungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-06"
    },
    {
      "id": "discipline-2026-12-07-25",
      "text": "Gewohnheiten bauen das Leben, das Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-07"
    },
    {
      "id": "discipline-2026-12-08-26",
      "text": "Du wirst nicht jeden Tag gewinnen wollen. Mach es trotzdem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-08"
    },
    {
      "id": "discipline-2026-12-09-27",
      "text": "Disziplin ist lauter als jede Ausrede, die du dir erzählst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-09"
    },
    {
      "id": "discipline-2026-12-10-28",
      "text": "Fortschritt fragt nicht nach deiner Laune.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-10"
    },
    {
      "id": "discipline-2026-12-11-29",
      "text": "Stärke zeigt sich nicht am Anfang, sondern am zehnten Tag ohne Applaus.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-11"
    },
    {
      "id": "fitness-2026-11-12-0",
      "text": "Dein Körper ist das einzige Investment, das dich überallhin begleitet.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-1",
      "text": "Energie ist die Währung, mit der du jeden Tag bezahlst – lade sie auf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-2",
      "text": "Wer seinen Körper vernachlässigt, verliert im Kopf zuerst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-3",
      "text": "Schwitzen ist Zinseszins für dein Nervensystem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-4",
      "text": "Kein Workout ist Verschwendung – jede Wiederholung ist Rendite.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-5",
      "text": "Disziplin im Training ist der Trainingsplan für dein restliches Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-6",
      "text": "Dein Puls entscheidet, wie laut dein Kopf später schreit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-7",
      "text": "Ausdauer im Gym ist Ausdauer im Business.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-8",
      "text": "Müde Beine, klarer Kopf – so funktioniert der Deal.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-9",
      "text": "Bewegung ist der günstigste Stimmungsaufheller, den du nie nutzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-10",
      "text": "Dein Fitnesslevel ist der Zinssatz auf deine Lebensqualität.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-11",
      "text": "Wer sich nicht bewegt, bewegt auch sonst nichts.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-12",
      "text": "Kraft im Körper baut man, bevor man Kraft im Leben braucht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-13",
      "text": "Dein Energielevel ist keine Laune, sondern eine Entscheidung von heute Morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-14",
      "text": "Jede verpasste Einheit ist ein verpasster Zinstag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-15",
      "text": "Schlaf ist die Basis, Training ist der Hebel.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-16",
      "text": "Du kannst nicht performen, wenn dein Körper streikt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-17",
      "text": "Fitness ist kein Ziel, sondern das Betriebssystem für alles andere.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-18",
      "text": "Dein Herz schlägt für Ziele, nicht für Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-19",
      "text": "Wer im Gym konsequent ist, ist überall konsequent.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-20",
      "text": "Energie sparen bringt nichts – Energie aufbauen schon.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-21",
      "text": "Dein Körper merkt sich jede Couch-Entscheidung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-12-04-22",
      "text": "Bewegung heute ist Kapital für den Kopf von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-04"
    },
    {
      "id": "fitness-2026-12-05-23",
      "text": "Kraft kommt nicht von Motivation, sondern von Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-05"
    },
    {
      "id": "fitness-2026-12-06-24",
      "text": "Wer schwach trainiert, denkt auch schwach.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-06"
    },
    {
      "id": "fitness-2026-12-07-25",
      "text": "Dein Immunsystem bewirbt sich nicht von allein – du musst es einstellen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-07"
    },
    {
      "id": "fitness-2026-12-08-26",
      "text": "Fitness ist der stille Zinseszins, den niemand sieht, bis er explodiert.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-08"
    },
    {
      "id": "fitness-2026-12-09-27",
      "text": "Keine App ersetzt den Puls, den du dir selbst erarbeitest.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-09"
    },
    {
      "id": "fitness-2026-12-10-28",
      "text": "Dein Körper ist der Server – crash ihn nicht durch Nichtstun.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-10"
    },
    {
      "id": "fitness-2026-12-11-29",
      "text": "Wer sich bewegt, denkt schneller, schläft besser, lebt länger.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-11"
    },
    {
      "id": "gratitude-2026-11-12-0",
      "text": "Dankbarkeit ist kein Soft-Skill, sie ist dein Wettbewerbsvorteil gegen den eigenen Stress.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-1",
      "text": "Zufriedenheit ist nicht das Ziel, sie ist der Treibstoff auf dem Weg dorthin.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-2",
      "text": "Wer nicht sieht, was er schon hat, verliert den Fokus für das, was noch kommt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-3",
      "text": "Dankbarkeit kostet nichts und bringt dir mehr Energie als jeder Espresso.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-4",
      "text": "Du musst nicht warten, bis du angekommen bist, um glücklich zu sein. Fang heute an.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-5",
      "text": "Erfolg ohne Dankbarkeit ist nur ein Zwischenstopp auf dem Weg zur Leere.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-6",
      "text": "Schau auf das, was du aufgebaut hast, bevor du auf das schaust, was noch fehlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-7",
      "text": "Zufriedenheit ist die stille Kraft hinter jedem nachhaltigen Erfolg.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-8",
      "text": "Dankbar sein heißt nicht stehen bleiben, es heißt mit vollem Tank weiterfahren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-9",
      "text": "Vergleiche dich nicht mit anderen, sondern mit dem, der du letztes Jahr warst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-10",
      "text": "Das Leben, das du gerade lebst, war mal dein größter Traum.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-11",
      "text": "Zufriedenheit ist keine Schwäche, sie ist die Ruhe, aus der neue Kraft entsteht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-12",
      "text": "Wer ständig mehr will, ohne zu würdigen, was er hat, verbrennt sich selbst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-13",
      "text": "Dankbarkeit macht aus einem normalen Tag einen, an den du dich erinnerst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-14",
      "text": "Du bist weiter, als du denkst, wenn du ehrlich zurückblickst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-15",
      "text": "Zufriedenheit ist der Unterschied zwischen Ankommen und ewig Rennen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-16",
      "text": "Dankbar sein für das Jetzt macht dich stärker für das, was kommt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-17",
      "text": "Nicht jeder Tag ist gut, aber in jedem Tag steckt etwas Gutes.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-18",
      "text": "Wer zufrieden mit dem Prozess ist, braucht keine Abkürzung mehr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-19",
      "text": "Dankbarkeit ist der günstigste Weg, dein Mindset zu verbessern.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-20",
      "text": "Du hast schon mehr überstanden, als du dir heute morgen zugetraut hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-21",
      "text": "Zufriedenheit beginnt da, wo der Vergleich mit anderen aufhört.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-12-04-22",
      "text": "Dankbar sein heißt, die eigene Geschichte nicht kleinreden.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-04"
    },
    {
      "id": "gratitude-2026-12-05-23",
      "text": "Was du täglich für selbstverständlich hältst, war mal dein größtes Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-05"
    },
    {
      "id": "gratitude-2026-12-06-24",
      "text": "Zufriedenheit ist kein Zufall, sie ist eine Entscheidung, die du jeden Morgen triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-06"
    },
    {
      "id": "gratitude-2026-12-07-25",
      "text": "Dankbarkeit verwandelt genug in mehr, ohne dass sich etwas ändert.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-07"
    },
    {
      "id": "gratitude-2026-12-08-26",
      "text": "Du wächst schneller, wenn du Wurzeln schlägst, statt ständig umzuziehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-08"
    },
    {
      "id": "gratitude-2026-12-09-27",
      "text": "Zufrieden sein mit dem Weg macht das Ziel erst lebenswert.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-09"
    },
    {
      "id": "gratitude-2026-12-10-28",
      "text": "Dankbarkeit ist das Fundament, auf dem echte Ambition stehen kann.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-10"
    },
    {
      "id": "gratitude-2026-12-11-29",
      "text": "Wer heute dankbar ist, verhandelt morgen nicht mit dem Schicksal.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-11"
    }
  ]
}