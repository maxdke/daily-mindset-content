{
  "generatedAt": "2026-11-07",
  "quotes": [
    {
      "id": "mindset-2026-11-07-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-1",
      "text": "Dein Kopf gibt zuerst auf, nicht dein Körper.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-2",
      "text": "Schwache Momente entscheiden, wie stark du wirklich bist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-3",
      "text": "Niemand rettet dich. Das ist die beste Nachricht des Tages.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-4",
      "text": "Ausreden sind Kredite, die du mit Reue zurückzahlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-5",
      "text": "Komfort ist der leiseste Dieb deiner Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-6",
      "text": "Du verlierst nicht gegen andere, du verlierst gegen deinen inneren Schweinehund.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-7",
      "text": "Mentale Stärke heißt: weitermachen, wenn niemand klatscht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-8",
      "text": "Dein Limit ist meistens nur eine Meinung, keine Tatsache.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-9",
      "text": "Wer ständig Motivation braucht, hat kein System.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-10",
      "text": "Starke Menschen fühlen sich auch schwach – sie handeln trotzdem.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-11",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Unbehagen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-12",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-13",
      "text": "Jede Ausrede, die du glaubst, bezahlst du doppelt zurück.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-14",
      "text": "Dein zukünftiges Ich kennt keine Ausreden von heute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-15",
      "text": "Mentale Stärke ist leise. Sie postet nicht, sie liefert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-16",
      "text": "Wer aufgibt, hat den Preis vergessen, für den er kämpfte.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-17",
      "text": "Schmerz ist temporär. Aufgeben wird dauerhaft gespeichert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-18",
      "text": "Du trainierst nicht deinen Körper, du trainierst deine Reaktion auf Widerstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-19",
      "text": "Comfort Zones haben eine hohe Miete und keine Aussicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-20",
      "text": "Dein größter Gegner trägt deine eigenen Schuhe.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-21",
      "text": "Disziplin fühlt sich nie gut an – nur ihre Ergebnisse.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-22",
      "text": "Wer immer auf den perfekten Moment wartet, verpasst alle anderen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-23",
      "text": "Stärke ist keine Stimmung, sie ist eine Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-24",
      "text": "Du bist nicht müde, du bist unmotiviert von dir selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-25",
      "text": "Jeder Tag ohne Fortschritt ist eine Investition in den Stillstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-26",
      "text": "Dein innerer Kritiker lügt am lautesten kurz vor deinem Durchbruch.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "mindset-2026-12-04-27",
      "text": "Härte ist kein Charakterzug, sie ist eine tägliche Wahl.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-04"
    },
    {
      "id": "mindset-2026-12-05-28",
      "text": "Du wirst nicht stark, weil es leicht wird. Du wirst stark, weil du bleibst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-05"
    },
    {
      "id": "mindset-2026-12-06-29",
      "text": "Resilienz heißt, enttäuscht zu sein und trotzdem weiterzugehen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-06"
    },
    {
      "id": "business-2026-11-07-0",
      "text": "Disziplin schlägt Motivation, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-1",
      "text": "Dein Kontostand ist nur ein Spiegel deiner Gewohnheiten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-2",
      "text": "Wer um 6 Uhr plant, hat um 9 Uhr schon gewonnen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-3",
      "text": "Ausreden sind die Währung der Verlierer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-4",
      "text": "Baue dein Business, während andere ihre Story posten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-5",
      "text": "Konsequenz ist die unsichtbare Abkürzung zum Erfolg.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-6",
      "text": "Du willst Freiheit? Dann verdien sie dir mit Fokus.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-7",
      "text": "Zwischen Idee und Umsetzung liegt dein ganzer Charakter.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-8",
      "text": "Niemand sieht die kurzen Nächte, alle sehen nur das Ergebnis.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-9",
      "text": "Dein Umfeld bestimmt dein Tempo, wähle es mit Bedacht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-10",
      "text": "Produktivität beginnt genau da, wo Ausreden enden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-11",
      "text": "Kleine Entscheidungen heute, großes Vermögen morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-12",
      "text": "Wer wartet, bis es sich richtig anfühlt, wartet ewig.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-13",
      "text": "Deine Komfortzone zahlt keine einzige Rechnung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-14",
      "text": "Erfolg ist kein Zufall, er ist ein Kalendereintrag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-15",
      "text": "Arbeite, als würde dich niemand retten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-16",
      "text": "Zeit ist das einzige Kapital, das du nicht nachkaufen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-17",
      "text": "Fokus ist die neue Währung der Reichen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-18",
      "text": "Mach den Plan klein, aber die Ausführung riesig.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-19",
      "text": "Dein zukünftiges Ich dankt dir für die harte Stunde heute.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-20",
      "text": "Wer ständig um Erlaubnis fragt, hat schon verloren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-21",
      "text": "Baue Systeme, nicht nur Ziele.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-22",
      "text": "Jeder Tag ohne Fortschritt ist verlorener Zinseszins.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-23",
      "text": "Reich wird man im Kopf, bevor man es im Konto sieht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-24",
      "text": "Lieber unperfekt starten als perfekt planen und nie liefern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-25",
      "text": "Deine Zukunft wird heute Morgen um 6 Uhr entschieden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-26",
      "text": "Wachstum tut weh, Stillstand tut am Ende mehr weh.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-12-04-27",
      "text": "Verkaufe Ergebnisse, nicht Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-04"
    },
    {
      "id": "business-2026-12-05-28",
      "text": "Dein Terminkalender zeigt, wie ernst du es wirklich meinst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-05"
    },
    {
      "id": "business-2026-12-06-29",
      "text": "Wer nur träumt, finanziert am Ende die, die handeln.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-06"
    },
    {
      "id": "discipline-2026-11-07-0",
      "text": "Disziplin ist der Zinseszins der Gewohnheiten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-1",
      "text": "Motivation lädt dich ein, Disziplin bringt dich hin.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-2",
      "text": "Du musst nicht jeden Tag wollen, du musst nur jeden Tag machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-3",
      "text": "Konsequenz schlägt Talent, wenn Talent keine Routine hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-4",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-5",
      "text": "Wer aufhört, wenn's unangenehm wird, bleibt für immer da, wo er ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-6",
      "text": "Disziplin ist die Sprache, in der dein zukünftiges Leben zu dir spricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-7",
      "text": "Du brauchst keine Inspiration, du brauchst ein System, das funktioniert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-8",
      "text": "Jeder Tag ohne Ausrede ist ein Tag mit Zinsen auf dein Ziel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-9",
      "text": "Comfort Zone ist der teuerste Ort, an dem du wohnen kannst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-10",
      "text": "Durchhalten ist langweilig. Aufgeben ist teuer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-11",
      "text": "Disziplin fühlt sich nie gut an – bis sie dein Leben verändert hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-12",
      "text": "Du scheiterst nicht am Ziel, du scheiterst an Tag 17.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-13",
      "text": "Gewohnheiten sind Verträge, die du täglich mit dir selbst erneuerst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-14",
      "text": "Wer auf Motivation wartet, wartet auf den falschen Zug.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-15",
      "text": "Harte Tage bauen das Fundament, das weiche Tage nie halten würden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-16",
      "text": "Disziplin ist unsichtbar, bis sie plötzlich dein ganzes Leben trägt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-17",
      "text": "Du bist nicht müde vom Arbeiten, du bist müde vom Zweifeln.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-18",
      "text": "Kleine Routinen schlagen große Pläne, die nie starten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-19",
      "text": "Dein Durchhaltevermögen ist die einzige Währung, die niemand dir klauen kann.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-20",
      "text": "Aufgeben ist die einzige Entscheidung, die man sofort bereut – und spät merkt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-21",
      "text": "Disziplin ist, weiterzumachen, wenn das Gefühl längst gekündigt hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-22",
      "text": "Du verhandelst nicht mit deiner Bequemlichkeit, du überstimmst sie.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-23",
      "text": "Konstanz ist unsexy – bis man das Ergebnis sieht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-24",
      "text": "Die Ausrede von heute ist der Rückstand von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-25",
      "text": "Disziplin heißt, dem Ich von heute zu misstrauen und für das von morgen zu arbeiten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-26",
      "text": "Du brauchst keinen guten Tag, um weiterzumachen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-12-04-27",
      "text": "Wer jeden Tag ein bisschen durchzieht, braucht nie einen Neustart.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-04"
    },
    {
      "id": "discipline-2026-12-05-28",
      "text": "Dein Durchbruch sieht aus wie ein stinknormaler Dienstag, den du nicht abgebrochen hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-05"
    },
    {
      "id": "discipline-2026-12-06-29",
      "text": "Disziplin ist der Unterschied zwischen Wollen und Werden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-06"
    },
    {
      "id": "fitness-2026-11-07-0",
      "text": "Dein Körper ist dein teuerstes Investment – zahl täglich ein.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-1",
      "text": "Energie ist die einzige Währung, die du nicht nachdrucken kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-2",
      "text": "Kein Meeting schlägt dein Workout – das ist der wichtigste Termin heute.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-3",
      "text": "Müde ist ein Gefühl, kein Status. Beweg dich trotzdem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-4",
      "text": "Du optimierst dein Portfolio, aber ignorierst deinen Puls?",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-5",
      "text": "Schlaf ist der Zinseszins deiner Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-6",
      "text": "Ein starker Körper verhandelt bessere Deals mit dem Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-7",
      "text": "Disziplin im Training ist Disziplin im Leben – Punkt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-8",
      "text": "Dein Grundumsatz interessiert niemanden, deine Ausreden auch nicht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-9",
      "text": "Bewegung ist das günstigste Antidepressivum mit der besten Rendite.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-10",
      "text": "Wer seinen Körper vernachlässigt, führt ein Unternehmen ohne Fundament.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-11",
      "text": "20 Minuten Sport schlagen 2 Stunden Grübeln.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-12",
      "text": "Dein Energielevel entscheidet, wie gut du heute verhandelst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-13",
      "text": "Fitness ist kein Ziel, sondern dein Betriebssystem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-14",
      "text": "Wer nicht schwitzt, zahlt später mit Zinsen in Erschöpfung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-15",
      "text": "Du brauchst keine Motivation, du brauchst einen Kalendereintrag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-16",
      "text": "Ein kurzer Lauf schlägt jede Kaffeepause.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-17",
      "text": "Starke Beine tragen starke Entscheidungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-18",
      "text": "Dein Körper merkt sich jeden Tag, den du ihn ignoriert hast.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-19",
      "text": "Energie-Management schlägt Zeitmanagement – immer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-20",
      "text": "Du kannst nicht skalieren, was ständig erschöpft ist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-21",
      "text": "Ein Satz Liegestütze schlägt einen Kopf voller Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-22",
      "text": "Wer früh trainiert, gewinnt den Tag doppelt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-23",
      "text": "Dein Body ist das einzige Asset, das du nicht verkaufen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-24",
      "text": "Bewegung ist der Reset-Knopf für einen überlasteten Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-25",
      "text": "Stärke im Körper baut Ruhe im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-26",
      "text": "Du investierst in Aktien – investier auch in deine Ausdauer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-12-04-27",
      "text": "Ein trainierter Körper lügt nie über harte Arbeit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-04"
    },
    {
      "id": "fitness-2026-12-05-28",
      "text": "Fitness ist der stille Vorteil, den niemand auf LinkedIn sieht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-05"
    },
    {
      "id": "fitness-2026-12-06-29",
      "text": "Schwitzen ist billiger als Burnout.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-06"
    },
    {
      "id": "gratitude-2026-11-07-0",
      "text": "Zufriedenheit ist kein Ziel, das du erreichst. Es ist eine Entscheidung, die du heute triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-1",
      "text": "Du vergleichst dein Jetzt mit dem Highlight-Reel von anderen. Hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-2",
      "text": "Dankbarkeit ist der Zinseszins der guten Laune.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-3",
      "text": "Wer nie zufrieden mit dem Status quo ist, verpasst den Moment, in dem er lebt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-4",
      "text": "Erfolg ohne Dankbarkeit fühlt sich an wie ein Konto ohne Guthaben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-5",
      "text": "Du jagst dem Nächsten hinterher und übersiehst, was du schon hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-6",
      "text": "Zufriedenheit ist kein Luxus für später. Sie ist Treibstoff für jetzt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-7",
      "text": "Dankbarkeit kostet nichts und zahlt sich trotzdem jeden Tag aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-8",
      "text": "Du hast heute geatmet, gegessen und etwas gelernt. Das ist schon ein guter Tag.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-9",
      "text": "Wer dankbar ist, verliert nicht an Ehrgeiz. Er gewinnt an Ruhe.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-10",
      "text": "Zufriedenheit heute macht Ambition morgen leichter.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-11",
      "text": "Du musst nicht alles haben, um dankbar zu sein. Du musst nur hinschauen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-12",
      "text": "Dankbarkeit ist die einzige Investition, die sofort Rendite bringt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-13",
      "text": "Mehr wollen ist okay. Weniger wertschätzen nicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-14",
      "text": "Du bist weiter, als du letztes Jahr warst. Erkenne das an, bevor du weiterläufst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-15",
      "text": "Zufriedenheit ist kein Stillstand. Es ist der Boden, von dem aus du springst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-16",
      "text": "Dankbarkeit macht aus genug ein Fest und aus wenig ein Vermögen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-17",
      "text": "Du optimierst deinen Tag, aber hast du heute schon Danke gesagt?",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-18",
      "text": "Wer immer nur das Ziel sieht, verpasst den Weg, der ihn dorthin bringt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-19",
      "text": "Zufriedenheit ist der Unterschied zwischen Ankommen und ständig Ankommen-Wollen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-20",
      "text": "Dankbarkeit ist keine Schwäche. Sie ist die Bestätigung, dass du schon etwas geschafft hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-21",
      "text": "Du musst nicht jeden Tag gewinnen, um einen guten Tag zu haben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-22",
      "text": "Zufriedenheit ist leise. Deshalb hört sie kaum jemand zwischen den Zielen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-23",
      "text": "Dankbarkeit ist der Moment, in dem du merkst: Ich bin schon genug.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-24",
      "text": "Du bist nicht im Rückstand. Du bist auf deinem eigenen Zeitplan.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-25",
      "text": "Wer zufrieden ist mit dem Prozess, muss nicht auf das Ergebnis warten, um glücklich zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-26",
      "text": "Dankbarkeit verändert nichts an deiner Situation. Sie verändert, wie du sie siehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-12-04-27",
      "text": "Du hast heute die Wahl gehabt. Das allein ist schon mehr, als viele haben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-04"
    },
    {
      "id": "gratitude-2026-12-05-28",
      "text": "Zufriedenheit heißt nicht aufhören. Es heißt, den Grund fürs Weitermachen zu kennen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-05"
    },
    {
      "id": "gratitude-2026-12-06-29",
      "text": "Dankbarkeit ist der stille Erfolg, den niemand auf deinem Profil sieht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-06"
    }
  ]
}