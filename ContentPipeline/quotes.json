{
  "generatedAt": "2026-10-25",
  "quotes": [
    {
      "id": "mindset-2026-10-25-0",
      "text": "Disziplin ist der Zins, den du heute zahlst, damit dein Zukunfts-Ich reich wird.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-1",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-2",
      "text": "Dein Kopf gibt auf, bevor dein Körper es tut – merk dir das.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-3",
      "text": "Komfort ist der leiseste Weg in die Bedeutungslosigkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-4",
      "text": "Niemand rettet dich. Das ist die beste Nachricht des Tages.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-5",
      "text": "Du musst nicht motiviert sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-6",
      "text": "Schwache Momente erzählen dir die überzeugendsten Ausreden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-7",
      "text": "Wer auf Stimmung wartet, wartet sein ganzes Leben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-8",
      "text": "Dein Gehirn verhandelt nur, weil du es ihm erlaubst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-9",
      "text": "Stärke ist kein Gefühl. Stärke ist eine Entscheidung, die du wiederholst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-10",
      "text": "Der Widerstand, den du spürst, zeigt dir genau, wo du wachsen musst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-11",
      "text": "Ausreden sind gut formulierte Lügen, die du selbst geschrieben hast.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-12",
      "text": "Dein Standard entscheidet, nicht dein Ziel.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-13",
      "text": "Unbequem ist der Preis für ein Leben, das sich später gut anfühlt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-14",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-15",
      "text": "Jeder Tag ohne Fortschritt ist ein stiller Rückschritt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-16",
      "text": "Mentale Stärke zeigt sich dort, wo niemand zuschaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-17",
      "text": "Dein innerer Kritiker lügt öfter, als du denkst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-18",
      "text": "Wer sich selbst führt, braucht keine Erlaubnis von außen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-19",
      "text": "Schmerz, den du heute vermeidest, kommt morgen mit Zinsen zurück.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-20",
      "text": "Konsequenz schlägt Talent, jedes einzelne Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-21",
      "text": "Du wächst nicht im Urlaub, du wächst im Widerstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-22",
      "text": "Die Stimme, die aufgeben will, ist nie die Stimme, die dich kennt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-23",
      "text": "Klarheit entsteht durch Handeln, nicht durch Nachdenken.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-24",
      "text": "Dein Limit ist eine Meinung, keine Tatsache.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-25",
      "text": "Wer Druck meidet, bleibt für immer derselbe.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-26",
      "text": "Starke Menschen fühlen auch Zweifel – sie handeln trotzdem.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-27",
      "text": "Dein Fokus ist deine Währung. Gib ihn nicht billig her.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-28",
      "text": "Disziplin fühlt sich nie gut an, bevor sie sich gut anfühlt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-29",
      "text": "Du verhandelst nicht mit dem Montag. Du erscheinst einfach.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-10-25-0",
      "text": "Wer um 9 Uhr noch plant, hat um 18 Uhr nichts gebaut.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-1",
      "text": "Dein Kalender zeigt, ob du ernst meinst, was du sagst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-2",
      "text": "Motivation ist ein Bonus, Disziplin ist das Fundament.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-3",
      "text": "Zwischen Idee und Umsatz liegt nur eine Sache: Ausführung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-4",
      "text": "Jede verschobene Aufgabe kostet dich heute, nicht morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-5",
      "text": "Erfolg ist kein Zufall, er ist eine wiederholte Entscheidung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-6",
      "text": "Wer auf den perfekten Moment wartet, verpasst jeden Moment.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-7",
      "text": "Dein Umsatz spiegelt deine Gewohnheiten der letzten 90 Tage.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-8",
      "text": "Baue, während andere noch diskutieren, ob es funktioniert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-9",
      "text": "Ein fertiges Produkt schlägt eine perfekte Idee jedes Mal.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-10",
      "text": "Du verlierst kein Geld durch Risiko, sondern durch Zögern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-11",
      "text": "Wachstum passiert nicht im Komfort, sondern im Konflikt mit ihm.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-12",
      "text": "Konsequenz schlägt Talent, wenn Talent nicht konsequent ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-13",
      "text": "Deine To-do-Liste lügt nicht - sie zeigt deine Prioritäten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-14",
      "text": "Wer zehn Dinge gleichzeitig macht, beendet keins richtig.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-15",
      "text": "Kapital ist ersetzbar. Zeit, die du heute verlierst, nicht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-16",
      "text": "Mach den Call, der dir unangenehm ist. Darin liegt das Geschäft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-17",
      "text": "Dein Business wächst erst, wenn du aufhörst, alles selbst zu machen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-18",
      "text": "Feedback, das wehtut, ist oft das wertvollste, das du bekommst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-19",
      "text": "Plane wie ein Stratege, handle wie jemand ohne Sicherheitsnetz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-20",
      "text": "Wer immer nur optimiert, baut nie etwas Neues.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-21",
      "text": "Dein nächster Kunde wartet nicht auf deine Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-22",
      "text": "Fokus ist die Fähigkeit, gute Ideen bewusst zu ignorieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-23",
      "text": "Jeder Tag ohne Fortschritt ist ein Tag, den dein Wettbewerb nutzt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-24",
      "text": "Du brauchst keine Motivation, du brauchst ein System.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-25",
      "text": "Verkauf beginnt dort, wo dein Ego aufhört zu reden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-26",
      "text": "Wer nie Nein sagt, hat für nichts wirklich Zeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-27",
      "text": "Ergebnisse zählen mehr als Stunden am Schreibtisch.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-28",
      "text": "Starte jetzt - unperfekt, aber in Bewegung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-29",
      "text": "Dein Netzwerk wächst durch Wert, den du gibst, nicht durch Visitenkarten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-10-25-0",
      "text": "Disziplin ist der Unterschied zwischen dem, der du bist, und dem, der du sein könntest.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-1",
      "text": "Motivation ist Zufall. Disziplin ist ein System, das liefert, wenn Motivation fehlt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-2",
      "text": "Dein zukünftiges Ich zahlt den Preis für die Ausreden von heute.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-3",
      "text": "Konsequenz schlägt Talent, wenn Talent nicht konsequent ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-4",
      "text": "Du musst nicht wollen. Du musst nur machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-5",
      "text": "Disziplin ist die stille Entscheidung, auch dann weiterzugehen, wenn keiner zuschaut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-6",
      "text": "Jeder Tag, an dem du durchziehst, ist ein Beweis gegen deine Zweifel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-7",
      "text": "Gewohnheiten bauen das Leben, das Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-8",
      "text": "Der Unterschied zwischen Träumen und Zielen heißt Wiederholung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-9",
      "text": "Du wirst nicht aufgeben, weil du längst zu weit gekommen bist, um klein zu denken.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-10",
      "text": "Disziplin fühlt sich nie gut an - bis sie dein Leben verändert hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-11",
      "text": "Wer täglich liefert, muss keine Ausnahmen rechtfertigen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-12",
      "text": "Der innere Widerstand ist der Preis für jeden echten Fortschritt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-13",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-14",
      "text": "Disziplin ist Selbstrespekt in Aktion.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-15",
      "text": "Härte gegen dich selbst heute spart dir Reue morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-16",
      "text": "Die Komfortzone zahlt keine Rechnungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-17",
      "text": "Jede Ausrede, die du glaubst, kostet dich ein Stück deiner Zukunft.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-18",
      "text": "Du trainierst nicht nur deinen Körper, du trainierst deinen Willen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-19",
      "text": "Disziplin ist lauter als jede Ausrede, wenn du ihr zuhörst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-20",
      "text": "Wer aufhört, wenn es unbequem wird, bleibt für immer da, wo er ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-21",
      "text": "Dein Standard ist das, was du tust, wenn niemand klatscht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-22",
      "text": "Kleine Pflichten heute verhindern große Reue morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-23",
      "text": "Disziplin ist die Brücke zwischen Plan und Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-24",
      "text": "Du schuldest dir selbst die Version, die durchzieht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-25",
      "text": "Konstanz schlägt Intensität - jedes Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-26",
      "text": "Der Moment, in dem du weitermachst, obwohl du nicht willst, formt dich.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-27",
      "text": "Wachstum passiert nicht im Feiern, sondern im Durchhalten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-28",
      "text": "Disziplin ist unsichtbar, bis sie sichtbar wird als Erfolg.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-29",
      "text": "Du wirst nicht über Nacht stark. Du wirst es durch jeden Tag, den du dranbleibst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-10-25-0",
      "text": "Dein Körper ist kein Tempel, er ist eine Maschine. Wart ihn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-1",
      "text": "Energie ist die einzige Währung, die du dir nicht leihen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-2",
      "text": "Wer seinen Körper vernachlässigt, zahlt später mit Zinsen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-3",
      "text": "Bewegung ist das günstigste Antidepressivum, das du nie nimmst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-4",
      "text": "Dein Training heute ist die Energie, die du morgen verkaufst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-5",
      "text": "Schwache Beine, schwacher Fokus. Trainier beides gleichzeitig.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-6",
      "text": "Du willst mehr leisten? Dann schlaf mehr und beweg dich härter.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-7",
      "text": "Fitness ist kein Ziel, sondern dein Betriebssystem-Update.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-8",
      "text": "Jeder Satz im Gym ist eine Einzahlung auf dein Energiekonto.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-9",
      "text": "Disziplin im Training überträgt sich auf jede andere Disziplin.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-10",
      "text": "Dein Puls entscheidet, wie schnell dein Kopf arbeitet.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-11",
      "text": "Müdigkeit ist oft nur ein Mangel an Bewegung, keine Pause.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-12",
      "text": "Wer still sitzt, denkt still. Beweg dich, um zu wachsen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-13",
      "text": "Dein Körper hört jedes Wort, das du über ihn denkst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-14",
      "text": "Kraft im Körper macht Ausreden im Kopf leiser.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-15",
      "text": "Du trainierst nicht für den Sommer, du trainierst für den Fokus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-16",
      "text": "Ein starker Körper verhandelt nicht mit der Snooze-Taste.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-17",
      "text": "Jede Wiederholung ist ein Investment in deine nächste Idee.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-18",
      "text": "Erschöpfung lügt. Ein Satz mehr beweist es dir jeden Tag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-19",
      "text": "Wer seinen Körper ignoriert, verliert zuerst den klaren Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-20",
      "text": "Bewegung ist der Zins, den dein Gehirn dir zurückzahlt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-21",
      "text": "Du brauchst keine Motivation, du brauchst einen Plan und Schweiß.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-22",
      "text": "Dein größtes Kapital schwitzt gerade nicht genug.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-23",
      "text": "Stärke baust du nicht im Kopf, sondern im Wiederholen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-24",
      "text": "Ein müder Körper macht aus jeder Chance eine Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-25",
      "text": "Dein Energielevel ist dein wahrer Kontostand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-26",
      "text": "Trainiere deinen Körper, als würdest du dein Gehirn optimieren.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-27",
      "text": "Wer hart trainiert, verhandelt nicht mehr mit Faulheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-28",
      "text": "Dein Körper ist der Zinseszins deiner täglichen Entscheidungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-29",
      "text": "Beweg dich, bevor dein Kopf anfängt zu verhandeln.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-10-25-0",
      "text": "Dankbarkeit ist der einzige Zinseszins, der sofort ausgezahlt wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-1",
      "text": "Wer zufrieden startet, grindet klüger statt verzweifelter.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-2",
      "text": "Du vergleichst dein Jetzt mit fremden Highlights. Hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-3",
      "text": "Dankbar sein heißt nicht aufhören zu wollen, sondern klar sehen, was du schon hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-4",
      "text": "Zufriedenheit ist kein Stillstand, sondern dein stabiler Boden für den nächsten Sprung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-5",
      "text": "Dein Leben in fünf Jahren dankt dir für das, was du heute schon wertschätzt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-6",
      "text": "Erfolg ohne Dankbarkeit ist nur eine längere To-do-Liste.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-7",
      "text": "Du jagst das nächste Level und verpasst das, was du schon erreicht hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-8",
      "text": "Zufriedenheit ist keine Schwäche, sondern der Beweis, dass du weißt, was zählt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-9",
      "text": "Dankbarkeit kostet nichts und zahlt sich in Energie aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-10",
      "text": "Wer nie zufrieden ist, verwechselt Ambition mit innerer Unruhe.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-11",
      "text": "Dein Konto wächst. Deine Dankbarkeit sollte mitwachsen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-12",
      "text": "Zufriedenheit ist der Treibstoff, nicht die Bremse.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-13",
      "text": "Du optimierst deinen Tag und vergisst, ihn zu schätzen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-14",
      "text": "Dankbarkeit ist die einzige Investition ohne Risiko.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-15",
      "text": "Wer dankbar ist, verhandelt nicht mit dem Universum, sondern arbeitet weiter.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-16",
      "text": "Zufriedenheit heute macht Ambition morgen leichter.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-17",
      "text": "Du willst mehr, bevor du überhaupt gesehen hast, was du schon hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-18",
      "text": "Dankbarkeit ist kein Gefühl, sondern eine tägliche Entscheidung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-19",
      "text": "Zufriedene Menschen grinden ruhiger und kommen trotzdem weiter.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-20",
      "text": "Dein größter Flex ist, mit dem zufrieden zu sein, was du dir selbst aufgebaut hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-21",
      "text": "Dankbarkeit macht aus Druck ein Dankeschön.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-22",
      "text": "Wer nichts wertschätzt, braucht immer mehr, um sich voll zu fühlen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-23",
      "text": "Zufriedenheit ist der Punkt, an dem Ambition nicht mehr aus Angst kommt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-24",
      "text": "Du feierst nie deine Meilensteine, kein Wunder, dass nichts reicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-25",
      "text": "Dankbarkeit ist der stille Vorteil, den niemand auf LinkedIn postet.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-26",
      "text": "Zufriedenheit bedeutet nicht aufhören, sondern ohne Groll weitermachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-27",
      "text": "Dein Leben jetzt war mal dein Ziel von vor drei Jahren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-28",
      "text": "Dankbar sein ist der günstigste Weg, sich reich zu fühlen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-29",
      "text": "Zufriedenheit ist der Unterschied zwischen Ankommen und ewig Rennen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    }
  ]
}