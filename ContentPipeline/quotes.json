{
  "generatedAt": "2026-11-10",
  "quotes": [
    {
      "id": "mindset-2026-11-10-0",
      "text": "Dein Kopf gibt auf, bevor dein Körper es tut. Trainiere zuerst den Kopf.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-1",
      "text": "Motivation ist ein Gast. Disziplin zieht bei dir ein.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-2",
      "text": "Wer auf Lust wartet, wartet sein Leben lang.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-3",
      "text": "Schwache Momente entscheiden über starke Jahre.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-4",
      "text": "Dein Umfeld flüstert dir Ausreden zu. Hör nicht hin.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-5",
      "text": "Komfort ist der leiseste Dieb deiner Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-6",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-7",
      "text": "Disziplin fühlt sich erst falsch an, bevor sie sich gut anfühlt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-8",
      "text": "Niemand rettet dich. Das ist die beste Nachricht des Tages.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-9",
      "text": "Dein zukünftiges Ich zahlt für jede Ausrede von heute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-10",
      "text": "Stärke entsteht nicht im Erfolg, sondern im Durchhalten danach.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-11",
      "text": "Du bist nicht müde. Du bist unausgerichtet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-12",
      "text": "Zweifel ist laut, aber er hat kein Stimmrecht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-13",
      "text": "Der Schmerz der Disziplin wiegt Gramm, der des Bereuens Tonnen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-14",
      "text": "Wachstum beginnt genau da, wo dein Ego aufhört zu reden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-15",
      "text": "Du brauchst keine Inspiration. Du brauchst eine Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-16",
      "text": "Resilienz ist kein Talent. Es ist eine tägliche Rechnung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-17",
      "text": "Dein innerer Kritiker lügt dich an, um sich sicher zu fühlen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-18",
      "text": "Harte Tage bauen das Fundament für leichte Jahre.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-19",
      "text": "Wer sich selbst führt, braucht keinen Applaus von außen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-20",
      "text": "Gewohnheiten schlagen Ziele. Jedes Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-21",
      "text": "Du verlierst nicht gegen andere. Du verlierst gegen gestern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-22",
      "text": "Angst ist ein Kompass, kein Stoppschild.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-23",
      "text": "Dein Kopf testet dich, bevor er dich belohnt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "mindset-2026-12-04-24",
      "text": "Stillstand fühlt sich sicher an und kostet trotzdem alles.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-04"
    },
    {
      "id": "mindset-2026-12-05-25",
      "text": "Die stärkste Version von dir wartet hinter der Bequemlichkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-05"
    },
    {
      "id": "mindset-2026-12-06-26",
      "text": "Klarheit entsteht durch Handeln, nicht durch Nachdenken.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-06"
    },
    {
      "id": "mindset-2026-12-07-27",
      "text": "Du bist nicht das Gefühl von heute Morgen. Du bist die Entscheidung von jetzt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-07"
    },
    {
      "id": "mindset-2026-12-08-28",
      "text": "Mentale Stärke ist der Mut, trotzdem weiterzumachen, wenn niemand zusieht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-08"
    },
    {
      "id": "mindset-2026-12-09-29",
      "text": "Dein Limit ist eine Meinung, keine Tatsache.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-09"
    },
    {
      "id": "business-2026-11-10-0",
      "text": "Disziplin ist der Zins, den du heute zahlst, damit Freiheit morgen zinst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-1",
      "text": "Deine To-Do-Liste interessiert sich nicht für deine Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-2",
      "text": "Wer auf Motivation wartet, wartet auf einen Bus, der nicht kommt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-3",
      "text": "Zeit ist das einzige Kapital, das du nicht nachkaufen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-4",
      "text": "Erfolg ist das, was passiert, wenn du trotzdem lieferst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-5",
      "text": "Dein Zukunfts-Ich zahlt die Rechnung für das, was du heute nicht tust.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-6",
      "text": "Fokus schlägt Talent, wenn Talent sich nicht fokussiert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-7",
      "text": "Du musst nicht motiviert sein, du musst nur anfangen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-8",
      "text": "Jeder Tag ohne Umsetzung ist eine verlorene Investition.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-9",
      "text": "Komfort ist der leiseste Weg in die Bedeutungslosigkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-10",
      "text": "Baue heute das System, das morgen ohne dich funktioniert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-11",
      "text": "Deadlines sind keine Bedrohung, sie sind deine Verbündeten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-12",
      "text": "Zweifel kosten mehr Zeit als jeder Fehler, den du machen könntest.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-13",
      "text": "Die Konkurrenz schläft nicht, aber sie scrollt auch nicht stundenlang.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-14",
      "text": "Kleine Entscheidungen heute bauen das Leben von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-15",
      "text": "Wer alles perfekt will, liefert am Ende gar nichts.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-16",
      "text": "Dein Konto wächst in dem Tempo, in dem du Ausreden abbaust.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-17",
      "text": "Plane wie ein Stratege, handle wie ein Besessener.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-18",
      "text": "Niemand bezahlt dich für Absichten, nur für Ergebnisse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-19",
      "text": "Der Unterschied zwischen Traum und Plan ist ein Datum.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-20",
      "text": "Routine ist die Maschine, die Talent reproduzierbar macht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-21",
      "text": "Du verlierst nicht gegen andere, du verlierst gegen deinen inneren Aufschub.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-22",
      "text": "Wachstum fühlt sich nie bequem an, sonst würdest du es schon tun.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-23",
      "text": "Jede Stunde Ablenkung ist eine Stunde, die dein Wettbewerber nutzt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-12-04-24",
      "text": "Konsequenz schlägt Intensität, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-04"
    },
    {
      "id": "business-2026-12-05-25",
      "text": "Du brauchst keinen perfekten Plan, du brauchst den ersten Schritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-05"
    },
    {
      "id": "business-2026-12-06-26",
      "text": "Verkaufe Ergebnisse, nicht Entschuldigungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-06"
    },
    {
      "id": "business-2026-12-07-27",
      "text": "Der Markt fragt nicht, wie hart du gearbeitet hast, sondern was geliefert wurde.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-07"
    },
    {
      "id": "business-2026-12-08-28",
      "text": "Baue dein Business so, dass es dich überflüssig macht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-08"
    },
    {
      "id": "business-2026-12-09-29",
      "text": "Strategie ohne Umsetzung ist nur eine teure Idee.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-09"
    },
    {
      "id": "discipline-2026-11-10-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-1",
      "text": "Motivation checkt aus, Disziplin bleibt im Shift.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-2",
      "text": "Deine Comfort Zone bringt dir null Rendite.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-3",
      "text": "Durchhalten ist der Skill, den keiner auf LinkedIn postet.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-4",
      "text": "Konsequenz schlägt Talent, jeden einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-5",
      "text": "Wer aufhört, wenn's unbequem wird, bleibt für immer da stehen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-6",
      "text": "Disziplin ist leise. Ergebnisse sind laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-7",
      "text": "Dein Future Self zahlt heute die Rechnung deiner Faulheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-8",
      "text": "Nicht jeder Tag fühlt sich gut an. Mach ihn trotzdem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-9",
      "text": "Gewohnheiten bauen das Fundament, Motivation nur die Fassade.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-10",
      "text": "Durchziehen schlägt Perfektion, jedes Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-11",
      "text": "Disziplin ist der Unterschied zwischen Wollen und Werden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-12",
      "text": "Die Ausrede von heute ist die Reue von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-13",
      "text": "Kein Hype hält länger als ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-14",
      "text": "Wer Ergebnisse will, führt den Tag ohne Gefühl.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-15",
      "text": "Dein Warum muss stärker sein als dein Wecker.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-16",
      "text": "Disziplin kostet jetzt wenig, Reue später alles.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-17",
      "text": "Konsistenz ist das stillste Flex, das es gibt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-18",
      "text": "Du brauchst keine Motivation. Du brauchst einen Plan, dem du folgst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-19",
      "text": "Der Unterschied zwischen Träumern und Machern ist ein Timer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-20",
      "text": "Wer durchzieht, wenn's schwer wird, gewinnt, wenn's zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-21",
      "text": "Disziplin ist Selbstrespekt in Aktion.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-22",
      "text": "Dein Ziel fragt nicht nach deiner Stimmung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-23",
      "text": "Jeden Tag eine Entscheidung mehr für das Leben, das du willst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-12-04-24",
      "text": "Komfort ist der Feind von allem, was du noch nicht erreicht hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-04"
    },
    {
      "id": "discipline-2026-12-05-25",
      "text": "Disziplin baut, was Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-05"
    },
    {
      "id": "discipline-2026-12-06-26",
      "text": "Du gibst nicht auf, weil Aufgeben keine Option mehr ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-06"
    },
    {
      "id": "discipline-2026-12-07-27",
      "text": "Harte Tage bauen das Leben, das du dir wünschst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-07"
    },
    {
      "id": "discipline-2026-12-08-28",
      "text": "Wer früh aufgibt, verliert spät den Respekt vor sich selbst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-08"
    },
    {
      "id": "discipline-2026-12-09-29",
      "text": "Disziplin ist der Preis für Freiheit später.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-09"
    },
    {
      "id": "fitness-2026-11-10-0",
      "text": "Dein Körper ist der einzige Ort, an dem du für immer wohnst - renovier ihn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-1",
      "text": "Energie ist kein Zufall, sie ist eine Entscheidung, die du jeden Morgen triffst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-2",
      "text": "Disziplin im Training ist Disziplin im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-3",
      "text": "Dein Puls entscheidet, wie wach dein Kopf heute wird.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-4",
      "text": "Schwitzen ist Zinseszins für deinen Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-5",
      "text": "Wer seinen Körper trainiert, trainiert seine Willenskraft gleich mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-6",
      "text": "Bewegung ist das günstigste Antidepressivum, das du nie nimmst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-7",
      "text": "Dein Energielevel ist dein größtes Investment-Asset.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-8",
      "text": "Muskeln baust du im Schlaf, Disziplin baust du im Studio.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-9",
      "text": "Keine Motivation? Dann zähl trotzdem die Wiederholungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-10",
      "text": "Dein Körper merkt sich jede Ausrede, die du ihm gibst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-11",
      "text": "Fitness ist der Zins, den dein zukünftiges Ich dir zahlt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-12",
      "text": "Ein starker Körper verhandelt nicht mit Müdigkeit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-13",
      "text": "Wer heute trainiert, denkt morgen klarer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-14",
      "text": "Energie tankst du nicht, du erzeugst sie durch Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-15",
      "text": "Dein Workout ist die Rechnung, die dein zukünftiges Ich nicht mehr zahlen muss.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-16",
      "text": "Schwache Ausreden bauen keine starken Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-17",
      "text": "Jede Wiederholung ist ein Investment in deine Zukunft.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-18",
      "text": "Du bist nicht müde, du bist unbewegt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-19",
      "text": "Dein Körper ist dein teuerstes Asset - pfleg es wie eines.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-20",
      "text": "Kraft kommt nicht von Motivation, sondern von Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-21",
      "text": "Wer seinen Körper vernachlässigt, verliert seine beste Ressource.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-22",
      "text": "Energie first, Ausreden second - nie andersrum.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-23",
      "text": "Dein Herz schlägt für Ziele, nicht für Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-12-04-24",
      "text": "Bewegung ist die Zinsrate deiner mentalen Klarheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-04"
    },
    {
      "id": "fitness-2026-12-05-25",
      "text": "Du trainierst nicht für den Sommer, du trainierst für dein Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-05"
    },
    {
      "id": "fitness-2026-12-06-26",
      "text": "Ein müder Körper lügt dir ein müdes Mindset vor.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-06"
    },
    {
      "id": "fitness-2026-12-07-27",
      "text": "Fitness ist der stille Teil deines Erfolgs.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-07"
    },
    {
      "id": "fitness-2026-12-08-28",
      "text": "Dein Körper spiegelt deine Disziplin, nicht deine Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-08"
    },
    {
      "id": "fitness-2026-12-09-29",
      "text": "Wer sich bewegt, bewegt auch seine Gedanken.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-09"
    },
    {
      "id": "gratitude-2026-11-10-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist der Treibstoff für den nächsten Schritt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-1",
      "text": "Wer dankbar für das Jetzt ist, verschwendet keine Energie an das Gestern.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-2",
      "text": "Dankbarkeit ist die einzige Investition, die sofort Rendite bringt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-3",
      "text": "Du musst nicht warten bis du angekommen bist, um dich zu freuen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-4",
      "text": "Zufriedenheit schlägt jedes Ziel, das du am Ende nicht genießen kannst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-5",
      "text": "Wer ständig vergleicht, verliert den Blick für das, was schon funktioniert.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-6",
      "text": "Dankbarkeit ist kein Gefühl, sie ist eine tägliche Entscheidung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-7",
      "text": "Erfolg ohne Dankbarkeit ist wie ein Konto ohne Zinsen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-8",
      "text": "Das Leben, das du gerade lebst, war mal dein Zukunftstraum.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-9",
      "text": "Zufriedenheit ist die Pause, die dich stärker macht für den nächsten Sprint.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-10",
      "text": "Wer nicht dankbar für Kleines ist, wird es auch für Großes nicht sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-11",
      "text": "Dankbarkeit kostet nichts und verändert alles, was du siehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-12",
      "text": "Dein Fortschritt zählt mehr als dein Vergleich mit anderen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-13",
      "text": "Zufriedenheit ist die stille Kraft hinter jedem nachhaltigen Erfolg.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-14",
      "text": "Wer dankbar ist, verschwendet keine Zeit mit Neid.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-15",
      "text": "Du bist weiter, als du denkst. Erkenne es an, bevor du weiterziehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-16",
      "text": "Dankbarkeit macht aus genug ein Gefühl von Fülle.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-17",
      "text": "Zufriedenheit ist der Unterschied zwischen Ankommen und ständigem Jagen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-18",
      "text": "Wer heute dankbar ist, hat morgen mehr Gründe dafür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-19",
      "text": "Dein Jetzt verdient genauso viel Anerkennung wie dein nächstes Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-20",
      "text": "Dankbarkeit ist der Filter, der Stress in Perspektive verwandelt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-21",
      "text": "Zufriedenheit ist kein Stillstand, sie ist dein Fundament.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-22",
      "text": "Du wächst schneller, wenn du aufhörst, dich selbst zu unterschätzen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-23",
      "text": "Dankbar sein heißt, das Jetzt nicht gegen ein Vielleicht einzutauschen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-12-04-24",
      "text": "Wer zufrieden ist, braucht keine Bestätigung von außen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-04"
    },
    {
      "id": "gratitude-2026-12-05-25",
      "text": "Dankbarkeit macht aus Druck eine Chance, die du sonst übersehen hättest.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-05"
    },
    {
      "id": "gratitude-2026-12-06-26",
      "text": "Zufriedenheit ist der Moment, in dem Ehrgeiz zur Ruhe kommt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-06"
    },
    {
      "id": "gratitude-2026-12-07-27",
      "text": "Du hast mehr erreicht, als dein innerer Kritiker zugibt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-07"
    },
    {
      "id": "gratitude-2026-12-08-28",
      "text": "Dankbarkeit ist die Abkürzung zu echter Motivation.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-08"
    },
    {
      "id": "gratitude-2026-12-09-29",
      "text": "Zufriedenheit ist nicht das Ende des Ehrgeizes, sondern sein Ursprung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-09"
    }
  ]
}