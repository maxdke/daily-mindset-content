{
  "generatedAt": "2026-11-02",
  "quotes": [
    {
      "id": "mindset-2026-11-02-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-1",
      "text": "Dein Kopf glaubt jede Ausrede, die du ihm oft genug erzählst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-2",
      "text": "Comfort Zone ist nur ein anderes Wort für Stillstand mit gutem Gefühl.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-3",
      "text": "Schwache Momente sind Investitionen in eine starke Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-4",
      "text": "Wer auf Motivation wartet, verliert gegen den, der einfach anfängt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-5",
      "text": "Dein Mindset ist das einzige Asset, das nie an Wert verliert, wenn du es pflegst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-6",
      "text": "Komfort ist der teuerste Kredit, den du je aufnehmen wirst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-7",
      "text": "Niemand rettet dich. Das ist die beste Nachricht, die du heute bekommst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-8",
      "text": "Stärke entsteht nicht im Erfolg, sondern im Moment davor, in dem du fast aufgibst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-9",
      "text": "Deine Ausreden sind gut. Deine Ziele sind besser.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-10",
      "text": "Resilienz ist kein Talent. Es ist eine tägliche Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-11",
      "text": "Du verhandelst nicht mit deiner Disziplin. Du folgst ihr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-12",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Durchhalten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-13",
      "text": "Dein Verstand testet dich jeden Morgen. Bestehe die Prüfung leise.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-14",
      "text": "Schmerz ist temporär. Aufgeben ist permanent. Wähle weise.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-15",
      "text": "Mentale Stärke zeigt sich nicht im Reden, sondern im Weitermachen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-16",
      "text": "Du bist nicht müde. Du bist unmotiviert. Das ist ein Unterschied.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-17",
      "text": "Wachstum fühlt sich nie bequem an. Genau deshalb ist es Wachstum.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-18",
      "text": "Dein größter Konkurrent schläft nicht - er ist du von gestern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-19",
      "text": "Stille Stärke schlägt lautes Gerede. Jedes Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-20",
      "text": "Du brauchst keine perfekte Stimmung. Du brauchst nur den ersten Schritt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-21",
      "text": "Disziplin fühlt sich nach Freiheit an, sobald die Ausrede verschwindet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-22",
      "text": "Wer sich selbst führt, braucht niemanden, der ihn antreibt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-23",
      "text": "Dein Kopf ist dein größter Verbündeter oder dein größter Feind. Du entscheidest.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-24",
      "text": "Mentale Stärke ist der Muskel, den niemand sieht, aber jeder spürt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-25",
      "text": "Du wächst nicht trotz der schweren Tage, sondern wegen ihnen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-26",
      "text": "Fokus ist die Fähigkeit, Nein zu fast allem zu sagen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-27",
      "text": "Dein zukünftiges Ich dankt dir für jede Entscheidung, die heute wehtut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-28",
      "text": "Aufgeben ist einfach. Deshalb tun es die meisten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-29",
      "text": "Du bist kein Opfer deiner Gedanken. Du bist ihr Architekt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-11-02-0",
      "text": "Disziplin schlägt Motivation, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-1",
      "text": "Du wirst nicht reich durch Zufall, sondern durch Wiederholung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-2",
      "text": "Ausreden sind die Raten für ein Leben, das du dir nicht wünschst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-3",
      "text": "Dein Konto wächst im Tempo, in dem du Ausreden abbaust.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-4",
      "text": "Produktivität beginnt da, wo dein Handy nicht mehr klingelt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-5",
      "text": "Wer immer erst morgen startet, bleibt für immer bei null.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-6",
      "text": "Komfort ist der leise Killer jeder großen Idee.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-7",
      "text": "Zeit ist das einzige Investment, das du nicht nachkaufen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-8",
      "text": "Niemand merkt deinen Fleiß, bis dein Ergebnis spricht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-9",
      "text": "Baue dein Business wie ein System, nicht wie ein Zufall.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-10",
      "text": "Jeder Tag ohne Fortschritt ist ein verkaufter Teil deiner Zukunft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-11",
      "text": "Erfolg ist das, was übrig bleibt, wenn du nicht aufgibst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-12",
      "text": "Deine Konkurrenz schläft nicht – also tu es auch seltener.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-13",
      "text": "Wachstum fühlt sich unbequem an, Stillstand fühlt sich sicher an.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-14",
      "text": "Reich wird, wer Probleme löst, bevor andere sie überhaupt sehen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-15",
      "text": "Dein Zeitplan ist dein Businessplan, egal was du behauptest.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-16",
      "text": "Mach aus deiner Idee ein Produkt, bevor es jemand anders tut.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-17",
      "text": "Fokus ist die neue Währung – gib sie nicht umsonst her.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-18",
      "text": "Wer alles liest, aber nichts umsetzt, bleibt beim Lesen stecken.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-19",
      "text": "Dein Umsatz ist nur die Quittung für deine Entscheidungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-20",
      "text": "Kleine Schritte täglich schlagen große Pläne, die nie starten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-21",
      "text": "Baue heute das, wofür du dich in fünf Jahren dankst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-22",
      "text": "Energie geht dahin, wo deine Aufmerksamkeit hinfließt – lenke sie bewusst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-23",
      "text": "Perfektion ist der Vorwand, den Start zu verschieben.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-24",
      "text": "Dein Netzwerk wächst nicht im Feed, sondern im echten Gespräch.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-25",
      "text": "Arbeite an deinem Business, nicht nur in ihm.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-26",
      "text": "Jede verkaufte Stunde Freizeit ist eine gekaufte Stunde Zukunft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-27",
      "text": "Risiko ist kalkulierbar, Stillstand ist tödlich für jede Idee.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-28",
      "text": "Wer Verantwortung übernimmt, übernimmt automatisch die Führung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-29",
      "text": "Dein größter Konkurrent ist die Version von dir, die aufgegeben hat.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-11-02-0",
      "text": "Disziplin ist der Unterschied zwischen deinen Zielen und deinen Ausreden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-1",
      "text": "Motivation hält einen Tag. Disziplin hält ein Leben lang durch.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-2",
      "text": "Du musst nicht wollen. Du musst einfach tun.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-3",
      "text": "Jeder Tag ohne Ausrede bringt dich näher an die Version, die du sein willst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-4",
      "text": "Comfort Zone und Erfolg haben noch nie denselben Raum geteilt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-5",
      "text": "Dein zukünftiges Ich zahlt den Preis für die Entscheidungen von heute.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-6",
      "text": "Konsequenz schlägt Talent, wenn Talent nicht konsequent ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-7",
      "text": "Die Routine, die du hasst, ist die Routine, die dich verändert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-8",
      "text": "Niemand sieht die Tage, an denen du trotzdem weitergemacht hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-9",
      "text": "Disziplin bedeutet, Entscheidungen zu treffen, bevor die Gefühle mitreden dürfen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-10",
      "text": "Du wirst nicht jeden Tag motiviert sein. Zeig trotzdem auf.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-11",
      "text": "Stärke entsteht nicht im Erfolg, sondern in den Wiederholungen davor.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-12",
      "text": "Wer aufhört, wenn es unangenehm wird, hört genau vor dem Durchbruch auf.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-13",
      "text": "Dein System entscheidet mehr über deinen Erfolg als dein Gefühl heute.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-14",
      "text": "Kleine Disziplin jeden Tag schlägt große Anstrengung einmal im Monat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-15",
      "text": "Die unsichtbaren Tage sind die, die später den sichtbaren Erfolg erklären.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-16",
      "text": "Du trainierst nicht nur deinen Körper, du trainierst deine Entscheidungsfähigkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-17",
      "text": "Wer Ausreden sammelt, sammelt keine Ergebnisse.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-18",
      "text": "Disziplin ist leise. Sie postet nicht, sie liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-19",
      "text": "Der Unterschied zwischen Wunsch und Realität heißt Wiederholung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-20",
      "text": "Du brauchst keine perfekte Stimmung, du brauchst nur den nächsten Schritt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-21",
      "text": "Durchhalten fühlt sich nie nach Fortschritt an, bis es plötzlich einer ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-22",
      "text": "Deine Grenzen verschieben sich genau dann, wenn du nicht aufgibst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-23",
      "text": "Konstanz ist langweilig, bevor sie beeindruckend wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-24",
      "text": "Was du heute vermeidest, holt dich morgen doppelt ein.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-25",
      "text": "Disziplin heißt, Verpflichtungen gegenüber dir selbst ernst zu nehmen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-26",
      "text": "Erfolg ist kein Zufall, er ist eine Wiederholung aus unbequemen Entscheidungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-27",
      "text": "Du musst nicht alles fühlen wollen, du musst es nur tun wollen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-28",
      "text": "Der Weg wird nicht leichter. Du wirst nur stärker im Durchhalten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-29",
      "text": "Wer täglich liefert, braucht später keine Ausreden mehr.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-11-02-0",
      "text": "Dein Körper ist kein Trend, er ist dein Werkzeug fürs Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-1",
      "text": "Energie tankst du nicht im Bett, sondern im Training.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-2",
      "text": "Wer sich bewegt, denkt klarer – wer stillsteht, stagniert.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-3",
      "text": "Müdigkeit lügt, dein Körper kann mehr als dein Kopf glaubt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-4",
      "text": "Kein Mindset der Welt rettet einen Körper ohne Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-5",
      "text": "Schwitzen ist die Quittung für ein ehrliches Training.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-6",
      "text": "Disziplin im Körper schafft Disziplin im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-7",
      "text": "Dein Workout heute ist die Energie von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-8",
      "text": "Stärke beginnt dort, wo die Ausrede aufhört.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-9",
      "text": "Jede Wiederholung baut mehr als nur Muskeln auf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-10",
      "text": "Bewegung ist der schnellste Weg aus einem schlechten Tag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-11",
      "text": "Du schuldest deinem Körper kein Mitleid, sondern Einsatz.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-12",
      "text": "Wer täglich trainiert, verhandelt nicht mehr mit sich selbst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-13",
      "text": "Energie ist kein Zufall, sie ist eine Entscheidung am Morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-14",
      "text": "Dein Puls ist der Beweis, dass du lebst – nutze ihn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-15",
      "text": "Kraft im Körper macht die Suche nach Klarheit überflüssig.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-16",
      "text": "Der Spiegel lügt nicht, nur deine Ausreden tun das.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-17",
      "text": "Wer sich täglich fordert, muss sich nie beweisen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-18",
      "text": "Bewegung ist die billigste Therapie, die du nie nutzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-19",
      "text": "Ein starker Körper trägt auch schwere Gedanken leichter.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-20",
      "text": "Trainiere, bevor dein Kopf Gründe findet, es nicht zu tun.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-21",
      "text": "Dein Körper merkt sich jede Ausrede – und jede Überwindung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-22",
      "text": "Fitness ist kein Ziel, sondern die Basis für alles andere.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-23",
      "text": "Wer beim Training aufgibt, gibt woanders leiser auf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-24",
      "text": "Schwache Energie kommt selten vom Körper, meist vom Stillstand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-25",
      "text": "Bewege dich, bevor die Gedanken dich lahmlegen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-26",
      "text": "Dein Körper ist das einzige Investment, das du nicht verkaufen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-27",
      "text": "Kraft zeigt sich nicht im Spiegel, sondern im Alltag danach.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-28",
      "text": "Wer heute schwitzt, muss morgen nicht zweifeln.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-29",
      "text": "Energie ist der Zins auf die Disziplin von gestern.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-11-02-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist die Energie, die dich dorthin bringt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-1",
      "text": "Du checkst dein Konto öfter als dein Leben. Dreh das um.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-2",
      "text": "Dankbarkeit ist der einzige Zins, der sofort ausgezahlt wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-3",
      "text": "Wer nie zufrieden ist, optimiert sich am Ende selbst weg.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-4",
      "text": "Erfolg ohne Dankbarkeit ist nur ein lauteres Leeregefühl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-5",
      "text": "Du vergleichst dein Level 3 mit fremdem Level 99. Hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-6",
      "text": "Heute ist der Tag, an dem du morgen dankbar zurückdenken wirst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-7",
      "text": "Zufriedenheit ist kein Stillstand, sie ist dein stabilster Antrieb.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-8",
      "text": "Dankbar sein heißt nicht aufhören zu wollen, sondern aufhören zu leiden.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-9",
      "text": "Dein jetziges Leben war mal dein größter Traum. Merk dir das.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-10",
      "text": "Wer nichts schätzt, verliert alles doppelt so schnell.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-11",
      "text": "Zufriedenheit ist die Steuerfreiheit der Gefühle.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-12",
      "text": "Du jagst dem Nächsten hinterher und übersiehst, was schon da ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-13",
      "text": "Dankbarkeit kostet nichts und zahlt sich trotzdem täglich aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-14",
      "text": "Mehr haben macht nicht zufrieden. Weniger wollen schon.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-15",
      "text": "Du bist schon weiter, als du dir selbst zugibst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-16",
      "text": "Zufriedenheit ist der stille Flex, den keiner auf Social Media sieht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-17",
      "text": "Wer dankbar lebt, verliert den Boden unter den Füßen nicht so schnell.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-18",
      "text": "Dein Standard von heute war der Traum von vor zwei Jahren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-19",
      "text": "Zufriedenheit schlägt Status. Immer. Nur merkt das kaum einer rechtzeitig.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-20",
      "text": "Du musst nicht alles erreichen, um heute schon genug zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-21",
      "text": "Dankbarkeit ist das Investment, das sich nie schlecht entwickelt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-22",
      "text": "Was du besitzt, besitzt irgendwann dich, wenn du es nie wertschätzt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-23",
      "text": "Zufriedene Menschen verhandeln nicht mit dem Universum, sie leben einfach.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-24",
      "text": "Du suchst Glück in der Zukunft und übersiehst es im Jetzt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-25",
      "text": "Dankbarkeit ist kein Gefühl für Verlierer, sondern ein Tool für Macher.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-26",
      "text": "Wer zufrieden startet, performt entspannter als wer getrieben rennt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-27",
      "text": "Dein Leben braucht kein Upgrade, nur mal einen bewussten Blick.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-28",
      "text": "Zufriedenheit heute macht dich ambitionierter für morgen, nicht fauler.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-29",
      "text": "Dankbarkeit ist die einzige Gewohnheit, die jedes System schlägt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    }
  ]
}