{
  "generatedAt": "2026-10-01",
  "quotes": [
    {
      "id": "gratitude-2026-10-01-0",
      "text": "Dankbarkeit ist der Zinseszins der Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-01"
    },
    {
      "id": "gratitude-2026-10-02-1",
      "text": "Wer heute dankbar ist, braucht morgen weniger.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-02"
    },
    {
      "id": "gratitude-2026-10-03-2",
      "text": "Zufriedenheit ist kein Ziel, sondern eine tägliche Entscheidung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-03"
    },
    {
      "id": "gratitude-2026-10-04-3",
      "text": "Du vergleichst dein Jetzt mit fremden Highlights. Hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-04"
    },
    {
      "id": "gratitude-2026-10-05-4",
      "text": "Dankbarkeit kostet nichts und bringt mehr als jede Gehaltserhöhung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-05"
    },
    {
      "id": "gratitude-2026-10-06-5",
      "text": "Wer nie genug hat, wird nie zufrieden sein, egal wie viel kommt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-06"
    },
    {
      "id": "gratitude-2026-10-07-6",
      "text": "Dein Leben ist der Entwurf, den andere sich wünschen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-07"
    },
    {
      "id": "gratitude-2026-10-08-7",
      "text": "Zufriedenheit ist der stille Gewinn, den niemand postet.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-08"
    },
    {
      "id": "gratitude-2026-10-09-8",
      "text": "Dankbarkeit ist das Fundament, auf dem echter Erfolg ruht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-09"
    },
    {
      "id": "gratitude-2026-10-10-9",
      "text": "Mehr haben wollen ist gut, weniger brauchen ist besser.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-10"
    },
    {
      "id": "gratitude-2026-10-11-10",
      "text": "Schreib auf, was läuft, bevor du dich beschwerst, was fehlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-11"
    },
    {
      "id": "gratitude-2026-10-12-11",
      "text": "Dankbarkeit macht aus genug ein Gefühl, nicht aus einer Zahl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-12"
    },
    {
      "id": "gratitude-2026-10-13-12",
      "text": "Du hast heute geatmet, gegessen, gelebt. Das ist schon ein Gewinn.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-13"
    },
    {
      "id": "gratitude-2026-10-14-13",
      "text": "Zufriedenheit ist der Zustand, den Ehrgeiz oft übersieht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-14"
    },
    {
      "id": "gratitude-2026-10-15-14",
      "text": "Dankbarkeit ist die billigste Form von Therapie.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-15"
    },
    {
      "id": "gratitude-2026-10-16-15",
      "text": "Wer dankbar lebt, verliert die Angst vor dem Verlieren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-16",
      "text": "Dein jetziges Leben war mal dein Wunschtraum vor drei Jahren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-17",
      "text": "Zufriedenheit heißt nicht stillstehen, sondern ohne Angst wachsen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-18",
      "text": "Dankbarkeit ist der Filter, der aus Alltag Bedeutung macht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-19",
      "text": "Du jagst dem Mehr hinterher und übersiehst das Genug.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-20",
      "text": "Dankbarkeit verändert nichts außer deinen Blick, und das reicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-21",
      "text": "Zufriedenheit ist kein Trostpreis, sondern die höchste Stufe.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-22",
      "text": "Was du besitzt, war für jemand anderen mal ein Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-23",
      "text": "Dankbarkeit ist Disziplin für den Kopf, nicht nur Gefühl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-24",
      "text": "Wer zufrieden ist, verhandelt nicht mehr mit der Vergangenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-25",
      "text": "Dankbarkeit macht aus Druck Perspektive.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-26",
      "text": "Du brauchst keinen Grund zur Freude, du musst nur hinsehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-27",
      "text": "Zufriedenheit ist der Moment, in dem Ehrgeiz kurz Pause macht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-28",
      "text": "Dankbarkeit ist die Quittung für ein Leben, das läuft.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-29",
      "text": "Wer dankbar startet, hat den Tag schon halb gewonnen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    }
  ]
}