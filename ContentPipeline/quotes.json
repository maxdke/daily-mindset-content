{
  "generatedAt": "2026-10-18",
  "quotes": [
    {
      "id": "mindset-2026-10-18-0",
      "text": "Disziplin ist der Zins, den du heute zahlst, damit die Zukunft dir gehört.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-1",
      "text": "Motivation ist ein Gast. Disziplin zieht bei dir ein.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-2",
      "text": "Dein Kopf lügt dir jeden Morgen etwas von Müdigkeit vor. Glaub ihm nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-3",
      "text": "Komfort ist der leiseste Weg in die Bedeutungslosigkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-4",
      "text": "Niemand rettet dich. Das ist die beste Nachricht, die du heute bekommst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-5",
      "text": "Dein Ego will recht haben. Dein Ziel will gewinnen. Entscheide dich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-6",
      "text": "Die Ausrede klingt heute gut. Morgen klingt sie peinlich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-7",
      "text": "Schwache Momente sind keine Charakterfehler, sie sind Entscheidungspunkte.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-8",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-9",
      "text": "Jeder Tag ohne Fortschritt ist eine stille Entscheidung gegen dich selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-10",
      "text": "Dein zukünftiges Ich zahlt für jede Ausrede, die du heute machst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-11",
      "text": "Stärke entsteht nicht im Erfolg, sondern in der Wiederholung nach dem Scheitern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-12",
      "text": "Hör auf, auf Motivation zu warten. Sie kommt nach der ersten Minute, nicht davor.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-13",
      "text": "Dein Verstand testet dich jeden Tag mit kleinen Fluchten. Besteh den Test.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-14",
      "text": "Wer bequem bleibt, bleibt unsichtbar.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-15",
      "text": "Die Stimme, die sagt morgen reicht auch, ist dein größter Gegner.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-16",
      "text": "Unbehagen ist der Eintrittspreis für Veränderung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-17",
      "text": "Du wirst nicht motiviert aufwachen. Du wirst diszipliniert aufstehen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-18",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht über deine Entscheidungen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-19",
      "text": "Dein Limit ist meistens nur eine Meinung, die du zu oft wiederholt hast.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-20",
      "text": "Niemand sieht die Wiederholungen. Alle sehen nur das Ergebnis.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-21",
      "text": "Schmerz, den du heute vermeidest, wartet morgen mit Zinsen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-22",
      "text": "Die beste Version von dir verlangt keine Ausnahmen, nur Konsequenz.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-23",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-24",
      "text": "Fokus schlägt Talent, wenn Talent sich nicht fokussiert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-25",
      "text": "Dein innerer Kritiker hat noch nie etwas gebaut. Hör trotzdem nicht ganz weg.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-26",
      "text": "Es gibt keinen perfekten Moment. Es gibt nur den nächsten Schritt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-27",
      "text": "Wer auf äußere Umstände wartet, wartet für immer.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-28",
      "text": "Harte Tage bauen die Version von dir, die leichte Tage nie formen könnten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-29",
      "text": "Deine Standards entscheiden über dein Leben, nicht deine Gefühle.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-10-18-0",
      "text": "Disziplin schlägt Motivation, jeden einzigen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-1",
      "text": "Dein Kontostand ist nur ein Spiegel deiner Gewohnheiten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-2",
      "text": "Wer um 6 Uhr plant, gewinnt, bevor andere aufwachen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-3",
      "text": "Ausreden sind die Währung der Erfolglosen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-4",
      "text": "Baue dein Business, als würde dir morgen gekündigt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-5",
      "text": "Produktivität ist kein Zufall, sondern ein System.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-6",
      "text": "Jede Stunde Ablenkung kostet dich eine Stunde Freiheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-7",
      "text": "Erfolg flüstert nicht, er wird gebaut, Ziegel für Ziegel.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-8",
      "text": "Dein Umfeld bestimmt dein Einkommen schneller als dein IQ.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-9",
      "text": "Wer Prioritäten setzt, braucht keine Ausreden mehr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-10",
      "text": "Komfortzonen zahlen keine Rechnungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-11",
      "text": "Zeit ist das einzige Kapital, das du nicht nachkaufen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-12",
      "text": "Plane dein Imperium, nicht nur deinen nächsten Urlaub.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-13",
      "text": "Wer auf Motivation wartet, verliert gegen den, der einfach startet.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-14",
      "text": "Dein Side Hustle von heute ist dein Hauptjob von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-15",
      "text": "Risiko ist der Preis, den Freiheit verlangt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-16",
      "text": "Erfolgreiche Menschen feiern Montage, nicht nur Freitage.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-17",
      "text": "Fokus ist die neue Währung der Reichen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-18",
      "text": "Wer nicht investiert, zahlt doppelt - in Zeit und Geld.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-19",
      "text": "Dein Zukunfts-Ich dankt dir für jede verpasste Ausrede heute.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-20",
      "text": "Kleine Schritte, konsequent wiederholt, bauen Imperien.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-21",
      "text": "Der Markt fragt nicht nach deiner Laune, sondern nach deiner Leistung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-22",
      "text": "Wer sein Ego parkt, bekommt irgendwann ein eigenes Büro.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-23",
      "text": "Gewinner optimieren Systeme, Verlierer suchen Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-24",
      "text": "Dein Netzwerk ist dein unsichtbares Gehalt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-25",
      "text": "Arbeite, als würde niemand applaudieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-26",
      "text": "Cashflow schlägt Prestige, jedes Mal.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-27",
      "text": "Jeder Rückschlag ist eine Rechnung, die sich später auszahlt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-28",
      "text": "Wer nur Trends folgt, baut kein Fundament.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-29",
      "text": "Dein Kalender zeigt, wer du wirklich bist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-10-18-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-1",
      "text": "Motivation läuft dir weg. Disziplin bleibt sitzen und macht den Job.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-2",
      "text": "Du musst dich nicht gut fühlen, um anzufangen. Du fühlst dich gut, weil du angefangen hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-3",
      "text": "Jeder Tag, den du durchziehst, ist ein Investment, das sich keiner sieht – außer du selbst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-4",
      "text": "Konsistenz schlägt Intensität. Immer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-5",
      "text": "Die Ausrede von heute ist der Stillstand von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-6",
      "text": "Du trainierst nicht deinen Körper. Du trainierst deine Fähigkeit, Unlust zu ignorieren.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-7",
      "text": "Wer auf Stimmung wartet, wartet sein Leben lang.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-8",
      "text": "Disziplin ist leise. Sie postet nichts, sie liefert einfach.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-9",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-10",
      "text": "Jede unbequeme Entscheidung heute ist ein Vorsprung, den morgen keiner mehr aufholt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-11",
      "text": "Erfolg ist, was passiert, wenn du trotzdem machst – nicht wenn du Lust hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-12",
      "text": "Comfort Zone ist kein Ort. Es ist ein Preis, den du täglich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-13",
      "text": "Du willst Ergebnisse wie die anderen 1%? Dann mach, was die anderen 99% nicht machen wollen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-14",
      "text": "Null Motivation ist kein Grund. Es ist eine Entschuldigung mit gutem Marketing.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-15",
      "text": "Disziplin fühlt sich erst wie Zwang an, dann wie Freiheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-16",
      "text": "Du verhandelst nicht mit dir selbst. Du führst aus.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-17",
      "text": "Wiederholung schlägt Talent. Jedes Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-18",
      "text": "Dein zukünftiges Ich schuldet dir nichts, wenn du heute aufgibst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-19",
      "text": "Der Unterschied zwischen Träumen und Zielen ist ein Wecker, der tatsächlich klingelt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-20",
      "text": "Du brauchst keinen guten Tag, um weiterzumachen. Du brauchst nur einen Plan.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-21",
      "text": "Stillstand fühlt sich sicher an. Genau deshalb ist er so gefährlich.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-22",
      "text": "Disziplin ist der stille Deal, den du jeden Morgen mit dir selbst abschließt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-23",
      "text": "Du hast keine Zeit verloren. Du hast nur noch keine Entscheidung getroffen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-24",
      "text": "Was andere Glück nennen, nennst du Routine.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-25",
      "text": "Es gibt keinen perfekten Moment. Es gibt nur den nächsten Schritt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-26",
      "text": "Du bist nicht dort, wo du sein willst, weil du dort bleibst, wo es bequem ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-27",
      "text": "Harte Tage bauen das Ich, das die leichten Tage genießt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-28",
      "text": "Disziplin heißt, Versprechen an dich selbst ernster zu nehmen als Ausreden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-29",
      "text": "Du musst nicht schnell sein. Du musst nur aufhören, aufzuhören.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-10-18-0",
      "text": "Dein Körper ist dein teuerster Besitz – pfleg ihn wie ein Investment.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-1",
      "text": "Energie ist die einzige Währung, die du jeden Morgen neu bekommst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-2",
      "text": "Wer seinen Körper vernachlässigt, verliert im Kopf zuerst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-3",
      "text": "Training ist keine Zeitverschwendung, sondern Zinseszins in dich selbst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-4",
      "text": "Schwache Energie, schwache Entscheidungen – trainier beides.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-5",
      "text": "Dein Puls heute bestimmt deine Klarheit morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-6",
      "text": "Muskeln baust du im Gym, Disziplin baust du überall.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-7",
      "text": "Bewegung ist der billigste Kaffee, den es gibt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-8",
      "text": "Wer sich körperlich fordert, lügt sich mental nichts mehr vor.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-9",
      "text": "Ein starker Körper verhandelt nicht mit Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-10",
      "text": "Schwitzen heute, Klarheit morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-11",
      "text": "Dein Energielevel ist dein wahres Startkapital.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-12",
      "text": "Fitness ist kein Hobby, es ist Infrastruktur für dein Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-13",
      "text": "Wer seinen Körper trainiert, zieht seine Grenzen neu.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-14",
      "text": "Bewegung ist das günstigste Antidepressivum mit Nebenwirkung Erfolg.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-15",
      "text": "Dein Körper merkt sich jede Ausrede, die du ihm gibst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-16",
      "text": "Kraft im Körper ist Ruhe im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-17",
      "text": "Ein trainierter Körper denkt schneller als ein müder Geist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-18",
      "text": "Jede Wiederholung im Training ist eine Übung in Durchhaltevermögen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-19",
      "text": "Wer müde bleibt, bleibt klein.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-20",
      "text": "Dein Energielevel entscheidet, wie groß dein Tag wird.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-21",
      "text": "Fitness ist der Zinseszins für dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-22",
      "text": "Ausdauer im Sport ist Ausdauer im Leben, nur ehrlicher.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-23",
      "text": "Dein Körper ist das einzige Büro, das du nie kündigen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-24",
      "text": "Bewege dich, bevor dein Kopf anfängt zu verhandeln.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-25",
      "text": "Stärke ist kein Zufall, sie ist ein tägliches Investment.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-26",
      "text": "Wer seinen Körper fordert, fordert auch sein Mindset heraus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-27",
      "text": "Energie tankst du nicht, du erzeugst sie durch Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-28",
      "text": "Dein Puls ist der ehrlichste Indikator für deinen Fortschritt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-29",
      "text": "Disziplin im Training ist Disziplin im Denken.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-10-18-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist der Boden, auf dem du wächst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-1",
      "text": "Dankbarkeit ist der Zinseszins der Seele.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-2",
      "text": "Wer heute dankbar ist, verschwendet morgen keine Energie an Neid.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-3",
      "text": "Zufrieden sein heißt nicht aufhören, es heißt klarer weitermachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-4",
      "text": "Du checkst dein Konto täglich, checke auch mal dein Glück.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-5",
      "text": "Dankbarkeit kostet nichts und zahlt sich trotzdem aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-6",
      "text": "Wer das Jetzt wertschätzt, verpasst das Morgen nicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-7",
      "text": "Zufriedenheit ist kein Stillstand, sie ist dein stabiler Startpunkt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-8",
      "text": "Dankbar sein ist die günstigste Form von Therapie.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-9",
      "text": "Du musst nicht alles haben, um alles zu schätzen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-10",
      "text": "Wer dankbar lebt, braucht keine Bestätigung von außen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-11",
      "text": "Zufriedenheit ist der einzige Gewinn, den dir keiner wegnehmen kann.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-12",
      "text": "Dankbarkeit ist Haltung, kein Zufallsgefühl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-13",
      "text": "Du vergleichst dein Leben mit Highlights anderer, vergiss das.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-14",
      "text": "Zufrieden sein heißt, deinen eigenen Fortschritt zu respektieren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-15",
      "text": "Dankbarkeit macht aus genug ein Gefühl, nicht aus mehr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-16",
      "text": "Wer das Kleine schätzt, verpasst das Große nicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-17",
      "text": "Zufriedenheit ist dein Ruhepuls für Entscheidungen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-18",
      "text": "Dankbar sein heißt, dein Leben nicht auf später zu verschieben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-19",
      "text": "Du brauchst keinen Grund zur Freude, du brauchst nur den Blick dafür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-20",
      "text": "Zufriedenheit ist die Basis, von der aus Erfolg leichter wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-21",
      "text": "Dankbarkeit ist der stille Antrieb hinter echtem Selbstvertrauen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-22",
      "text": "Wer dankbar startet, startet nie leer.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-23",
      "text": "Zufrieden sein heißt nicht verzichten, es heißt bewusst wählen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-24",
      "text": "Dankbarkeit ist der Unterschied zwischen Haben und Fühlen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-25",
      "text": "Du jagst dem Mehr hinterher und übersiehst das Genug.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-26",
      "text": "Zufriedenheit ist dein Fundament, nicht dein Endziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-27",
      "text": "Dankbar sein heißt, mit dem arbeiten, was du hast, nicht was fehlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-28",
      "text": "Wer sein Leben wertschätzt, verschwendet keine Zeit mit Jammern.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-29",
      "text": "Zufriedenheit ist leise, aber sie trägt am weitesten.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    }
  ]
}