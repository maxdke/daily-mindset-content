{
  "generatedAt": "2026-10-10",
  "quotes": [
    {
      "id": "mindset-2026-10-10-0",
      "text": "Disziplin ist der Zins, den du heute zahlst, damit dein zukünftiges Ich reich wird.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-10"
    },
    {
      "id": "mindset-2026-10-11-1",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-11"
    },
    {
      "id": "mindset-2026-10-12-2",
      "text": "Dein Kopf glaubt jede Ausrede, die er selbst erfindet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-12"
    },
    {
      "id": "mindset-2026-10-13-3",
      "text": "Schwache Momente sind normal. Schwache Entscheidungen sind optional.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-13"
    },
    {
      "id": "mindset-2026-10-14-4",
      "text": "Comfort Zones haben keine Fenster. Du siehst nie, was draußen wartet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-14"
    },
    {
      "id": "mindset-2026-10-15-5",
      "text": "Dein Ego will recht haben. Dein Ziel will Fortschritt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-15"
    },
    {
      "id": "mindset-2026-10-16-6",
      "text": "Niemand sieht die 5-Uhr-Alarme. Alle sehen nur das Ergebnis.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-16"
    },
    {
      "id": "mindset-2026-10-17-7",
      "text": "Zweifel sind laut, aber sie haben nie das letzte Wort.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-8",
      "text": "Du wirst nicht durch Zufall stark. Du trainierst es wie einen Muskel.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-9",
      "text": "Dein Mindset ist der einzige Rohstoff, der nie ausgeht, wenn du ihn pflegst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-10",
      "text": "Stillstand fühlt sich sicher an und kostet dich trotzdem alles.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-11",
      "text": "Die beste Version von dir wartet nicht auf Montag.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-12",
      "text": "Ausreden sind gut formulierte Lügen an dich selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-13",
      "text": "Mentale Stärke zeigt sich nicht im Sieg, sondern im nächsten Versuch danach.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-14",
      "text": "Dein Kopf ist dein größter Investor oder dein größter Saboteur.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-15",
      "text": "Wer ständig auf Motivation wartet, verpasst sein eigenes Potenzial.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-16",
      "text": "Schmerz ist temporär. Aufgeben fühlt sich am Ende schlimmer an.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-17",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-18",
      "text": "Dein innerer Kritiker hat keine Ahnung, wozu du fähig bist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-19",
      "text": "Harte Tage bauen die Version von dir, die harte Tage nicht mehr fürchtet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-20",
      "text": "Perfektion ist die teuerste Ausrede, die du dir leisten kannst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-21",
      "text": "Du bist nicht müde. Du bist unterfordert von deinem eigenen Potenzial.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-22",
      "text": "Fokus schlägt Talent, wenn Talent keinen Fokus hat.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-23",
      "text": "Dein Verstand testet dich nur, um zu sehen, wie ernst du es meinst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-24",
      "text": "Wachstum fühlt sich unangenehm an, bevor es sich gut anfühlt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-25",
      "text": "Die Stimme, die sagt hör auf, ist nie die Stimme, die dich weiterbringt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-26",
      "text": "Du verlierst nicht gegen andere. Du verlierst gegen deinen inneren Autopiloten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-27",
      "text": "Konsequenz ist lauter als jedes Talent, das du je hattest.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-28",
      "text": "Dein zukünftiges Ich zahlt heute schon die Rechnung für deine Bequemlichkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-29",
      "text": "Mentale Stärke ist kein Gefühl. Es ist eine Entscheidung, die du wiederholst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-10-10-0",
      "text": "Disziplin schlägt Motivation, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-10"
    },
    {
      "id": "business-2026-10-11-1",
      "text": "Deine Zukunft wird heute gebaut, nicht morgen geplant.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-11"
    },
    {
      "id": "business-2026-10-12-2",
      "text": "Wer aufschiebt, verkauft seine Zeit unter Wert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-12"
    },
    {
      "id": "business-2026-10-13-3",
      "text": "Ausreden sind die Währung der Erfolglosen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-13"
    },
    {
      "id": "business-2026-10-14-4",
      "text": "Baue dein Business wie ein Fundament, nicht wie ein Strohhaus.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-14"
    },
    {
      "id": "business-2026-10-15-5",
      "text": "Comfort Zone ist der teuerste Ort, an dem du wohnen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-15"
    },
    {
      "id": "business-2026-10-16-6",
      "text": "Deadlines sind Versprechen an dein zukünftiges Ich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-16"
    },
    {
      "id": "business-2026-10-17-7",
      "text": "Erfolg ist kein Zufall, sondern ein Kalendereintrag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-8",
      "text": "Wer nicht skaliert, stagniert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-9",
      "text": "Dein Netzwerk ist dein Nettoumsatz von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-10",
      "text": "Zeit ist das einzige Kapital, das du nicht nachkaufen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-11",
      "text": "Fokus ist die neue Währung der Macher.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-12",
      "text": "Kleine Schritte, konsequent wiederholt, bauen Imperien.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-13",
      "text": "Wer um sechs Uhr plant, führt um zehn Uhr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-14",
      "text": "Dein Investor Nummer eins bist du selbst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-15",
      "text": "Produktivität ist kein Zufall, sondern ein System.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-16",
      "text": "Risiko ist der Preis für Wachstum.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-17",
      "text": "Wer wartet, bis es sich richtig anfühlt, wartet ewig.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-18",
      "text": "Jede Rechnung, die du bezahlst, ist ein Beweis deiner Arbeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-19",
      "text": "Dein Output heute entscheidet über deinen Impact morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-20",
      "text": "Konsequenz schlägt Talent, jedes Mal.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-21",
      "text": "Baue Systeme, nicht nur Ziele.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-22",
      "text": "Wer Prioritäten setzt, braucht keine Motivation.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-23",
      "text": "Dein Kalender zeigt, was dir wirklich wichtig ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-24",
      "text": "Gewinner optimieren Prozesse, Verlierer suchen Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-25",
      "text": "Cashflow ist König, aber Fokus ist der Thron.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-26",
      "text": "Wer nicht investiert, konsumiert sein Potenzial.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-27",
      "text": "Dein Mindset ist dein erstes Startup.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-28",
      "text": "Erfolgreiche Menschen managen Energie, nicht nur Zeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-29",
      "text": "Jeder Tag ohne Fortschritt ist verschwendetes Kapital.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-10-10-0",
      "text": "Disziplin ist der Unterschied zwischen dem, der du bist, und dem, der du sein könntest.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-10"
    },
    {
      "id": "discipline-2026-10-11-1",
      "text": "Motivation lädt dich auf, Disziplin hält dich am Laufen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-11"
    },
    {
      "id": "discipline-2026-10-12-2",
      "text": "Du brauchst keine Lust, du brauchst ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-12"
    },
    {
      "id": "discipline-2026-10-13-3",
      "text": "Durchhalten schlägt Talent, wenn Talent nicht durchhält.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-13"
    },
    {
      "id": "discipline-2026-10-14-4",
      "text": "Jeden Tag ein Prozent – das ist der ganze Trick.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-14"
    },
    {
      "id": "discipline-2026-10-15-5",
      "text": "Disziplin fühlt sich erst gut an, wenn du aufhörst, sie zu hinterfragen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-15"
    },
    {
      "id": "discipline-2026-10-16-6",
      "text": "Konsequenz schlägt Intensität – jedes Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-16"
    },
    {
      "id": "discipline-2026-10-17-7",
      "text": "Niemand sieht die Wiederholung, alle sehen nur das Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-8",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-9",
      "text": "Disziplin ist die Sprache, die dein Ziel versteht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-10",
      "text": "Du musst nicht motiviert sein, du musst nur anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-11",
      "text": "Gewohnheiten bauen das Leben, das Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-12",
      "text": "Wer aufgibt, wenn es schwer wird, hat es nie wirklich gewollt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-13",
      "text": "Disziplin ist leise – sie schreit nicht, sie liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-14",
      "text": "Der Unterschied zwischen Traum und Ziel ist ein Datum und tägliche Arbeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-15",
      "text": "Du verlierst nicht, wenn du scheiterst – du verlierst, wenn du aufhörst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-16",
      "text": "Komfort ist der teuerste Preis, den du zahlen kannst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-17",
      "text": "Disziplin ist Freiheit in Verkleidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-18",
      "text": "Dein Plan funktioniert nur an den Tagen, an denen du keine Lust hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-19",
      "text": "Konstanz ist unsexy – genau deshalb funktioniert sie.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-20",
      "text": "Du trainierst nicht für heute, du trainierst für den Tag, an dem es zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-21",
      "text": "Disziplin ist die Entscheidung, die du triffst, bevor du gefragt wirst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-22",
      "text": "Wer wartet, bis es sich richtig anfühlt, wartet für immer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-23",
      "text": "Durchhalten ist unspektakulär – bis es das Ergebnis ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-24",
      "text": "Dein Komfortbereich bezahlt keine Rechnungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-25",
      "text": "Disziplin bedeutet, dein Ziel wichtiger zu nehmen als deine Laune.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-26",
      "text": "Du wirst nicht jeden Tag gewinnen wollen – gewinne trotzdem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-27",
      "text": "Der Tag, an dem du aufhören willst, ist der Tag, der zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-28",
      "text": "Disziplin ist der Zinseszins der Gewohnheiten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-29",
      "text": "Wer durchhält, wenn niemand zuschaut, gewinnt, wenn alle zuschauen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-10-10-0",
      "text": "Dein Körper ist die Firma, in die du jeden Morgen investierst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-10"
    },
    {
      "id": "fitness-2026-10-11-1",
      "text": "Energie ist kein Zufall. Sie ist eine Entscheidung vor dem Frühstück.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-11"
    },
    {
      "id": "fitness-2026-10-12-2",
      "text": "Wer seinen Puls kontrolliert, kontrolliert seinen Tag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-12"
    },
    {
      "id": "fitness-2026-10-13-3",
      "text": "Müdigkeit lügt öfter als dein Wecker.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-13"
    },
    {
      "id": "fitness-2026-10-14-4",
      "text": "Bewegung ist der Zinseszins deiner Gesundheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-14"
    },
    {
      "id": "fitness-2026-10-15-5",
      "text": "Ein starker Körper verhandelt nicht mit Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-15"
    },
    {
      "id": "fitness-2026-10-16-6",
      "text": "Schwitzen heute, Klarheit morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-16"
    },
    {
      "id": "fitness-2026-10-17-7",
      "text": "Dein Workout beginnt da, wo deine Motivation aufhört.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-8",
      "text": "Disziplin im Training ist Freiheit im Alltag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-9",
      "text": "Du trainierst nicht für den Sommer. Du trainierst für dein Gehirn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-10",
      "text": "Jede Wiederholung ist eine Rechnung, die sich später auszahlt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-11",
      "text": "Kraft baust du nicht im Spiegel auf, sondern im Widerstand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-12",
      "text": "Ein Tag ohne Bewegung ist ein Tag auf Pump.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-13",
      "text": "Dein Energielevel ist das Budget für deine Produktivität.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-14",
      "text": "Schlechter Schlaf ist ein stiller Dieb deiner Leistung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-15",
      "text": "Wer sich körperlich fordert, denkt mental klarer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-16",
      "text": "Der Körper merkt sich jede verpasste Chance zur Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-17",
      "text": "Ausdauer im Training ist Übung für Ausdauer im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-18",
      "text": "Du bist nicht müde. Du bist unbewegt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-19",
      "text": "Dein Puls ist dein ehrlichster Berater.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-20",
      "text": "Stärke ist die Zinsrate, die du auf Schweiß bekommst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-21",
      "text": "Wer aufgibt beim Training, übt das Aufgeben fürs Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-22",
      "text": "Ein wacher Kopf beginnt mit einem bewegten Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-23",
      "text": "Dein Körper ist dein erstes Werkzeug. Halt es scharf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-24",
      "text": "Fitness ist kein Ziel. Es ist dein operatives System.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-25",
      "text": "Schmerz im Training ist nur Feedback, keine Bremse.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-26",
      "text": "Wer still sitzt, verliert leise an Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-27",
      "text": "Dein Herzschlag heute entscheidet über dein Tempo morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-28",
      "text": "Bewegung ist das günstigste Antidepressivum, das du besitzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-29",
      "text": "Du schuldest deinem Körper keine Ausrede, sondern Taten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-10-10-0",
      "text": "Dankbarkeit ist der einzige Zinssatz, der garantiert steigt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-10"
    },
    {
      "id": "gratitude-2026-10-11-1",
      "text": "Wer zufrieden mit wenig ist, verhandelt nie aus einer schwachen Position.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-11"
    },
    {
      "id": "gratitude-2026-10-12-2",
      "text": "Erfolg ohne Dankbarkeit ist nur lauter Lärm ohne Substanz.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-12"
    },
    {
      "id": "gratitude-2026-10-13-3",
      "text": "Check dein Konto täglich - check auch, was du schon hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-13"
    },
    {
      "id": "gratitude-2026-10-14-4",
      "text": "Zufriedenheit ist eine Entscheidung, kein Ziel am Ende des Weges.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-14"
    },
    {
      "id": "gratitude-2026-10-15-5",
      "text": "Dankbarkeit kostet nichts und zahlt trotzdem die höchste Rendite.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-15"
    },
    {
      "id": "gratitude-2026-10-16-6",
      "text": "Wer nie ankommt, vergisst zu leben, während er losläuft.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-7",
      "text": "Dein Kontostand bestimmt deine Zufriedenheit nur, wenn du es zulässt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-8",
      "text": "Zufrieden sein heißt nicht aufhören zu wachsen - es heißt ohne Angst zu wachsen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-9",
      "text": "Du vergleichst dein Jetzt mit fremden Highlights - hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-10",
      "text": "Mehr wollen und dankbar sein schließen sich nicht aus, sie bedingen sich.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-11",
      "text": "Wer das Wenige nicht schätzt, wird auch das Viele nicht schätzen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-12",
      "text": "Dankbarkeit ist der Soundtrack, zu dem sich Erfolg richtig anfühlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-13",
      "text": "Zufriedenheit erarbeitest du dir, du wartest nicht darauf.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-14",
      "text": "Ein Tag ohne Dankbarkeit fühlt sich doppelt so anstrengend an.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-15",
      "text": "Schau zurück, bevor du wieder nach vorne rennst - du bist weiter, als du denkst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-16",
      "text": "Dankbarkeit macht aus genug ein Fest und aus wenig eine Fülle.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-17",
      "text": "Zufriedenheit ist der Atemzug zwischen zwei Zielen, nicht das Ende des Weges.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-18",
      "text": "Wer das Jetzt nicht schätzt, wird auch das Später nicht schätzen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-19",
      "text": "Dankbarkeit ist das stille Kapital, das jeder spürt, aber niemand sieht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-20",
      "text": "Du musst nicht fertig sein, um stolz auf das zu sein, was schon steht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-21",
      "text": "Zufriedenheit und Ehrgeiz sind kein Widerspruch, sie sind ein gutes Team.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-22",
      "text": "Dankbarkeit ist der Rabatt, den dir niemand gewährt außer du selbst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-23",
      "text": "Wer dankbar lebt, verliert nie - er lernt nur manchmal langsamer.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-24",
      "text": "Dein größter Vorteil: zufrieden mit dem sein, was du schon aufgebaut hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-25",
      "text": "Dankbarkeit verwandelt Druck in Antrieb.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-26",
      "text": "Zufriedenheit heißt, aufzuhören, dem hinterherzujagen, was du längst bist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-27",
      "text": "Was du heute hast, wolltest du letztes Jahr noch unbedingt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-28",
      "text": "Dankbarkeit ist die Pause, die dich am Ende schneller macht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-29",
      "text": "Zufriedenheit ist nicht das Gegenteil von Ehrgeiz - sie ist sein Fundament.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    }
  ]
}