{
  "generatedAt": "2026-10-15",
  "quotes": [
    {
      "id": "mindset-2026-10-15-0",
      "text": "Disziplin ist der Zinseszins deiner Entscheidungen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-15"
    },
    {
      "id": "mindset-2026-10-16-1",
      "text": "Dein Kopf glaubt jede Ausrede, die du ihm oft genug erzählst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-16"
    },
    {
      "id": "mindset-2026-10-17-2",
      "text": "Motivation ist ein Gast, Disziplin wohnt bei dir.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-3",
      "text": "Du wirst nicht durch gute Tage stark, sondern durch die, an denen du trotzdem lieferst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-4",
      "text": "Komfort ist der Zins, den du für Stillstand zahlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-5",
      "text": "Dein größter Konkurrent schläft gerade nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-6",
      "text": "Wer auf Gefühle wartet, wartet sein Leben lang.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-7",
      "text": "Stärke zeigt sich nicht im Reden, sondern im Durchziehen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-8",
      "text": "Deine Ausreden klingen gut, bringen dich aber nirgendwo hin.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-9",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Durchhalten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-10",
      "text": "Schwache Gedanken bauen keine starken Leben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-11",
      "text": "Du bist nicht müde, du bist unmotiviert – finde den Grund.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-12",
      "text": "Jede Grenze, die du akzeptierst, wird zu deiner Realität.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-13",
      "text": "Mentale Stärke beginnt dort, wo Bequemlichkeit aufhört.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-14",
      "text": "Dein Verstand testet dich jeden Tag – bestehe die Prüfung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-15",
      "text": "Wer sich selbst führt, braucht keine Motivation von außen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-16",
      "text": "Druck formt Diamanten und Disziplin formt Menschen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-17",
      "text": "Du verlierst nicht, wenn du scheiterst, sondern wenn du aufhörst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-18",
      "text": "Dein innerer Dialog entscheidet, wie weit du kommst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-19",
      "text": "Stillstand fühlt sich sicher an, kostet aber am meisten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-20",
      "text": "Niemand rettet dich – das ist deine größte Freiheit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-21",
      "text": "Klarheit entsteht durch Handeln, nicht durch Nachdenken.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-22",
      "text": "Dein Limit ist meistens nur eine Gewohnheit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-23",
      "text": "Wer ständig wartet, wartet am Ende auf sich selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-24",
      "text": "Starke Menschen fühlen auch Zweifel – sie ignorieren sie nur lauter.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-25",
      "text": "Deine Zukunft hört nicht zu, wenn du jammerst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-26",
      "text": "Jeden Tag entscheidest du neu, wer du wirklich bist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-27",
      "text": "Schmerz ist temporär, Aufgeben ist permanent.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-28",
      "text": "Dein Kopf ist dein größtes Werkzeug oder dein größtes Hindernis.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-29",
      "text": "Konsequenz schlägt Talent, jedes einzelne Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-10-15-0",
      "text": "Disziplin ist der Zinseszins der Produktivität.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-15"
    },
    {
      "id": "business-2026-10-16-1",
      "text": "Deine Ausreden haben einen höheren Marktwert als dein Business-Plan.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-16"
    },
    {
      "id": "business-2026-10-17-2",
      "text": "Wer auf Motivation wartet, verkauft seine Zeit an den Zufall.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-3",
      "text": "Erfolg ist kein Launch-Event, sondern ein stilles tägliches Update.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-4",
      "text": "Dein Kalender ist dein ehrlichster Investor-Pitch.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-5",
      "text": "Komfortzonen zahlen keine Dividende.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-6",
      "text": "Du skalierst nicht dein Business, du skalierst deine Entscheidungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-7",
      "text": "Arbeite wie ein Startup, denke wie ein Konzern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-8",
      "text": "Zeit ist die einzige Aktie, die du nicht nachkaufen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-9",
      "text": "Produktivität ohne Richtung ist nur teurer Leerlauf.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-10",
      "text": "Jede ungenutzte Stunde ist ein Investment, das du storniert hast.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-11",
      "text": "Dein Side-Hustle merkt, wenn du nur halb da bist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-12",
      "text": "Wachstum fühlt sich meistens wie Unbequemlichkeit mit Potenzial an.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-13",
      "text": "Strategien scheitern selten, Umsetzung schon.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-14",
      "text": "Du brauchst keinen Masterplan, du brauchst den nächsten Schritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-15",
      "text": "Fokus ist das einzige Asset, das niemand kopieren kann.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-16",
      "text": "Dein Netzwerk ist dein Net Worth, aber nur mit Substanz dahinter.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-17",
      "text": "Perfektion ist der teuerste Weg, nichts zu liefern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-18",
      "text": "Jeder Tag ohne Fortschritt ist ein verpasster Compound-Effekt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-19",
      "text": "Baue dein Geschäft wie dein Depot: diversifiziert, aber fokussiert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-20",
      "text": "Zweifel ist teuer, Handeln ist günstig.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-21",
      "text": "Du verlierst nicht an der Konkurrenz, du verlierst an deiner Trägheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-22",
      "text": "Konsequenz schlägt Talent an jedem einzelnen Werktag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-23",
      "text": "Dein Zukunfts-Ich bezahlt die Rechnung für deine heutige Faulheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-24",
      "text": "Kleine Systeme schlagen große Ziele ohne Plan.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-25",
      "text": "Risiko ist kalkulierbar, Stillstand ist garantiert tödlich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-26",
      "text": "Wer jeden Tag ein Prozent liefert, besitzt bald den Markt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-27",
      "text": "Dein Mindset ist der Rohstoff, aus dem dein Umsatz entsteht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-28",
      "text": "Du musst nicht motiviert sein, du musst nur angefangen haben.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-29",
      "text": "Erfolg ist, was passiert, wenn niemand applaudiert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-10-15-0",
      "text": "Disziplin ist der Unterschied zwischen dem, was du willst, und dem, was du jetzt tust.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-15"
    },
    {
      "id": "discipline-2026-10-16-1",
      "text": "Motivation ist Zufall, Disziplin ist Plan.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-16"
    },
    {
      "id": "discipline-2026-10-17-2",
      "text": "Du musst nicht wollen – du musst machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-3",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-4",
      "text": "Disziplin ist leise. Sie postet nicht, sie liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-5",
      "text": "Jeden Tag, an dem du durchhältst, wird aufgeben unwahrscheinlicher.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-6",
      "text": "Gewohnheit schlägt Gefühl – jedes Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-7",
      "text": "Der Unterschied zwischen Träumern und Machern ist der Montagmorgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-8",
      "text": "Disziplin ist der Zins, den du auf deine Ziele zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-9",
      "text": "Wer aufhört, wenn's schwer wird, hat nie verstanden, wofür er angefangen hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-10",
      "text": "Konsistenz ist unsexy – aber sie gewinnt immer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-11",
      "text": "Dein Durchhaltevermögen entscheidet, nicht dein Talent.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-12",
      "text": "Disziplin fühlt sich nie gut an – bis sie sich auszahlt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-13",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-14",
      "text": "Niemand sieht die Tage, an denen du trotzdem weitergemacht hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-15",
      "text": "Erfolg ist das, was übrig bleibt, wenn die Ausreden aufgebraucht sind.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-16",
      "text": "Disziplin ist Selbstliebe in ihrer unbequemsten Form.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-17",
      "text": "Du brauchst keine Inspiration. Du brauchst einen Plan und Sturheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-18",
      "text": "Die Wiederholung ist langweilig. Das Ergebnis nicht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-19",
      "text": "Wer immer erst Lust haben will, wartet sein Leben lang.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-20",
      "text": "Disziplin ist der Preis, Reue ist die Rechnung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-21",
      "text": "Durchhalten heißt: weitermachen, obwohl niemand zuschaut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-22",
      "text": "Dein Comfort Zone ist der teuerste Ort, an dem du wohnen kannst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-23",
      "text": "Jeden Tag ein bisschen – das ist der ganze Trick.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-24",
      "text": "Disziplin bedeutet, dein älteres Ich nicht zu enttäuschen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-25",
      "text": "Es gibt keinen Tag, an dem Disziplin sich leicht anfühlt. Nur Tage, an denen du sie trotzdem wählst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-26",
      "text": "Du scheiterst nicht am Ziel. Du scheiterst am Dienstag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-27",
      "text": "Was heute schwer ist, macht dich morgen unaufhaltsam.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-28",
      "text": "Disziplin ist die Fähigkeit, dein zukünftiges Ich wichtiger zu nehmen als dein jetziges Gefühl.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-29",
      "text": "Halte durch, wenn's niemand sieht – dann gewinnst du, wenn's jeder sieht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-10-15-0",
      "text": "Energie ist eine Entscheidung, keine Stimmung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-15"
    },
    {
      "id": "fitness-2026-10-16-1",
      "text": "Dein Körper ist der einzige Ort, in dem du für immer wohnst – renovier ihn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-16"
    },
    {
      "id": "fitness-2026-10-17-2",
      "text": "Disziplin im Training ist Disziplin im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-3",
      "text": "Jedes Workout ist eine Einzahlung auf dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-4",
      "text": "Müdigkeit lügt, Bewegung sagt die Wahrheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-5",
      "text": "Dein Puls entscheidet, wie wach dein Kopf heute ist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-6",
      "text": "Wer seinen Körper trainiert, trainiert seine Willenskraft gratis mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-7",
      "text": "Bewegung ist der billigste Kaffee, den es gibt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-8",
      "text": "Dein Körper merkt sich jede Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-9",
      "text": "Stärke baut man nicht im Kopf, sondern im Widerstand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-10",
      "text": "Jedes Rep zählt doppelt: einmal für den Körper, einmal für den Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-11",
      "text": "Dein Limit von gestern ist dein Warm-up von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-12",
      "text": "Wer früh schwitzt, denkt später klarer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-13",
      "text": "Dein Körper ist dein teuerstes Investment – pfleg es wie Kapital.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-14",
      "text": "Bewegung schlägt jede Ausrede im direkten Vergleich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-15",
      "text": "Kraft kommt nicht von Motivation, sondern von Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-16",
      "text": "Ein starker Körper verhandelt nicht mit Faulheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-17",
      "text": "Dein Energielevel ist kein Zufall, sondern eine Statistik deiner Gewohnheiten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-18",
      "text": "Wer sich bewegt, bewegt auch sein Denken.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-19",
      "text": "Kein Schmerz ohne Fortschritt, kein Fortschritt ohne Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-20",
      "text": "Dein Körper ist die Hardware – trainier sie wie dein wichtigstes System.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-21",
      "text": "Energie entsteht durch Handlung, nicht durch Warten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-22",
      "text": "Dein Körper ist dein stiller Mitgründer – behandel ihn wie einen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-23",
      "text": "Schlaf ist dein Reset-Button, Sport ist dein Upgrade.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-24",
      "text": "Kraft ist der Zins, den dein Körper auf harte Arbeit zahlt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-25",
      "text": "Wer sich schont, bremst sein eigenes Potenzial aus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-26",
      "text": "Ausdauer ist nur Disziplin in Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-27",
      "text": "Dein Körper hört jeden Tag mit, was dein Kopf entscheidet.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-28",
      "text": "Vitalität ist keine Gabe, sie ist ein Trainingsplan.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-29",
      "text": "Wer seinen Körper ignoriert, verliert das stärkste Werkzeug seines Erfolgs.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-10-15-0",
      "text": "Zufriedenheit ist der Zinseszins der Dankbarkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-15"
    },
    {
      "id": "gratitude-2026-10-16-1",
      "text": "Wer heute dankbar ist, verschwendet morgen keine Energie an Neid.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-2",
      "text": "Dankbarkeit ist keine Emotion, sondern eine tägliche Entscheidung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-3",
      "text": "Checkst du dein Konto täglich? Check auch dein Glück.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-4",
      "text": "Zufriedenheit ist der einzige Gewinn, der nicht versteuert wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-5",
      "text": "Die günstigste Investition deines Lebens heißt Dankbarkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-6",
      "text": "Wer nie zufrieden ist, hat auch nie wirklich genug.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-7",
      "text": "Dankbarkeit kostet nichts und verändert alles.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-8",
      "text": "Dein Leben ist kein Vergleichsportal für fremde Highlights.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-9",
      "text": "Zufriedenheit beginnt genau dort, wo der Vergleich aufhört.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-10",
      "text": "Du brauchst keinen Grund zur Dankbarkeit, nur den Blick dafür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-11",
      "text": "Alltag wird Glück, sobald du ihn durch Dankbarkeit filterst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-12",
      "text": "Wer dankbar lebt, verliert nie die Bodenhaftung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-13",
      "text": "Zufriedenheit ist der einzige Luxus, den sich jeder leisten kann.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-14",
      "text": "Dankbarkeit macht aus genug automatisch mehr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-15",
      "text": "Dein heutiger Alltag war gestern noch dein größter Traum.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-16",
      "text": "Zufriedenheit ist kein Ziel, sondern eine tägliche Übung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-17",
      "text": "Die beste Altersvorsorge für deine Seele heißt Dankbarkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-18",
      "text": "Wer dankbar startet, hat den Tag schon vor dem ersten Schritt gewonnen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-19",
      "text": "Manche Rendite sieht niemand, aber jeder spürt sie: Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-20",
      "text": "Dankbarkeit ist dein unsichtbares Startkapital.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-21",
      "text": "Du musst nicht mehr haben, du musst nur mehr sehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-22",
      "text": "Ein ruhiges Leben hat immer denselben Soundtrack: Dankbarkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-23",
      "text": "Zufriedenheit schlägt jede Gehaltserhöhung der Welt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-24",
      "text": "Die schnellste Abkürzung zum Glück heißt Dankbarkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-25",
      "text": "Wer zufrieden ist, muss niemandem mehr etwas beweisen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-26",
      "text": "Dankbarkeit macht aus wenig genug und aus genug viel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-27",
      "text": "Dein Jetzt ist die Zukunft, von der du früher geträumt hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-28",
      "text": "Zufriedenheit ist der stille Erfolg, den niemand liked.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-29",
      "text": "Ein täglicher Gewinn ganz ohne Risiko heißt Dankbarkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    }
  ]
}