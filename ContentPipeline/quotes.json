{
  "generatedAt": "2026-11-06",
  "quotes": [
    {
      "id": "mindset-2026-11-06-0",
      "text": "Dein Kopf gibt auf, bevor dein Körper es tut – trainier zuerst den Kopf.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-1",
      "text": "Schwache Momente lügen dir die größten Ausreden ins Ohr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-2",
      "text": "Comfort ist der leiseste Dieb deiner Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-3",
      "text": "Du verhandelst nicht mit deiner Disziplin, du folgst ihr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-4",
      "text": "Jeder Tag ohne Fortschritt ist ein Tag, den dein zukünftiges Ich zurückzahlt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-5",
      "text": "Mentale Stärke ist kein Gefühl, sondern eine tägliche Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-6",
      "text": "Wer auf Motivation wartet, verliert gegen den, der einfach anfängt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-7",
      "text": "Dein Standard ist das, was du tust, wenn niemand zusieht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-8",
      "text": "Der Schmerz der Disziplin wiegt leichter als der Schmerz der Reue.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-9",
      "text": "Zweifel sind laut, aber sie haben nie recht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-10",
      "text": "Du bist nicht müde vom Arbeiten, du bist müde vom Zögern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-11",
      "text": "Starke Menschen fühlen genauso viel Angst – sie handeln trotzdem.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-12",
      "text": "Dein Gehirn sucht Ausreden, dein Ziel braucht Beweise.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-13",
      "text": "Unbequem ist der Preis für ein Leben, das sich lohnt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-14",
      "text": "Du wirst nicht über Nacht stark, sondern durch jeden Tag, an dem du nicht aufgibst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-15",
      "text": "Die beste Antwort auf Zweifel ist Output.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-16",
      "text": "Niemand sieht die Stunden, nur das Ergebnis – also zähl die Stunden nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-17",
      "text": "Dein innerer Kritiker hat noch nie etwas gebaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-18",
      "text": "Konsequenz schlägt Talent, wenn Talent sich nicht anstrengt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-19",
      "text": "Du musst nicht bereit sein, du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-20",
      "text": "Widerstand ist oft das Zeichen, dass du am richtigen Weg bist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-21",
      "text": "Dein Limit ist meistens nur eine Meinung, keine Tatsache.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-22",
      "text": "Härte dich nicht gegen Gefühle ab, härte dich gegen Ausreden ab.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-23",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Unbequemlichkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-24",
      "text": "Du bist stärker als jede Stimme, die dir das Gegenteil erzählt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-25",
      "text": "Wachstum fühlt sich nie nach Komfort an.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-26",
      "text": "Stillstand ist die teuerste Entscheidung, die du heute treffen kannst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-27",
      "text": "Mach es, bevor deine Gedanken dich davon abhalten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "mindset-2026-12-04-28",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-04"
    },
    {
      "id": "mindset-2026-12-05-29",
      "text": "Stärke zeigt sich nicht im Erfolg, sondern im Weitermachen danach.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-05"
    },
    {
      "id": "business-2026-11-06-0",
      "text": "Disziplin ist der Zins, den du auf dein Talent zahlst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-1",
      "text": "Deine Konkurrenz schläft nicht – also tu es auch nicht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-2",
      "text": "Output ist die einzige Währung, die zählt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-3",
      "text": "Wer wartet, bis er bereit ist, wartet für immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-4",
      "text": "Baue heute, was dich morgen trägt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-5",
      "text": "Zeit ist kein Investment, sie ist dein Fundament.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-6",
      "text": "Ausreden kosten mehr als jeder Fehler.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-7",
      "text": "Dein Kalender verrät, was dir wirklich wichtig ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-8",
      "text": "Perfektion ist der Feind von Fortschritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-9",
      "text": "Wer nichts riskiert, hat schon verloren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-10",
      "text": "Systeme schlagen Willenskraft, jedes Mal.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-11",
      "text": "Erfolg ist, was übrig bleibt, wenn alle anderen aufgeben.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-12",
      "text": "Mach den ersten Schritt, der Rest ergibt sich im Tun.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-13",
      "text": "Dein Umfeld bestimmt dein Tempo, nicht dein Talent.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-14",
      "text": "Klein anfangen schlägt nie anfangen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-15",
      "text": "Fokus ist dein größter Wettbewerbsvorteil.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-16",
      "text": "Wachstum fühlt sich nie bequem an.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-17",
      "text": "Baue dein Business mit Absicht, nicht mit Zufall.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-18",
      "text": "Zweifel verschwinden, sobald Resultate sprechen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-19",
      "text": "Du brauchst keine Inspiration, du brauchst einen Plan.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-20",
      "text": "Geld folgt Wert, nicht Wünschen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-21",
      "text": "Arbeite, als würde dich niemand retten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-22",
      "text": "Konsequenz schlägt Talent über die Zeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-23",
      "text": "Dein zukünftiges Ich dankt dir für heute.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-24",
      "text": "Wer Ausreden sucht, findet immer welche.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-25",
      "text": "Investiere in dich, bevor du in alles andere investierst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-26",
      "text": "Stillstand ist die teuerste Entscheidung, die es gibt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-27",
      "text": "Handle schneller, als du dich bereit fühlst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-12-04-28",
      "text": "Dein Netzwerk von heute ist dein Vermögen von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-04"
    },
    {
      "id": "business-2026-12-05-29",
      "text": "Baue dein Imperium, nicht nur dein Image.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-05"
    },
    {
      "id": "discipline-2026-11-06-0",
      "text": "Disziplin ist der Zinseszins der Gewohnheiten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-1",
      "text": "Motivation lädt dich ein, Disziplin bringt dich hin.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-2",
      "text": "Du musst nicht fühlen wollen, du musst einfach tun.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-3",
      "text": "Komfort ist die teuerste Investition in Mittelmäßigkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-4",
      "text": "Wer aufgibt, wenn's schwer wird, war nie wirklich dabei.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-5",
      "text": "Disziplin ist die Sprache, die Erfolg versteht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-6",
      "text": "Deine Zukunft zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-7",
      "text": "Durchhalten ist der Unterschied zwischen Traum und Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-8",
      "text": "Jeder Tag ohne Ausrede ist ein Tag näher am Ziel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-9",
      "text": "Disziplin schlägt Talent, wenn Talent sich ausruht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-10",
      "text": "Du wirst nicht aufgeben, du wirst nur müde – das ist okay.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-11",
      "text": "Konstanz schlägt Intensität, jedes Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-12",
      "text": "Dein Durchhaltevermögen ist dein größter Konkurrenzvorteil.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-13",
      "text": "Niemand sieht die hundert Tage davor, nur das Ergebnis danach.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-14",
      "text": "Disziplin ist Freiheit in Verkleidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-15",
      "text": "Wer heute aufhört, verliert, was er gestern aufgebaut hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-16",
      "text": "Dein zukünftiges Ich zählt auf das, was du jetzt durchziehst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-17",
      "text": "Schwache Tage sind der Test, nicht das Ende.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-18",
      "text": "Erfolg ist, was passiert, wenn Motivation längst weg ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-19",
      "text": "Du brauchst keine Lust, du brauchst ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-20",
      "text": "Disziplin ist der Preis, den du für ein besseres Leben zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-21",
      "text": "Durchziehen schlägt Perfektion.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-22",
      "text": "Deine Routine entscheidet, nicht deine Stimmung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-23",
      "text": "Wer stoppt, wenn's unbequem wird, bleibt für immer unbequem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-24",
      "text": "Disziplin baut, was Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-25",
      "text": "Der Unterschied liegt in den Tagen, an denen du keine Lust hattest.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-26",
      "text": "Du wächst nicht trotz Widerstand, sondern durch ihn.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-27",
      "text": "Kleine Disziplin heute spart große Reue morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-12-04-28",
      "text": "Härte heute ist Leichtigkeit morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-04"
    },
    {
      "id": "discipline-2026-12-05-29",
      "text": "Nicht aufgeben ist eine Entscheidung, keine Emotion.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-05"
    },
    {
      "id": "fitness-2026-11-06-0",
      "text": "Dein Körper ist dein Startkapital – investier täglich, oder verlier die Rendite.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-1",
      "text": "Energie ist die einzige Währung, die sich nicht drucken lässt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-2",
      "text": "Training ist kein Ausgabenposten, es ist dein höchster Zinssatz.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-3",
      "text": "Wer seinen Körper vernachlässigt, zahlt später mit Zinseszins.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-4",
      "text": "Schwache Energie heute ist ein Kredit, den dein Zukunfts-Ich zurückzahlen muss.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-5",
      "text": "Dein Puls entscheidet, wie schnell deine Ideen laufen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-6",
      "text": "Muskeln bauen ist das langweiligste Investment mit der sichersten Rendite.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-7",
      "text": "Wer müde denkt, denkt klein. Beweg dich, bevor du planst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-8",
      "text": "Disziplin im Training ist der Beweis, dass du dir selbst vertraust.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-9",
      "text": "Dein Körper merkt sich jede Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-10",
      "text": "Energie managen schlägt Zeit managen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-11",
      "text": "Ein kurzer Sprint schlägt tausend Motivationssprüche.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-12",
      "text": "Fitness ist der Zinseszins, den niemand auf dem Kontoauszug sieht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-13",
      "text": "Du verhandelst nicht mit deinem Körper, du führst ihn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-14",
      "text": "Bewegung ist der billigste Produktivitäts-Hack, den es gibt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-15",
      "text": "Wer seine Energie verschwendet, verschwendet seine Zukunft.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-16",
      "text": "Dein Nervensystem braucht Training, keine Motivation.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-17",
      "text": "Kraft kommt nicht von Worten, sondern von Wiederholungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-18",
      "text": "Ausdauer im Training ist Ausdauer im Leben – nur ehrlicher.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-19",
      "text": "Dein Körper ist das einzige Büro, das du nicht kündigen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-20",
      "text": "Schlaf ist die Zinsgutschrift für harte Trainingstage.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-21",
      "text": "Wer früh schwitzt, denkt später klar.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-22",
      "text": "Dein Energielevel ist dein wahrer Leistungsausweis.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-23",
      "text": "Stärke baust du nicht im Kopf, sondern in der Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-24",
      "text": "Ein müder Körper lügt deinem Kopf jeden Tag etwas vor.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-25",
      "text": "Bewegung ist der Reset-Knopf, den dein Gehirn wirklich braucht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-26",
      "text": "Wer seinen Körper trainiert, trainiert seine Entscheidungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-27",
      "text": "Dein Puls ist ehrlicher als dein Kalender.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-12-04-28",
      "text": "Fitness ist das einzige Konto, das nie negativ werden darf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-04"
    },
    {
      "id": "fitness-2026-12-05-29",
      "text": "Kraft ist kein Zufall, sondern ein tägliches Investment.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-05"
    },
    {
      "id": "gratitude-2026-11-06-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist die Entscheidung, heute schon genug zu haben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-1",
      "text": "Dankbarkeit ist der Zinseszins der Gefühle - klein gestartet, unaufhaltsam gewachsen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-2",
      "text": "Wer nicht sieht, was er hat, wird nie genug bekommen, egal wie viel noch kommt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-3",
      "text": "Zufriedenheit schlägt jeden Vergleich mit anderen - sie ist dein persönlicher Benchmark.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-4",
      "text": "Dankbarkeit ist das einzige Investment ohne Risiko und mit täglicher Rendite.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-5",
      "text": "Du brauchst kein neues Level, um stolz auf das aktuelle zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-6",
      "text": "Genug ist kein Kompromiss, sondern die höchste Form von Erfolg.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-7",
      "text": "Wer dankbar ist, verliert nie - er gewinnt nur an verschiedenen Stellen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-8",
      "text": "Dein Leben braucht kein Update, nur einen Moment der echten Betrachtung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-9",
      "text": "Zufriedenheit ist leise, aber sie überlebt jeden lauten Trend.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-10",
      "text": "Dankbarkeit macht aus einem normalen Tag eine kleine Erfolgsgeschichte.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-11",
      "text": "Du musst nicht mehr wollen, um glücklicher zu sein - nur bewusster hinschauen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-12",
      "text": "Jeder Tag ohne Dankbarkeit ist ein Tag, den du doppelt bezahlst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-13",
      "text": "Zufriedenheit ist der stille Gewinner, während alle anderen noch rechnen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-14",
      "text": "Was du besitzt, zählt erst, wenn du aufhörst, es zu übersehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-15",
      "text": "Dankbarkeit ist dein Frühwarnsystem gegen die ewige Unzufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-16",
      "text": "Du vergleichst dein Kapitel 3 mit fremdem Kapitel 20 - hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-17",
      "text": "Genügsamkeit ist keine Schwäche, sie ist die Abwesenheit von unnötigem Stress.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-18",
      "text": "Dankbar sein heißt, die eigene Bilanz auch mal positiv zu lesen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-19",
      "text": "Zufriedenheit kostet nichts und zahlt sich trotzdem jeden Tag aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-20",
      "text": "Du musst nicht alles neu erreichen, wenn du lernst, das Erreichte zu sehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-21",
      "text": "Dankbarkeit ist der einzige Trend, der nie out geht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-22",
      "text": "Wer zufrieden ist, verschwendet keine Energie an das, was fehlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-23",
      "text": "Dein jetziges Leben ist für jemand anderen der Traum von morgen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-24",
      "text": "Zufriedenheit heißt nicht stillstehen, sondern wissen, wo du schon stehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-25",
      "text": "Dankbarkeit verwandelt bloßen Besitz in echte Bedeutung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-26",
      "text": "Du musst nicht dankbar sein für alles, nur ehrlich mit dem, was gut läuft.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-27",
      "text": "Genug zu haben ist die unterschätzteste Form von Freiheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-12-04-28",
      "text": "Dankbarkeit ist das Gegenmittel gegen den ständigen Vergleichsdruck.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-04"
    },
    {
      "id": "gratitude-2026-12-05-29",
      "text": "Zufriedenheit ist kein Ziel am Ende des Weges, sondern die Art, wie du ihn gehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-05"
    }
  ]
}