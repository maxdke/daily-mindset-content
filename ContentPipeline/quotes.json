{
  "generatedAt": "2026-10-14",
  "quotes": [
    {
      "id": "mindset-2026-10-14-0",
      "text": "Disziplin ist der Zinseszins der mentalen Stärke.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-14"
    },
    {
      "id": "mindset-2026-10-15-1",
      "text": "Dein Kopf glaubt jede Ausrede, die du ihm lang genug erzählst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-15"
    },
    {
      "id": "mindset-2026-10-16-2",
      "text": "Schwache Momente sind normal. Schwache Gewohnheiten sind eine Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-16"
    },
    {
      "id": "mindset-2026-10-17-3",
      "text": "Du verhandelst nicht mit deiner Komfortzone, du verlässt sie.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-4",
      "text": "Mentale Stärke zeigt sich nicht im Erfolg, sondern im Montagmorgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-5",
      "text": "Wer sich selbst motivieren muss, hat noch kein System.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-6",
      "text": "Dein Gehirn sucht Komfort. Du musst öfter widersprechen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-7",
      "text": "Stärke ist kein Gefühl, sondern eine wiederholte Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-8",
      "text": "Die Ausrede klingt heute genauso gut wie gestern. Ignorier sie trotzdem.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-9",
      "text": "Wachstum fühlt sich nie nach Wachstum an, sondern nach Unbehagen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-10",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-11",
      "text": "Konsequenz schlägt Intensität, jedes Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-12",
      "text": "Dein größter Gegner trägt deine Stimme.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-13",
      "text": "Erfolg beginnt da, wo deine Ausreden aufhören zu funktionieren.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-14",
      "text": "Unbequemlichkeit ist der Preis für ein anderes Leben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-15",
      "text": "Deine Gedanken sind Mieter, nicht Eigentümer. Kündige den falschen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-16",
      "text": "Mentale Stärke ist nichts für gute Tage, die kannst du allein meistern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-17",
      "text": "Du trainierst nicht deinen Körper, du trainierst deine Reaktion auf Widerstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-18",
      "text": "Die Stimme, die aufgeben will, hat noch nie etwas aufgebaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-19",
      "text": "Resilienz entsteht nicht durch Ruhe, sondern durch Wiederholung unter Druck.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-20",
      "text": "Dein Standard ist das, was du tust, wenn niemand zuschaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-21",
      "text": "Zweifel ist kein Stoppschild, sondern eine Ampel, die du selbst steuerst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-22",
      "text": "Wer ständig auf Motivation wartet, wartet auf den falschen Mitarbeiter.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-23",
      "text": "Du bist nicht das Opfer deiner Gedanken, du bist ihr Regisseur.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-24",
      "text": "Mentale Stärke wird nicht gefunden, sie wird in kleinen Momenten gebaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-25",
      "text": "Der Unterschied zwischen Aufgeben und Durchhalten ist ein einziger Gedanke.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-26",
      "text": "Dein innerer Kritiker hat nie etwas erreicht, hör trotzdem nicht auf ihn.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-27",
      "text": "Komfort ist der leiseste Dieb deiner Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-28",
      "text": "Du brauchst keine perfekte Stimmung, du brauchst eine klare Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-29",
      "text": "Härte gegen dich selbst heute ist Freiheit für dich selbst morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-10-14-0",
      "text": "Deine Komfortzone zahlt keine Rechnungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-14"
    },
    {
      "id": "business-2026-10-15-1",
      "text": "Disziplin ist der Zins, den du heute auf dein Morgen zahlst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-15"
    },
    {
      "id": "business-2026-10-16-2",
      "text": "Niemand sieht den Wecker um 5 Uhr, nur das Ergebnis um 17 Uhr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-16"
    },
    {
      "id": "business-2026-10-17-3",
      "text": "Dein Konto spiegelt die Entscheidungen der letzten 90 Tage.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-4",
      "text": "Ausreden sind die teuerste Währung, die du besitzt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-5",
      "text": "Wer nur Content konsumiert, wird nie zum Produzenten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-6",
      "text": "Dein Zukunfts-Ich bezahlt die Schulden deiner Faulheit von heute.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-7",
      "text": "Produktivität beginnt genau dort, wo Motivation aufhört.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-8",
      "text": "Zeit ist das einzige Investment ohne Nachkaufmöglichkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-9",
      "text": "Wer um 6 Uhr plant, hat um 12 Uhr schon gewonnen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-10",
      "text": "Dein Business wächst nie schneller als dein Mindset.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-11",
      "text": "Hustle ohne System ist nur Stress ohne Umsatz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-12",
      "text": "Kleine Entscheidungen von heute sind dein Exit von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-13",
      "text": "Fokus ist die Abkürzung, die niemand abkürzen will.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-14",
      "text": "Wer alles aufschiebt, verkauft seine Zukunft im Ausverkauf.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-15",
      "text": "Dein Netzwerk von heute ist dein Nettoeinkommen von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-16",
      "text": "Umsatz lügt nicht, Ausreden schon.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-17",
      "text": "Jede ungenutzte Stunde ist ein Mitarbeiter, den du gefeuert hast.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-18",
      "text": "Skalierung beginnt im Kopf, nicht auf dem Kontostand.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-19",
      "text": "Wer auf den perfekten Moment wartet, verpasst den ersten Schritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-20",
      "text": "Dein Kalender verrät, ob du Unternehmer bist oder nur Träumer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-21",
      "text": "Cashflow folgt Fokus, nicht Hoffnung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-22",
      "text": "Der Markt fragt nicht nach Motivation, sondern nach Ergebnissen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-23",
      "text": "Wer heute pausiert, zahlt morgen Zinsen in Reue.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-24",
      "text": "Dein größter Konkurrent schläft gerade nicht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-25",
      "text": "Systeme schlagen Willenskraft, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-26",
      "text": "Aus Ideen werden Firmen, aus Ausreden werden Angestellte.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-27",
      "text": "Dein Pitch ist nur so stark wie deine letzte Umsetzung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-28",
      "text": "Wer nicht investiert, konsumiert nur seine eigene Zukunft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-29",
      "text": "Erfolg ist kein Zufall, sondern ein wiederholter Prozess.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-10-14-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-14"
    },
    {
      "id": "discipline-2026-10-15-1",
      "text": "Motivation ist Zufall. Disziplin ist ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-15"
    },
    {
      "id": "discipline-2026-10-16-2",
      "text": "Du musst nicht wollen. Du musst einfach machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-16"
    },
    {
      "id": "discipline-2026-10-17-3",
      "text": "Durchhalten schlägt Talent, wenn Talent nicht durchhält.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-4",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Konsequenz.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-5",
      "text": "Disziplin fühlt sich erst gut an, wenn du aufhörst, sie zu hassen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-6",
      "text": "Jeden Tag eine Entscheidung mehr für das Ich von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-7",
      "text": "Komfort ist der leise Killer großer Pläne.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-8",
      "text": "Wer auf die richtige Stimmung wartet, wartet ewig.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-9",
      "text": "Dein Future Self dankt dir nicht für Ausreden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-10",
      "text": "Disziplin ist unsichtbar, bis sie plötzlich sichtbar wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-11",
      "text": "Kleine Routinen bauen große Leben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-12",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-13",
      "text": "Konstanz schlägt Intensität, jeden einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-14",
      "text": "Niemand sieht die Wiederholung. Jeder sieht nur das Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-15",
      "text": "Disziplin ist Freiheit in Verkleidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-16",
      "text": "Aufhören ist leicht. Deshalb machen es die meisten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-17",
      "text": "Dein Limit ist nur die letzte Ausrede, die du geglaubt hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-18",
      "text": "Was du heute aufschiebst, verlangt morgen Zinsen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-19",
      "text": "Wachstum passiert nicht im Gefühl, sondern in der Wiederholung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-20",
      "text": "Du brauchst kein Gefühl der Motivation. Du brauchst ein System, das trotzdem läuft.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-21",
      "text": "Disziplin ist der Preis für ein Leben nach deinen eigenen Regeln.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-22",
      "text": "Härte gegen dich selbst heute ist Milde gegen dich selbst morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-23",
      "text": "Wer immer erst bereit sein will, startet nie.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-24",
      "text": "Deine Zukunft wird aus den Tagen gebaut, die sich langweilig anfühlten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-25",
      "text": "Disziplin merkt man nicht am Start, sondern am hundertsten Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-26",
      "text": "Du scheiterst nicht am Ziel, du scheiterst an der Routine davor.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-27",
      "text": "Bequemlichkeit verspricht Ruhe und liefert Stillstand.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-28",
      "text": "Der Unterschied liegt nicht im Talent, sondern in der Wiederholung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-29",
      "text": "Mach es, auch wenn es sich falsch anfühlt. Gefühle lügen oft.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-10-14-0",
      "text": "Dein Körper ist der einzige Besitz, den du nie verkaufen kannst. Pfleg ihn wie dein wertvollstes Asset.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-14"
    },
    {
      "id": "fitness-2026-10-15-1",
      "text": "Müdigkeit ist eine Meinung, keine Tatsache. Beweg dich trotzdem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-15"
    },
    {
      "id": "fitness-2026-10-16-2",
      "text": "Disziplin im Training ist der Zinseszins für deinen zukünftigen Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-16"
    },
    {
      "id": "fitness-2026-10-17-3",
      "text": "Wer seinen Körper vernachlässigt, führt ein Unternehmen ohne Fundament.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-4",
      "text": "Energie ist die einzige Währung, die du jeden Morgen neu investierst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-5",
      "text": "Kein Meeting schlägt 30 Minuten Bewegung. Beides zusammen schlägt alles.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-6",
      "text": "Dein Puls ist der Taktgeber deiner Produktivität. Trimm ihn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-7",
      "text": "Schwache Beine, schwacher Fokus. Trainier beides gleichzeitig.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-8",
      "text": "Wer sich morgens quält, braucht sich mittags nicht mehr motivieren.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-9",
      "text": "Dein Kopf denkt klarer, wenn dein Körper schon was geleistet hat.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-10",
      "text": "Bewegung ist das günstigste Antidepressivum mit der besten Rendite.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-11",
      "text": "Du schuldest deinem zukünftigen Ich ein trainiertes Herz-Kreislauf-System.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-12",
      "text": "Fitness ist kein Luxus-Hobby, sondern Risikomanagement für dein Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-13",
      "text": "Jeder Satz im Gym ist eine Einzahlung auf dein Energiekonto.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-14",
      "text": "Wer körperlich stagniert, stagniert bald überall sonst auch.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-15",
      "text": "Dein Körper merkt sich jede Ausrede. Mach ihm keine Angewohnheit draus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-16",
      "text": "Schlaf, Wasser, Bewegung – die unsexy Basics, die alles andere tragen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-17",
      "text": "Ein starker Körper verhandelt bessere Deals mit dem eigenen Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-18",
      "text": "Cardio heute spart dir Ausreden morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-19",
      "text": "Du brauchst keine Motivation, du brauchst einen Termin mit dir selbst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-20",
      "text": "Wer seine Energie managt, braucht weniger Zeit managen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-21",
      "text": "Dein Körper ist das Büro, in dem dein Kopf jeden Tag arbeitet. Halt es instand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-22",
      "text": "Bewegung ist der Reset-Knopf, den niemand drückt, obwohl er gratis ist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-23",
      "text": "Kraft im Körper macht Kraft im Kopf günstiger.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-24",
      "text": "Du optimierst deinen Kalender, aber nicht deinen Schlaf? Falsche Priorität.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-25",
      "text": "Wer seinen Körper trainiert, trainiert nebenbei seine Willenskraft mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-26",
      "text": "Erschöpfung lügt. Nach den ersten fünf Minuten kommt die Energie zurück.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-27",
      "text": "Dein Workout ist kein Ziel, sondern die Gebühr für einen klaren Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-28",
      "text": "Stärke baust du nicht im Schlaf, aber ohne Schlaf baust du gar nichts.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-29",
      "text": "Körperliche Energie ist der Zinssatz, zu dem dein Tag läuft.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-10-14-0",
      "text": "Zufriedenheit ist kein Stillstand, sondern die Basis für deinen nächsten Schritt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-14"
    },
    {
      "id": "gratitude-2026-10-15-1",
      "text": "Wer dankbar ist für das Jetzt, verschwendet keine Energie an das Gestern.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-15"
    },
    {
      "id": "gratitude-2026-10-16-2",
      "text": "Dankbarkeit ist der Zinseszins der Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-3",
      "text": "Du musst nicht alles erreicht haben, um stolz auf dich zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-4",
      "text": "Vergleich frisst Zufriedenheit - Fokus nährt sie.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-5",
      "text": "Dankbarkeit ist die billigste Form von Reichtum.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-6",
      "text": "Wer sein Jetzt wertschätzt, baut sein Morgen mit ruhigerem Kopf.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-7",
      "text": "Zufriedenheit ist kein Ziel, sie ist dein Startkapital.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-8",
      "text": "Erfolg ohne Dankbarkeit fühlt sich an wie ein leeres Konto.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-9",
      "text": "Du bist weiter, als du denkst - erlaub dir, das zu spüren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-10",
      "text": "Dankbarkeit kostet nichts und zahlt trotzdem die höchste Rendite.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-11",
      "text": "Zufrieden sein heißt nicht, aufzuhören zu wollen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-12",
      "text": "Dein Fortschritt zählt auch dann, wenn ihn niemand sieht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-13",
      "text": "Wer ständig mehr will, vergisst oft, was er schon hat.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-14",
      "text": "Dankbarkeit ist der stille Antrieb hinter jeder nachhaltigen Motivation.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-15",
      "text": "Zufriedenheit ist die Pause, die dich stärker weitermachen lässt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-16",
      "text": "Du musst nicht gewinnen, um dankbar zu sein - aber dankbar sein hilft dir zu gewinnen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-17",
      "text": "Wer das Jetzt nicht schätzt, wird auch das Später nicht genießen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-18",
      "text": "Dankbarkeit macht aus Druck Perspektive.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-19",
      "text": "Dein Leben ist kein Entwurf - es läuft schon, und das ist schon viel wert.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-20",
      "text": "Zufriedenheit ist der Boden, auf dem Ambition wächst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-21",
      "text": "Du hast heute schon mehr geschafft, als dir bewusst ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-22",
      "text": "Dankbarkeit verändert nicht deine Situation, sondern deinen Blick darauf.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-23",
      "text": "Wer dankbar ist, verhandelt nicht mit der Vergangenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-24",
      "text": "Zufriedenheit ist keine Schwäche - sie ist dein mentaler Puffer.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-25",
      "text": "Du darfst stolz sein, auch wenn das Ziel noch weit weg ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-26",
      "text": "Dankbarkeit ist Energie, die du nicht kaufen kannst, aber jeden Tag verdienst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-27",
      "text": "Das Leben, das du jetzt lebst, war mal dein Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-28",
      "text": "Zufriedenheit heute macht dich nicht langsamer, sondern klarer.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-29",
      "text": "Dankbarkeit ist die einzige Investition, die sofort Rendite bringt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    }
  ]
}