{
  "generatedAt": "2026-10-03",
  "quotes": [
    {
      "id": "mindset-2026-10-03-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-03"
    },
    {
      "id": "mindset-2026-10-04-1",
      "text": "Dein Kopf liefert dir jede Ausrede frei Haus - genau das ist das Problem.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-04"
    },
    {
      "id": "mindset-2026-10-05-2",
      "text": "Comfort Zones haben keine Zukunft, nur ein Verfallsdatum.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-05"
    },
    {
      "id": "mindset-2026-10-06-3",
      "text": "Wer auf Motivation wartet, hat die Disziplin schon verloren.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-06"
    },
    {
      "id": "mindset-2026-10-07-4",
      "text": "Mentale Stärke zeigt sich nicht im Sieg, sondern am Montagmorgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-07"
    },
    {
      "id": "mindset-2026-10-08-5",
      "text": "Dein Gehirn spart Energie, dein Ziel braucht Einsatz. Entscheide dich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-08"
    },
    {
      "id": "mindset-2026-10-09-6",
      "text": "Schwache Gedanken bauen keine starken Leben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-09"
    },
    {
      "id": "mindset-2026-10-10-7",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-10"
    },
    {
      "id": "mindset-2026-10-11-8",
      "text": "Härte ist kein Zufall, sie ist eine tägliche Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-11"
    },
    {
      "id": "mindset-2026-10-12-9",
      "text": "Wer sich selbst überwindet, muss keine Konkurrenz fürchten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-12"
    },
    {
      "id": "mindset-2026-10-13-10",
      "text": "Ausreden klingen immer vernünftig - das macht sie so gefährlich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-13"
    },
    {
      "id": "mindset-2026-10-14-11",
      "text": "Dein Limit ist oft nur eine Meinung, die du zu oft wiederholt hast.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-14"
    },
    {
      "id": "mindset-2026-10-15-12",
      "text": "Stärke beginnt genau dort, wo Bequemlichkeit endet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-15"
    },
    {
      "id": "mindset-2026-10-16-13",
      "text": "Du verlierst nicht gegen andere, sondern gegen deinen inneren Dialog.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-16"
    },
    {
      "id": "mindset-2026-10-17-14",
      "text": "Resilienz wird nicht gefunden, sie wird trainiert - Tag für Tag.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-15",
      "text": "Dein Verstand ist ein Muskel. Wer ihn schont, lässt ihn verkümmern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-16",
      "text": "Die stärkste Version von dir wartet hinter dem Widerstand, nicht davor.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-17",
      "text": "Zweifel sind laut, aber Fakten sind stiller und stärker.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-18",
      "text": "Niemand wird dich retten, also werde selbst zur Rettung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-19",
      "text": "Klarheit entsteht nicht durch Nachdenken, sondern durch Handeln.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-20",
      "text": "Dein Mindset ist der einzige Teil deines Lebens, den du komplett kontrollierst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-21",
      "text": "Schwäche flüstert Ausreden, Stärke flüstert Routinen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-22",
      "text": "Du kannst nicht jeden Tag motiviert sein, aber jeden Tag diszipliniert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-23",
      "text": "Innere Stärke merkt man nicht am Reden, sondern am Durchhalten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-24",
      "text": "Wer sich selbst führt, braucht niemanden, der ihn antreibt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-25",
      "text": "Der Geist gibt zuerst auf - der Körper folgt erst viel später.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-26",
      "text": "Mentale Stärke ist die Fähigkeit, unangenehme Wahrheiten anzunehmen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-27",
      "text": "Du bist nicht blockiert, du bist nur bequem geworden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-28",
      "text": "Starke Menschen zweifeln auch - sie handeln trotzdem.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-29",
      "text": "Fortschritt fühlt sich nie nach Motivation an, sondern nach Arbeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-10-03-0",
      "text": "Dein Kalender ist dein ehrlichster Lebenslauf.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-03"
    },
    {
      "id": "business-2026-10-04-1",
      "text": "Output schlägt Intention. Immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-04"
    },
    {
      "id": "business-2026-10-05-2",
      "text": "Wer auf Motivation wartet, hat das System nicht verstanden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-05"
    },
    {
      "id": "business-2026-10-06-3",
      "text": "Disziplin ist die Abkürzung, die sich lang anfühlt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-06"
    },
    {
      "id": "business-2026-10-07-4",
      "text": "Dein Zukunfts-Ich bezahlt die Rechnung für dein heutiges Zögern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-07"
    },
    {
      "id": "business-2026-10-08-5",
      "text": "Umsätze lügen nicht, Ausreden schon.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-08"
    },
    {
      "id": "business-2026-10-09-6",
      "text": "Plane nicht den perfekten Moment. Erschaffe den nächsten Schritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-09"
    },
    {
      "id": "business-2026-10-10-7",
      "text": "Wer ständig Optionen offen hält, entscheidet sich für keine.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-10"
    },
    {
      "id": "business-2026-10-11-8",
      "text": "Fokus ist das neue Kapital.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-11"
    },
    {
      "id": "business-2026-10-12-9",
      "text": "Dein Netzwerk wächst nicht durch Likes, sondern durch Lieferung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-12"
    },
    {
      "id": "business-2026-10-13-10",
      "text": "Komfort ist der leiseste Weg in die Bedeutungslosigkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-13"
    },
    {
      "id": "business-2026-10-14-11",
      "text": "Baue, während andere noch brainstormen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-14"
    },
    {
      "id": "business-2026-10-15-12",
      "text": "Konsequenz schlägt Talent an jedem einzelnen Werktag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-15"
    },
    {
      "id": "business-2026-10-16-13",
      "text": "Wer jeden Tag ein Prozent besser wird, ist in einem Jahr unerkennbar.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-16"
    },
    {
      "id": "business-2026-10-17-14",
      "text": "Dein To-Do-List ist wertlos ohne eine Deadline.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-15",
      "text": "Zweifel kosten Zeit. Zeit ist die einzige Währung ohne Nachdruck.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-16",
      "text": "Erfolg ist selten laut. Er ist meistens früh und einsam.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-17",
      "text": "Entscheide schneller, korrigiere später.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-18",
      "text": "Wer wartet, bis alles stimmt, wartet für immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-19",
      "text": "Ein durchschnittlicher Plan heute schlägt einen perfekten Plan nie.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-20",
      "text": "Deine Ausrede klingt gut. Dein Konto merkt den Unterschied nicht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-21",
      "text": "Wachstum fühlt sich an wie Unbehagen mit Zinsen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-22",
      "text": "Verkaufe Ergebnisse, nicht Absichten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-23",
      "text": "Die Konkurrenz schläft nicht. Sie optimiert gerade ihren Workflow.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-24",
      "text": "Routinen sind der stille Motor hinter lauten Erfolgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-25",
      "text": "Du brauchst keinen Plan B. Du brauchst Tempo bei Plan A.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-26",
      "text": "Wer Verantwortung outsourct, outsourct auch den Erfolg.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-27",
      "text": "Zeit, die du heute sparst, verlierst du morgen mit Zinseszins.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-28",
      "text": "Kleine Deadlines bauen große Imperien.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-29",
      "text": "Dein größter Konkurrent ist dein gestriges Tempo.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-10-03-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-03"
    },
    {
      "id": "discipline-2026-10-04-1",
      "text": "Motivation checkt aus, Disziplin bleibt und macht den Job fertig.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-04"
    },
    {
      "id": "discipline-2026-10-05-2",
      "text": "Du musst keine Lust haben, du musst nur anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-05"
    },
    {
      "id": "discipline-2026-10-06-3",
      "text": "Konsequenz schlägt Intensität – jeden einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-06"
    },
    {
      "id": "discipline-2026-10-07-4",
      "text": "Deine Comfort Zone zahlt keine Rechnungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-07"
    },
    {
      "id": "discipline-2026-10-08-5",
      "text": "Wer aufgibt, wenn's schwer wird, war nie wirklich bereit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-08"
    },
    {
      "id": "discipline-2026-10-09-6",
      "text": "Disziplin ist die Brücke zwischen Plan und Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-09"
    },
    {
      "id": "discipline-2026-10-10-7",
      "text": "Tu es, auch wenn keiner zusieht – besonders dann.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-10"
    },
    {
      "id": "discipline-2026-10-11-8",
      "text": "Durchhalten ist kein Talent, sondern eine Entscheidung pro Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-11"
    },
    {
      "id": "discipline-2026-10-12-9",
      "text": "Dein Future Self dankt dir für jede unbequeme Minute heute.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-12"
    },
    {
      "id": "discipline-2026-10-13-10",
      "text": "Ausreden sind billig, Ergebnisse sind teuer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-13"
    },
    {
      "id": "discipline-2026-10-14-11",
      "text": "Disziplin fühlt sich nie gut an – bis sie sich auszahlt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-14"
    },
    {
      "id": "discipline-2026-10-15-12",
      "text": "Du wirst nicht jeden Tag motiviert sein, aber du kannst liefern.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-15"
    },
    {
      "id": "discipline-2026-10-16-13",
      "text": "Konstanz schlägt Genie, das nur manchmal auftaucht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-16"
    },
    {
      "id": "discipline-2026-10-17-14",
      "text": "Der Unterschied zwischen Wunsch und Ziel heißt Disziplin.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-15",
      "text": "Niemand sieht die Wiederholung Nummer 4.000, nur das Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-16",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-17",
      "text": "Disziplin schützt dich vor deinem eigenen Bauchgefühl.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-18",
      "text": "Wer Pausen vor dem Ziel macht, startet nie richtig durch.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-19",
      "text": "Dein Zukunfts-Ich zählt auf das, was du heute durchziehst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-20",
      "text": "Fortschritt ist leise, Aufgeben ist laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-21",
      "text": "Halte durch, wenn's unspektakulär wird – da passiert der Wandel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-22",
      "text": "Disziplin ist Selbstliebe in Arbeitskleidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-23",
      "text": "Du brauchst keinen Motivationsschub, du brauchst ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-24",
      "text": "Jeder Tag, den du durchhältst, ist ein Investment ohne Rückbuchung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-25",
      "text": "Was du heute aufschiebst, kostet dich morgen doppelt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-26",
      "text": "Stärke zeigt sich nicht im Start, sondern im Dranbleiben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-27",
      "text": "Disziplin ist der Preis, Freiheit ist der Gewinn.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-28",
      "text": "Du scheiterst nicht am Ziel, du scheiterst an Tag 17.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-29",
      "text": "Mach weiter, wenn's egal wird – genau da entsteht der Unterschied.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-10-03-0",
      "text": "Dein Körper ist das einzige Investment, das dich überallhin begleitet.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-03"
    },
    {
      "id": "fitness-2026-10-04-1",
      "text": "Energie ist die Währung, mit der du deinen Tag bezahlst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-04"
    },
    {
      "id": "fitness-2026-10-05-2",
      "text": "Wer seinen Körper vernachlässigt, arbeitet mit kaputten Werkzeugen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-05"
    },
    {
      "id": "fitness-2026-10-06-3",
      "text": "Muskeln wachsen im Schlaf, Disziplin zeigt sich im Spiegel.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-06"
    },
    {
      "id": "fitness-2026-10-07-4",
      "text": "Dein Training heute ist der Zinseszins von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-07"
    },
    {
      "id": "fitness-2026-10-08-5",
      "text": "Schweiß ist die Quittung für ein ehrliches Workout.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-08"
    },
    {
      "id": "fitness-2026-10-09-6",
      "text": "Ein starker Körper verhandelt bessere Deals mit dem Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-09"
    },
    {
      "id": "fitness-2026-10-10-7",
      "text": "Bewegung ist das günstigste Antidepressivum, das du kennst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-10"
    },
    {
      "id": "fitness-2026-10-11-8",
      "text": "Dein Puls entscheidet, wie wach dein Kopf heute ist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-11"
    },
    {
      "id": "fitness-2026-10-12-9",
      "text": "Wer sich nicht bewegt, stagniert doppelt - körperlich und mental.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-12"
    },
    {
      "id": "fitness-2026-10-13-10",
      "text": "Cardio heute, Klarheit morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-13"
    },
    {
      "id": "fitness-2026-10-14-11",
      "text": "Dein Körper merkt sich jede Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-14"
    },
    {
      "id": "fitness-2026-10-15-12",
      "text": "Kraft im Körper ist Kapital im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-15"
    },
    {
      "id": "fitness-2026-10-16-13",
      "text": "Ein Satz Liegestütze schlägt eine Stunde Grübeln.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-16"
    },
    {
      "id": "fitness-2026-10-17-14",
      "text": "Du kannst nicht outperformen, wenn dein Akku leer ist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-15",
      "text": "Schlaf ist der unsichtbare Investor deiner Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-16",
      "text": "Körper ist Hardware, Mindset ist Software - beide brauchen Updates.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-17",
      "text": "Bewegung schlägt Motivation, jedes Mal.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-18",
      "text": "Wer heute joggt, denkt morgen schneller.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-19",
      "text": "Dein Körper zahlt Dividenden, wenn du regelmäßig einzahlst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-20",
      "text": "Fitness ist kein Ziel, sondern dein tägliches Betriebssystem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-21",
      "text": "Ein kurzer Sprint reicht, um lange Ausreden zu überholen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-22",
      "text": "Energie tankst du nicht im Kühlschrank, sondern im Training.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-23",
      "text": "Dein Körper ist dein Büro - halt es in Ordnung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-24",
      "text": "Wer stark ist, muss weniger beweisen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-25",
      "text": "Schweiß ist flüssige Disziplin.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-26",
      "text": "Dein Immunsystem kennt deine Ausreden nicht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-27",
      "text": "Bewege dich, bevor dein Kopf Nein sagen kann.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-28",
      "text": "Ein fitter Körper trägt größere Ziele.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-29",
      "text": "Ausdauer im Training ist Ausdauer im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-10-03-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist die Energie, die dich dahin bringt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-03"
    },
    {
      "id": "gratitude-2026-10-04-1",
      "text": "Dankbarkeit ist der Zinseszins der Mentalität.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-04"
    },
    {
      "id": "gratitude-2026-10-05-2",
      "text": "Wer das Jetzt nicht wertschätzt, verliert auch die Zukunft aus den Augen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-05"
    },
    {
      "id": "gratitude-2026-10-06-3",
      "text": "Erfolg ohne Dankbarkeit ist ein Konto ohne Deckung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-06"
    },
    {
      "id": "gratitude-2026-10-07-4",
      "text": "Zufrieden sein heißt nicht aufhören, sondern klarer weitermachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-07"
    },
    {
      "id": "gratitude-2026-10-08-5",
      "text": "Dankbarkeit kostet nichts und zahlt sich trotzdem aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-08"
    },
    {
      "id": "gratitude-2026-10-09-6",
      "text": "Du besitzt mehr, als dein Vergleich dir zeigt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-09"
    },
    {
      "id": "gratitude-2026-10-10-7",
      "text": "Wer dankbar lebt, verschwendet keine Energie an das, was fehlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-10"
    },
    {
      "id": "gratitude-2026-10-11-8",
      "text": "Zufriedenheit ist der Zustand, in dem Ambition nicht verbrennt, sondern trägt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-11"
    },
    {
      "id": "gratitude-2026-10-12-9",
      "text": "Dankbarkeit macht aus Druck Perspektive.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-12"
    },
    {
      "id": "gratitude-2026-10-13-10",
      "text": "Du musst nicht alles haben, um alles zu schätzen, was du hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-13"
    },
    {
      "id": "gratitude-2026-10-14-11",
      "text": "Zufriedenheit ist die stille Version von Stolz.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-14"
    },
    {
      "id": "gratitude-2026-10-15-12",
      "text": "Dankbarkeit ist die Investition, die sofort Rendite bringt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-15"
    },
    {
      "id": "gratitude-2026-10-16-13",
      "text": "Wer heute dankbar ist, verhandelt morgen nicht aus Mangel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-14",
      "text": "Zufriedenheit ist kein Stillstand, sondern ein ruhiger Motor.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-15",
      "text": "Dankbarkeit verändert nicht deine Situation, sondern deinen Zugriff darauf.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-16",
      "text": "Du wächst schneller, wenn du nicht ständig im Vergleich lebst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-17",
      "text": "Zufriedenheit ist der Unterschied zwischen Ankommen und Weiterjagen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-18",
      "text": "Dankbarkeit ist die billigste Form von Therapie.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-19",
      "text": "Was du wertschätzt, wächst - was du ignorierst, verkümmert.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-20",
      "text": "Zufrieden sein bedeutet, deinen eigenen Fortschritt nicht zu unterschätzen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-21",
      "text": "Dankbarkeit ist der Kontostand, den niemand sehen kann, aber jeder spürt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-22",
      "text": "Du wirst nie genug haben, wenn du nie genug bist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-23",
      "text": "Zufriedenheit ist Strategie, nicht Zufall.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-24",
      "text": "Dankbarkeit macht aus kleinen Tagen große Erinnerungen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-25",
      "text": "Wer dankbar startet, startet nie bei null.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-26",
      "text": "Zufriedenheit ist der Punkt, an dem Ehrgeiz leiser, aber klarer wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-27",
      "text": "Dankbarkeit ist der Filter, der Chancen sichtbar macht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-28",
      "text": "Du verpasst die Gegenwart, wenn du nur auf das Ziel schaust.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-29",
      "text": "Zufriedenheit ist nicht das Ende der Reise, sondern das Fahrzeug.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    }
  ]
}