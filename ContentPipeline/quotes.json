{
  "generatedAt": "2026-10-22",
  "quotes": [
    {
      "id": "mindset-2026-10-22-0",
      "text": "Deine Ausreden sind lauter als dein Ehrgeiz – dreh die Lautstärke um.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-1",
      "text": "Comfort Zone ist kein Zuhause, sondern ein Wartezimmer.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-2",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-3",
      "text": "Motivation ist ein Gast, Disziplin bleibt für immer.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-4",
      "text": "Dein Kopf gibt auf, bevor dein Körper es tut – glaub ihm nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-5",
      "text": "Schwache Tage bauen starke Menschen, wenn du dranbleibst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-6",
      "text": "Wer auf perfekte Bedingungen wartet, wartet sein Leben lang.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-7",
      "text": "Dein Standard entscheidet, nicht deine Stimmung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-8",
      "text": "Zweifel kosten mehr als Fehler.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-9",
      "text": "Du musst nicht motiviert sein, du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-10",
      "text": "Der Widerstand, den du spürst, ist der Beweis, dass es wichtig ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-11",
      "text": "Starke Mindsets entstehen nicht im Urlaub, sondern im Chaos.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-12",
      "text": "Dein größter Konkurrent schläft gerade nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-13",
      "text": "Klein anfangen schlägt groß aufgeben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-14",
      "text": "Wer sich selbst belügt, verliert zuerst gegen sich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-15",
      "text": "Energie folgt der Entscheidung, nicht der Lust.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-16",
      "text": "Unbequemlichkeit ist der Preis für Veränderung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-17",
      "text": "Deine Zukunft fragt nicht nach deiner Laune heute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-18",
      "text": "Druck formt Diamanten, nicht Ausreden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-19",
      "text": "Wer ständig auf den richtigen Moment wartet, verpasst jeden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-20",
      "text": "Dein Verstand kennt Grenzen, die dein Wille nicht akzeptiert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-21",
      "text": "Fortschritt fühlt sich selten gut an, bevor er gut aussieht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-22",
      "text": "Mentale Stärke heißt: trotzdem.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-23",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-24",
      "text": "Jede Stimme in deinem Kopf, die sagt lass es, lügt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-25",
      "text": "Konsequenz schlägt Talent, wenn Talent nicht konsequent ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-26",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Durchhalten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-27",
      "text": "Du wächst nicht trotz Druck, sondern wegen ihm.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-28",
      "text": "Schwäche ist ein Gefühl, keine Tatsache.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-29",
      "text": "Wer sich selbst führt, braucht keine Ausrede mehr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-10-22-0",
      "text": "Motivation ist unzuverlässig. Systeme nicht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-1",
      "text": "Deine Zukunft wird heute gebaut, nicht morgen beschlossen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-2",
      "text": "Wer auf den perfekten Moment wartet, verpasst den einzigen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-3",
      "text": "Ausreden kosten mehr als Fehler.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-4",
      "text": "Fortschritt schlägt Perfektion jedes Mal.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-5",
      "text": "Du verhandelst nicht mit deiner Disziplin.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-6",
      "text": "Die Komfortzone ist der teuerste Ort, an dem du wohnen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-7",
      "text": "Wer ständig erreichbar ist, erreicht selten etwas Großes.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-8",
      "text": "Zeit ist das einzige Investment ohne Nachkaufoption.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-9",
      "text": "Klein anfangen schlägt nie anfangen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-10",
      "text": "Dein Kalender zeigt, was dir wirklich wichtig ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-11",
      "text": "Ergebnisse reden, Pläne schweigen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-12",
      "text": "Ein Prozent besser pro Tag macht dich in einem Jahr unkopierbar.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-13",
      "text": "Risiko ist der Preis für Relevanz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-14",
      "text": "Niemand wird dich retten. Das ist die gute Nachricht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-15",
      "text": "Konsequenz schlägt Talent, wenn Talent nicht konsequent ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-16",
      "text": "Dein Umfeld ist dein unsichtbarer Vertrag mit der Zukunft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-17",
      "text": "Harte Entscheidungen heute sparen harte Jahre morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-18",
      "text": "Wer alles optimiert außer sich selbst, optimiert nichts.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-19",
      "text": "Stillstand fühlt sich sicher an und ist der größte Rückschritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-20",
      "text": "Dein Startkapital ist Zeit, nicht Geld.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-21",
      "text": "Wer nicht plant, wird geplant.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-22",
      "text": "Große Ziele sterben an kleinen Ablenkungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-23",
      "text": "Du wirst nicht zufällig erfolgreich. Du wirst es systematisch.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-24",
      "text": "Jede Stunde Ablenkung ist eine Rechnung, die später fällig wird.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-25",
      "text": "Wettbewerbsvorteil beginnt mit dem, was andere nicht tun wollen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-26",
      "text": "Dein zukünftiges Ich zahlt für die Entscheidungen von heute.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-27",
      "text": "Fokus ist die neue Währung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-28",
      "text": "Wer alles will, bekommt meistens nichts.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-29",
      "text": "Erfolg hinterlässt keine Abkürzungen, nur Muster.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-10-22-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-1",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-2",
      "text": "Du brauchst keine Lust, du brauchst ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-3",
      "text": "Jeder Tag ohne Ausrede ist ein Tag im Plus.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-4",
      "text": "Dein Komfort ist der Preis für deine Ziele.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-5",
      "text": "Konsequenz schlägt Talent, jeden einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-6",
      "text": "Wer aufhört, wenn es wehtut, hat nie angefangen zu wachsen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-7",
      "text": "Disziplin fühlt sich erst gut an, wenn du aufhörst sie zu hassen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-8",
      "text": "Dein zukünftiges Ich dankt dir für heute, nicht für gestern.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-9",
      "text": "Keine Ausnahmen, keine Ausreden, nur Ergebnisse.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-10",
      "text": "Du wirst nicht motiviert aufwachen, du musst trotzdem aufstehen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-11",
      "text": "Disziplin ist das stille Versprechen an dich selbst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-12",
      "text": "Durchhalten ist unsichtbar, bis es sichtbar wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-13",
      "text": "Kleine Pflichten heute, große Freiheit morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-14",
      "text": "Dein Warum muss stärker sein als dein Montagmorgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-15",
      "text": "Wiederholung schlägt Inspiration.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-16",
      "text": "Niemand sieht die Tage, an denen du weitermachst, obwohl du aufhören wolltest.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-17",
      "text": "Disziplin ist die Brücke zwischen Ziel und Realität.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-18",
      "text": "Du verlierst nicht gegen andere, du verlierst gegen deine Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-19",
      "text": "Jede Gewohnheit ist eine Stimme für die Person, die du werden willst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-20",
      "text": "Fortschritt passiert im Dunkeln, lange bevor er sichtbar wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-21",
      "text": "Du musst nicht schnell sein, du musst konstant sein.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-22",
      "text": "Dein Standard ist das, was du akzeptierst, wenn niemand hinschaut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-23",
      "text": "Disziplin ist Freiheit in Verkleidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-24",
      "text": "Halte durch, wenn es langweilig wird - genau da beginnt der Unterschied.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-25",
      "text": "Du baust dein Leben in den Momenten, in denen es niemand sieht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-26",
      "text": "Konstanz ist das Kapital, das sich am meisten verzinst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-27",
      "text": "Wer immer auf den perfekten Moment wartet, verpasst jeden Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-28",
      "text": "Disziplin kostet heute wenig und morgen alles.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-29",
      "text": "Dein Durchhaltevermögen ist dein größter Wettbewerbsvorteil.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-10-22-0",
      "text": "Dein Körper ist das einzige Büro, das du nie kündigen kannst – halt es in Schuss.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-1",
      "text": "Energie ist kein Zufall, sie ist das Ergebnis von drei Workouts pro Woche.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-2",
      "text": "Wer seinen Körper vernachlässigt, verschenkt die Hälfte seiner Leistungsfähigkeit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-3",
      "text": "Muskeln baust du im Gym, Disziplin baust du dabei gleich mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-4",
      "text": "Dein Puls heute entscheidet über deine Klarheit morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-5",
      "text": "Bewegung ist der billigste Kaffee, den es gibt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-6",
      "text": "Wer schwitzt, denkt später klarer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-7",
      "text": "Fitness ist kein Ziel, sondern der Motor für alles andere.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-8",
      "text": "Dein Bett hat noch nie eine einzige Idee gehabt – steh auf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-9",
      "text": "Jede Wiederholung im Gym ist eine Rechnung, die sich später auszahlt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-10",
      "text": "Energie tankst du nicht im Bett, sondern beim Laufen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-11",
      "text": "Ein starker Körper trägt einen klaren Kopf leichter durch den Tag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-12",
      "text": "Training ist das einzige Investment, das garantiert Zinsen bringt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-13",
      "text": "Wer sich heute bewegt, muss morgen nicht nachdenken, ob er kann.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-14",
      "text": "Dein Körper merkt sich jede Ausrede, die du ihm erzählst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-15",
      "text": "Schwache Beine tragen keine großen Pläne.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-16",
      "text": "Fitness beginnt nicht im Kopf, sondern in den Schuhen, die du anziehst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-17",
      "text": "Jeder Schritt heute ist ein Vorschuss auf die Energie von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-18",
      "text": "Dein Körper ist das Werkzeug – stumpfes Werkzeug schneidet nicht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-19",
      "text": "Wer nie trainiert, trainiert sich nur im Stillstand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-20",
      "text": "Ausdauer im Sport ist Ausdauer im Leben, nur mit Schweiß statt Excel.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-21",
      "text": "Dein Blutdruck entscheidet mit, wie groß deine Ziele heute wirken.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-22",
      "text": "Bewegung ist die einzige Abkürzung, die wirklich funktioniert.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-23",
      "text": "Ein Satz Liegestütze schlägt jede Ausrede, die du dir ausdenkst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-24",
      "text": "Dein Körper zahlt zurück, was du ihm an Training leihst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-25",
      "text": "Fitness ist der Zinseszins für deine Zukunft.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-26",
      "text": "Wer stark ist, muss sich seltener entschuldigen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-27",
      "text": "Energie klaust du dir nicht – du erarbeitest sie dir im Training.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-28",
      "text": "Ein müder Körper lügt deinem Kopf jeden Tag etwas vor.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-29",
      "text": "Bewege dich, bevor der Tag dich bewegt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-10-22-0",
      "text": "Dankbarkeit ist der Zinseszins der Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-1",
      "text": "Wer zufrieden mit dem Weg ist, verliert nie das Ziel aus den Augen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-2",
      "text": "Dankbarkeit kostet nichts und bringt mehr als jede Investition.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-3",
      "text": "Zufriedenheit ist kein Ziel, sie ist dein Startkapital.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-4",
      "text": "Du kannst nicht gleichzeitig dankbar und gestresst sein. Wähl weise.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-5",
      "text": "Erfolg ohne Dankbarkeit ist nur ein leeres Konto.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-6",
      "text": "Zufriedenheit ist die Rendite, die niemand versteuert.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-7",
      "text": "Dankbarkeit macht aus genug ein Zuhause.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-8",
      "text": "Wer dankbar ist, hat schon gewonnen, bevor das Spiel beginnt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-9",
      "text": "Zufriedenheit ist nicht das Ende der Ambition, sondern ihr Fundament.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-10",
      "text": "Dankbarkeit ist die Disziplin, das Gute nicht zu übersehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-11",
      "text": "Dein Konto wächst schneller, wenn dein Dankbarkeits-Level das auch tut.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-12",
      "text": "Zufrieden sein heißt nicht aufhören, sondern klarer weitermachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-13",
      "text": "Dankbarkeit ist der Filter, der aus Druck Perspektive macht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-14",
      "text": "Mehr haben wollen und dankbar sein schließen sich nicht aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-15",
      "text": "Zufriedenheit ist die stillste Form von Stärke.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-16",
      "text": "Dankbarkeit ist unsichtbares Kapital mit sichtbarer Wirkung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-17",
      "text": "Wer nichts wertschätzt, hat nie wirklich etwas besessen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-18",
      "text": "Zufriedenheit beginnt da, wo der Vergleich aufhört.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-19",
      "text": "Dankbarkeit ist die Abkürzung zu echtem Antrieb.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-20",
      "text": "Du bist nicht im Rückstand. Du bist dankbar und on track.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-21",
      "text": "Zufriedenheit ist der Beweis, dass du schon mehr erreicht hast, als du denkst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-22",
      "text": "Dankbarkeit verwandelt Druck in Perspektive.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-23",
      "text": "Wer zufrieden mit sich ist, braucht keine Bestätigung von außen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-24",
      "text": "Dankbarkeit ist die Energie, die kein Energy-Drink ersetzt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-25",
      "text": "Zufriedenheit heute ist der Grundstein für Ambition morgen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-26",
      "text": "Dankbarkeit macht aus kleinen Erfolgen echte Meilensteine.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-27",
      "text": "Zufriedenheit ist dein Ruhepuls in einer Welt im Sprint.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-28",
      "text": "Dankbarkeit ist der Soundtrack, zu dem Erfolg leiser wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-29",
      "text": "Zufrieden sein mit dem Prozess ist der Trick der Erfolgreichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    }
  ]
}