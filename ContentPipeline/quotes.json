{
  "generatedAt": "2026-10-26",
  "quotes": [
    {
      "id": "mindset-2026-10-26-0",
      "text": "Dein Kopf glaubt dir jede Ausrede, wenn du sie nur oft genug wiederholst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-1",
      "text": "Komfort ist der Ort, an dem Potenzial verhungert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-2",
      "text": "Niemand sieht die Entscheidungen, die du um 6 Uhr morgens triffst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-3",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-4",
      "text": "Dein zukünftiges Ich zahlt den Preis für die Ausreden von heute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-5",
      "text": "Schwache Tage sind kein Charakterfehler, sondern Teil des Trainings.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-6",
      "text": "Du verhandelst nicht mit deinem inneren Schweinehund, du überstimmst ihn.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-7",
      "text": "Wer auf perfekte Bedingungen wartet, wartet für immer.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-8",
      "text": "Mentale Stärke zeigt sich nicht im Erfolg, sondern im Montagmorgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-9",
      "text": "Dein Limit ist meistens nur eine Meinung, keine Tatsache.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-10",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Gewohnheit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-11",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht über deine Entscheidungen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-12",
      "text": "Du musst nicht motiviert sein, du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-13",
      "text": "Jeder Tag ohne Ausrede ist ein Tag mehr Vorsprung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-14",
      "text": "Dein Gehirn testet dich jeden Morgen – bestehe den Test leise.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-15",
      "text": "Stärke ist kein Gefühl, sondern eine Entscheidung, die du wiederholst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-16",
      "text": "Wer aufgibt, wenn es unbequem wird, war nie wirklich im Spiel.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-17",
      "text": "Dein innerer Kritiker hat noch nie etwas erreicht – warum hörst du ihm zu?",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-18",
      "text": "Disziplin fühlt sich nie gut an, bevor sie sich gut anfühlt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-19",
      "text": "Die Stimme, die sagt morgen, ist dieselbe, die seit Jahren verliert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-20",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-21",
      "text": "Härte gegen dich selbst heute spart dir Entschuldigungen morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-22",
      "text": "Niemand rettet dich – aber du kannst dich selbst nicht enttäuschen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-23",
      "text": "Dein Standard bestimmt dein Schicksal, nicht dein Ziel.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-24",
      "text": "Die Komfortzone killt mehr Träume als jedes Scheitern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-25",
      "text": "Wachstum fühlt sich an wie Unsicherheit, die sich lohnt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-26",
      "text": "Du brauchst keine Inspiration, du brauchst ein System.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-27",
      "text": "Der Moment, in dem du keine Lust hast, ist der Moment, der zählt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-28",
      "text": "Mentale Stärke heißt, dir selbst nicht zu glauben, wenn du aufgeben willst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-29",
      "text": "Dein Verstand gibt zuerst auf – dein Körper kann noch länger.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-10-26-0",
      "text": "Disziplin schlägt Motivation an jedem einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-1",
      "text": "Dein Zukunfts-Ich bezahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-2",
      "text": "Wer um 6 Uhr aufsteht, hat um 9 Uhr schon drei Stunden Vorsprung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-3",
      "text": "Erfolg ist kein Zufall, sondern das Ergebnis wiederholter Entscheidungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-4",
      "text": "Du brauchst keine Motivation, du brauchst ein System.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-5",
      "text": "Jede Ausrede kostet dich einen Kunden mehr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-6",
      "text": "Reich wird man nicht durch Ideen, sondern durch Ausführung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-7",
      "text": "Dein Konkurrent schläft nicht, also zögere nicht zu lange.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-8",
      "text": "Mittelmäßigkeit fühlt sich bequem an, deshalb bleiben die meisten dort.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-9",
      "text": "Zeit ist die einzige Währung, die du nicht nachdrucken kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-10",
      "text": "Baue heute das Unternehmen, das dich in zehn Jahren rettet.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-11",
      "text": "Comfort Zones zahlen keine Rechnungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-12",
      "text": "Wer immer nur plant, hat noch nie etwas gebaut.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-13",
      "text": "Deine To-do-Liste ist nutzlos, wenn du nicht priorisierst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-14",
      "text": "Kleine Fortschritte jeden Tag schlagen große Pläne, die nie starten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-15",
      "text": "Niemand merkt deinen Fleiß, bis er sich auszahlt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-16",
      "text": "Du verhandelst nicht mit deinem inneren Schweinehund, du überholst ihn.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-17",
      "text": "Der Markt fragt nicht nach deiner Motivation, sondern nach deinem Ergebnis.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-18",
      "text": "Wer heute Opfer bringt, kauft sich morgen Freiheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-19",
      "text": "Dein Umsatz spiegelt deine Entscheidungen der letzten zwölf Monate.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-20",
      "text": "Fokus ist das neue Kapital.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-21",
      "text": "Jeder Tag ohne Fortschritt ist ein verlorener Investment-Zyklus.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-22",
      "text": "Hustle ohne Strategie ist nur teure Beschäftigung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-23",
      "text": "Dein Netzwerk bestimmt dein Nettoeinkommen schneller als dein Talent.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-24",
      "text": "Wachstum fühlt sich unbequem an, bevor es sich lohnt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-25",
      "text": "Wer auf den perfekten Moment wartet, verpasst den Markt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-26",
      "text": "Erfolgreiche Menschen erledigen heute, was andere auf morgen verschieben.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-27",
      "text": "Dein Pitch ist nur so gut wie deine letzte Umsetzung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-28",
      "text": "Risiko ist der Preis für Freiheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-29",
      "text": "Baue Systeme, nicht nur Ziele.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-10-26-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-1",
      "text": "Motivation checkt aus, Disziplin bleibt bis zum Ende der Schicht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-2",
      "text": "Dein Comfort-Zone-Abo kündigst du heute.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-3",
      "text": "Konsequenz schlägt Talent, wenn Talent aufhört zu üben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-4",
      "text": "Wer jeden Tag die Ausrede wechselt, trainiert nur seine Kreativität.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-5",
      "text": "Durchhalten ist der Skill, den niemand postet, aber jeder braucht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-6",
      "text": "Dein zukünftiges Ich liest gerade deine Chat-Verläufe mit Netflix.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-7",
      "text": "Disziplin ist unsexy, bis du die Ergebnisse siehst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-8",
      "text": "Jeder Tag ohne Ausrede ist ein Investment mit Zinseszins.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-9",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-10",
      "text": "Die Routine, die du hasst, baut das Leben, das du willst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-11",
      "text": "Aufgeben fühlt sich nur einmal gut an. Durchziehen fühlt sich für immer gut an.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-12",
      "text": "Dein Momentum stirbt nicht durch Pausen, sondern durch Ausreden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-13",
      "text": "Disziplin ist die Sprache, die dein zukünftiges Ich versteht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-14",
      "text": "Wer auf Motivation wartet, verpasst den ganzen Prozess.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-15",
      "text": "Du brauchst keinen guten Tag, du brauchst eine gute Gewohnheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-16",
      "text": "Durchhalten heißt: weitermachen, wenn niemand mehr zuschaut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-17",
      "text": "Dein Ziel fragt nicht nach deiner Stimmung, nur nach deiner Handlung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-18",
      "text": "Disziplin ist der Unterschied zwischen Wollen und Werden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-19",
      "text": "Die harte Phase ist der Eintrittspreis für das Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-20",
      "text": "Kleine Taten, oft wiederholt, schlagen große Pläne, einmal gedacht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-21",
      "text": "Dein innerer Schweinehund zahlt keine Miete, wirf ihn raus.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-22",
      "text": "Disziplin heute ist Freiheit morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-23",
      "text": "Wer jeden Tag ein bisschen durchzieht, braucht später keinen Motivationsschub.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-24",
      "text": "Konstanz ist der leise Erfolgsfaktor, den niemand zugibt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-25",
      "text": "Der Unterschied zwischen Träumen und Ergebnissen heißt Wiederholung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-26",
      "text": "Dranbleiben ist unspektakulär, bis es das Spektakulärste ist, was du je gemacht hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-27",
      "text": "Disziplin fragt nicht, ob du Lust hast, sie fragt, ob du es tust.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-28",
      "text": "Dein Future Self dankt dir für jede Minute, die du heute durchziehst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-29",
      "text": "Es gibt keinen Plan B, solange Plan A noch nicht ausgereizt ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-10-26-0",
      "text": "Dein Körper ist dein teuerstes Investment – zahl täglich ein.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-1",
      "text": "Energie lässt sich nicht leihen, nur erarbeiten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-2",
      "text": "Jedes Workout ist eine Einzahlung auf dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-3",
      "text": "Müdigkeit ist nur eine Ausrede mit Trainingsanzug.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-4",
      "text": "Disziplin im Gym ist Disziplin im Leben – gleiche Währung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-5",
      "text": "Wer seinen Körper vernachlässigt, verliert still an Rendite.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-6",
      "text": "Schwitzen heute, Klarheit morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-7",
      "text": "Dein Puls ist der Zinssatz deiner Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-8",
      "text": "Bewegung ist der günstigste Produktivitäts-Hack, den es gibt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-9",
      "text": "Keine Motivation nötig, nur ein Plan und Schuhe.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-10",
      "text": "Dein Bett kostet dich mehr Potenzial als jede schlechte Entscheidung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-11",
      "text": "Ein starker Körper verhandelt bessere Deals mit dem Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-12",
      "text": "Trainiere, als würde dein zukünftiges Ich zusehen – das tut es.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-13",
      "text": "Kraft ist aufgeschobene Bequemlichkeit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-14",
      "text": "Ausdauer im Training ist Ausdauer im Business.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-15",
      "text": "Dein Energielevel entscheidet, wie teuer dein Tag wird.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-16",
      "text": "Jede Wiederholung ist ein Vorschuss auf später.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-17",
      "text": "Schlaf ist kein Luxus, sondern dein größter Hebel.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-18",
      "text": "Wer sich bewegt, denkt schneller – und entscheidet klüger.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-19",
      "text": "Fitness ist kein Ziel, sondern ein Zinseszins-Konto.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-20",
      "text": "Ein kalter Duschstrahl schlägt jeden Espresso.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-21",
      "text": "Dein Körper merkt sich jede verpasste Einheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-22",
      "text": "Stärke baut man nicht im Kopf, sondern unter Last.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-23",
      "text": "Wer heute schwitzt, muss morgen nicht betteln.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-24",
      "text": "Energie ist die einzige Ressource, die du täglich neu verdienst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-25",
      "text": "Bewegung ist der Reset-Knopf für einen überhitzten Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-26",
      "text": "Dein Training ist der stille Vorsprung, den keiner sieht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-27",
      "text": "Konsequenz schlägt Motivation – jeden einzelnen Tag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-28",
      "text": "Ein trainierter Körper lügt nicht über harte Arbeit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-29",
      "text": "Wer seine Energie managt, managt sein ganzes Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-10-26-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist der Boden, von dem aus du startest.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-1",
      "text": "Du brauchst nicht mehr Erfolg, um dankbar zu sein - du brauchst mehr Aufmerksamkeit für das, was schon da ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-2",
      "text": "Dankbarkeit ist die einzige Investition, die sofort Rendite bringt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-3",
      "text": "Wer zufrieden ist mit dem Jetzt, verschwendet keine Energie an das Gestern.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-4",
      "text": "Dein aktuelles Leben war mal dein größter Traum - vergiss das nicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-5",
      "text": "Erfolg ohne Dankbarkeit ist nur ein lauteres Leeregefühl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-6",
      "text": "Zufriedenheit schlägt jeden Status, den du dir kaufen kannst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-7",
      "text": "Du jagst Ziele, während du übersiehst, was du schon erreicht hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-8",
      "text": "Dankbarkeit ist kein Gefühl, das kommt - es ist eine Entscheidung, die du triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-9",
      "text": "Dein Konto zeigt Zahlen, dein Leben zeigt Reichtum - schau genauer hin.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-10",
      "text": "Wer nie zufrieden ist, wird auch mit mehr nie genug haben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-11",
      "text": "Dankbar sein heißt nicht stehen bleiben, sondern bewusst weitergehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-12",
      "text": "Du hast heute Dinge, für die andere jahrelang gebetet haben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-13",
      "text": "Zufriedenheit ist der stille Antrieb hinter den lautesten Erfolgen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-14",
      "text": "Vergleiche killen Dankbarkeit schneller als jeder Rückschlag.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-15",
      "text": "Dein Morgen-Kaffee, dein warmes Bett, dein Puls - alles unverdiente Geschenke.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-16",
      "text": "Ambition ohne Dankbarkeit frisst dich von innen auf.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-17",
      "text": "Du bist schon die Version, von der du vor fünf Jahren geträumt hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-18",
      "text": "Zufriedenheit ist keine Schwäche, sie ist die Energiequelle für den nächsten Schritt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-19",
      "text": "Dankbarkeit macht aus genug ein Fest und aus wenig einen Reichtum.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-20",
      "text": "Wer dankbar lebt, verliert nie den Boden unter den Füßen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-21",
      "text": "Dein größter Flex ist innere Ruhe, nicht dein nächster Erfolg.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-22",
      "text": "Zufriedenheit ist kein Stillstand, sondern der Moment vor dem nächsten Sprung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-23",
      "text": "Du hast mehr erreicht, als dein innerer Kritiker dir erlaubt zuzugeben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-24",
      "text": "Dankbarkeit ist der Zinseszins für ein erfülltes Leben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-25",
      "text": "Genug ist ein Gefühl, kein Kontostand.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-26",
      "text": "Du brauchst keinen Grund zur Freude - du brauchst nur den Blick dafür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-27",
      "text": "Zufriedenheit heute macht Ambition morgen nachhaltig.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-28",
      "text": "Dankbar sein kostet nichts und verändert alles.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-29",
      "text": "Dein Leben ist kein Mangel, den du füllen musst, sondern ein Geschenk, das du nutzt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    }
  ]
}