{
  "generatedAt": "2026-10-21",
  "quotes": [
    {
      "id": "mindset-2026-10-21-0",
      "text": "Disziplin ist der Zinseszins der Persönlichkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-1",
      "text": "Dein Kopf glaubt jede Ausrede, die du ihm oft genug erzählst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-2",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-3",
      "text": "Wer auf Gefühle wartet, wartet sein ganzes Leben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-4",
      "text": "Schwache Momente sind keine Charaktereigenschaft, sondern nur ein Zustand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-5",
      "text": "Dein Limit ist meistens nur ein schlecht verhandelter Kompromiss.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-6",
      "text": "Komfort ist der Ort, an dem Potenzial verhungert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-7",
      "text": "Du wirst nicht durch Pläne stark, sondern durch das, was du trotz Plänen durchziehst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-8",
      "text": "Jede Ausrede klingt gut, bis du sie laut aussprichst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-9",
      "text": "Stärke entsteht nicht im Erfolg, sondern in der Wiederholung nach dem Scheitern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-10",
      "text": "Dein innerer Kritiker hat keine Beweise, nur Lautstärke.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-11",
      "text": "Wer ständig auf den perfekten Moment wartet, verpasst alle unperfekten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-12",
      "text": "Mentale Stärke ist kein Mindset, sondern ein Trainingsplan.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-13",
      "text": "Du verlierst nicht gegen andere, du verlierst gegen deinen inneren Dialog.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-14",
      "text": "Gedanken sind Mieter, keine Eigentümer - wirf die schlechten raus.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-15",
      "text": "Der Unterschied zwischen Stillstand und Fortschritt ist eine einzige Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-16",
      "text": "Dein Unterbewusstsein merkt sich jede Ausrede als Präzedenzfall.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-17",
      "text": "Wachstum fühlt sich nie nach Fortschritt an, solange er passiert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-18",
      "text": "Wer sich selbst nicht führt, wird von seiner Laune geführt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-19",
      "text": "Disziplin fragt nicht nach deiner Stimmung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-20",
      "text": "Der Moment, in dem du aufgeben willst, ist der Moment, der dich definiert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-21",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-22",
      "text": "Erfolg fragt nicht, wie du dich heute fühlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-23",
      "text": "Klarheit entsteht nicht durch Nachdenken, sondern durch Handeln.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-24",
      "text": "Dein zukünftiges Ich zahlt die Zinsen deiner heutigen Bequemlichkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-25",
      "text": "Wer sich selbst belügt, verliert zuerst den Respekt vor sich selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-26",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-27",
      "text": "Stärke ist keine Stimmung, sondern eine Entscheidung, die du wiederholst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-28",
      "text": "Dein Verstand testet täglich, wie ernst du es wirklich meinst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-29",
      "text": "Die lauteste Stimme in deinem Kopf ist selten die klügste.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-10-21-0",
      "text": "Disziplin schlägt Motivation an jedem einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-1",
      "text": "Dein Kontostand ist nur die Quittung deiner Gewohnheiten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-2",
      "text": "Wer um 6 Uhr plant, gewinnt die Schlacht um 12.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-3",
      "text": "Ausreden sind die Währung der Ahnungslosen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-4",
      "text": "Baue dein Imperium in der Stille, bevor andere aufwachen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-5",
      "text": "Produktivität ist kein Zufall, sondern eine Entscheidung vor dem Frühstück.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-6",
      "text": "Jeder ungenutzte Tag ist eine verlorene Investition in dich selbst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-7",
      "text": "Komfort ist der leise Killer großer Ziele.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-8",
      "text": "Wachstum passiert nicht im Warten, sondern im Machen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-9",
      "text": "Dein Zukunfts-Ich zahlt den Preis für deine heutige Faulheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-10",
      "text": "Wer Strukturen baut, braucht keine Motivation mehr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-11",
      "text": "Erfolg ist das, was übrig bleibt, wenn du aufhörst zu zögern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-12",
      "text": "Zeit ist dein einziges unkopierbares Asset – handle danach.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-13",
      "text": "Kleine Systeme schlagen große Träume ohne Plan.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-14",
      "text": "Niemand bewundert den Plan – alle bewundern das Ergebnis.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-15",
      "text": "Fokus ist die neue Währung der Macher.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-16",
      "text": "Du verhandelst nicht mit deinem inneren Schweinehund, du überholst ihn.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-17",
      "text": "Dein Kalender verrät mehr über deine Ziele als dein Mund.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-18",
      "text": "Reichtum beginnt mit der Disziplin, einen Tag durchzuziehen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-19",
      "text": "Konsequenz ist unsexy, aber sie bezahlt die Rechnungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-20",
      "text": "Wer aufschiebt, verkauft seine Zukunft für billige Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-21",
      "text": "Baue heute das System, das dich morgen trägt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-22",
      "text": "Energie-Management schlägt Zeit-Management.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-23",
      "text": "Dein Netzwerk ist dein Net Worth – investiere klug.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-24",
      "text": "Große Ziele sterben an kleinen, unerledigten Aufgaben.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-25",
      "text": "Mach aus Montag keinen Gegner, sondern deinen Vorsprung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-26",
      "text": "Wer nicht plant, arbeitet für den, der plant.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-27",
      "text": "Dein Mindset ist der erste Umsatz, den du generierst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-28",
      "text": "Stillstand fühlt sich sicher an und kostet dich trotzdem alles.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-29",
      "text": "Echte Freiheit beginnt da, wo die Ausreden aufhören.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-10-21-0",
      "text": "Disziplin ist der Deal, den du mit deinem zukünftigen Ich machst – und einhältst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-1",
      "text": "Motivation ist ein Gast. Disziplin wohnt bei dir.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-2",
      "text": "Du verhandelst nicht mit dir selbst. Du machst einfach.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-3",
      "text": "Der Unterschied zwischen Träumen und Ergebnissen heißt Montag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-4",
      "text": "Keiner sieht die 500 Wiederholungen. Alle sehen das eine Resultat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-5",
      "text": "Dein Comfort-Zone-Abo kündigst du heute.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-6",
      "text": "Wer auf Lust wartet, wartet ein Leben lang.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-7",
      "text": "Langweilig ist der Preis für außergewöhnlich.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-8",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-9",
      "text": "Disziplin fühlt sich nie gut an. Nur die Ergebnisse.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-10",
      "text": "Gewohnheiten schlagen Gefühle. Jedes Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-11",
      "text": "Zeig auf, auch wenn niemand klatscht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-12",
      "text": "Kleine Schritte, die du wiederholst, schlagen große Pläne, die du aufschiebst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-13",
      "text": "Konsequenz ist unsexy. Erfolg ist die Rechnung dafür.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-14",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Faulheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-15",
      "text": "Wer aufgibt, verliert nur die Zeit, die er schon investiert hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-16",
      "text": "Disziplin ist leise. Ausreden sind laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-17",
      "text": "Du musst nicht motiviert sein. Du musst nur anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-18",
      "text": "Perfekt ist der Feind von erledigt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-19",
      "text": "Niemand rettet deinen Tag. Du übernimmst ihn.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-20",
      "text": "Harte Tage bauen die Version von dir, die du sein willst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-21",
      "text": "Du trainierst nicht den Körper. Du trainierst den Willen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-22",
      "text": "Stillstand fühlt sich sicher an. Genau deshalb ist er gefährlich.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-23",
      "text": "Mach es, bevor dein Kopf anfängt zu diskutieren.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-24",
      "text": "Erfolg ist kein Funke. Er ist ein Feuer, das du täglich nährst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-25",
      "text": "Du bist nicht im Rückstand. Du hast nur noch nicht angefangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-26",
      "text": "Disziplin ist die Entscheidung, die du vor der Entscheidung triffst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-27",
      "text": "Es gibt keinen Belohnungsschein für Ausreden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-28",
      "text": "Die Wiederholung ist unsichtbar. Das Ergebnis ist es nicht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-29",
      "text": "Wer durchhält, wenn es sinnlos erscheint, gewinnt, wenn es zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-10-21-0",
      "text": "Dein Körper ist dein erstes Investment – alles andere baut darauf auf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-1",
      "text": "Energie ist die einzige Währung, die du dir nicht leihen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-2",
      "text": "Kein Zinseszins schlägt den Effekt von täglichem Training.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-3",
      "text": "Müde Beine heute bauen eine starke Zukunft morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-4",
      "text": "Wer seinen Körper vernachlässigt, verliert auf allen anderen Konten mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-5",
      "text": "Schweiß ist die Quittung für harte Arbeit an dir selbst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-6",
      "text": "Ein trainierter Körper denkt klarer als ein müder Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-7",
      "text": "Du kannst nicht performen, wenn dein System leer ist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-8",
      "text": "Bewegung ist das günstigste Antidepressivum, das du nie nutzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-9",
      "text": "Dein Energielevel entscheidet, wie weit dein Tag wirklich reicht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-10",
      "text": "Disziplin im Training zahlt sich in jedem anderen Lebensbereich aus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-11",
      "text": "Starke Muskeln, starker Wille – beide trainierst du gleichzeitig.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-12",
      "text": "Wer morgens schwitzt, denkt mittags schärfer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-13",
      "text": "Körper ist Hardware, Mindset ist Software – beides braucht Updates.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-14",
      "text": "Ausreden verbrennen keine Kalorien.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-15",
      "text": "Dein Körper merkt sich jeden Tag, an dem du ihn ignoriert hast.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-16",
      "text": "Fitness ist kein Ziel, sondern dein Betriebssystem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-17",
      "text": "Jede Wiederholung ist eine Einzahlung auf dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-18",
      "text": "Ohne Energie-Management gibt es kein Zeit-Management.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-19",
      "text": "Dein Puls entscheidet, wie schnell du deine Ziele erreichst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-20",
      "text": "Wer sich körperlich fordert, fordert sich mental automatisch mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-21",
      "text": "Bewegung ist der Reset-Knopf für einen überlasteten Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-22",
      "text": "Kraft im Körper macht Kraft im Kopf erst verfügbar.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-23",
      "text": "Du trainierst nicht für den Sommer, du trainierst für den Alltag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-24",
      "text": "Ein fitter Körper liefert täglich mehr Output bei gleichem Input.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-25",
      "text": "Schlaf, Training, Ernährung – deine drei stillen Teilhaber.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-26",
      "text": "Wer seine Energie managt, braucht weniger Motivation.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-27",
      "text": "Dein Körper ist das einzige Büro, das du nie wechseln kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-28",
      "text": "Stärke wird nicht verliehen, sie wird jeden Tag neu erarbeitet.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-29",
      "text": "Ein geladener Körper macht ungeladene Ausreden überflüssig.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-10-21-0",
      "text": "Dankbarkeit ist kein Soft Skill, sondern dein mentales Fundament.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-1",
      "text": "Du musst nicht alles erreicht haben, um heute zufrieden einzuschlafen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-2",
      "text": "Zufriedenheit ist der Zwischenstand, nicht das Ende deiner Reise.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-3",
      "text": "Wer nichts wertschätzt, läuft ewig dem nächsten Ziel hinterher.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-4",
      "text": "Dankbarkeit kostet nichts, verändert aber deine ganze Wahrnehmung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-5",
      "text": "Du vergleichst dein Jetzt mit fremden Highlights. Hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-6",
      "text": "Zufriedenheit ist kein Stillstand, sie ist dein Energiespeicher.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-7",
      "text": "Drei Dinge, für die du heute dankbar bist, schlagen drei neue To-dos.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-8",
      "text": "Du hast schon mehr geschafft, als dein innerer Kritiker zugibt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-9",
      "text": "Dankbarkeit ist die einzige App, die dein Mindset wirklich aufräumt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-10",
      "text": "Wer das Jetzt nicht wertschätzt, verpasst die Hälfte seines Erfolgs.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-11",
      "text": "Zufriedenheit heute macht dich morgen nicht langsamer, sondern stabiler.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-12",
      "text": "Du brauchst keinen Grund für Dankbarkeit, nur einen Moment Stille.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-13",
      "text": "Erfolg ohne Dankbarkeit ist nur ein Zahlenspiel ohne Bedeutung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-14",
      "text": "Dein Leben jetzt war mal der Traum von jemandem vor einem Jahr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-15",
      "text": "Zufriedenheit ist kein Ziel, sie ist eine Entscheidung, die du täglich triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-16",
      "text": "Du musst nicht mehr haben wollen, um dankbar sein zu können.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-17",
      "text": "Dankbarkeit macht aus genug ein Gefühl, nicht aus Zahlen eine Grenze.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-18",
      "text": "Wer zufrieden ist, verhandelt nicht mehr mit der Vergangenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-19",
      "text": "Dein Fortschritt zählt mehr als die Distanz zum Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-20",
      "text": "Dankbarkeit ist der Unterschied zwischen Ankommen und Ausruhen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-21",
      "text": "Du bist nicht spät dran. Du bist genau da, wo du sein musst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-22",
      "text": "Zufriedenheit ist leise. Erfolg ist laut. Beides gehört dir.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-23",
      "text": "Dankbar sein heißt nicht aufhören zu wollen, sondern aufhören zu hadern.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-24",
      "text": "Du feierst nie das, was du schon hast, nur das, was noch fehlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-25",
      "text": "Zufriedenheit ist kein Trostpreis für die, die aufgegeben haben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-26",
      "text": "Dankbarkeit verwandelt Druck in Perspektive.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-27",
      "text": "Du hast genug Gründe zu lächeln, auch ohne nächsten Meilenstein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-28",
      "text": "Zufriedenheit ist dein Ruhepuls, Ambition ist dein Sprint. Beides zählt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-29",
      "text": "Wer dankbar lebt, verliert nicht an Antrieb, sondern gewinnt an Klarheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    }
  ]
}