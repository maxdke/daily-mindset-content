{
  "generatedAt": "2026-11-14",
  "quotes": [
    {
      "id": "mindset-2026-11-14-0",
      "text": "Disziplin ist der Zins, den du zahlst, bevor dein Leben sich verzinst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-1",
      "text": "Deine Ausreden klingen gut, deine Ergebnisse bleiben trotzdem aus.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-2",
      "text": "Motivation ist ein Gast. Disziplin zieht bei dir ein.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-3",
      "text": "Du musst dich nicht gut fühlen, um gut zu handeln.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-4",
      "text": "Wer auf perfekte Bedingungen wartet, wartet sein Leben lang.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-5",
      "text": "Schwache Tage sind kein Grund, schwache Entscheidungen zu treffen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-6",
      "text": "Dein Kopf gibt oft lange vor deinem Körper auf. Trainiere beide.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-7",
      "text": "Komfort ist der leiseste Dieb deiner Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-8",
      "text": "Niemand rettet dich. Das ist die beste Nachricht des Tages.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-9",
      "text": "Stärke entsteht nicht im Erfolg, sondern im Weitermachen danach.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-10",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-11",
      "text": "Der innere Kritiker lügt am lautesten kurz vor deinem Durchbruch.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-12",
      "text": "Mentale Stärke heißt: handeln, obwohl der Zweifel mitredet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-13",
      "text": "Du verhandelst nicht mit deiner Zukunft. Du arbeitest für sie.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-14",
      "text": "Wer sich selbst Ausnahmen erlaubt, baut sich selbst eine Falle.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-15",
      "text": "Klarheit entsteht nicht im Denken, sondern im Tun.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-16",
      "text": "Dein Standard ist das, was du wiederholt tolerierst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-17",
      "text": "Angst verschwindet nicht durch Warten, sondern durch Handeln.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-18",
      "text": "Du brauchst keine Inspiration. Du brauchst einen Plan.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-19",
      "text": "Jeder Tag ohne Fortschritt ist eine stille Entscheidung gegen dich selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "mindset-2026-12-04-20",
      "text": "Deine Gedanken sind Mieter. Du entscheidest, wer bleibt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-04"
    },
    {
      "id": "mindset-2026-12-05-21",
      "text": "Stärke zeigt sich nicht laut, sondern in der stillen Wiederholung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-05"
    },
    {
      "id": "mindset-2026-12-06-22",
      "text": "Wer ständig Sicherheit sucht, verpasst jedes Wachstum.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-06"
    },
    {
      "id": "mindset-2026-12-07-23",
      "text": "Dein Limit ist meistens nur eine schlecht geprüfte Annahme.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-07"
    },
    {
      "id": "mindset-2026-12-08-24",
      "text": "Disziplin fühlt sich nach nichts an – bis sie alles verändert hat.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-08"
    },
    {
      "id": "mindset-2026-12-09-25",
      "text": "Du musst nicht motiviert sein. Du musst nur konsequent sein.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-09"
    },
    {
      "id": "mindset-2026-12-10-26",
      "text": "Der Widerstand, den du spürst, ist oft das Zeichen, dass es wichtig ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-10"
    },
    {
      "id": "mindset-2026-12-11-27",
      "text": "Kontrolliere deinen Fokus, bevor andere ihn für dich übernehmen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-11"
    },
    {
      "id": "mindset-2026-12-12-28",
      "text": "Unbequemlichkeit ist der Preis für ein Leben, das sich lohnt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-12"
    },
    {
      "id": "mindset-2026-12-13-29",
      "text": "Du wirst nicht stärker durch Pläne, sondern durch Wiederholung unter Druck.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-13"
    },
    {
      "id": "business-2026-11-14-0",
      "text": "Disziplin schlägt Motivation, jedes einzelne Mal.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-1",
      "text": "Dein Kontostand ist nur der Nachweis deiner Entscheidungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-2",
      "text": "Während andere Ausreden sammeln, sammelst du Ergebnisse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-3",
      "text": "Ein Tag ohne Fortschritt ist ein Tag für die Konkurrenz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-4",
      "text": "Deine Komfortzone zahlt keine Rechnungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-5",
      "text": "Plane wie ein CEO, arbeite wie ein Praktikant.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-6",
      "text": "Wer um 6 Uhr aufsteht, überholt die, die um 10 Uhr aufwachen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-7",
      "text": "Zeit ist das einzige Investment, das du nie zurückbekommst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-8",
      "text": "Erfolg ist kein Zufall, sondern ein Kalendereintrag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-9",
      "text": "Du baust entweder dein Business oder das von jemand anderem.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-10",
      "text": "Konsequenz ist das Vermögen der Unscheinbaren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-11",
      "text": "Jede Stunde Ablenkung ist eine Stunde für deinen Konkurrenten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-12",
      "text": "Dein Umsatz wächst, sobald deine Ausreden schrumpfen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-13",
      "text": "Arbeite leise, lass die Zahlen sprechen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-14",
      "text": "Risiko ist der Preis für ein Leben außerhalb der Masse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-15",
      "text": "Wer auf den perfekten Moment wartet, verpasst jeden Moment.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-16",
      "text": "Dein Netzwerk entscheidet, wie schnell dein Business wächst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-17",
      "text": "Fokus ist die neue Währung der Erfolgreichen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-18",
      "text": "Mach aus deinem Side-Hustle deinen Hauptjob.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-19",
      "text": "Jede Ablenkung kostet dich einen Kunden mehr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-12-04-20",
      "text": "Du verhandelst nicht mit deiner Zukunft, du baust sie.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-04"
    },
    {
      "id": "business-2026-12-05-21",
      "text": "Produktivität beginnt, wo Ausreden enden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-05"
    },
    {
      "id": "business-2026-12-06-22",
      "text": "Dein Pitch muss sitzen, bevor die Idee verkauft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-06"
    },
    {
      "id": "business-2026-12-07-23",
      "text": "Nicht die Idee macht reich, sondern die Umsetzung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-07"
    },
    {
      "id": "business-2026-12-08-24",
      "text": "Wer nicht skaliert, stagniert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-08"
    },
    {
      "id": "business-2026-12-09-25",
      "text": "Dein erstes Investment ist Selbstdisziplin.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-09"
    },
    {
      "id": "business-2026-12-10-26",
      "text": "Erfolgreiche Menschen erledigen, was andere aufschieben.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-10"
    },
    {
      "id": "business-2026-12-11-27",
      "text": "Ein volles Postfach bremst dich, ein voller Umsatz treibt dich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-11"
    },
    {
      "id": "business-2026-12-12-28",
      "text": "Gewinner optimieren Prozesse, Verlierer optimieren Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-12"
    },
    {
      "id": "business-2026-12-13-29",
      "text": "Baue Systeme, nicht nur Stunden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-13"
    },
    {
      "id": "discipline-2026-11-14-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-1",
      "text": "Motivation checkt aus, Disziplin bleibt und macht den Job fertig.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-2",
      "text": "Du musst nicht wollen. Du musst nur machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-3",
      "text": "Jeder Tag ohne Ausrede ist ein Tag mehr Vorsprung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-4",
      "text": "Durchhalten ist langweilig. Aufgeben ist teurer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-5",
      "text": "Komfort ist der Ort, an dem Träume verhungern.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-6",
      "text": "Wer auf Motivation wartet, verliert gegen den, der einfach anfängt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-7",
      "text": "Disziplin fühlt sich nie gut an - bis sie dein Leben verändert hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-8",
      "text": "Die Ausrede von heute ist die Reue von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-9",
      "text": "Du wirst nicht aufwachen und Lust haben. Du stehst trotzdem auf.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-10",
      "text": "Konsequenz schlägt Talent, jeden einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-11",
      "text": "Null Bock ist kein Grund, null zu tun.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-12",
      "text": "Gewohnheiten bauen das Leben, das Willenskraft allein nicht halten kann.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-13",
      "text": "Wer stoppt, wenn's unangenehm wird, bleibt für immer auf dem gleichen Level.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-14",
      "text": "Disziplin ist Freiheit in Verkleidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-15",
      "text": "Die harte Phase ist der Teil, der dich von allen anderen unterscheidet.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-16",
      "text": "Du brauchst keine Inspiration. Du brauchst einen Plan und die Härte, ihn durchzuziehen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-17",
      "text": "Jeder Tag, den du durchziehst, ist ein Beweis gegen deine alten Zweifel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-18",
      "text": "Aufgeben ist leise. Durchhalten ist lauter als jede Ausrede.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-19",
      "text": "Dein Standard von heute ist dein Limit von morgen - leg die Latte höher.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-12-04-20",
      "text": "Disziplin heißt, dein Ziel mehr zu lieben als deine Laune.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-04"
    },
    {
      "id": "discipline-2026-12-05-21",
      "text": "Die Leute sehen das Ergebnis. Niemand sieht die 100 Tage davor, an denen du trotzdem weitergemacht hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-05"
    },
    {
      "id": "discipline-2026-12-06-22",
      "text": "Wenn's leicht wäre, würde es jeder machen. Genau deshalb machst du's.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-06"
    },
    {
      "id": "discipline-2026-12-07-23",
      "text": "Disziplin ist die Brücke zwischen dem, was du willst, und dem, was du bekommst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-07"
    },
    {
      "id": "discipline-2026-12-08-24",
      "text": "Du verlierst nicht, wenn du scheiterst. Du verlierst, wenn du aufhörst, es erneut zu versuchen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-08"
    },
    {
      "id": "discipline-2026-12-09-25",
      "text": "Härte ist kein Zustand. Härte ist eine Entscheidung, die du jeden Morgen triffst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-09"
    },
    {
      "id": "discipline-2026-12-10-26",
      "text": "Konstanz ist das stille Superpower, das niemand sieht, bis es dich unaufhaltbar macht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-10"
    },
    {
      "id": "discipline-2026-12-11-27",
      "text": "Dein Durchhaltevermögen heute entscheidet, wie frei du morgen lebst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-11"
    },
    {
      "id": "discipline-2026-12-12-28",
      "text": "Deine Zukunft fragt nicht, wie du dich fühltest. Sie fragt, ob du dran geblieben bist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-12"
    },
    {
      "id": "discipline-2026-12-13-29",
      "text": "Der Unterschied zwischen Träumen und Zielen ist der Tag, an dem du trotzdem aufstehst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-13"
    },
    {
      "id": "fitness-2026-11-14-0",
      "text": "Dein Körper ist dein größter Zinseszins – investier täglich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-1",
      "text": "Energie ist die einzige Währung, die du dir nicht leihen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-2",
      "text": "Wer seinen Körper vernachlässigt, verliert sein wichtigstes Werkzeug.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-3",
      "text": "Müdigkeit ist keine Tatsache, sondern eine Entscheidung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-4",
      "text": "Dein Workout heute ist dein Vorsprung morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-5",
      "text": "Disziplin im Training formt Disziplin im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-6",
      "text": "Kraft entsteht nicht durch Motivation, sondern durch Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-7",
      "text": "Ein starker Körper trägt einen klaren Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-8",
      "text": "Du trainierst nicht für den Sommer, sondern für jeden Tag danach.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-9",
      "text": "Bewegung ist der Preis, den dein Körper für Energie verlangt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-10",
      "text": "Wer schwitzt, verdient sich Klarheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-11",
      "text": "Dein Limit von gestern ist dein Aufwärmen von heute.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-12",
      "text": "Energie zu managen schlägt Zeit zu managen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-13",
      "text": "Kein Ziel übersteht einen erschöpften Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-14",
      "text": "Trainiere, als hinge dein Leben davon ab – es tut es.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-15",
      "text": "Ausdauer im Training wird Ausdauer im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-16",
      "text": "Du bist nicht müde, du bist unterfordert von deinem Potenzial.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-17",
      "text": "Jeder Trainingsschritt ist eine Einzahlung auf dein Zukunfts-Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-18",
      "text": "Dein Körper merkt sich jede Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-19",
      "text": "Fitness ist der Zinseszins deiner Gesundheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-12-04-20",
      "text": "Bewegung schlägt jeden Energy-Drink.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-04"
    },
    {
      "id": "fitness-2026-12-05-21",
      "text": "Du kannst nicht optimieren, was du nicht trainierst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-05"
    },
    {
      "id": "fitness-2026-12-06-22",
      "text": "Dein Puls heute entscheidet über deine Power morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-06"
    },
    {
      "id": "fitness-2026-12-07-23",
      "text": "Stärke entsteht nicht im Kopf, sondern in der Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-07"
    },
    {
      "id": "fitness-2026-12-08-24",
      "text": "Ein trainierter Körper ist dein stiller Vorteil.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-08"
    },
    {
      "id": "fitness-2026-12-09-25",
      "text": "Schlaf ist dein Reset, Training ist dein Upgrade.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-09"
    },
    {
      "id": "fitness-2026-12-10-26",
      "text": "Wer sich bewegt, denkt schneller.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-10"
    },
    {
      "id": "fitness-2026-12-11-27",
      "text": "Dein Körper ist das einzige Asset, das du nie verkaufen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-11"
    },
    {
      "id": "fitness-2026-12-12-28",
      "text": "Kraft ist leise – sie zeigt sich erst im Ergebnis.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-12"
    },
    {
      "id": "fitness-2026-12-13-29",
      "text": "Dein nächstes Set entscheidet, wer du in zwei Jahren bist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-13"
    },
    {
      "id": "gratitude-2026-11-14-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist die Entscheidung, heute schon zu gewinnen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-1",
      "text": "Dankbarkeit ist dein unfairer Vorteil – sie macht aus Druck Energie.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-2",
      "text": "Wer das Jetzt nicht wertschätzt, verpasst die Hälfte seines Erfolgs.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-3",
      "text": "Zufriedenheit ist der stille Zinseszins der Dankbarkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-4",
      "text": "Du musst nicht alles haben, um reich an diesem Tag zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-5",
      "text": "Dankbarkeit kostet nichts und bringt mehr als jede Abkürzung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-6",
      "text": "Wer dankbar startet, performt den ganzen Tag auf einem anderen Level.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-7",
      "text": "Zufriedenheit ist nicht das Ende des Ehrgeizes, sondern sein ruhiger Motor.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-8",
      "text": "Du vergleichst dein Kapitel 3 mit fremdem Kapitel 20 – hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-9",
      "text": "Dankbarkeit ist die Pause, die dich schneller weiterlaufen lässt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-10",
      "text": "Was du heute besitzt, war gestern noch dein größter Wunsch.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-11",
      "text": "Zufriedenheit schlägt jeden Trend, weil sie nie out ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-12",
      "text": "Bleib ab und zu stehen und checke, was du schon erreicht hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-13",
      "text": "Dankbarkeit ist der Soundtrack, zu dem harte Arbeit leichter fällt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-14",
      "text": "Zufriedene Menschen verhandeln nicht mit dem Leben, sie gestalten es.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-15",
      "text": "Dein Konto wächst schneller, wenn dein Kopf nicht ständig Mangel denkt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-16",
      "text": "Dankbarkeit ist kein Luxus für später, sie ist Treibstoff für jetzt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-17",
      "text": "Wer zufrieden ist, verschwendet keine Energie an Neid.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-18",
      "text": "Du bist weiter, als du denkst – schau mal zurück statt nur nach vorn.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-19",
      "text": "Zufriedenheit heißt nicht aufhören, sondern klarer weitermachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-12-04-20",
      "text": "Dankbarkeit macht aus einem normalen Tag einen Vorsprung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-04"
    },
    {
      "id": "gratitude-2026-12-05-21",
      "text": "Du brauchst keinen Grund zu warten, um stolz auf dich zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-05"
    },
    {
      "id": "gratitude-2026-12-06-22",
      "text": "Zufriedenheit ist die Insel, auf der du Kraft für die nächste Welle tankst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-06"
    },
    {
      "id": "gratitude-2026-12-07-23",
      "text": "Dankbar sein heißt, deinen Fortschritt nicht kleinreden.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-07"
    },
    {
      "id": "gratitude-2026-12-08-24",
      "text": "Wer das Wenige wertschätzt, bekommt irgendwann das Viele.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-08"
    },
    {
      "id": "gratitude-2026-12-09-25",
      "text": "Zufriedenheit ist der Ruhepuls, mit dem du Höchstleistung bringst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-09"
    },
    {
      "id": "gratitude-2026-12-10-26",
      "text": "Dankbarkeit ist die Abkürzung zu echter Motivation.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-10"
    },
    {
      "id": "gratitude-2026-12-11-27",
      "text": "Du musst nicht glücklicher werden – nur öfter hinsehen, was schon gut läuft.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-11"
    },
    {
      "id": "gratitude-2026-12-12-28",
      "text": "Zufriedenheit ist Macht, die dir niemand nehmen kann.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-12"
    },
    {
      "id": "gratitude-2026-12-13-29",
      "text": "Dankbarkeit heute ist der Zins, den dein zukünftiges Ich dir dankt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-13"
    }
  ]
}