{
  "generatedAt": "2026-10-24",
  "quotes": [
    {
      "id": "mindset-2026-10-24-0",
      "text": "Disziplin ist die Stimme, die lauter wird, wenn Motivation längst schweigt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-1",
      "text": "Dein Kopf gibt nicht auf, weil er müde ist, sondern weil er bequem ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-2",
      "text": "Schwache Momente sind keine Charakterfehler, sondern Trainingseinheiten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-3",
      "text": "Wer sich selbst belügt, verliert jeden Kampf, bevor er begonnen hat.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-4",
      "text": "Mentale Stärke entsteht nicht im Erfolg, sondern im stillen Weitermachen danach.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-5",
      "text": "Du bist nicht gestresst, du bist unvorbereitet auf dich selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-6",
      "text": "Komfort ist der leiseste Dieb deiner Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-7",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-8",
      "text": "Dein Verstand testet dich nicht, um dich zu stoppen, sondern um dich zu formen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-9",
      "text": "Wer aufgibt, verliert nichts außer der Version, die er hätte werden können.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-10",
      "text": "Stärke zeigt sich nicht im Lärm, sondern in der Ruhe nach dem Rückschlag.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-11",
      "text": "Du musst dich nicht motiviert fühlen, du musst nur weitermachen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-12",
      "text": "Innere Stärke wächst dort, wo Ausreden aufhören zu funktionieren.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-13",
      "text": "Nicht jeder schlechte Tag ist ein Rückschritt, manche sind nur Pausen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-14",
      "text": "Dein größter Gegner trägt deinen eigenen Namen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-15",
      "text": "Mentale Stärke ist die Fähigkeit, unbequem zu bleiben, wenn es leicht wäre aufzuhören.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-16",
      "text": "Du wächst nicht trotz Widerstand, sondern genau durch ihn.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-17",
      "text": "Wer ständig Bestätigung braucht, hat sein Fundament noch nicht gefunden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-18",
      "text": "Angst verschwindet nicht durch Warten, sondern durch Handeln trotz ihr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-19",
      "text": "Deine Gedanken sind Mieter, nicht Besitzer deines Kopfes.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-20",
      "text": "Konsequenz schlägt Intensität, jeden Tag, ohne Ausnahme.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-21",
      "text": "Du verlierst nicht an schwierigen Tagen, du gewinnst an ihnen heimlich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-22",
      "text": "Selbstdisziplin fühlt sich zuerst wie Verzicht an, später wie Freiheit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-23",
      "text": "Keine Stimmung der Welt ist stärker als eine klare Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-24",
      "text": "Du bist nicht das, was du denkst, sondern das, was du trotzdem tust.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-25",
      "text": "Wer sich selbst führen kann, braucht keine äußere Erlaubnis mehr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-26",
      "text": "Rückschläge sind kein Stopp, sie sind eine Neuausrichtung mit Tempo.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-27",
      "text": "Dein Unterbewusstsein glaubt jedes Wort, das du über dich selbst sagst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-28",
      "text": "Stärke ist kein Gefühl, es ist eine tägliche Entscheidung ohne Applaus.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-29",
      "text": "Du musst nicht bereit sein, du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-10-24-0",
      "text": "Motivation bringt dich an den Start, Systeme bringen dich ins Ziel.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-1",
      "text": "Du musst nicht jeden Tag motiviert sein, nur konsequent.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-2",
      "text": "Wer auf den perfekten Moment wartet, verpasst den einzig richtigen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-3",
      "text": "Dein Kalender zeigt, was dir wirklich wichtig ist – nicht dein Mund.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-4",
      "text": "Kleine Entscheidungen heute, großer Vorsprung morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-5",
      "text": "Wachstum fühlt sich selten bequem an.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-6",
      "text": "Ausreden sind die Währung der Mittelmäßigkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-7",
      "text": "Wer alles optimiert außer sich selbst, optimiert nichts.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-8",
      "text": "Dein Netzwerk ist dein unsichtbares Gehalt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-9",
      "text": "Fokus schlägt Talent, wenn Talent sich verzettelt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-10",
      "text": "Plane dein Jahr in Quartalen, nicht in Wünschen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-11",
      "text": "Wer zu viele Optionen offenhält, trifft keine Entscheidung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-12",
      "text": "Risiko ist nicht der Feind – Stillstand ist es.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-13",
      "text": "Dein zukünftiges Ich zahlt die Rechnung für deine heutige Faulheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-14",
      "text": "Ergebnisse reden, Meinungen verhallen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-15",
      "text": "Baue, während andere noch diskutieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-16",
      "text": "Konsistenz ist die unterschätzteste Form von Talent.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-17",
      "text": "Wer sein Ziel kennt, braucht keine Motivation, nur einen Plan.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-18",
      "text": "Geld folgt Problemen, die du löst – nicht Träumen, die du hast.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-19",
      "text": "Dein Umsatz wächst erst, wenn deine Komfortzone schrumpft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-20",
      "text": "Disziplin ist leiser als Motivation, aber hält länger durch.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-21",
      "text": "Wer jede Ablenkung zulässt, verliert den Wettlauf gegen sich selbst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-22",
      "text": "Nicht jede Stunde zählt gleich – manche zählen zehnmal.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-23",
      "text": "Erfolg ist das, was übrig bleibt, wenn du nicht aufgibst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-24",
      "text": "Zeit ist das einzige Kapital, das du nie nachschießen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-25",
      "text": "Wer nur plant, arbeitet nie. Wer nur arbeitet, plant falsch.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-26",
      "text": "Dein Umfeld bestimmt dein Tempo – wähle es bewusst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-27",
      "text": "Jeder Tag ohne Fortschritt ist ein Tag für die Konkurrenz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-28",
      "text": "Lerne schneller, als sich der Markt verändert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-29",
      "text": "Perfektion ist der Feind von Fertig – und Fertig schlägt immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-10-24-0",
      "text": "Disziplin ist der Zinseszins der Gewohnheiten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-1",
      "text": "Motivation bringt dich los, Disziplin bringt dich durch.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-2",
      "text": "Du musst nicht wollen. Du musst nur machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-3",
      "text": "Konsequenz schlägt Talent, wenn Talent nicht konsequent ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-4",
      "text": "Der Tag, an dem du keine Lust hast, zählt am meisten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-5",
      "text": "Gewohnheiten bauen das Leben, das Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-6",
      "text": "Du verhandelst nicht mit dir selbst. Du handelst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-7",
      "text": "Disziplin ist leise. Ausreden sind laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-8",
      "text": "Wer auf Stimmung wartet, wartet für immer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-9",
      "text": "Jeder Tag ohne Ausnahme ist ein Tag mehr Vorsprung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-10",
      "text": "Der Unterschied zwischen Wunsch und Ziel ist Wiederholung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-11",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-12",
      "text": "Disziplin fühlt sich nie gut an, bevor sie sich gut anfühlt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-13",
      "text": "Nicht die großen Tage zählen. Die normalen Tage entscheiden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-14",
      "text": "Bequemlichkeit ist der teuerste Kredit, den du aufnimmst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-15",
      "text": "Du trainierst nicht deinen Körper. Du trainierst deine Entscheidungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-16",
      "text": "Wer aufhört, wenn es schwer wird, hat nie angefangen, es ernst zu meinen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-17",
      "text": "Struktur ist Freiheit in Verkleidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-18",
      "text": "Du schuldest niemandem Erklärungen, außer dir selbst am Abend.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-19",
      "text": "Die Ausnahme von heute ist die Regel von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-20",
      "text": "Diszipliniert sein heißt, dem zukünftigen Ich nicht ständig Rechnungen zu schicken.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-21",
      "text": "Kein Ziel überlebt eine Woche ohne System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-22",
      "text": "Du machst es nicht, weil es leicht ist. Du machst es, weil es zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-23",
      "text": "Wiederholung ist die Sprache, die dein Unterbewusstsein versteht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-24",
      "text": "Perfekte Tage gibt es nicht. Nur Tage, an denen du weitergemacht hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-25",
      "text": "Dein Durchhaltevermögen ist größer als dein schlechtester Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-26",
      "text": "Disziplin ist die Entscheidung, die du triffst, bevor du gefragt wirst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-27",
      "text": "Niemand sieht die 500 Tage davor. Alle sehen das Ergebnis danach.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-28",
      "text": "Du brauchst keine Inspiration. Du brauchst einen Plan und Sturheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-29",
      "text": "Stillstand fühlt sich sicher an. Er ist der teuerste Fehler überhaupt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-10-24-0",
      "text": "Dein Körper ist der einzige Ort, aus dem du nicht kündigen kannst. Also mach ihn lebenswert.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-1",
      "text": "Energie klaust du nicht vom Kaffee, du verdienst sie dir im Training.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-2",
      "text": "Disziplin heute, Dopamin morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-3",
      "text": "Du willst Klarheit im Kopf? Fang bei den Beinen an.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-4",
      "text": "Müde ist ein Gefühl, kein Status. Beweg dich trotzdem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-5",
      "text": "Wer seinen Körper trainiert, trainiert seine Willenskraft gratis mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-6",
      "text": "Schwitzen ist der Preis, den du für Energie im Überfluss zahlst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-7",
      "text": "Bewegung ist das billigste Antidepressivum, das niemand nimmt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-8",
      "text": "Dein zukünftiges Ich trägt entweder deine Ausreden oder deine Fortschritte.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-9",
      "text": "Ein starker Körper macht leise Zweifel still.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-10",
      "text": "Du brauchst keine Motivation, du brauchst Schuhe und eine Tür.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-11",
      "text": "Fitness ist kein Ziel, es ist die Grundausstattung für alles andere.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-12",
      "text": "Wer bequem trainiert, bleibt bequem im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-13",
      "text": "Jeder Satz Wiederholungen ist ein Investment in deine nächsten zehn Jahre.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-14",
      "text": "Erschöpfung lügt. Nach drei Minuten kommt immer die zweite Luft.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-15",
      "text": "Du kannst nicht alles kontrollieren, aber dein Training heute schon.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-16",
      "text": "Kein Erfolg hält lange ohne einen Körper, der mithält.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-17",
      "text": "Trainiere wie jemand, der noch etwas zu beweisen hat.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-18",
      "text": "Dein Puls ist der Taktgeber für deine Produktivität.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-19",
      "text": "Wer sich morgens bewegt, verhandelt nicht mehr mit seiner Faulheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-20",
      "text": "Stärke baust du nicht in der Komfortzone, sondern eine Wiederholung danach.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-21",
      "text": "Ein Körper in Bewegung bringt auch den Kopf in Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-22",
      "text": "Du bist nicht zu müde. Du bist zu wenig in Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-23",
      "text": "Fitness ist die Zinsrechnung für ein Leben mit mehr Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-24",
      "text": "Belohn dich nicht mit Pause, belohn dich mit Fortschritt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-25",
      "text": "Ein Workout ersetzt keine Therapie, aber es schlägt jede Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-26",
      "text": "Wer stark sein will, muss zuerst unbequem werden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-27",
      "text": "Deine Energie heute entscheidet über deine Entscheidungen morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-28",
      "text": "Bewegung ist kein Programmpunkt, sie ist dein Betriebssystem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-29",
      "text": "Du hast keine Zeit zum Trainieren? Dann hast du erst recht keine zu verlieren.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-10-24-0",
      "text": "Dankbarkeit ist der Zinseszins der Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-1",
      "text": "Wer nicht dankbar für das Wenige ist, wird auch beim Vielen nicht zufrieden sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-2",
      "text": "Zufriedenheit ist kein Ziel, sondern eine Entscheidung, die du jeden Morgen triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-3",
      "text": "Du kannst nicht gleichzeitig dankbar und gestresst sein. Wähl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-4",
      "text": "Erfolg ohne Dankbarkeit ist nur ein leeres Konto mit vielen Nullen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-5",
      "text": "Dankbarkeit kostet nichts und bringt mehr als jede Investition.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-6",
      "text": "Wer das Jetzt nicht wertschätzt, verpasst sein eigenes Leben live.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-7",
      "text": "Zufriedenheit ist der stille Gewinn, den niemand auf Social Media zeigt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-8",
      "text": "Dankbar sein heißt nicht aufhören zu wollen, sondern anfangen zu sehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-9",
      "text": "Vergleich frisst Dankbarkeit wie Inflation dein Erspartes.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-10",
      "text": "Du bist nicht im Rückstand. Du bist einfach noch nicht fertig.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-11",
      "text": "Dankbarkeit ist das einzige Investment ohne Risiko und mit garantierter Rendite.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-12",
      "text": "Wer dankbar lebt, braucht keine Bestätigung von außen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-13",
      "text": "Zufriedenheit beginnt da, wo der Vergleich aufhört.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-14",
      "text": "Das Leben, das du willst, beginnt mit Dankbarkeit für das, was du hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-15",
      "text": "Dankbarkeit ist Fokus auf das, was funktioniert, statt auf das, was fehlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-16",
      "text": "Du musst nicht mehr haben, um zufrieden zu sein. Du musst mehr sehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-17",
      "text": "Zufriedenheit ist der Luxus, den sich Unzufriedene nicht leisten können.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-18",
      "text": "Dankbar sein ist kein Rückschritt, sondern dein stabilster Boden.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-19",
      "text": "Wer heute dankbar ist, verschwendet morgen keine Energie an Neid.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-20",
      "text": "Zufriedenheit ist nicht das Ende des Ehrgeizes, sondern sein Fundament.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-21",
      "text": "Du wächst schneller, wenn du nicht ständig gegen das Jetzt kämpfst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-22",
      "text": "Dankbarkeit macht aus genug ein Gefühl, nicht aus einer Zahl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-23",
      "text": "Wer nichts wertschätzt, dem wird auch nichts reichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-24",
      "text": "Zufriedenheit ist die Zinsgutschrift für ein dankbares Leben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-25",
      "text": "Dankbarkeit ist der Unterschied zwischen Ankommen und ewigem Unterwegssein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-26",
      "text": "Du bist schon weiter, als du dir selbst zugestehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-27",
      "text": "Zufriedenheit heute macht dich stärker für die Ziele von morgen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-28",
      "text": "Dankbarkeit ist produktiv, weil sie Energie spart statt sie zu verbrennen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-29",
      "text": "Wer das Jetzt nicht ehrt, wird auch das Später nicht genießen können.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    }
  ]
}