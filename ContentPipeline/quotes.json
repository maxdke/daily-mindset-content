{
  "generatedAt": "2026-10-19",
  "quotes": [
    {
      "id": "mindset-2026-10-19-0",
      "text": "Disziplin ist der Zinseszins der mentalen Stärke.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-1",
      "text": "Dein Kopf glaubt jede Ausrede, die du ihm oft genug erzählst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-2",
      "text": "Comfort Zones haben keine Fenster, du siehst nicht, was draußen wartet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-3",
      "text": "Motivation ist ein Gast, Disziplin ist der Hausbesitzer.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-4",
      "text": "Du verhandelst nicht mit deinem inneren Schweinehund, du überstimmst ihn.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-5",
      "text": "Schwache Tage bauen starke Routinen, nicht umgekehrt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-6",
      "text": "Dein Standard von heute ist dein Durchschnitt von morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-7",
      "text": "Wer auf Gefühle wartet, wartet ein Leben lang.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-8",
      "text": "Resilienz ist kein Talent, sondern eine tägliche Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-9",
      "text": "Dein Mindset ist der einzige Rohstoff, der nie ausgeht, wenn du ihn pflegst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-10",
      "text": "Starke Gedanken bauen starke Tage, nicht umgekehrt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-11",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-12",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-13",
      "text": "Dein Unterbewusstsein hört mit, wähle deine Worte über dich selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-14",
      "text": "Mentale Stärke zeigt sich nicht im Erfolg, sondern im Montagmorgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-15",
      "text": "Wer sich selbst führt, braucht keine Ausreden mehr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-16",
      "text": "Der Kopf gibt zuerst auf, der Körper könnte noch zehn Runden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-17",
      "text": "Du bist das Produkt deiner wiederholten Entscheidungen, nicht deiner Wünsche.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-18",
      "text": "Unbequem ist der Preis, Wachstum ist der Gegenwert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-19",
      "text": "Dein Limit ist meistens nur eine Meinung deines Gehirns von gestern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-20",
      "text": "Stärke entsteht nicht durch Motivation, sondern durch Wiederholung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-21",
      "text": "Wer jeden Tag kleine Siege sammelt, baut unsichtbare Festungen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-22",
      "text": "Dein innerer Kritiker hat keine Beweise, nur Gewohnheit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-23",
      "text": "Fokus schlägt Talent, wenn Talent keinen Fokus hat.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-24",
      "text": "Du musst nicht bereit sein, du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-25",
      "text": "Ausdauer ist die leise Schwester vom Erfolg.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-26",
      "text": "Deine Grenzen sind oft nur ungetestete Annahmen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-27",
      "text": "Jeder Tag ohne Ausrede ist ein Tag mit Zinsen auf dich selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-28",
      "text": "Dein Verstand folgt deiner Körperhaltung, nicht umgekehrt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-29",
      "text": "Wer aufhört zu zweifeln, fängt an zu bauen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-10-19-0",
      "text": "Motivation hält dich wach, Disziplin hält dich im Spiel.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-1",
      "text": "Deine Ausreden sind der teuerste Kredit, den du je aufgenommen hast.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-2",
      "text": "Comfort Zone ist nur ein anderes Wort für finanziellen Stillstand.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-3",
      "text": "Jeder Tag ohne Fortschritt ist eine stille Investition in Mittelmäßigkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-4",
      "text": "Wer auf den perfekten Moment wartet, zahlt mit verpasster Zeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-5",
      "text": "Dein Kontostand ist nur die Quittung deiner täglichen Entscheidungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-6",
      "text": "Fokus schlägt Talent, wenn Talent sich selbst ablenkt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-7",
      "text": "Risiko ist kein Gegner, sondern der Preis für echtes Wachstum.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-8",
      "text": "Wer morgens plant, führt abends Bilanz statt Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-9",
      "text": "Dein Netzwerk ist dein Nettovermögen von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-10",
      "text": "Hustle ohne Strategie ist nur teure Bewegung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-11",
      "text": "Erfolg fragt nicht nach deiner Stimmung, sondern nach deiner Routine.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-12",
      "text": "Jede Stunde Prokrastination ist eine stille Rechnung an dein Zukunfts-Ich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-13",
      "text": "Wer billig denkt, bleibt billig bezahlt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-14",
      "text": "Dein Kalender verrät mehr über deine Ziele als dein Mindset.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-15",
      "text": "Kleine Gewohnheiten sind der Zinseszins deines Charakters.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-16",
      "text": "Wachstum passiert nicht im Meeting, sondern in der Umsetzung danach.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-17",
      "text": "Wer nur Trends folgt, verpasst die Richtung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-18",
      "text": "Dein größter Konkurrent ist dein gestriges Niveau an Disziplin.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-19",
      "text": "Geld folgt Klarheit, nicht Lautstärke.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-20",
      "text": "Wer Ausreden sammelt, investiert in nichts.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-21",
      "text": "Produktivität beginnt da, wo Bequemlichkeit endet.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-22",
      "text": "Jede Entscheidung ist eine Investition – triff sie wie eine.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-23",
      "text": "Dein Mindset ist das einzige Startkapital, das niemand pfänden kann.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-24",
      "text": "Wer wartet, bis er bereit ist, verpasst, bereit zu werden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-25",
      "text": "Zeit ist die einzige Währung, die du nie zurückbekommst – gib sie klug aus.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-26",
      "text": "Deine To-do-Liste ist wertlos, bis du sie abarbeitest.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-27",
      "text": "Wer sich selbst führt, braucht keinen Motivationsspruch vom Chef.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-28",
      "text": "Erfolgreiche Menschen planen nicht mehr – sie entscheiden schneller.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-29",
      "text": "Dein Umsatz wächst erst, wenn dein Fokus es tut.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-10-19-0",
      "text": "Disziplin ist der Unterschied zwischen Wollen und Werden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-1",
      "text": "Motivation ist launisch. Disziplin zeigt jeden Tag auf.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-2",
      "text": "Du brauchst keine gute Laune, um weiterzumachen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-3",
      "text": "Komfort ist der Feind von Wachstum.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-4",
      "text": "Die Ausrede von heute ist die Reue von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-5",
      "text": "Zeig auf, auch wenn niemand zuschaut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-6",
      "text": "Disziplin ist leise. Ergebnisse sind laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-7",
      "text": "Wer aufgibt, hat recht gehabt mit seinen Zweifeln.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-8",
      "text": "Durchhalten ist unsexy. Erfolg auch – bis er da ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-9",
      "text": "Dein zukünftiges Ich zahlt den Preis deiner heutigen Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-10",
      "text": "Kleine Schritte schlagen große Pläne, die nie starten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-11",
      "text": "Disziplin kauft dir die Freiheit, die Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-12",
      "text": "Du scheiterst nicht am großen Tag. Du scheiterst an Tag drei.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-13",
      "text": "Niemand sieht die Tage, an denen du trotzdem dran geblieben bist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-14",
      "text": "Konsequenz schlägt Talent, wenn Talent nicht konsequent ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-15",
      "text": "Der Unterschied liegt nicht im Start, sondern im Tag danach.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-16",
      "text": "Disziplin heißt, dem Ich von gestern ein Versprechen zu halten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-17",
      "text": "Wer wartet, bis es sich richtig anfühlt, wartet für immer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-18",
      "text": "Deine wahren Grenzen zeigen sich erst, wenn die Lust fehlt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-19",
      "text": "Konstanz schlägt Intensität – jeden einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-20",
      "text": "Der Preis der Disziplin ist planbar. Der Preis der Reue nicht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-21",
      "text": "Du musst nicht motiviert sein. Du musst nur anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-22",
      "text": "Harte Tage bauen das Fundament für leichte Jahre.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-23",
      "text": "Disziplin heißt Nein sagen zu allem, was dich vom Ziel trennt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-24",
      "text": "Wer wartet, bis es leichter wird, bleibt für immer stehen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-25",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-26",
      "text": "Zwischen Traum und Ziel liegen ein Datum und tägliche Arbeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-27",
      "text": "Disziplin fühlt sich nach nichts an – bis sie alles verändert hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-28",
      "text": "Durchziehen, wenn's unbequem wird – das ist der ganze Trick.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-29",
      "text": "Deine Zukunft wird heute entschieden, nicht morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-10-19-0",
      "text": "Dein Körper ist kein Projekt, das du irgendwann startest. Er läuft schon.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-1",
      "text": "Energie ist die einzige Währung, die du nicht leihen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-2",
      "text": "Skip das Workout und du zahlst morgen Zinsen in Müdigkeit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-3",
      "text": "Du verhandelst nicht mit deinem Körper. Du führst ihn.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-4",
      "text": "Kein Meeting ist wichtiger als die 45 Minuten für dich selbst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-5",
      "text": "Disziplin im Training ist der Zinseszins für deinen ganzen Tag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-6",
      "text": "Wer seinen Körper vernachlässigt, arbeitet mit halber Kapazität.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-7",
      "text": "Bewegung ist das günstigste Investment mit der höchsten Rendite.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-8",
      "text": "Dein Limit von heute ist dein Warm-up von nächstem Monat.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-9",
      "text": "Schlaf ist keine Pause. Schlaf ist Produktion.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-10",
      "text": "Du kannst nicht optimieren, was du nicht trainierst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-11",
      "text": "Jeder Satz, den du auslässt, ist eine Ausrede, die du behältst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-12",
      "text": "Fitness ist kein Ziel. Es ist die Infrastruktur für alles andere.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-13",
      "text": "Dein Körper merkt sich jede Couch-Entscheidung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-14",
      "text": "Starke Beine tragen auch schwere Entscheidungen leichter.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-15",
      "text": "Wer müde ist, denkt klein. Wer trainiert ist, denkt groß.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-16",
      "text": "Du schuldest deinem zukünftigen Ich ein starkes Herz-Kreislauf-System.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-17",
      "text": "Bewegung ist der Reset-Knopf, den niemand drückt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-18",
      "text": "Ein kurzer Lauf schlägt jede lange Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-19",
      "text": "Dein Energielevel ist keine Laune, sondern eine Entscheidung von heute Morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-20",
      "text": "Muskeln baust du nicht im Gym. Du baust sie in der Wiederholung danach.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-21",
      "text": "Wer seine Fitness managed, managed auch seinen Fokus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-22",
      "text": "Die Tür zum Gym ist leichter als die Tür zur Reue.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-23",
      "text": "Körperliche Stärke ist mentale Rücklage.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-24",
      "text": "Du trainierst nicht für den Sommer. Du trainierst für die nächsten 50 Jahre.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-25",
      "text": "Ausdauer im Training ist Ausdauer im Leben, nur früher trainiert.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-26",
      "text": "Wer sich bewegt, bewegt auch seine Gedanken.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-27",
      "text": "Dein Körper ist das einzige Asset, das du nie verkaufen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-28",
      "text": "20 Minuten Bewegung schlagen 2 Stunden Grübeln.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-29",
      "text": "Wer stark werden will, muss müde anfangen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-10-19-0",
      "text": "Dankbarkeit ist der Zinseszins der Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-1",
      "text": "Wer nicht schätzt, was er hat, verliert es an die eigene Ungeduld.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-2",
      "text": "Zufriedenheit ist kein Ziel, das ist dein Ausgangspunkt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-3",
      "text": "Du jagst der nächsten Stufe nach und übersiehst, auf welcher du schon stehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-4",
      "text": "Dankbarkeit kostet nichts und zahlt sich trotzdem jeden Tag aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-5",
      "text": "Vergleiche dich mit deinem Gestern, nicht mit dem Feed von heute.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-6",
      "text": "Wer dankbar ist, verhandelt nicht mit dem Universum, er arbeitet einfach weiter.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-7",
      "text": "Zufriedenheit ist der ruhige Motor hinter nachhaltigem Erfolg.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-8",
      "text": "Du hast heute mehr erreicht, als du dir morgens eingestanden hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-9",
      "text": "Dankbarkeit ist die Pause, die dich schneller weiterlaufen lässt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-10",
      "text": "Unzufriedenheit ist nur Ambition ohne Perspektive.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-11",
      "text": "Schätze den Prozess, das Ergebnis ist nur die Quittung dafür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-12",
      "text": "Wer immer mehr will, ohne zu würdigen, was schon da ist, verbrennt sich selbst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-13",
      "text": "Dankbarkeit ist kein Rückschritt, sie ist der Boden, auf dem du wächst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-14",
      "text": "Dein Standard von heute war der Traum von vor drei Jahren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-15",
      "text": "Zufriedenheit heißt nicht aufhören, sondern ohne Druck weitermachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-16",
      "text": "Dankbar sein kostet drei Sekunden, bitter sein kostet Jahre.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-17",
      "text": "Du musst nicht alles neu erreichen, manches darfst du einfach behalten.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-18",
      "text": "Wer dankbar lebt, hat weniger Angst, etwas zu verlieren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-19",
      "text": "Zufriedenheit ist die Energiequelle, die Ehrgeiz nicht verbrennt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-20",
      "text": "Erfolg ohne Dankbarkeit ist nur eine andere Form von Leere.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-21",
      "text": "Du bist weiter, als dein innerer Kritiker zugeben will.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-22",
      "text": "Dankbarkeit macht aus genug ein ehrliches Wort, nicht eine Ausrede.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-23",
      "text": "Zufriedene Menschen bauen leiser, aber stabiler.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-24",
      "text": "Was du heute selbstverständlich findest, war früher dein größter Wunsch.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-25",
      "text": "Dankbarkeit ist der einzige Zins, den dir die Zeit ohne Risiko zahlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-26",
      "text": "Wer zufrieden ist, muss niemandem mehr etwas beweisen außer sich selbst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-27",
      "text": "Weniger vergleichen, mehr würdigen, das ist der ganze Trick.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-28",
      "text": "Zufriedenheit ist nicht das Ende des Ehrgeizes, sondern sein Fundament.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-29",
      "text": "Dankbarkeit verwandelt Besitz in Bedeutung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    }
  ]
}