{
  "generatedAt": "2026-10-05",
  "quotes": [
    {
      "id": "mindset-2026-10-05-0",
      "text": "Deine Ausreden sind lauter als dein Ehrgeiz – ändere das Verhältnis.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-05"
    },
    {
      "id": "mindset-2026-10-06-1",
      "text": "Niemand rettet dich. Das ist die beste Nachricht des Tages.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-06"
    },
    {
      "id": "mindset-2026-10-07-2",
      "text": "Schwache Momente lügen dir ins Gesicht – glaub ihnen nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-07"
    },
    {
      "id": "mindset-2026-10-08-3",
      "text": "Du bist nicht müde, du bist unmotiviert. Erkenne den Unterschied.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-08"
    },
    {
      "id": "mindset-2026-10-09-4",
      "text": "Disziplin ist der Rabatt, den dein zukünftiges Ich dir gewährt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-09"
    },
    {
      "id": "mindset-2026-10-10-5",
      "text": "Dein Kopf gibt auf, bevor dein Körper es tut. Trainier den Kopf zuerst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-10"
    },
    {
      "id": "mindset-2026-10-11-6",
      "text": "Komfort ist ein Kredit, den du mit Reue zurückzahlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-11"
    },
    {
      "id": "mindset-2026-10-12-7",
      "text": "Stärke entsteht nicht im Erfolg, sondern im nächsten Versuch danach.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-12"
    },
    {
      "id": "mindset-2026-10-13-8",
      "text": "Du brauchst keine Motivation. Du brauchst eine Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-13"
    },
    {
      "id": "mindset-2026-10-14-9",
      "text": "Dein innerer Kritiker hat noch nie etwas gebaut. Ignorier ihn.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-14"
    },
    {
      "id": "mindset-2026-10-15-10",
      "text": "Mentale Stärke ist leise. Sie schreit nicht, sie liefert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-15"
    },
    {
      "id": "mindset-2026-10-16-11",
      "text": "Hör auf, auf den perfekten Moment zu warten. Er kommt nie.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-16"
    },
    {
      "id": "mindset-2026-10-17-12",
      "text": "Dein Limit ist eine Meinung, keine Tatsache.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-13",
      "text": "Wer sich selbst überwindet, muss keine Konkurrenz mehr fürchten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-14",
      "text": "Unbequem ist der Preis für ein Leben, das du wirklich willst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-15",
      "text": "Schmerz heute oder Reue morgen – wähl weise.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-16",
      "text": "Dein Verstand testet dich nur, um zu sehen, ob du es ernst meinst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-17",
      "text": "Stärke ist keine Stimmung, sie ist eine Gewohnheit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-18",
      "text": "Du verhandelst nicht mit deiner Disziplin. Du folgst ihr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-19",
      "text": "Die Stimme, die sagt morgen, ist dein größter Feind.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-20",
      "text": "Resilienz baut man nicht in guten Tagen, sondern in miesen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-21",
      "text": "Dein Ego will Ausreden. Dein Ziel will Ergebnisse.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-22",
      "text": "Wachstum fühlt sich wie Unbehagen an – gewöhn dich daran.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-23",
      "text": "Du bist kein Opfer deiner Laune. Du bist ihr Chef.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-24",
      "text": "Konsequenz schlägt Talent, wenn Talent nicht konsequent ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-25",
      "text": "Dein zukünftiges Ich zahlt für jede Ausrede, die du heute machst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-26",
      "text": "Starke Menschen fühlen auch Zweifel – sie handeln trotzdem.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-27",
      "text": "Deine Komfortzone ist ein schönes Gefängnis mit Ausblick.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-28",
      "text": "Mentale Stärke heißt: weitermachen, wenn niemand zuschaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-29",
      "text": "Du wirst nicht motiviert aufwachen. Du wirst diszipliniert handeln.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-10-05-0",
      "text": "Motivation ist ein Gefühl. Disziplin ist ein System. Baue das System.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-05"
    },
    {
      "id": "business-2026-10-06-1",
      "text": "Deine Konkurrenz schläft nicht schlecht, sie arbeitet einfach mehr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-06"
    },
    {
      "id": "business-2026-10-07-2",
      "text": "Ausreden sind die Währung der Mittelmäßigkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-07"
    },
    {
      "id": "business-2026-10-08-3",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-08"
    },
    {
      "id": "business-2026-10-09-4",
      "text": "Zeit ist das einzige Kapital, das du nicht nachkaufen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-09"
    },
    {
      "id": "business-2026-10-10-5",
      "text": "Plane wie ein Stratege, handle wie ein Besessener.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-10"
    },
    {
      "id": "business-2026-10-11-6",
      "text": "Wer auf den perfekten Moment wartet, verpasst jeden einzelnen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-11"
    },
    {
      "id": "business-2026-10-12-7",
      "text": "Dein Kontostand ist ein Spiegel deiner Gewohnheiten, nicht deines Glücks.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-12"
    },
    {
      "id": "business-2026-10-13-8",
      "text": "Komfort ist der leiseste Karrierekiller.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-13"
    },
    {
      "id": "business-2026-10-14-9",
      "text": "Erfolg hinterlässt keine Spuren im Feed, sondern im Kalender.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-14"
    },
    {
      "id": "business-2026-10-15-10",
      "text": "Jeder ungenutzte Tag ist eine stille Investition in die Konkurrenz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-15"
    },
    {
      "id": "business-2026-10-16-11",
      "text": "Du verhandelst nicht mit dem Markt. Du passt dich an oder verschwindest.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-16"
    },
    {
      "id": "business-2026-10-17-12",
      "text": "Netzwerken heißt: Wert geben, bevor du Wert verlangst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-13",
      "text": "Dein Ego kostet mehr als jeder Kredit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-14",
      "text": "Wachstum fühlt sich nie bequem an. Genau deshalb ist es Wachstum.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-15",
      "text": "Ein Plan ohne Deadline ist nur ein Wunsch mit Struktur.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-16",
      "text": "Du brauchst keine Inspiration. Du brauchst einen Kalendereintrag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-17",
      "text": "Fokus schlägt Talent, wenn Talent nicht fokussiert ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-18",
      "text": "Risiko ist kein Gegner. Unentschlossenheit ist einer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-19",
      "text": "Wer alles kontrollieren will, delegiert nichts und skaliert nie.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-20",
      "text": "Dein Umsatz wächst nicht durch Hoffnung, sondern durch Wiederholung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-21",
      "text": "Zwischen Idee und Umsetzung liegt der Unterschied zwischen Träumer und Gründer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-22",
      "text": "Produktivität ist kein Zustand, den du erreichst. Es ist eine Entscheidung, die du täglich triffst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-23",
      "text": "Kleine Unternehmen scheitern selten am Produkt. Sie scheitern an der Disziplin.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-24",
      "text": "Du bist nicht müde. Du bist unklar in deinen Prioritäten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-25",
      "text": "Wer jeden Tag optimiert, muss nie wieder motivieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-26",
      "text": "Dein Morgenritual entscheidet, wer über deinen Tag bestimmt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-27",
      "text": "Kapital folgt Klarheit, nicht Lautstärke.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-28",
      "text": "Überdenken ist die teuerste Form von Stillstand.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-29",
      "text": "Mache aus deinem To-do nicht eine Liste der Hoffnung, sondern der Verpflichtung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-10-05-0",
      "text": "Disziplin ist der Deal, den du mit deinem zukünftigen Ich machst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-05"
    },
    {
      "id": "discipline-2026-10-06-1",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-06"
    },
    {
      "id": "discipline-2026-10-07-2",
      "text": "Du musst nicht wollen, du musst nur machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-07"
    },
    {
      "id": "discipline-2026-10-08-3",
      "text": "Konsistenz schlägt Intensität, jedes einzelne Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-08"
    },
    {
      "id": "discipline-2026-10-09-4",
      "text": "Dein Durchbruch liegt hinter dem Tag, an dem du aufgeben wolltest.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-09"
    },
    {
      "id": "discipline-2026-10-10-5",
      "text": "Niemand sieht die Wiederholung, alle sehen nur das Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-10"
    },
    {
      "id": "discipline-2026-10-11-6",
      "text": "Disziplin fühlt sich erst wie Zwang an, dann wie Freiheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-11"
    },
    {
      "id": "discipline-2026-10-12-7",
      "text": "Die Ausrede von heute ist die Entschuldigung von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-12"
    },
    {
      "id": "discipline-2026-10-13-8",
      "text": "Wer jeden Tag ein Prozent liefert, hat in einem Jahr ein neues Leben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-13"
    },
    {
      "id": "discipline-2026-10-14-9",
      "text": "Durchhalten heißt, weitermachen, wenn das Gefühl fehlt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-14"
    },
    {
      "id": "discipline-2026-10-15-10",
      "text": "Dein Limit ist nur der Punkt, an dem du aufgehört hast zu testen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-15"
    },
    {
      "id": "discipline-2026-10-16-11",
      "text": "Disziplin ist leise. Sie postet nicht, sie liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-16"
    },
    {
      "id": "discipline-2026-10-17-12",
      "text": "Du trainierst nicht deinen Körper, du trainierst deinen Willen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-13",
      "text": "Die unbequeme Wiederholung ist der Preis für das bequeme Leben später.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-14",
      "text": "Komfort ist der Feind, den du jeden Tag neu besiegen musst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-15",
      "text": "Zwischen Anfang und Ziel liegt nur eine Sache: dranbleiben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-16",
      "text": "Disziplin ist die Brücke zwischen Plan und Realität.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-17",
      "text": "Tu es, auch wenn es sich falsch anfühlt. Besonders dann.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-18",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-19",
      "text": "Es gibt keine Abkürzung, nur Abstand zwischen dir und den anderen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-20",
      "text": "Wiederhole den Prozess, bis er dich verändert, nicht dein Gefühl.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-21",
      "text": "Disziplin bedeutet, Verträge mit dir selbst einzuhalten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-22",
      "text": "Die, die bleiben, wenn es schwer wird, gewinnen, wenn es leicht wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-23",
      "text": "Du brauchst keine Inspiration, du brauchst eine Routine.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-24",
      "text": "Jeder Tag ohne Ausrede ist ein Tag näher am Ziel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-25",
      "text": "Stärke ist kein Gefühl, Stärke ist eine Entscheidung, die du wiederholst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-26",
      "text": "Was du heute durchziehst, musst du morgen nicht mehr beweisen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-27",
      "text": "Disziplin ist der Unterschied zwischen Wunsch und Plan.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-28",
      "text": "Du scheiterst nicht am Tag, du scheiterst an der Ausrede davor.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-29",
      "text": "Halte durch, wenn niemand zuschaut. Genau dann zählt es.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-10-05-0",
      "text": "Dein Körper ist dein Betriebssystem. Update ihn täglich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-05"
    },
    {
      "id": "fitness-2026-10-06-1",
      "text": "Energie ist keine Ressource, die du findest. Du produzierst sie selbst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-06"
    },
    {
      "id": "fitness-2026-10-07-2",
      "text": "Jedes Training ist eine Einzahlung auf dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-07"
    },
    {
      "id": "fitness-2026-10-08-3",
      "text": "Müdigkeit lügt. Dein Körper kann mehr, als dein Kopf glaubt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-08"
    },
    {
      "id": "fitness-2026-10-09-4",
      "text": "Disziplin im Gym ist Disziplin im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-09"
    },
    {
      "id": "fitness-2026-10-10-5",
      "text": "Du trainierst nicht für heute. Du trainierst für die nächsten 30 Jahre.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-10"
    },
    {
      "id": "fitness-2026-10-11-6",
      "text": "Schwache Energie bedeutet schwache Entscheidungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-11"
    },
    {
      "id": "fitness-2026-10-12-7",
      "text": "Dein Körper merkt sich jede Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-12"
    },
    {
      "id": "fitness-2026-10-13-8",
      "text": "Bewegung ist der schnellste Weg zu einem klaren Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-13"
    },
    {
      "id": "fitness-2026-10-14-9",
      "text": "Wer seinen Körper vernachlässigt, verliert seine beste Ressource.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-14"
    },
    {
      "id": "fitness-2026-10-15-10",
      "text": "Fitness ist kein Ziel. Es ist dein Betriebssystem für alles andere.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-15"
    },
    {
      "id": "fitness-2026-10-16-11",
      "text": "Kraft im Körper erzeugt Klarheit im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-16"
    },
    {
      "id": "fitness-2026-10-17-12",
      "text": "Du kannst nicht Großes leisten mit leerem Tank.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-13",
      "text": "Dein Energielevel entscheidet, wie weit du heute kommst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-14",
      "text": "Schlaf ist keine Schwäche, sondern Strategie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-15",
      "text": "Jeder Satz im Training ist ein Beweis gegen deine Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-16",
      "text": "Ein starker Körper trägt einen starken Willen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-17",
      "text": "Du bist nicht müde. Du bist unterfordert von deiner eigenen Disziplin.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-18",
      "text": "Bewegung heute verhindert Stillstand morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-19",
      "text": "Dein Körper ist das einzige Werkzeug, das du nie ersetzen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-20",
      "text": "Wer früh schwitzt, denkt später klarer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-21",
      "text": "Fitness kauft dir Jahre, die sonst niemand bezahlt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-22",
      "text": "Dein Energielevel ist dein Wettbewerbsvorteil.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-23",
      "text": "Kein Mindset-Hack ersetzt einen erschöpften Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-24",
      "text": "Du optimierst deine Zeit. Optimiere zuerst deinen Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-25",
      "text": "Bewegung ist der Zinseszins für deine Gesundheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-26",
      "text": "Ein trainierter Körper denkt schneller unter Druck.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-27",
      "text": "Dein Puls heute bestimmt deine Energie morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-28",
      "text": "Stärke baust du nicht im Kopf. Du baust sie im Wiederholen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-29",
      "text": "Wer seinen Körper führt, führt auch seinen Tag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-10-05-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist der Treibstoff für den nächsten Schritt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-05"
    },
    {
      "id": "gratitude-2026-10-06-1",
      "text": "Wer dankbar startet, performt den ganzen Tag auf einem anderen Level.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-06"
    },
    {
      "id": "gratitude-2026-10-07-2",
      "text": "Dankbarkeit ist der günstigste Produktivitäts-Hack, den du nie genutzt hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-07"
    },
    {
      "id": "gratitude-2026-10-08-3",
      "text": "Du vergleichst dein Jetzt mit fremden Highlights. Hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-08"
    },
    {
      "id": "gratitude-2026-10-09-4",
      "text": "Zufrieden sein heißt nicht aufhören zu wollen, es heißt anfangen zu sehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-09"
    },
    {
      "id": "gratitude-2026-10-10-5",
      "text": "Dein Leben in zehn Jahren dankt dir für das, was du heute schon schätzt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-10"
    },
    {
      "id": "gratitude-2026-10-11-6",
      "text": "Dankbarkeit verändert nichts an der Lage, aber alles an deiner Energie dafür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-11"
    },
    {
      "id": "gratitude-2026-10-12-7",
      "text": "Du hast heute schon mehr erreicht, als dir dein innerer Kritiker zugibt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-12"
    },
    {
      "id": "gratitude-2026-10-13-8",
      "text": "Zufriedenheit ist keine Schwäche, sie ist die Basis für den nächsten Hunger.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-13"
    },
    {
      "id": "gratitude-2026-10-14-9",
      "text": "Was du besitzt, war vor einem Jahr noch dein größter Wunsch.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-14"
    },
    {
      "id": "gratitude-2026-10-15-10",
      "text": "Dankbarkeit ist der Unterschied zwischen Ankommen und ewig Rennen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-15"
    },
    {
      "id": "gratitude-2026-10-16-11",
      "text": "Dein Standard von heute war der Traum von vor fünf Jahren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-12",
      "text": "Wer nie zufrieden sein kann, wird auch im Erfolg nie ankommen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-13",
      "text": "Dankbarkeit kostet nichts und bringt mehr als jede Zielsetzung allein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-14",
      "text": "Du jagst dem Nächsten hinterher und übersiehst, was du schon hältst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-15",
      "text": "Zufriedenheit ist der Moment, in dem Ehrgeiz aufhört, Angst zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-16",
      "text": "Dankbar sein heißt verstehen, dass nicht alles selbstverständlich war.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-17",
      "text": "Dein größter Flex ist, mit dem zufrieden zu sein, was wirklich zählt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-18",
      "text": "Wachstum ohne Dankbarkeit ist nur eine andere Form von Leere.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-19",
      "text": "Du brauchst keinen Grund zur Freude, du brauchst nur den Blick dafür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-20",
      "text": "Dankbarkeit macht aus einem normalen Tag einen, an den du dich erinnerst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-21",
      "text": "Zufriedenheit ist die Entscheidung, nicht auf das nächste Ziel zu warten.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-22",
      "text": "Was heute selbstverständlich ist, war früher harte Arbeit von dir.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-23",
      "text": "Dankbarkeit ist der leiseste Erfolg, den niemand auf Social Media sieht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-24",
      "text": "Du musst nicht alles neu erreichen, du darfst auch mal halten, was du hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-25",
      "text": "Zufriedenheit und Ambition schließen sich nicht aus, sie ergänzen sich.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-26",
      "text": "Dankbarkeit ist Checkpoint, kein Ziel, du speicherst und gehst weiter.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-27",
      "text": "Dein System läuft, dein Umfeld steht, dein Körper funktioniert. Das ist nicht nichts.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-28",
      "text": "Wer nicht dankbar sein kann für wenig, wird es auch nicht für viel sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-29",
      "text": "Zufriedenheit ist der ruhige Moment zwischen zwei großen Zielen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    }
  ]
}