{
  "generatedAt": "2026-10-13",
  "quotes": [
    {
      "id": "mindset-2026-10-13-0",
      "text": "Dein Kopf gibt immer zu früh auf – dein Körper könnte noch zehnmal mehr.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-13"
    },
    {
      "id": "mindset-2026-10-14-1",
      "text": "Disziplin ist der Moment, in dem du trotzdem weitermachst, obwohl niemand zuschaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-14"
    },
    {
      "id": "mindset-2026-10-15-2",
      "text": "Motivation ist Zufall. Struktur ist Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-15"
    },
    {
      "id": "mindset-2026-10-16-3",
      "text": "Du wirst nie bereit sein. Du wirst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-16"
    },
    {
      "id": "mindset-2026-10-17-4",
      "text": "Schwache Momente sind kein Charakterfehler, nur ein Test deiner Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-5",
      "text": "Wer ständig auf den richtigen Moment wartet, verpasst jeden einzelnen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-6",
      "text": "Dein Zukunfts-Ich zahlt den Preis für die Ausreden von heute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-7",
      "text": "Comfort ist kein Zuhause, sondern eine Pause, die zu lang wird.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-8",
      "text": "Stärke zeigt sich nicht im Sieg, sondern im Montagmorgen nach der Niederlage.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-9",
      "text": "Du brauchst keine Inspiration. Du brauchst eine Deadline.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-10",
      "text": "Jede Ausrede, die du glaubst, ist ein Vertrag gegen dich selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-11",
      "text": "Konsequenz schlägt Talent, wenn Talent nicht konsequent ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-12",
      "text": "Dein Limit ist meistens nur die erste unangenehme Minute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-13",
      "text": "Die Stimme, die aufgeben will, lügt öfter, als sie recht hat.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-14",
      "text": "Klein anfangen schlägt perfekt planen – jedes Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-15",
      "text": "Wer sich selbst nicht fordert, wird von der Zeit gefordert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-16",
      "text": "Erfolg fühlt sich erst im Nachhinein logisch an, nie im Moment selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-17",
      "text": "Du verhandelst nicht mit deiner Müdigkeit. Du führst sie.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-18",
      "text": "Druck ist kein Feind. Druck ist der Beweis, dass du etwas riskierst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-19",
      "text": "Die Ausrede von heute wird morgen zur Gewohnheit, wenn du sie zulässt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-20",
      "text": "Niemand rettet deinen Tag. Du entscheidest, wann er beginnt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-21",
      "text": "Dein Standard entscheidet, nicht dein Gefühl an diesem Tag.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-22",
      "text": "Unbequem ist der Preis für alles, was später bequem wird.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-23",
      "text": "Wachstum passiert genau dort, wo du am liebsten aufhören würdest.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-24",
      "text": "Du bist nicht müde von der Arbeit. Du bist müde vom Zögern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-25",
      "text": "Selbstdisziplin ist die leiseste Form von Selbstrespekt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-26",
      "text": "Jeder Tag ohne Fokus ist ein Tag, den dein Ziel dir schuldet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-27",
      "text": "Die beste Version von dir verhandelt nicht über den ersten Schritt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-28",
      "text": "Konstanz ist langweilig, bis sie plötzlich unschlagbar wird.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-29",
      "text": "Dein Verstand testet dich nur, um zu sehen, ob du es ernst meinst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-10-13-0",
      "text": "Disziplin schlägt Motivation, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-13"
    },
    {
      "id": "business-2026-10-14-1",
      "text": "Dein Kontostand ist nur ein Nebenprodukt deiner Gewohnheiten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-14"
    },
    {
      "id": "business-2026-10-15-2",
      "text": "Während andere Ausreden sammeln, sammelst du Ergebnisse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-15"
    },
    {
      "id": "business-2026-10-16-3",
      "text": "Wer um 6 Uhr plant, gewinnt um 18 Uhr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-16"
    },
    {
      "id": "business-2026-10-17-4",
      "text": "Komfort ist der leise Killer großer Ziele.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-5",
      "text": "Baue dein Business, als würde es niemand für dich tun – weil es so ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-6",
      "text": "Zeit ist das einzige Investment ohne Nachkauf-Option.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-7",
      "text": "Deine Konkurrenz schläft nicht, also schlaf schneller ein.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-8",
      "text": "Output schlägt Aufwand, immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-9",
      "text": "Risiko ist der Preis, den Durchschnitt nicht zahlen will.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-10",
      "text": "Mach aus Montagen deinen produktivsten Tag, nicht deinen schwersten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-11",
      "text": "Wer alles plant, hat schon die halbe Arbeit erledigt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-12",
      "text": "Dein Side-Hustle von heute ist dein Hauptjob von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-13",
      "text": "Erfolg hinterlässt Spuren, aber keine Abkürzungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-14",
      "text": "Verkauf dich nicht unter Wert – verhandle dich hoch.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-15",
      "text": "Jede Stunde Ablenkung kostet dich ein Stück Zukunft.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-16",
      "text": "Baue Systeme, nicht nur To-do-Listen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-17",
      "text": "Wer auf den perfekten Moment wartet, verpasst den ersten Schritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-18",
      "text": "Cashflow ist King, Ego ist teuer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-19",
      "text": "Du brauchst keinen Plan B, du brauchst einen besseren Plan A.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-20",
      "text": "Klein anfangen ist besser als groß aufschieben.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-21",
      "text": "Produktivität ist kein Zufall, sondern eine Entscheidung pro Stunde.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-22",
      "text": "Dein Netzwerk ist dein Nettowert – pflege beides.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-23",
      "text": "Wachstum passiert außerhalb der Komfortzone, nicht im Büro.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-24",
      "text": "Fokus ist die neue Währung der Macher.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-25",
      "text": "Wer nicht investiert, konsumiert sich selbst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-26",
      "text": "Deadlines sind Geschenke an dein zukünftiges Ich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-27",
      "text": "Baue heute das Unternehmen, das dich morgen nicht mehr braucht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-28",
      "text": "Harte Arbeit ohne Strategie ist nur harte Erschöpfung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-29",
      "text": "Dein größter Konkurrent ist dein gestriges Ich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-10-13-0",
      "text": "Disziplin ist der Moment, in dem du keine Lust hast und trotzdem lieferst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-13"
    },
    {
      "id": "discipline-2026-10-14-1",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-14"
    },
    {
      "id": "discipline-2026-10-15-2",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-15"
    },
    {
      "id": "discipline-2026-10-16-3",
      "text": "Konsequenz schlägt Intensität – jeden einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-16"
    },
    {
      "id": "discipline-2026-10-17-4",
      "text": "Der Unterschied zwischen Träumen und Zielen heißt Wiederholung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-5",
      "text": "Wer aufgibt, wenn es unbequem wird, war nie wirklich im Spiel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-6",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-7",
      "text": "Disziplin fühlt sich nie gut an – bis sie zum Ergebnis wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-8",
      "text": "Nicht jeder Tag motiviert dich. Deshalb brauchst du ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-9",
      "text": "Durchhalten ist kein Talent, es ist eine Entscheidung, die du täglich triffst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-10",
      "text": "Du hörst nicht auf, weil es hart ist. Du hörst auf, wenn du aufhörst zu wollen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-11",
      "text": "Die Ausrede von heute ist das Bedauern von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-12",
      "text": "Disziplin ist leise. Ergebnisse sind laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-13",
      "text": "Wer immer erst auf den perfekten Moment wartet, wartet für immer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-14",
      "text": "Kleine Schritte, die du nicht abbrichst, schlagen große Pläne, die du aufgibst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-15",
      "text": "Du brauchst keine Motivation, du brauchst eine Routine, die auch ohne sie funktioniert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-16",
      "text": "Jeder Tag, an dem du dranbleibst, ist ein Tag, den die Konkurrenz nicht aufholt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-17",
      "text": "Comfort Zone und Fortschritt wohnen nie im selben Haus.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-18",
      "text": "Disziplin heißt, Versprechen an dich selbst zu halten, wenn keiner zuschaut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-19",
      "text": "Du überholst niemanden, indem du aufhörst, sobald es unbequem wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-20",
      "text": "Das Ziel verschwindet nicht – nur deine Geduld, wenn du nicht aufpasst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-21",
      "text": "Wer täglich 1% besser wird, ist in einem Jahr nicht wiederzuerkennen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-22",
      "text": "Durchhalten ist der Preis, den Erfolg für seine Echtheit verlangt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-23",
      "text": "Du scheiterst nicht am Tag X – du scheiterst an den Tagen davor, an denen du aufgehört hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-24",
      "text": "Disziplin ist die Brücke zwischen deinem Plan und deinem Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-25",
      "text": "Niemand sieht die Wiederholungen. Jeder sieht nur das Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-26",
      "text": "Dranbleiben, wenn es langweilig wird – das ist der eigentliche Wettbewerbsvorteil.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-27",
      "text": "Du musst nicht schnell sein. Du musst nur weitermachen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-28",
      "text": "Disziplin ist Selbstrespekt in Aktion.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-29",
      "text": "Der Unterschied zwischen dir und deinem Ziel ist die Anzahl der Tage, die du durchhältst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-10-13-0",
      "text": "Dein Körper ist kein Wartezimmer. Hör auf zu warten, fang an zu trainieren.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-13"
    },
    {
      "id": "fitness-2026-10-14-1",
      "text": "Energie ist keine Glückssache, sie ist das Ergebnis deines letzten Workouts.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-14"
    },
    {
      "id": "fitness-2026-10-15-2",
      "text": "Wer seinen Körper vernachlässigt, führt sein Mindset in die Insolvenz.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-15"
    },
    {
      "id": "fitness-2026-10-16-3",
      "text": "Disziplin im Gym ist der Zinseszins für deine Energie im Alltag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-16"
    },
    {
      "id": "fitness-2026-10-17-4",
      "text": "Dein schwächster Punkt heute wird dein Standard für morgen, außer du bewegst dich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-5",
      "text": "Kein Motivationstief übersteht ein hartes Workout.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-6",
      "text": "Muskeln lügen nicht. Entweder du hast gearbeitet oder nicht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-7",
      "text": "Dein Körper speichert jede ausgefallene Einheit als Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-8",
      "text": "Schlaf ist kein Luxus, er ist dein günstigster Produktivitäts-Boost.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-9",
      "text": "Wer müde ist, hat meistens zu wenig trainiert, nicht zu viel.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-10",
      "text": "Fitness ist die Zinsrechnung, die dir niemand in der Schule beigebracht hat.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-11",
      "text": "Ein kurzer Lauf schlägt jeden Kaffee, ohne Absturz danach.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-12",
      "text": "Dein Körper ist dein Büro. Halt es sauber.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-13",
      "text": "Stärke entsteht nicht im Kopf, sie wandert nur von dort in die Beine.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-14",
      "text": "Bewegung ist das billigste Antidepressivum, das du nie eingenommen hast.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-15",
      "text": "Wer seinen Puls nicht fordert, fordert auch sein Leben nicht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-16",
      "text": "Du verhandelst nicht mit deinem inneren Schweinehund, du trainierst ihn weg.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-17",
      "text": "Die besten Ideen entstehen nicht am Schreibtisch, sondern beim Joggen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-18",
      "text": "Ausdauer im Training ist Ausdauer im Leben, nur mit mehr Schweiß.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-19",
      "text": "Jedes Workout ist eine Einzahlung auf dein zukünftiges Energiekonto.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-20",
      "text": "Dein Körper merkt sich jede Couch-Entscheidung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-21",
      "text": "Fitness beginnt nicht im Kopf, sie beginnt beim Aufstehen, sofort.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-22",
      "text": "Wer nie außer Atem kommt, kommt auch beruflich nicht voran.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-23",
      "text": "Kraft ist kein Zufall, sie ist ein wiederkehrender Kalendereintrag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-24",
      "text": "Ein wacher Kopf wohnt in einem bewegten Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-25",
      "text": "Dein Energielevel ist verhandelbar, durch Bewegung, nicht durch Reden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-26",
      "text": "Körperliche Stärke ist der Unterbau für jede andere Stärke.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-27",
      "text": "Wer seine Fitness aufschiebt, schiebt seine beste Version auf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-28",
      "text": "Schwitzen ist die Quittung für ein ehrliches Workout.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-29",
      "text": "Dein Körper ist die Hardware, ohne Wartung läuft keine Software.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-10-13-0",
      "text": "Zufriedenheit ist nicht das Ziel - sie ist der Treibstoff für den nächsten Schritt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-13"
    },
    {
      "id": "gratitude-2026-10-14-1",
      "text": "Ohne Handeln ist Dankbarkeit nur ein Gefühl. Mit Handeln wird sie Strategie.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-14"
    },
    {
      "id": "gratitude-2026-10-15-2",
      "text": "Du vergleichst dein Kapitel 3 mit fremden Kapitel 20. Hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-15"
    },
    {
      "id": "gratitude-2026-10-16-3",
      "text": "Wer das Wenige nicht schätzt, wird auch mit viel nie zufrieden sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-4",
      "text": "Zufriedenheit ist keine Entdeckung - sie ist eine tägliche Entscheidung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-5",
      "text": "Dein aktuelles Level war mal dein größter Traum.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-6",
      "text": "Dankbarkeit kostet nichts, bringt aber Klarheit, die du nicht ignorieren solltest.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-7",
      "text": "Wer ständig mehr will, ohne das Jetzt zu sehen, verliert am Ende beides.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-8",
      "text": "Zufriedenheit ist der Zinseszins der Dankbarkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-9",
      "text": "Werd jetzt glücklich und jage trotzdem weiter nach mehr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-10",
      "text": "Dankbarkeit ist die einzige Investition mit garantierter Rendite ohne Risiko.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-11",
      "text": "Dein Leben in 5 Jahren dankt dir für die Geduld von heute.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-12",
      "text": "Zufriedenheit und Ambition schließen sich nicht aus - sie verstärken sich.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-13",
      "text": "Du bist nicht im Rückstand. Du bist genau da, wo dein Weg hinführen musste.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-14",
      "text": "Dankbarkeit ist das Mindset derer, die trotzdem noch gewinnen wollen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-15",
      "text": "Wer das Jetzt nicht wertschätzt, wird auch das Später nie wertschätzen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-16",
      "text": "Zufriedenheit ist kein Bremsklotz für Ambition - sie ist ihr Fundament.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-17",
      "text": "Dein Konto, dein Körper, dein Kopf - alle drei verdienen heute ein Danke.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-18",
      "text": "Die Dankbarkeit von heute ist die Resilienz von morgen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-19",
      "text": "Zufriedenheit heißt nicht aufhören - sie heißt ohne Angst weitermachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-20",
      "text": "Du musst nicht alles haben, um alles zu schätzen, was du hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-21",
      "text": "Dankbarkeit ist der stille Flex, den niemand sehen muss.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-22",
      "text": "Wer zufrieden mit dem Prozess ist, braucht kein Ergebnis zur Bestätigung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-23",
      "text": "Dein jetziges Ich würde dein zukünftiges beneiden, wenn es wüsste, wie dankbar es wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-24",
      "text": "Dankbarkeit macht aus Druck Antrieb und aus Stress Sinn.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-25",
      "text": "Zufriedenheit ist nicht das Gegenteil von Ehrgeiz - sie ist sein ruhiger Kern.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-26",
      "text": "Du bist heute dankbar für das, wofür du letztes Jahr gekämpft hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-27",
      "text": "Dankbarkeit verändert nicht die Umstände - sie verändert, wie du sie trägst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-28",
      "text": "Zufriedenheit ist der Beweis, dass du schon gewonnen hast, bevor das Ziel kommt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-29",
      "text": "Dein größter Flex ist nicht dein Erfolg - es ist deine Ruhe dabei.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    }
  ]
}