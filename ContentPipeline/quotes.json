{
  "generatedAt": "2026-10-27",
  "quotes": [
    {
      "id": "mindset-2026-10-27-0",
      "text": "Disziplin ist der Zins, den du heute zahlst, damit dein zukünftiges Ich reich wird.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-1",
      "text": "Deine Ausreden klingen gut, aber dein Konto merkt es nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-2",
      "text": "Comfort Zone ist nur ein hübscher Name für Stillstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-3",
      "text": "Niemand rettet dich. Das ist die beste Nachricht, die du heute bekommst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-4",
      "text": "Motivation ist Zufall. System ist Garantie.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-5",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-6",
      "text": "Schwache Tage sind kein Grund, schwache Entscheidungen zu treffen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-7",
      "text": "Dein größter Konkurrent ist die Version von dir, die aufgegeben hat.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-8",
      "text": "Resultate interessieren sich nicht für deine Laune.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-9",
      "text": "Wer auf perfekte Bedingungen wartet, wartet für immer.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-10",
      "text": "Härte ist kein Zufall. Sie ist eine tägliche Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-11",
      "text": "Dein Umfeld flüstert dir ständig, wer du sein sollst. Stell lauter.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-12",
      "text": "Du wirst nicht über Nacht stark. Du wirst es durch die Nächte, die du durchhältst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-13",
      "text": "Zweifel ist laut, aber Taten sind lauter.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-14",
      "text": "Fokus schlägt Talent, wenn Talent nicht fokussiert ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-15",
      "text": "Dein Ziel kennt dich nicht. Es kennt nur deine Taten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-16",
      "text": "Wachstum fühlt sich nie bequem an – deshalb merken es so wenige an.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-17",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-18",
      "text": "Druck macht aus Kohle Diamanten – oder aus dir eine Ausrede.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-19",
      "text": "Konsequenz ist das stille Kapital der Erfolgreichen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-20",
      "text": "Niemand sieht die Stunden. Alle sehen das Ergebnis.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-21",
      "text": "Dein Verstand testet dich jeden Morgen. Besteh den Test, bevor du aufstehst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-22",
      "text": "Stillstand fühlt sich sicher an und kostet dich trotzdem alles.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-23",
      "text": "Du brauchst keine Motivation. Du brauchst eine Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-24",
      "text": "Erfolg hasst Ausreden, aber liebt Wiederholung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-25",
      "text": "Dein Limit ist meistens nur eine Meinung, die du zu oft wiederholt hast.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-26",
      "text": "Kleine Disziplin heute schlägt große Pläne von morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-27",
      "text": "Wer sich selbst führt, braucht keinen, der ihn antreibt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-28",
      "text": "Schmerz ist temporär. Aufgeben ist permanent in deinem Kopf gespeichert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-29",
      "text": "Du wirst nicht zufällig stark. Du trainierst es, wie jeden Muskel.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-10-27-0",
      "text": "Disziplin schlägt Motivation, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-1",
      "text": "Dein Zukunfts-Ich bezahlt den Preis für deine Ausreden von heute.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-2",
      "text": "Wer um 6 Uhr plant, gewinnt um 18 Uhr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-3",
      "text": "Umsatz lügt nicht, Ausreden schon.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-4",
      "text": "Komfortzonen sind die teuersten Mieten, die man zahlen kann.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-5",
      "text": "Baue dein Business, als würde niemand dich retten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-6",
      "text": "Produktivität ist kein Zufall, sondern ein System.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-7",
      "text": "Wer auf den perfekten Moment wartet, verpasst den aktuellen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-8",
      "text": "Dein Netzwerk ist dein Nettovermögen von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-9",
      "text": "Erfolg fühlt sich erst nach dem hundertsten Versuch gut an.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-10",
      "text": "Zeit ist die einzige Währung, die du nie zurückbekommst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-11",
      "text": "Kleine Entscheidungen heute, große Freiheit morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-12",
      "text": "Wer nicht skaliert, stagniert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-13",
      "text": "Dein Kalender zeigt, was dir wirklich wichtig ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-14",
      "text": "Risiko ist der Preis für Relevanz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-15",
      "text": "Arbeite, als hättest du schon gekündigt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-16",
      "text": "Fokus schlägt Talent, jedes Mal.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-17",
      "text": "Dein größter Konkurrent ist dein gestriges Ich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-18",
      "text": "Wachstum passiert außerhalb deiner To-do-Liste.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-19",
      "text": "Wer alles kontrollieren will, baut nichts Großes.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-20",
      "text": "Cashflow ist Sauerstoff, Vision ist die Lunge.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-21",
      "text": "Konsequenz schlägt Intelligenz, langfristig immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-22",
      "text": "Dein erstes Nein ist der Anfang deines ersten Deals.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-23",
      "text": "Erfolgreiche Menschen erledigen, was andere aufschieben.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-24",
      "text": "Baue Systeme, nicht nur Ziele.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-25",
      "text": "Wer nie scheitert, hat nie wirklich versucht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-26",
      "text": "Dein Umsatz wächst, sobald dein Mindset es zulässt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-27",
      "text": "Handle schnell, denke klar, lerne ständig.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-28",
      "text": "Freiheit kostet Vorleistung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-29",
      "text": "Wer heute Opfer bringt, kauft sich morgen Optionen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-10-27-0",
      "text": "Disziplin ist der Zins, den du heute zahlst, damit dein Ich von morgen reich wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-1",
      "text": "Motivation checkt aus, Disziplin bleibt bis zum Ladenschluss.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-2",
      "text": "Du musst nicht jeden Tag Lust haben, du musst nur jeden Tag liefern.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-3",
      "text": "Durchhalten ist langweilig, aber langweilig ist der Preis für außergewöhnlich.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-4",
      "text": "Disziplin fühlt sich nicht gut an, sie zahlt sich gut aus.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-5",
      "text": "Jeden Tag ein bisschen – das ist das Geheimnis, das keiner hören will.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-6",
      "text": "Konsequenz schlägt Talent, wenn Talent keine Lust mehr hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-7",
      "text": "Du brauchst keinen guten Tag, du brauchst eine gute Routine.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-8",
      "text": "Wer auf Motivation wartet, verpasst das Leben seiner Disziplin.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-9",
      "text": "Disziplin ist die Brücke zwischen Zielen und Ergebnissen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-10",
      "text": "Härte gegen dich selbst heute spart dir Ausreden von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-11",
      "text": "Kleine Disziplinen bauen große Leben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-12",
      "text": "Dranbleiben, wenn's unbequem wird – genau da beginnt der Unterschied.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-13",
      "text": "Deine Zukunft fragt nicht nach deiner Laune, sondern nach deinem Einsatz.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-14",
      "text": "Gewohnheiten schlagen Willenskraft – bau dir ein System, kein Gefühl.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-15",
      "text": "Disziplin heißt, der Person von gestern ein Versprechen zu halten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-16",
      "text": "Du wirst nicht jeden Tag gewinnen, aber du kannst jeden Tag zeigen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-17",
      "text": "Durchhaltevermögen heißt, enttäuscht zu sein und trotzdem weiterzumachen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-18",
      "text": "Der Unterschied zwischen Wollen und Haben heißt Durchhalten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-19",
      "text": "Disziplin ist leise – sie schreit nicht, sie liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-20",
      "text": "Wer immer erst bereit sein will, ist nie bereit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-21",
      "text": "Konstanz ist das stille Kapital, das sich niemand stehlen kann.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-22",
      "text": "Du optimierst nicht deinen Tag, du optimierst deinen Charakter.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-23",
      "text": "Disziplin ist der Unterschied zwischen einem Traum und einem Plan.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-24",
      "text": "Niemand sieht die Tage, an denen du trotzdem dran bliebst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-25",
      "text": "Erfolg ist nur Disziplin, die niemand gefilmt hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-26",
      "text": "Du zahlst Disziplin in kleinen Münzen, das Ergebnis kommt als großer Schein.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-27",
      "text": "Stark ist, wer weitermacht, wenn der Antrieb längst Pause hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-28",
      "text": "Disziplin ist dein Investment in ein Leben, das du dir noch nicht leisten kannst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-29",
      "text": "Wer jeden Tag ein Prozent besser wird, baut sich ein neues Leben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-10-27-0",
      "text": "Dein Körper ist der Zinseszins, den du jeden Tag im Gym einzahlst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-1",
      "text": "Energie ist die einzige Währung, die du nicht nachdrucken kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-2",
      "text": "Wer seinen Körper trainiert, trainiert seinen Kopf gleich mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-3",
      "text": "Müdigkeit ist kein Zustand, sie ist eine Entscheidung, die du heute triffst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-4",
      "text": "Dein Puls heute entscheidet über deinen Fokus morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-5",
      "text": "Bewegung ist das günstigste Investment mit der höchsten Rendite.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-6",
      "text": "Schwache Muskeln, schwacher Wille – beides trainierst du zusammen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-7",
      "text": "Der Körper zahlt zurück, was du ihm an Schweiß vorstreckst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-8",
      "text": "Disziplin im Training ist Disziplin im Leben, nur lauter.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-9",
      "text": "Wer sich morgens quält, braucht abends keine Motivation mehr.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-10",
      "text": "Dein Limit von gestern ist dein Warm-up von heute.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-11",
      "text": "Energie tankst du nicht auf der Couch, sondern im Widerstand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-12",
      "text": "Jeder Satz Wiederholungen ist ein Vertrag mit deiner Zukunft.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-13",
      "text": "Ein müder Körper lügt, ein trainierter Körper liefert.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-14",
      "text": "Du schuldest deinem Körper nichts – außer Bewegung, jeden Tag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-15",
      "text": "Kraft ist kein Talent, sie ist eine Rechnung, die du begleichst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-16",
      "text": "Wer aufhört sich zu bewegen, fängt an zu verrosten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-17",
      "text": "Dein Grundumsatz an Energie steigt mit jeder Wiederholung, die du schaffst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-18",
      "text": "Schmerz heute ist Zins, den du für Stärke morgen zahlst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-19",
      "text": "Ein starker Körper verhandelt nicht mit Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-20",
      "text": "Bewegung ist der Kaffee, den dein Nervensystem wirklich braucht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-21",
      "text": "Du trainierst nicht für den Sommer, du trainierst für den Alltag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-22",
      "text": "Kondition ist der Kredit, den dir dein zukünftiges Ich dankt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-23",
      "text": "Wer sich täglich fordert, muss sich nie mehr beweisen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-24",
      "text": "Dein Körper merkt sich jede Ausrede – und jede Extra-Runde.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-25",
      "text": "Stillstand fühlt sich bequem an, bis er zur Schwäche wird.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-26",
      "text": "Schweiß ist die Quittung für Entscheidungen, die du ernst meinst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-27",
      "text": "Ein trainierter Körper denkt klarer, auch wenn du nur sitzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-28",
      "text": "Du bist nicht müde, dein System ist nur unterfordert.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-29",
      "text": "Kraft wächst nicht im Ruhemodus, sondern im Widerstand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-10-27-0",
      "text": "Dankbarkeit ist der günstigste Produktivitäts-Hack, den du heute nutzen kannst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-1",
      "text": "Du checkst dein Konto täglich. Check auch mal, was du schon erreicht hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-2",
      "text": "Zufriedenheit ist kein Ziel, sondern eine Entscheidung, die du jeden Morgen triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-3",
      "text": "Wer nie stehen bleibt, sieht nie, wie weit er schon gekommen ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-4",
      "text": "Dankbarkeit skaliert nicht mit deinem Kontostand, sondern mit deiner Aufmerksamkeit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-5",
      "text": "Du vergleichst dein Kapitel 3 mit dem Kapitel 20 von jemand anderem. Hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-6",
      "text": "Mehr wollen ist gut. Nie zufrieden sein ist ein Burnout mit Umweg.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-7",
      "text": "Erfolg ohne Dankbarkeit ist nur ein längerer Weg zur Leere.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-8",
      "text": "Dein Leben jetzt war mal der Plan, für den du gebetet hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-9",
      "text": "Zufriedenheit ist kein Stillstand. Es ist Treibstoff mit Ruhepuls.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-10",
      "text": "Du optimierst deinen Tag bis ins Detail. Optimiere auch deinen Blick auf das, was da ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-11",
      "text": "Dankbarkeit kostet nichts und zahlt sich sofort aus. Besseres Investment gibt es nicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-12",
      "text": "Wer ständig vergleicht, verpasst, was direkt vor ihm liegt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-13",
      "text": "Ambition ohne Dankbarkeit ist ein Motor ohne Öl. Irgendwann frisst er sich fest.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-14",
      "text": "Du jagst dem nächsten Level hinterher und vergisst, dass dieses hier auch mal Zukunft war.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-15",
      "text": "Zufriedenheit heute macht dich morgen nicht schwächer, sondern klarer.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-16",
      "text": "Dankbarkeit ist die einzige Währung, die mit jedem Gebrauch mehr wert wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-17",
      "text": "Du willst mehr erreichen? Fang an, das zu sehen, was du schon erreicht hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-18",
      "text": "Nicht jede Pause ist verschwendete Zeit. Manche sind der Grund, warum es weitergeht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-19",
      "text": "Zufriedenheit und Ehrgeiz schließen sich nicht aus. Sie brauchen sich.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-20",
      "text": "Du bist dankbar für dein Ziel, aber hast du dem Weg dorthin schon mal gedankt?",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-21",
      "text": "Erfolgreiche Menschen feiern nicht nur das Ziel, sondern auch jeden Meter davor.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-22",
      "text": "Dein Jetzt-Ich würde sich freuen, wenn du kurz innehältst, statt nur weiterzurennen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-23",
      "text": "Zufriedenheit ist keine Schwäche. Unzufriedenheit ohne Pause ist es.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-24",
      "text": "Du optimierst Prozesse, Ziele, Routinen. Optimiere auch, wofür du Danke sagst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-25",
      "text": "Dankbarkeit ist der Unterschied zwischen Erfolg haben und Erfolg spüren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-26",
      "text": "Wer nie zufrieden ist, verwechselt Ehrgeiz mit innerer Unruhe.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-27",
      "text": "Dein größter Wettbewerbsvorteil ist, zufrieden zu sein und trotzdem weiterzumachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-28",
      "text": "Du feierst jeden Umsatz. Feier auch den Moment, in dem du angefangen hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-29",
      "text": "Dankbarkeit macht aus einem guten Tag einen unvergesslichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    }
  ]
}