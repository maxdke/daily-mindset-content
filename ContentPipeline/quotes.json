{
  "generatedAt": "2026-10-20",
  "quotes": [
    {
      "id": "mindset-2026-10-20-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-1",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-2",
      "text": "Dein Kopf glaubt jede Ausrede, die du ihm oft genug erzählst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-3",
      "text": "Comfort Zone ist nur eine schöne Umschreibung für Stillstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-4",
      "text": "Wer auf Stimmung wartet, wartet sein Leben lang.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-5",
      "text": "Deine Zukunft fragt nicht, wie du dich heute fühlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-6",
      "text": "Schwache Momente sind keine Charaktereigenschaft, nur ein Zustand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-7",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Durchhalten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-8",
      "text": "Niemand bewundert den Plan, alle bewundern das Ergebnis.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-9",
      "text": "Dein Gehirn optimiert auf Bequemlichkeit, du musst gegensteuern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-10",
      "text": "Stärke entsteht nicht im Erfolg, sondern im Wiederaufstehen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-11",
      "text": "Ausreden klingen immer vernünftig, solange du sie selbst erfindest.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-12",
      "text": "Wer ständig auf den perfekten Moment wartet, verpasst jeden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-13",
      "text": "Dein Standard von heute ist die Decke von morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-14",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-15",
      "text": "Mentale Stärke ist der Moment, in dem du trotzdem weitermachst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-16",
      "text": "Du verhandelst nicht mit deiner Faulheit, du führst sie.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-17",
      "text": "Der Preis für Wachstum wird immer vor dem Ergebnis fällig.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-18",
      "text": "Konsequenz schlägt Talent, wenn Talent sich nicht anstrengt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-19",
      "text": "Dein innerer Kritiker hat keine Ahnung, wozu du fähig bist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-20",
      "text": "Druck ist nur Energie, die noch keine Richtung gefunden hat.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-21",
      "text": "Wer sich selbst nicht fordert, wird von der Realität gefordert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-22",
      "text": "Beständigkeit ist langweilig, bis sie unschlagbar wird.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-23",
      "text": "Dein Kopf kennt tausend Gründe aufzuhören - ignorier sie.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-24",
      "text": "Erfolg ist selten spontan, meistens einfach nur stur.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-25",
      "text": "Mentale Stärke zeigt sich, wenn niemand zuschaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-26",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-27",
      "text": "Härte gegen dich selbst heute spart dir Reue morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-28",
      "text": "Die beste Version von dir hat keine Lust auf Ausreden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-29",
      "text": "Wachstum fühlt sich nie bequem an, nur rückblickend richtig.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-10-20-0",
      "text": "Disziplin schlägt Motivation an jedem einzelnen Tag der Woche.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-1",
      "text": "Dein Kalender zeigt, was dir wirklich wichtig ist – nicht deine Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-2",
      "text": "Wer auf den perfekten Moment wartet, verpasst den einzig richtigen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-3",
      "text": "Umsatz heilt die meisten Zweifel, aber nur Arbeit bringt Umsatz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-4",
      "text": "Deine Konkurrenz schläft nicht – sie optimiert gerade ihren Prozess.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-5",
      "text": "Ideen sind billig. Umsetzung ist die eigentliche Währung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-6",
      "text": "Du musst nicht motiviert sein, du musst nur anfangen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-7",
      "text": "Jede ungenutzte Stunde heute ist ein Vorsprung für jemand anderen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-8",
      "text": "Erfolg ist kein Zufall, sondern das Ergebnis wiederholter kleiner Entscheidungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-9",
      "text": "Wer sich nicht selbst führt, wird irgendwann geführt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-10",
      "text": "Komfort ist der leiseste Feind deiner Ziele.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-11",
      "text": "Plane wie ein Stratege, handle wie ein Macher.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-12",
      "text": "Das Risiko, nichts zu tun, wird systematisch unterschätzt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-13",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-14",
      "text": "Fokus ist die Fähigkeit, laute Optionen zu ignorieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-15",
      "text": "Kleine Fortschritte schlagen große Pläne, die nie starten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-16",
      "text": "Baue heute das System, das dich morgen nicht mehr braucht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-17",
      "text": "Wer ständig optimiert, vergisst oft einfach zu liefern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-18",
      "text": "Zeit ist das einzige Kapital, das sich nicht nachschießen lässt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-19",
      "text": "Mut ist der erste Investor in jede gute Idee.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-20",
      "text": "Niemand bewundert den Plan. Alle bewundern das Ergebnis.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-21",
      "text": "Dein Netzwerk wächst nicht durch Warten, sondern durch Liefern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-22",
      "text": "Struktur ist Freiheit in Verkleidung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-23",
      "text": "Rückschläge sind Daten, keine Urteile.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-24",
      "text": "Wer alles kontrollieren will, skaliert nie.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-25",
      "text": "Verkaufe das Problem, das du wirklich löst – nicht das Produkt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-26",
      "text": "Konsequenz ist die unsichtbare Abkürzung zum Erfolg.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-27",
      "text": "Deine Ausrede von heute wird deine Realität in fünf Jahren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-28",
      "text": "Wachstum fühlt sich selten bequem an – genau deshalb ist es Wachstum.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-29",
      "text": "Baue dein Business so, dass es ohne dich funktioniert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-10-20-0",
      "text": "Disziplin ist der Unterschied zwischen dem, was du willst, und dem, was du bekommst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-1",
      "text": "Motivation startet dich. Disziplin hält dich am Laufen, wenn Motivation längst schläft.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-2",
      "text": "Du brauchst keine Lust, du brauchst ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-3",
      "text": "Jeden Tag, an dem du durchziehst, wird die Ausrede leiser.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-4",
      "text": "Komfort ist der Ort, an dem Ziele sterben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-5",
      "text": "Disziplin ist leise. Sie postet nicht, sie liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-6",
      "text": "Wer auf Gefühle wartet, wartet ewig. Mach es einfach.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-7",
      "text": "Dein zukünftiges Ich zahlt den Preis für die Ausreden von heute.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-8",
      "text": "Konsequenz schlägt Intensität – jeden einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-9",
      "text": "Die Wiederholung ist langweilig. Der Erfolg ist es nie.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-10",
      "text": "Du musst nicht motiviert sein. Du musst nur anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-11",
      "text": "Disziplin ist Selbstliebe in ihrer unbequemsten Form.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-12",
      "text": "Niemand sieht die 5 Uhr morgens. Alle sehen das Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-13",
      "text": "Härte heute spart Reue morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-14",
      "text": "Standhaft bleiben, wenn niemand zuschaut – das ist der ganze Unterschied.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-15",
      "text": "Dein Standard ist das, was du tust, wenn es sich scheiße anfühlt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-16",
      "text": "Durchziehen schlägt perfekt planen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-17",
      "text": "Disziplin fühlt sich nach nichts an – bis sie alles verändert hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-18",
      "text": "Du verlierst nicht an einem schlechten Tag. Du verlierst, wenn du aufhörst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-19",
      "text": "Jede Ausrede klingt plausibel. Keine bringt dich weiter.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-20",
      "text": "Konstanz ist das stille Superpower, das keiner sehen will.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-21",
      "text": "Groß wird man nicht durch Lust, sondern durch Routine.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-22",
      "text": "Der Weg ist unsexy. Das Ziel ist es wert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-23",
      "text": "Zeig mir deinen Tagesablauf, ich zeig dir deine Zukunft.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-24",
      "text": "Disziplin ist der Vertrag, den du mit dir selbst einhältst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-25",
      "text": "Wer aufgibt, wenn es schwer wird, hat es nie wirklich gewollt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-26",
      "text": "Schmerz ist temporär. Aufgeben ist für immer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-27",
      "text": "Du bist nicht müde von der Arbeit. Du bist müde von der Ausrede.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-28",
      "text": "Disziplin kauft Freiheit auf Raten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-29",
      "text": "Mach weiter, auch wenn es sich nach nichts anfühlt – besonders dann.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-10-20-0",
      "text": "Dein Körper ist kein Projekt, er ist dein Betriebssystem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-1",
      "text": "Energie ist die einzige Währung, die du nicht leihen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-2",
      "text": "Wer seinen Körper vernachlässigt, arbeitet mit kaputter Hardware.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-3",
      "text": "Bewegung ist der Zinseszins deiner Gesundheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-4",
      "text": "Kein Meeting schlägt dein Training – beides entscheidet über deinen Tag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-5",
      "text": "Dein Puls heute bestimmt deine Klarheit morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-6",
      "text": "Schwache Beine, schwacher Fokus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-7",
      "text": "Fitness ist kein Ziel, sondern dein Betriebskapital.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-8",
      "text": "Du optimierst dein Portfolio – optimier zuerst deinen Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-9",
      "text": "Ohne Energie-Management gibt's kein Zeit-Management.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-10",
      "text": "Dein schwerstes Gewicht heute ist dein leichtestes morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-11",
      "text": "Muskeln lügen nicht, Ausreden schon.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-12",
      "text": "Jede Wiederholung ist ein Investment ohne Risiko.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-13",
      "text": "Schlaf ist dein günstigster Performance-Booster.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-14",
      "text": "Wer sich nicht bewegt, bremst sein eigenes System.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-15",
      "text": "Dein Körper merkt sich jede verpasste Einheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-16",
      "text": "Stärke ist kein Zufall, sondern ein Abo, das man täglich bezahlt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-17",
      "text": "Ausdauer im Training wird Ausdauer im Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-18",
      "text": "Kein Kaffee ersetzt einen Puls über 140.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-19",
      "text": "Dein Energielevel ist dein wahres Guthaben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-20",
      "text": "Wer körperlich stagniert, stagniert überall.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-21",
      "text": "Ein starker Körper trägt einen starken Willen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-22",
      "text": "Bewegung ist die billigste Therapie, die du nie nutzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-23",
      "text": "Dein Workout heute finanziert deine Energie morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-24",
      "text": "Schwitzen ist die Quittung für Fortschritt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-25",
      "text": "Disziplin im Training ist Disziplin im Denken.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-26",
      "text": "Wer sich körperlich fordert, verhandelt mental auf Augenhöhe.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-27",
      "text": "Dein Körper ist das einzige Büro, das du nie kündigen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-28",
      "text": "Kraft baust du nicht im Kopf, sondern in der Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-29",
      "text": "Jede Einheit ist ein Vorschuss auf deine beste Version.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-10-20-0",
      "text": "Dankbarkeit ist der Zinseszins der Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-1",
      "text": "Wer nicht würdigt was er hat, verliert das Nächste schneller.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-2",
      "text": "Zufriedenheit ist kein Ziel, sie ist der Boden, auf dem du wächst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-3",
      "text": "Dankbarkeit kostet nichts und zahlt jeden Tag Rendite.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-4",
      "text": "Du vergleichst dein Jetzt mit fremden Highlights. Hör auf damit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-5",
      "text": "Genug ist ein Gefühl, kein Kontostand.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-6",
      "text": "Dankbar sein heißt nicht, aufhören zu wollen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-7",
      "text": "Dein Leben in fünf Jahren dankt dir, wenn du heute schon zufrieden bist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-8",
      "text": "Zufriedenheit ist der stabilste Antrieb, den es gibt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-9",
      "text": "Wer dankbar lebt, verschwendet keine Energie an Neid.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-10",
      "text": "Dankbarkeit ist die einzige Investition ohne Risiko.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-11",
      "text": "Du musst nicht alles erreicht haben, um stolz zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-12",
      "text": "Zufriedenheit heute macht dich schneller morgen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-13",
      "text": "Dankbarkeit ist kein Rückblick, sie ist dein Tempo heute.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-14",
      "text": "Wer ständig mehr will, übersieht was schon da ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-15",
      "text": "Dein Fortschritt zählt auch, wenn er klein aussieht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-16",
      "text": "Zufriedenheit ist keine Bremse, sie ist dein Fundament.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-17",
      "text": "Dankbarkeit macht aus Druck Motivation.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-18",
      "text": "Du bist weiter, als du dir selbst zugibst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-19",
      "text": "Genieße das Level, auf dem du gerade bist, bevor du weiterlevelst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-20",
      "text": "Dankbarkeit ist die Pause, die dich am Ende schneller macht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-21",
      "text": "Zufriedenheit und Ehrgeiz schließen sich nicht aus, sie ergänzen sich.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-22",
      "text": "Was du heute hast, war gestern noch dein Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-23",
      "text": "Dankbarkeit ist dein Realitätscheck gegen den ständigen Vergleich.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-24",
      "text": "Wer zufrieden startet, läuft entspannter zum Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-25",
      "text": "Dein Jetzt ist das Ergebnis von früherem Durchhalten. Ehre es.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-26",
      "text": "Zufriedenheit ist Energie, die du nicht an Unzufriedenheit verlierst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-27",
      "text": "Dankbarkeit macht aus Erfolgsdruck Erfolgsfreude.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-28",
      "text": "Du musst nicht alles sofort haben, um jetzt schon reich zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-29",
      "text": "Zufriedenheit ist dein Startkapital, keine Endstation.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    }
  ]
}