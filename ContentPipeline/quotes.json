{
  "generatedAt": "2026-11-09",
  "quotes": [
    {
      "id": "mindset-2026-11-09-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-1",
      "text": "Dein Kopf glaubt an Limits, die dein Körper nie getestet hat.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-2",
      "text": "Motivation ist Zufall. Systeme sind Garantie.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-3",
      "text": "Wer auf Gefühle wartet, wartet auf Ausreden.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-4",
      "text": "Unbequem ist der Preis, Reue die Alternative.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-5",
      "text": "Dein Mindset skaliert nicht automatisch mit deinem Konto.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-6",
      "text": "Schwache Tage sind kein Beweis, nur eine Momentaufnahme.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-7",
      "text": "Niemand bewundert den Plan. Alle bewundern das Ergebnis.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-8",
      "text": "Stärke ist kein Zustand, sondern eine tägliche Entscheidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-9",
      "text": "Du verhandelst nicht mit deinem inneren Schweinehund, du ignorierst ihn.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-10",
      "text": "Komfort ist der leiseste Dieb deiner Zukunft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-11",
      "text": "Klarheit entsteht nicht durch Denken, sondern durch Handeln.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-12",
      "text": "Dein Standard ist, was du tolerierst, wenn niemand zusieht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-13",
      "text": "Disziplin fühlt sich wie Freiheit an, sobald sie Routine wird.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-14",
      "text": "Wer ständig Energie sucht, hat die falschen Prioritäten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-15",
      "text": "Dein größter Konkurrent schläft nicht in deinem Kopf, sondern in deinem Bett.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-16",
      "text": "Zweifel sind laut, Fortschritt ist leise.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-17",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-18",
      "text": "Perfektion ist eine Entschuldigung in gutem Design.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-19",
      "text": "Resilienz baust du nicht in guten, sondern in miesen Phasen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-20",
      "text": "Wer jeden Tag Ausnahmen macht, hat keine Regeln.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-21",
      "text": "Dein Verstand testet dich nur, um zu sehen, ob du es ernst meinst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-22",
      "text": "Gewohnheiten schlagen Willenskraft jeden einzelnen Tag.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-23",
      "text": "Du bist nicht müde. Du bist unmotiviert mit Ausrede.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-24",
      "text": "Erfolg fühlt sich im Prozess fast immer wie Scheitern an.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "mindset-2026-12-04-25",
      "text": "Mentale Stärke zeigt sich nicht im Sieg, sondern im Montag danach.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-04"
    },
    {
      "id": "mindset-2026-12-05-26",
      "text": "Du kannst nicht optimieren, was du nicht ehrlich betrachtest.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-05"
    },
    {
      "id": "mindset-2026-12-06-27",
      "text": "Der Unterschied zwischen Träumern und Machern ist ein Wecker.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-06"
    },
    {
      "id": "mindset-2026-12-07-28",
      "text": "Wachstum fühlt sich an wie Unsicherheit, die du trotzdem aushältst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-07"
    },
    {
      "id": "mindset-2026-12-08-29",
      "text": "Dein Ego will Applaus. Dein Charakter will Ergebnisse.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-08"
    },
    {
      "id": "business-2026-11-09-0",
      "text": "Disziplin schlägt Motivation an jedem Tag, an dem du keine Lust hast.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-1",
      "text": "Dein Kontostand ist nur ein Echo deiner Gewohnheiten von vor sechs Monaten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-2",
      "text": "Während andere Ausreden sammeln, sammelst du Ergebnisse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-3",
      "text": "Wer um 6 Uhr plant, schlägt den, der um 10 Uhr aufwacht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-4",
      "text": "Dein Side Hustle wird nie größer als dein Durchhaltevermögen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-5",
      "text": "Komfort ist die Zinsrate, die du für Stillstand zahlst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-6",
      "text": "Niemand bewundert den Plan. Alle bewundern das Ergebnis.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-7",
      "text": "Du verhandelst nicht mit deiner Snooze-Taste, du feuerst sie.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-8",
      "text": "Zeit ist die einzige Währung, die du nie zurückbekommst, also investiere sie wie eine.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-9",
      "text": "Dein zukünftiges Ich finanziert sich aus den Entscheidungen von heute.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-10",
      "text": "Wachstum fühlt sich nie bequem an, sonst würde es jeder tun.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-11",
      "text": "Ein Ziel ohne Deadline ist nur ein Wunsch mit besserem Marketing.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-12",
      "text": "Du brauchst keine Motivation, du brauchst ein System, das ohne sie funktioniert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-13",
      "text": "Erfolg ist langweilig, bevor er spektakulär wird.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-14",
      "text": "Deine Konkurrenz schläft nicht, sie plant gerade deinen nächsten Schritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-15",
      "text": "Jede Stunde Netflix heute ist ein Jahr Verzögerung morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-16",
      "text": "Reichtum beginnt nicht auf dem Konto, sondern im Kalender.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-17",
      "text": "Du bist nicht müde, du bist unterfordert von deinen eigenen Zielen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-18",
      "text": "Die besten Deals machst du mit dir selbst, früh am Morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-19",
      "text": "Stillstand kostet mehr als jeder Fehler, den du beim Starten machst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-20",
      "text": "Dein Umsatz wächst so schnell wie dein Unbehagen es zulässt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-21",
      "text": "Wer auf den perfekten Moment wartet, zahlt Miete in der Warteschlange.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-22",
      "text": "Du skalierst kein Business, du skalierst deine Entscheidungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-23",
      "text": "Produktivität ist kein Zufall, sie ist eine tägliche Verhandlung mit dir selbst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-24",
      "text": "Der Markt belohnt nicht deine Absicht, sondern deine Ausführung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-12-04-25",
      "text": "Zwischen Idee und Imperium liegt nur konsequentes Handeln.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-04"
    },
    {
      "id": "business-2026-12-05-26",
      "text": "Du verlierst keine Zeit, du verschenkst sie an Leute, die nichts riskieren.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-05"
    },
    {
      "id": "business-2026-12-06-27",
      "text": "Dein Netzwerk ist dein Vorsprung, bau es aus, bevor du ihn brauchst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-06"
    },
    {
      "id": "business-2026-12-07-28",
      "text": "Risiko ist nur ein anderes Wort für Vorsprung, den andere nicht wollen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-07"
    },
    {
      "id": "business-2026-12-08-29",
      "text": "Wer heute optimiert, verkauft morgen zu besseren Konditionen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-08"
    },
    {
      "id": "discipline-2026-11-09-0",
      "text": "Disziplin ist der Zinseszins der Gewohnheiten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-1",
      "text": "Motivation ist ein Gefühl. Disziplin ist eine Entscheidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-2",
      "text": "Du wirst nicht jeden Tag Lust haben. Mach es trotzdem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-3",
      "text": "Konsequenz schlägt Talent, wenn Talent sich nicht anstrengt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-4",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-5",
      "text": "Disziplin fühlt sich schwer an, bis sie zur Identität wird.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-6",
      "text": "Wer aufgibt, wenn's unbequem wird, war nie wirklich im Spiel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-7",
      "text": "Durchhalten ist langweilig. Aufgeben ist teuer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-8",
      "text": "Die Ausrede von heute ist die Niederlage von morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-9",
      "text": "Kleine Schritte, jeden Tag, ohne Applaus.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-10",
      "text": "Disziplin ist die Brücke zwischen Ziel und Realität.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-11",
      "text": "Niemand sieht die Tage, an denen du trotzdem weitergemacht hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-12",
      "text": "Komfort ist der leiseste Feind deiner Ziele.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-13",
      "text": "Du brauchst keine Inspiration. Du brauchst einen Plan und Sturheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-14",
      "text": "Was du heute vermeidest, verfolgt dich morgen als Rückstand.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-15",
      "text": "Stillstand fühlt sich sicher an. Genau das macht ihn gefährlich.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-16",
      "text": "Erfolg ist das, was übrig bleibt, wenn die Ausreden aufgebraucht sind.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-17",
      "text": "Wiederholung ist die Mutter der Meisterschaft, nicht der Zufall.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-18",
      "text": "Jeder Tag, den du durchhältst, ist ein Tag weniger bis zum Ziel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-19",
      "text": "Dein Durchhaltevermögen entscheidet, nicht dein Ausgangspunkt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-20",
      "text": "Disziplin ist leise. Reue ist laut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-21",
      "text": "Du verlierst nicht gegen andere. Du verlierst gegen deine Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-22",
      "text": "Der Unterschied zwischen Träumen und Zielen heißt Disziplin.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-23",
      "text": "Mach weiter, wenn niemand klatscht. Genau dort entsteht der Unterschied.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-24",
      "text": "Konstanz ist unsexy. Ergebnisse sind es nicht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-12-04-25",
      "text": "Du musst nicht motiviert sein. Du musst nur anfangen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-04"
    },
    {
      "id": "discipline-2026-12-05-26",
      "text": "Jede Ausnahme kostet dich mehr als du denkst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-05"
    },
    {
      "id": "discipline-2026-12-06-27",
      "text": "Harte Tage bauen die Version von dir, die du sein willst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-06"
    },
    {
      "id": "discipline-2026-12-07-28",
      "text": "Disziplin ist der Preis, den du für Freiheit später zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-07"
    },
    {
      "id": "discipline-2026-12-08-29",
      "text": "Wer immer erst wartet, bis er bereit ist, wartet für immer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-08"
    },
    {
      "id": "fitness-2026-11-09-0",
      "text": "Dein Körper ist kein Projekt für morgen, sondern dein Werkzeug für heute.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-1",
      "text": "Energie ist kein Zufall, sie ist eine Entscheidung vor dem Frühstück.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-2",
      "text": "Wer seinen Körper trainiert, trainiert seinen Kopf gleich mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-3",
      "text": "Müdigkeit lügt öfter als dein Wecker.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-4",
      "text": "Disziplin im Training ist Zinseszins für deine Zukunft.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-5",
      "text": "Dein Puls entscheidet, wie klar dein Kopf heute denkt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-6",
      "text": "Bewegung ist der billigste Kaffee, den es gibt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-7",
      "text": "Ein starker Körper verhandelt nicht mit schwachen Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-8",
      "text": "Schweiß ist die Quittung für Potenzial, das du nicht ignoriert hast.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-9",
      "text": "Dein Limit von gestern ist dein Warm-up von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-10",
      "text": "Wer sich bewegt, bewegt auch seine Gedanken aus der Schleife.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-11",
      "text": "Kraft baut man nicht im Kopf auf, sondern im Wiederholen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-12",
      "text": "Dein Körper merkt sich jeden Tag, an dem du ihn ignoriert hast.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-13",
      "text": "Energie tanken heißt nicht warten, sondern loslaufen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-14",
      "text": "Ein kurzer Satz Liegestütze schlägt jede lange Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-15",
      "text": "Fitness ist kein Ziel, sie ist dein Betriebssystem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-16",
      "text": "Wer schwach startet, trainiert trotzdem stärker als wer gar nicht startet.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-17",
      "text": "Dein Körper ist die einzige Immobilie, die du nie verkaufen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-18",
      "text": "Ausdauer im Training ist Ausdauer im Leben, nur schneller sichtbar.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-19",
      "text": "Bewege dich, bevor dein Kopf anfängt zu verhandeln.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-20",
      "text": "Jeder Satz im Training ist ein Investment ohne Risiko.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-21",
      "text": "Dein Körper spricht Klartext, auch wenn du ihn ignorierst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-22",
      "text": "Stärke zeigt sich nicht im Spiegel, sondern in der nächsten Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-23",
      "text": "Wer heute trainiert, muss morgen weniger kämpfen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-24",
      "text": "Dein Energielevel ist keine Veranlagung, sondern dein Zeitplan.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-12-04-25",
      "text": "Ein Workout verschiebt keine Probleme, es verbrennt sie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-04"
    },
    {
      "id": "fitness-2026-12-05-26",
      "text": "Dein Körper ist das Fundament für jeden anderen Erfolg.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-05"
    },
    {
      "id": "fitness-2026-12-06-27",
      "text": "Bewegung schlägt Motivation, jedes einzelne Mal.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-06"
    },
    {
      "id": "fitness-2026-12-07-28",
      "text": "Kraft kommt nicht von Worten, sondern von der letzten Wiederholung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-07"
    },
    {
      "id": "fitness-2026-12-08-29",
      "text": "Dein Körper zahlt Zinsen auf jede Einheit, die du investierst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-08"
    },
    {
      "id": "gratitude-2026-11-09-0",
      "text": "Zufriedenheit ist kein Ziel, sie ist dein Ausgangspunkt für mehr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-1",
      "text": "Dankbarkeit ist der Zinseszins deiner Gedanken.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-2",
      "text": "Wer nicht sieht, was er hat, verliert irgendwann, was er hatte.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-3",
      "text": "Dein Jetzt ist das Resultat von gestern. Sei stolz drauf, bevor du weitermachst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-4",
      "text": "Zufriedenheit und Ambition schließen sich nicht aus, sie verstärken sich.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-5",
      "text": "Du musst nicht glücklich sein, um dankbar zu sein. Aber dankbar, um glücklich zu bleiben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-6",
      "text": "Vergleich killt Dankbarkeit. Fokus killt Vergleich.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-7",
      "text": "Jeder Tag ohne Krise ist bereits ein Tag im Plus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-8",
      "text": "Dankbarkeit ist das Fundament, auf dem du baust, nicht die Decke, unter der du stehen bleibst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-9",
      "text": "Was du besitzt, bestimmt nicht, wer du bist. Wie du es wertschätzt schon.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-10",
      "text": "Zufriedenheit ist kein Stillstand, sondern dein Fundament für den nächsten Move.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-11",
      "text": "Du bist weiter als du denkst. Zeit, dankbarer dafür zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-12",
      "text": "Minimalismus im Kopf heißt: weniger Neid, mehr Dank.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-13",
      "text": "Jeder Erfolg fühlt sich leer an, wenn du vergisst, wofür du dankbar bist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-14",
      "text": "Dankbarkeit ist die einzige Investition mit sofortiger Rendite.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-15",
      "text": "Du jagst Ziele. Vergiss nicht zu feiern, was du schon erreicht hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-16",
      "text": "Zufriedenheit heute macht dich hungriger auf morgen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-17",
      "text": "Wer dankbar lebt, verliert nie den Boden unter den Füßen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-18",
      "text": "Dein Leben ist der Wunschtraum von jemand anderem. Handle entsprechend.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-19",
      "text": "Dankbarkeit ist Mindset-Training für den Umgang mit Erfolg.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-20",
      "text": "Zufriedenheit schützt dich vor Burnout, nicht vor Zielen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-21",
      "text": "Du brauchst keine Gründe für Dankbarkeit. Nur Augen dafür.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-22",
      "text": "Jeder Tag, den du bewusst lebst, ist bereits ein Gewinn.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-23",
      "text": "Ambition ohne Dankbarkeit ist ein Fass ohne Boden.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-24",
      "text": "Zufriedenheit ist nicht das Ende der Reise, sondern ihr Treibstoff.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-12-04-25",
      "text": "Du bist schon weiter, als dein innerer Kritiker zugibt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-04"
    },
    {
      "id": "gratitude-2026-12-05-26",
      "text": "Dankbarkeit macht aus Druck Perspektive.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-05"
    },
    {
      "id": "gratitude-2026-12-06-27",
      "text": "Was heute selbstverständlich ist, war gestern noch ein Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-06"
    },
    {
      "id": "gratitude-2026-12-07-28",
      "text": "Zufrieden sein heißt nicht aufhören zu wollen, sondern anfangen zu sehen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-07"
    },
    {
      "id": "gratitude-2026-12-08-29",
      "text": "Dankbarkeit ist die stille Disziplin der Erfolgreichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-08"
    }
  ]
}