{
  "generatedAt": "2026-11-08",
  "quotes": [
    {
      "id": "mindset-2026-11-08-0",
      "text": "Dein Kopf gibt zuerst auf, nicht dein Körper. Trainier beide.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-1",
      "text": "Motivation ist ein Gast. Disziplin zieht bei dir ein.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-2",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-3",
      "text": "Comfort Zone ist nur ein anderes Wort für Stillstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-4",
      "text": "Wer auf perfekte Bedingungen wartet, wartet für immer.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-5",
      "text": "Dein Umfeld formt dein Limit. Wähl es mit Bedacht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-6",
      "text": "Schwache Tage gehören dazu. Aufgeben nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-7",
      "text": "Du bist nicht müde von der Arbeit, sondern vom Zweifel.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-8",
      "text": "Große Ziele brauchen kleine, stille Tage.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-9",
      "text": "Niemand sieht die 5 Uhr morgens, aber jeder sieht das Ergebnis.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-10",
      "text": "Dein zukünftiges Ich zahlt für die Ausreden von heute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-11",
      "text": "Stärke ist kein Gefühl, sondern eine Entscheidung am Morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-12",
      "text": "Du wirst nicht über Nacht stark, sondern jeden Tag ein bisschen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-13",
      "text": "Zweifel ist laut, aber er hat nie etwas erreicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-14",
      "text": "Wer sich selbst überwindet, muss keine Konkurrenz fürchten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-15",
      "text": "Dein Kopf ist dein stärkster Verbündeter – wenn du ihn trainierst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-16",
      "text": "Unbequem ist der Preis für ein Leben, das sich lohnt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-17",
      "text": "Du kannst müde sein und trotzdem weitermachen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-18",
      "text": "Erfolg fragt nicht nach deiner Stimmung, nur nach deiner Aktion.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-19",
      "text": "Jeder Tag, an dem du durchhältst, ist ein Tag, den andere aufgegeben hätten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-20",
      "text": "Dein Verstand testet dich zuerst, bevor er dir vertraut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-21",
      "text": "Disziplin fühlt sich nie gut an – bis sie zur Identität wird.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-22",
      "text": "Du verlierst nicht, wenn du fällst. Du verlierst, wenn du liegen bleibst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-23",
      "text": "Klarheit kommt nicht vom Denken, sondern vom Handeln.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-24",
      "text": "Dein innerer Kritiker lügt öfter, als du denkst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-25",
      "text": "Wachstum fühlt sich an wie Unbehagen in Verkleidung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "mindset-2026-12-04-26",
      "text": "Du brauchst keine Motivation. Du brauchst ein System.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-04"
    },
    {
      "id": "mindset-2026-12-05-27",
      "text": "Stillstand ist der leiseste Feind deiner Ziele.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-05"
    },
    {
      "id": "mindset-2026-12-06-28",
      "text": "Wer sich selbst führen kann, führt irgendwann andere.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-06"
    },
    {
      "id": "mindset-2026-12-07-29",
      "text": "Dein Limit ist meistens nur eine Meinung, keine Tatsache.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-07"
    },
    {
      "id": "business-2026-11-08-0",
      "text": "Disziplin schlägt Motivation an jedem einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-1",
      "text": "Deine Zukunft wird heute gebaut, nicht morgen geplant.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-2",
      "text": "Wer wartet, bis er bereit ist, wartet für immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-3",
      "text": "Umsätze lügen nicht, Ausreden schon.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-4",
      "text": "Dein Konkurrent schläft nicht, also lauf weiter.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-5",
      "text": "Komfort ist der leise Tod jeder Ambition.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-6",
      "text": "Erfolg ist keine Eingebung, sondern eine trainierte Gewohnheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-7",
      "text": "Jede verschwendete Stunde ist ein Investment in Mittelmäßigkeit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-8",
      "text": "Plane wie ein CEO, handle wie ein Praktikant.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-9",
      "text": "Dein Netzwerk entscheidet, wie schnell dein Aufstieg geht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-10",
      "text": "Wer keine Risiken eingeht, verliert garantiert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-11",
      "text": "Baue heute, was dir in fünf Jahren Freiheit schenkt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-12",
      "text": "Produktivität beginnt genau da, wo Ausreden enden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-13",
      "text": "Kleine Entscheidungen heute, große Ergebnisse morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-14",
      "text": "Fokus ist die neue Währung der Erfolgreichen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-15",
      "text": "Dein Kalender zeigt, wie ernst du deine Ziele wirklich nimmst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-16",
      "text": "Null freie Tage, solange dein Ziel noch Lücken hat.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-17",
      "text": "Verkaufe nicht deine Zeit, verkaufe dein System.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-18",
      "text": "Wer nur reagiert, wird niemals führen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-19",
      "text": "Dein größter Konkurrent bist du von gestern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-20",
      "text": "Gewinner optimieren Prozesse, Verlierer sammeln Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-21",
      "text": "Jede E-Mail, die du aufschiebst, kostet dich eine Chance.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-22",
      "text": "Stillstand fühlt sich sicher an und ist der teuerste Fehler.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-23",
      "text": "Baue dein Business so, als müsste es dich einmal retten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-24",
      "text": "Wer nicht skaliert, stagniert leise.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-25",
      "text": "Eine Liste ist nur ein Plan, Taten sind das Ergebnis.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-12-04-26",
      "text": "Cashflow ist Freiheit, Schulden sind Ketten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-04"
    },
    {
      "id": "business-2026-12-05-27",
      "text": "Arbeite an deinem Unternehmen, nicht nur in ihm.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-05"
    },
    {
      "id": "business-2026-12-06-28",
      "text": "Jeder Tag ohne Fortschritt ist ein Geschenk an deine Konkurrenz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-06"
    },
    {
      "id": "business-2026-12-07-29",
      "text": "Mut kostet nichts, Zögern kostet alles.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-07"
    },
    {
      "id": "discipline-2026-11-08-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-1",
      "text": "Motivation bringt dich an den Start, Disziplin über die Ziellinie.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-2",
      "text": "Du musst nicht wollen, du musst machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-3",
      "text": "Jeden Tag eine Entscheidung gegen den bequemen Weg.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-4",
      "text": "Durchhalten ist langweilig. Aufgeben ist teurer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-5",
      "text": "Dein zukünftiges Ich dankt dir für heute, nicht für morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-6",
      "text": "Disziplin fühlt sich nie gut an, bis sie sich auszahlt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-7",
      "text": "Wer aufhört zu üben, hört auf zu wachsen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-8",
      "text": "Konsequenz schlägt Talent, jeden einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-9",
      "text": "Der Unterschied zwischen Wunsch und Ziel heißt Disziplin.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-10",
      "text": "Keine Ausnahme, auch nicht heute.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-11",
      "text": "Harte Tage bauen das Fundament für leichte Jahre.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-12",
      "text": "Du entscheidest dich nicht einmal, du entscheidest dich täglich neu.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-13",
      "text": "Wer Ausreden sammelt, sammelt keine Ergebnisse.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-14",
      "text": "Dranbleiben, wenn niemand mehr zuschaut – das ist Charakter.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-15",
      "text": "Disziplin ist Freiheit in Verkleidung.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-16",
      "text": "Kleine Schritte, aber jeden Tag – das schlägt jeden Sprint.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-17",
      "text": "Gewohnheiten bauen das Leben, das Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-18",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-19",
      "text": "Der Preis der Disziplin ist immer kleiner als der Preis des Bereuens.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-20",
      "text": "Komfort ist der leiseste Feind deiner Ziele.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-21",
      "text": "Wer jeden Tag ein bisschen besser wird, ist in einem Jahr unaufhaltbar.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-22",
      "text": "Disziplin heißt, dem Ich von gestern ein Versprechen zu halten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-23",
      "text": "Nicht jeder Tag fühlt sich nach Fortschritt an, aber jeder zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-24",
      "text": "Du brauchst keine Lust, du brauchst ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-25",
      "text": "Stärke entsteht nicht im Erfolg, sondern im Wiederholen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-12-04-26",
      "text": "Wer immer erst wartet, bis es sich richtig anfühlt, wartet ewig.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-04"
    },
    {
      "id": "discipline-2026-12-05-27",
      "text": "Disziplin ist die Brücke zwischen Zielen und Realität.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-05"
    },
    {
      "id": "discipline-2026-12-06-28",
      "text": "Du überholst niemanden, solange du nur an guten Tagen arbeitest.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-06"
    },
    {
      "id": "discipline-2026-12-07-29",
      "text": "Durchhalten ist die stille Version von Gewinnen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-07"
    },
    {
      "id": "fitness-2026-11-08-0",
      "text": "Dein Körper ist dein erstes Investment – alle anderen Renditen folgen danach.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-1",
      "text": "Energie ist die einzige Währung, die du nicht leihen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-2",
      "text": "Wer seinen Körper vernachlässigt, arbeitet mit kaputter Hardware.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-3",
      "text": "Training ist der Zinseszins deiner Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-4",
      "text": "Müdigkeit ist oft nur eine Entscheidung mit schlechtem Marketing.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-5",
      "text": "Dein Puls heute bestimmt dein Tempo morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-6",
      "text": "Bewegung ist das günstigste Antidepressivum, das du nie einlöst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-7",
      "text": "Du kannst nicht outperformen, wenn dein Körper im Energiesparmodus läuft.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-8",
      "text": "Jeder Satz im Gym ist eine Einzahlung auf dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-9",
      "text": "Disziplin im Training ist der Beweis, dass du dir selbst vertraust.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-10",
      "text": "Ein starker Körper verhandelt bessere Konditionen mit dem Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-11",
      "text": "Wer schwitzt, denkt klarer – das ist keine Floskel, das ist Biologie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-12",
      "text": "Dein Energielevel ist kein Zufall, sondern ein Ergebnis.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-13",
      "text": "Schlaf ist die unterschätzteste Leistungssteigerung überhaupt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-14",
      "text": "Du schuldest deinem Körper die gleiche Disziplin wie deinem Konto.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-15",
      "text": "Bewegung ist der Zins, den du auf gute Entscheidungen bekommst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-16",
      "text": "Wer sich körperlich fordert, verschiebt seine mentale Grenze automatisch mit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-17",
      "text": "Ausdauer im Training ist Ausdauer im Leben – nur mit Schweiß statt Excel.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-18",
      "text": "Dein Körper merkt sich jede Ausrede, die du ihm erzählst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-19",
      "text": "Fitness ist kein Ziel, sondern das Fundament, auf dem alles andere steht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-20",
      "text": "Kraft im Körper macht Kraft im Kopf verhandelbar.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-21",
      "text": "Wer heute trainiert, kauft sich morgen mehr Optionen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-22",
      "text": "Dein Energielevel ist dein Aktienkurs – pflege ihn täglich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-23",
      "text": "Bewegung ist die billigste Form von Selbstrespekt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-24",
      "text": "Ein Workout ist ein Meeting mit dir selbst, das du nicht canceln solltest.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-25",
      "text": "Dein Körper ist die Firma, die du nie verkaufen kannst – führe sie gut.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-12-04-26",
      "text": "Wer sich körperlich stark fühlt, trifft mutigere Entscheidungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-04"
    },
    {
      "id": "fitness-2026-12-05-27",
      "text": "Energie tanken heißt nicht ausruhen, sondern bewegen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-05"
    },
    {
      "id": "fitness-2026-12-06-28",
      "text": "Dein Puls lügt nicht – er zeigt, wie ernst du es meinst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-06"
    },
    {
      "id": "fitness-2026-12-07-29",
      "text": "Fitness ist der stille Vorteil, den niemand auf LinkedIn sieht.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-07"
    },
    {
      "id": "gratitude-2026-11-08-0",
      "text": "Zufriedenheit ist kein Ziel, sondern eine Entscheidung, die du heute triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-1",
      "text": "Wer nicht dankbar ist für das Jetzt, wird auch im Erfolg nichts spüren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-2",
      "text": "Dankbarkeit ist der Zinseszins der Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-3",
      "text": "Du optimierst dein Portfolio, aber ignorierst dein Glücksgefühl von heute.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-4",
      "text": "Erfolg ohne Dankbarkeit ist nur eine leere Zahl auf dem Konto.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-5",
      "text": "Zufriedenheit checkst du nicht im Kontostand, sondern im Spiegel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-6",
      "text": "Wer ständig mehr will, hat nie genug - lern das Jetzt zu feiern.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-7",
      "text": "Dankbarkeit kostet nichts und bringt mehr Rendite als jede Aktie.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-8",
      "text": "Dein größter Flex ist Zufriedenheit, die keiner sehen muss.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-9",
      "text": "Gratitude ist dein unsichtbares Investment in mentale Stabilität.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-10",
      "text": "Wer das Haben feiert, braucht das Zeigen nicht mehr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-11",
      "text": "Zufriedenheit ist der Bonus, den du dir selbst auszahlst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-12",
      "text": "Du jagst dem Nächsten hinterher und verpasst, was du schon hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-13",
      "text": "Dankbarkeit ist die günstigste Therapie, die du nie in Anspruch nimmst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-14",
      "text": "Genug ist ein Gefühl, kein Kontostand.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-15",
      "text": "Wer dankbar lebt, braucht keine Bestätigung von außen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-16",
      "text": "Dein Leben ist bereits ein Investment, das sich auszahlt - merk's dir.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-17",
      "text": "Zufriedenheit skaliert nicht mit deinem Einkommen, sondern mit deinem Blick.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-18",
      "text": "Dankbarkeit ist das Asset, das niemand dir wegnehmen kann.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-19",
      "text": "Du vergleichst dein Jetzt mit fremden Highlights - unfairer Deal.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-20",
      "text": "Wer zufrieden ist, verhandelt nicht mehr um jedes Detail des Lebens.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-21",
      "text": "Dankbarkeit heute ist der Vorschuss auf Gelassenheit morgen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-22",
      "text": "Dein Konto wächst, aber wächst auch deine Zufriedenheit mit?",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-23",
      "text": "Zufriedenheit ist die Dividende, die du dir selbst ausschüttest.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-24",
      "text": "Wer das Kleine nicht wertschätzt, verliert sich im Großen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-25",
      "text": "Dankbarkeit macht aus genug ein Gefühl von mehr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-12-04-26",
      "text": "Du brauchst kein neues Ziel, um heute zufrieden zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-04"
    },
    {
      "id": "gratitude-2026-12-05-27",
      "text": "Zufriedenheit ist der stille Erfolg, den keiner liked.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-05"
    },
    {
      "id": "gratitude-2026-12-06-28",
      "text": "Dankbarkeit ist dein Gegenpol zum ständigen Mehr-wollen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-06"
    },
    {
      "id": "gratitude-2026-12-07-29",
      "text": "Wer zufrieden startet, performt entspannter durch den Tag.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-07"
    }
  ]
}