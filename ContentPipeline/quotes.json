{
  "generatedAt": "2026-11-03",
  "quotes": [
    {
      "id": "mindset-2026-11-03-0",
      "text": "Disziplin ist der Zinseszins der Persönlichkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-1",
      "text": "Deine Ausreden klingen gut, bringen dich aber nirgendwohin.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-2",
      "text": "Comfort Zone ist nur ein anderes Wort für Stillstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-3",
      "text": "Du wirst nicht motiviert geboren, du wirst diszipliniert gemacht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-4",
      "text": "Jeder Tag ohne Anstrengung ist ein Tag gegen dein zukünftiges Ich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-5",
      "text": "Dein Kopf gibt vor dir auf, lange bevor dein Körper es tut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-6",
      "text": "Stärke entsteht nicht im Erfolg, sondern im Durchhalten danach.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-7",
      "text": "Wer auf Motivation wartet, wartet auf den falschen Mitarbeiter.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-8",
      "text": "Mentale Stärke ist die Fähigkeit, trotzdem zu liefern.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-9",
      "text": "Dein Standard ist das, was du akzeptierst, wenn niemand hinschaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-10",
      "text": "Schwache Momente bauen starke Menschen, wenn du durchhältst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-11",
      "text": "Du verhandelst nicht mit deiner Bequemlichkeit, du überstimmst sie.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-12",
      "text": "Jede Ausrede ist ein kleiner Vertrag mit der Mittelmäßigkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-13",
      "text": "Dein Gehirn sucht Sicherheit, dein Ziel verlangt Risiko. Entscheide dich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-14",
      "text": "Unbequemlichkeit ist der Preis, Reue ist die Rechnung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-15",
      "text": "Du bist nicht müde, du bist unmotiviert. Erkenne den Unterschied.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-16",
      "text": "Disziplin fühlt sich nie gut an, bevor sie sich gut anfühlt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-17",
      "text": "Dein zukünftiges Ich zahlt für jede Entscheidung von heute.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-18",
      "text": "Stärke zeigt sich nicht im Plan, sondern in der Ausführung bei Widerstand.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-19",
      "text": "Wer sich selbst führt, braucht keine Motivation von außen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-20",
      "text": "Dein Kopf lügt, wenn er dir sagt, morgen sei auch noch Zeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-21",
      "text": "Mentale Härte heißt: handeln, bevor du dich bereit fühlst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-22",
      "text": "Klein anfangen schlägt perfekt warten, jedes Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-23",
      "text": "Du bist kein Opfer deiner Laune, du bist ihr Chef.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-24",
      "text": "Konsequenz schlägt Intensität, jeden einzelnen Tag.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-25",
      "text": "Dein Verstand testet dich nur, um zu sehen, ob du es ernst meinst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-26",
      "text": "Wachstum passiert genau dort, wo du aufhören willst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-27",
      "text": "Niemand rettet dich. Das ist die beste Nachricht, die es gibt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-28",
      "text": "Dein innerer Widerstand ist der Beweis, dass es wichtig ist.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-29",
      "text": "Stärke ist leise. Sie redet nicht, sie liefert.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-11-03-0",
      "text": "Disziplin schlägt Motivation, jeden einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-1",
      "text": "Dein Kontostand ist nur das Echo deiner Entscheidungen von gestern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-2",
      "text": "Wer auf den perfekten Moment wartet, verpasst die ersten zehn guten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-3",
      "text": "Produktivität ist kein Zufall, sondern ein System.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-4",
      "text": "Ausreden sind die Währung der Erfolglosen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-5",
      "text": "Zeit ist das einzige Kapital, das du nicht nachkaufen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-6",
      "text": "Wachstum passiert außerhalb deiner Komfortzone, nicht in deinem Bett.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-7",
      "text": "Erfolg wird gebaut, Ziegel für Ziegel, nicht über Nacht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-8",
      "text": "Dein Zukunfts-Ich zahlt den Preis für deine heutige Faulheit.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-9",
      "text": "Konsequenz ist unsexy, aber sie zahlt die Rechnungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-10",
      "text": "Wer nicht plant, plant seinen eigenen Stillstand.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-11",
      "text": "Montagmorgen entscheidet, wer Freitagabend feiert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-12",
      "text": "Dein Netzwerk ist dein Nettovermögen von morgen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-13",
      "text": "Null Tage Pause bedeutet nicht null Tage Fortschritt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-14",
      "text": "Gewinner erledigen heute, was andere auf morgen schieben.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-15",
      "text": "Fokus ist die neue Superkraft in einer Welt voller Ablenkung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-16",
      "text": "Risiko ist der Preis für ein Leben außerhalb des Durchschnitts.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-17",
      "text": "Deine Ziele kennen keine Ausreden, nur Ergebnisse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-18",
      "text": "Baue dein Business, als hinge dein Leben davon ab, denn das tut es.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-19",
      "text": "Kleine Schritte täglich schlagen große Pläne niemals.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-20",
      "text": "Dein größter Konkurrent ist dein gestriges Ich.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-21",
      "text": "Geld folgt Fokus, nicht Hoffnung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-22",
      "text": "Die Uhr tickt für jeden gleich, der Unterschied ist, wer sie nutzt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-23",
      "text": "Erfolg ist das Nebenprodukt unbequemer Entscheidungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-24",
      "text": "Wer bequem bleibt, bleibt auch arm.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-25",
      "text": "Dein Kalender zeigt, was dir wirklich wichtig ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-26",
      "text": "Investiere in dich selbst, das ist die einzige Aktie ohne Risiko.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-27",
      "text": "Chaos im Kopf heißt Chaos im Konto.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-28",
      "text": "Hustle ohne Strategie ist nur Lärm.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-29",
      "text": "Baue heute das System, das dich morgen nicht mehr braucht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-11-03-0",
      "text": "Motivation ist ein Gast, Disziplin bleibt für immer wohnen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-1",
      "text": "Du brauchst keine Lust, du brauchst ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-2",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-3",
      "text": "Wer nur bei guter Laune arbeitet, bleibt für immer Amateur.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-4",
      "text": "Der Unterschied zwischen dir und deinem Ziel heißt Durchhalten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-5",
      "text": "Disziplin fühlt sich erst nach dem hundertsten Mal leicht an.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-6",
      "text": "Bequemlichkeit ist der Kredit, den du mit Zinsen zurückzahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-7",
      "text": "Du musst nicht motiviert sein, du musst nur weitermachen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-8",
      "text": "Wer aufgibt, wenn's unbequem wird, hat das Ziel nie wirklich gewollt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-9",
      "text": "Disziplin ist das stille Versprechen an dich selbst, das keiner sieht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-10",
      "text": "Erfolg ist, was passiert, wenn niemand mehr applaudiert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-11",
      "text": "Du überholst niemanden, solange du auf den perfekten Moment wartest.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-12",
      "text": "Jeden Tag die gleiche Entscheidung treffen, das ist der ganze Trick.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-13",
      "text": "Disziplin ist unspektakulär, bis sie dein Leben verändert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-14",
      "text": "Dein zukünftiges Ich verdient keinen Ausredenkatalog.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-15",
      "text": "Gewohnheit schlägt Willenskraft an jedem einzelnen Tag.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-16",
      "text": "Wer durchhält, wenn's langweilig wird, gewinnt, wenn's zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-17",
      "text": "Disziplin ist der Preis, Freiheit ist der Gewinn.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-18",
      "text": "Comfort Zone und Fortschritt haben noch nie zusammen gewohnt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-19",
      "text": "Du wirst nicht über Nacht besser, aber jede Nacht ein bisschen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-20",
      "text": "Konsequenz schlägt Talent, wenn Talent keine Disziplin hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-21",
      "text": "Der Tag, an dem du keine Lust hast, zählt am meisten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-22",
      "text": "Disziplin heißt, Verträge mit dir selbst einzuhalten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-23",
      "text": "Niemand sieht die Wiederholung, nur das Ergebnis danach.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-24",
      "text": "Dein Ziel fragt nicht, wie du dich heute fühlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-25",
      "text": "Durchhalten ist die unsichtbare Arbeit hinter jedem sichtbaren Erfolg.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-26",
      "text": "Du verlierst nicht durch Fehler, sondern durch Aufgeben.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-27",
      "text": "Disziplin ist die Brücke zwischen Plan und Realität.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-28",
      "text": "Wer immer erst wartet bis er bereit ist, wartet für immer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-29",
      "text": "Die langweiligen Tage bauen das Fundament für die besten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-11-03-0",
      "text": "Energie ist die einzige Währung, die du nicht leihen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-1",
      "text": "Dein Körper ist der Zinseszins deiner Disziplin.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-2",
      "text": "Wer seine Energie verwaltet, braucht keine Motivation.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-3",
      "text": "Ein Workout ist eine Einzahlung auf dein zukünftiges Ich.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-4",
      "text": "Müdigkeit lügt öfter als du denkst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-5",
      "text": "Bewegung ist der Reset-Knopf, den niemand drückt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-6",
      "text": "Dein Puls entscheidet, wie klar dein Kopf heute denkt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-7",
      "text": "Stärke baut man nicht im Kopf, sondern im Wiederholen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-8",
      "text": "Jeder Satz im Training ist ein Investment ohne Inflation.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-9",
      "text": "Energie fließt dorthin, wo du trainierst, nicht wo du redest.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-10",
      "text": "Dein Körper merkt sich jede Ausrede.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-11",
      "text": "Schwitzen ist die Quittung für ehrliche Arbeit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-12",
      "text": "Wer sich bewegt, denkt schneller als wer sitzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-13",
      "text": "Kraft ist kein Zufall, sondern ein tägliches Abo.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-14",
      "text": "Dein Energielevel ist dein unsichtbares Startkapital.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-15",
      "text": "Fitness ist kein Ziel, sondern dein Betriebssystem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-16",
      "text": "Ein starker Körper verhandelt bessere Entscheidungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-17",
      "text": "Bewegung kostet Zeit, Stillstand kostet Jahre.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-18",
      "text": "Dein Training heute ist dein Vorsprung morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-19",
      "text": "Wer seinen Körper ignoriert, zahlt später mit Zinsen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-20",
      "text": "Energie ist der Rohstoff, den du täglich neu abbauen musst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-21",
      "text": "Disziplin im Training schlägt Talent im Schlaf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-22",
      "text": "Dein Körper ist das einzige Büro, das du nie kündigen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-23",
      "text": "Ausdauer ist gespeicherte Willenskraft.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-24",
      "text": "Wer sich morgens bewegt, gewinnt den Tag vor allen anderen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-25",
      "text": "Kraft trainierst du nicht für den Spiegel, sondern für den Alltag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-26",
      "text": "Dein Körper speichert jede Entscheidung, die du heute triffst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-27",
      "text": "Erschöpfung ist oft nur fehlende Bewegung in Verkleidung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-28",
      "text": "Ein klarer Kopf beginnt mit einem bewegten Körper.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-29",
      "text": "Starker Körper, starker Kopf - das ist keine Floskel, das ist Biologie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-11-03-0",
      "text": "Zufriedenheit ist kein Ziel, sondern das Nebenprodukt guter Entscheidungen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-1",
      "text": "Dankbarkeit kostet nichts und verändert trotzdem alles.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-2",
      "text": "Wer nicht genug hat von dem, was er hat, hat nie genug.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-3",
      "text": "Dein Leben jetzt war mal dein Traum von vor zwei Jahren.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-4",
      "text": "Checke deine Fortschritte, bevor du deine Defizite checkst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-5",
      "text": "Zufrieden sein heißt nicht, aufzuhören zu wachsen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-6",
      "text": "Dankbarkeit ist die günstigste Form von Therapie.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-7",
      "text": "Du vergleichst dein Jetzt mit dem Highlight-Reel anderer. Lass es.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-8",
      "text": "Wer dankbar lebt, verschwendet keine Energie an Neid.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-9",
      "text": "Genug ist ein Gefühl, kein Kontostand.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-10",
      "text": "Dein größtes Kapital ist nicht dein Depot, sondern dein Blick auf das, was du hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-11",
      "text": "Zufriedenheit schlägt jede Rendite.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-12",
      "text": "Du musst nicht alles gut finden, aber für etwas dankbar sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-13",
      "text": "Erfolg ohne Dankbarkeit ist nur lauter Lärm.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-14",
      "text": "Wer jeden Tag einen Grund zur Dankbarkeit findet, verliert nie ganz.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-15",
      "text": "Dankbarkeit ist der Zinseszins der Zufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-16",
      "text": "Mehr wollen ist okay. Weniger wertschätzen nicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-17",
      "text": "Du bist weiter, als du denkst. Schau mal zurück, nicht nur nach vorne.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-18",
      "text": "Zufriedenheit ist der stille Gewinn, den niemand postet.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-19",
      "text": "Dankbar sein heißt, dein Leben nicht als selbstverständlich abzubuchen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-20",
      "text": "Wer ständig mehr will, übersieht oft, was er schon erreicht hat.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-21",
      "text": "Dein ruhiger Moment heute ist der Traum von jemand anderem.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-22",
      "text": "Zufriedenheit ist keine Schwäche, sondern die Basis für einen klaren Kopf.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-23",
      "text": "Dankbarkeit macht aus genug ein Fest und aus wenig ein Vermögen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-24",
      "text": "Du brauchst keinen Anlass zum Feiern. Du bist schon hier.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-25",
      "text": "Wachstum ohne Dankbarkeit ist nur Flucht nach vorne.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-26",
      "text": "Zufrieden mit dem Weg, ehrgeizig beim Ziel - das geht beides.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-27",
      "text": "Dankbarkeit ist die einzige Investition ohne Risiko.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-28",
      "text": "Was du heute normal findest, war früher dein großes Ziel.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-29",
      "text": "Ruhe im Kopf ist mehr wert als Lärm im Kalender.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    }
  ]
}