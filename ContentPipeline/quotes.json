{
  "generatedAt": "2026-10-16",
  "quotes": [
    {
      "id": "mindset-2026-10-16-0",
      "text": "Disziplin ist der Zins, den du heute zahlst, damit Freiheit morgen dir gehört.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-16"
    },
    {
      "id": "mindset-2026-10-17-1",
      "text": "Deine Ausreden klingen überzeugend, aber dein Konto glaubt sie nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-17"
    },
    {
      "id": "mindset-2026-10-18-2",
      "text": "Motivation ist ein Gast. Disziplin zahlt die Miete.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-18"
    },
    {
      "id": "mindset-2026-10-19-3",
      "text": "Du musst nicht bereit sein. Du musst nur anfangen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-19"
    },
    {
      "id": "mindset-2026-10-20-4",
      "text": "Komfort ist der leiseste Weg in die Bedeutungslosigkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-20"
    },
    {
      "id": "mindset-2026-10-21-5",
      "text": "Wer auf perfekte Bedingungen wartet, wartet auf ein Leben, das nie beginnt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-21"
    },
    {
      "id": "mindset-2026-10-22-6",
      "text": "Dein zukünftiges Ich zahlt heute die Rechnung für deine Faulheit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-22"
    },
    {
      "id": "mindset-2026-10-23-7",
      "text": "Stärke entsteht nicht im Erfolg, sondern im nächsten Versuch danach.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-23"
    },
    {
      "id": "mindset-2026-10-24-8",
      "text": "Niemand rettet dich. Das ist die beste Nachricht, die du heute bekommst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-24"
    },
    {
      "id": "mindset-2026-10-25-9",
      "text": "Du vergleichst dein Kapitel 1 mit fremden Kapitel 20. Hör auf.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-25"
    },
    {
      "id": "mindset-2026-10-26-10",
      "text": "Der Kopf gibt auf, bevor der Körper es tut. Trainiere den Kopf zuerst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-26"
    },
    {
      "id": "mindset-2026-10-27-11",
      "text": "Unbequem ist der Preis für ein Leben, das dir später gehört.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-27"
    },
    {
      "id": "mindset-2026-10-28-12",
      "text": "Du brauchst keine Motivation. Du brauchst ein System, das ohne sie läuft.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-28"
    },
    {
      "id": "mindset-2026-10-29-13",
      "text": "Jeder Tag ohne Fortschritt ist eine Schuld bei deinem zukünftigen Ich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-29"
    },
    {
      "id": "mindset-2026-10-30-14",
      "text": "Zweifel ist laut, aber Handeln hat das letzte Wort.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-30"
    },
    {
      "id": "mindset-2026-10-31-15",
      "text": "Deine Komfortzone ist bezahlbar. Dein Potenzial ist es nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-10-31"
    },
    {
      "id": "mindset-2026-11-01-16",
      "text": "Stillstand fühlt sich sicher an und kostet dich trotzdem alles.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-01"
    },
    {
      "id": "mindset-2026-11-02-17",
      "text": "Du wirst nicht durch Inspiration verändert, sondern durch Wiederholung.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-02"
    },
    {
      "id": "mindset-2026-11-03-18",
      "text": "Wer ständig Ausnahmen macht, baut keine Regel, sondern eine Ausrede.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-03"
    },
    {
      "id": "mindset-2026-11-04-19",
      "text": "Dein Ego will Applaus. Dein Ziel will Arbeit. Entscheide dich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-04"
    },
    {
      "id": "mindset-2026-11-05-20",
      "text": "Klarheit kommt nicht vom Denken, sondern vom Tun.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-21",
      "text": "Du verlierst nicht gegen andere. Du verlierst gegen deine Snooze-Taste.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-22",
      "text": "Schmerz heute ist ein Rabatt auf Reue morgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-23",
      "text": "Mentale Stärke ist kein Gefühl. Es ist eine Entscheidung, die du wiederholst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-24",
      "text": "Du brauchst keinen Plan B. Du brauchst Commitment zu Plan A.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-25",
      "text": "Erfolg sieht langweilig aus, bevor er beeindruckend aussieht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-26",
      "text": "Dein Verstand testet dich jeden Tag. Bestehe den Test, auch unbeobachtet.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-27",
      "text": "Wer auf Gefühle wartet, um zu handeln, hat die Kontrolle schon abgegeben.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-28",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-29",
      "text": "Die Version von dir, die du willst, existiert nur durch die Version, die du heute lebst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-10-16-0",
      "text": "Disziplin schlägt Motivation an jedem einzelnen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-16"
    },
    {
      "id": "business-2026-10-17-1",
      "text": "Dein Umsatz kennt keine Ausreden, nur Ergebnisse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-17"
    },
    {
      "id": "business-2026-10-18-2",
      "text": "Wer um sechs plant, gewinnt um achtzehn Uhr.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-18"
    },
    {
      "id": "business-2026-10-19-3",
      "text": "Komfort ist der leise Killer deiner Ziele.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-19"
    },
    {
      "id": "business-2026-10-20-4",
      "text": "Baue heute, wovon andere erst in fünf Jahren träumen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-20"
    },
    {
      "id": "business-2026-10-21-5",
      "text": "Zeit ist das einzige Kapital, das nie zurückkommt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-21"
    },
    {
      "id": "business-2026-10-22-6",
      "text": "Erfolg ist keine Stimmung, sondern eine tägliche Entscheidung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-22"
    },
    {
      "id": "business-2026-10-23-7",
      "text": "Wer wartet, bis es sich richtig anfühlt, wartet für immer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-23"
    },
    {
      "id": "business-2026-10-24-8",
      "text": "Dein Netzwerk ist dein Nettowert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-24"
    },
    {
      "id": "business-2026-10-25-9",
      "text": "Mach aus deinem Nebenprojekt deinen Hauptberuf.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-25"
    },
    {
      "id": "business-2026-10-26-10",
      "text": "Keine Ausrede ist stärker als dein Ehrgeiz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-26"
    },
    {
      "id": "business-2026-10-27-11",
      "text": "Risiko ist der Preis für ein Leben nach eigenen Regeln.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-27"
    },
    {
      "id": "business-2026-10-28-12",
      "text": "Reich wirst du durch Handeln, nicht durch Wünschen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-28"
    },
    {
      "id": "business-2026-10-29-13",
      "text": "Fokus schlägt Talent, wenn Talent nicht fokussiert ist.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-29"
    },
    {
      "id": "business-2026-10-30-14",
      "text": "Dein Mitbewerber schläft nicht – also du auch nicht.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-30"
    },
    {
      "id": "business-2026-10-31-15",
      "text": "Kleine Schritte, täglich wiederholt, bauen Imperien.",
      "author": null,
      "category": "business",
      "dateKey": "2026-10-31"
    },
    {
      "id": "business-2026-11-01-16",
      "text": "Wer Ausreden sammelt, sammelt keine Erfolge.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-01"
    },
    {
      "id": "business-2026-11-02-17",
      "text": "Investiere zuerst in dich, dann in alles andere.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-02"
    },
    {
      "id": "business-2026-11-03-18",
      "text": "Konsequenz ist die Währung der Erfolgreichen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-03"
    },
    {
      "id": "business-2026-11-04-19",
      "text": "Du baust entweder dein Business oder das eines anderen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-04"
    },
    {
      "id": "business-2026-11-05-20",
      "text": "Arbeite, während andere Ausreden suchen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-21",
      "text": "Dein Potenzial interessiert niemanden, nur deine Ergebnisse.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-22",
      "text": "Wachstum passiert außerhalb der Komfortzone, nie darin.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-23",
      "text": "Plane dein Jahr, nicht nur deinen Tag.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-24",
      "text": "Geld folgt Wert, niemals Wünschen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-25",
      "text": "Der erste Schritt kostet mehr Mut als alle folgenden zusammen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-26",
      "text": "Dein Morgen beginnt mit der Entscheidung von heute Abend.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-27",
      "text": "Härte im Prozess bringt Leichtigkeit im Ergebnis.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-28",
      "text": "Wer nicht skaliert, stagniert leise.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-29",
      "text": "Baue Systeme, keine Ausreden.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-10-16-0",
      "text": "Disziplin ist der Zins, den du auf dein zukünftiges Ich zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-16"
    },
    {
      "id": "discipline-2026-10-17-1",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-17"
    },
    {
      "id": "discipline-2026-10-18-2",
      "text": "Du brauchst keine gute Laune, um anzufangen – nur einen Plan.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-18"
    },
    {
      "id": "discipline-2026-10-19-3",
      "text": "Comfort Zone zahlt keine Rechnungen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-19"
    },
    {
      "id": "discipline-2026-10-20-4",
      "text": "Wer auf Gefühle wartet, wartet ewig. Mach einfach.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-20"
    },
    {
      "id": "discipline-2026-10-21-5",
      "text": "Dein zukünftiges Ich checkt gerade, ob du heute durchgezogen hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-21"
    },
    {
      "id": "discipline-2026-10-22-6",
      "text": "Disziplin fühlt sich erst wie Zwang an, dann wie Freiheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-22"
    },
    {
      "id": "discipline-2026-10-23-7",
      "text": "Ausreden sind billig. Ergebnisse sind teuer.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-23"
    },
    {
      "id": "discipline-2026-10-24-8",
      "text": "Konsistenz schlägt Intensität – jedes verdammte Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-24"
    },
    {
      "id": "discipline-2026-10-25-9",
      "text": "Du willst Resultate ohne Reibung? Gibt's nicht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-25"
    },
    {
      "id": "discipline-2026-10-26-10",
      "text": "Jeder Tag ohne Disziplin ist ein Kredit gegen dein Ziel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-26"
    },
    {
      "id": "discipline-2026-10-27-11",
      "text": "Dein Umfeld merkt deine Disziplin, bevor du sie selbst siehst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-27"
    },
    {
      "id": "discipline-2026-10-28-12",
      "text": "Härte heute spart Reue morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-28"
    },
    {
      "id": "discipline-2026-10-29-13",
      "text": "Disziplin ist leise. Sie postet nicht, sie liefert.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-29"
    },
    {
      "id": "discipline-2026-10-30-14",
      "text": "Du bist nicht müde. Du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-30"
    },
    {
      "id": "discipline-2026-10-31-15",
      "text": "Wiederholung ist die Mutter der Meisterschaft, nicht das Talent.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-10-31"
    },
    {
      "id": "discipline-2026-11-01-16",
      "text": "Zeig mir deinen Tagesablauf, ich sag dir deine Zukunft.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-01"
    },
    {
      "id": "discipline-2026-11-02-17",
      "text": "Disziplin ist der Unterschied zwischen Wollen und Werden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-02"
    },
    {
      "id": "discipline-2026-11-03-18",
      "text": "Es gibt keine Abkürzung – nur Ablenkung mit Umweg.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-03"
    },
    {
      "id": "discipline-2026-11-04-19",
      "text": "Dein Ziel fragt nicht nach deiner Stimmung, nur nach deinem Einsatz.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-04"
    },
    {
      "id": "discipline-2026-11-05-20",
      "text": "Durchhalten heißt: weitermachen, wenn niemand mehr zuschaut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-21",
      "text": "Kleine Disziplin heute, großer Vorsprung morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-22",
      "text": "Du verlierst nicht, wenn du scheiterst. Du verlierst, wenn du aufhörst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-23",
      "text": "Disziplin ist Selbstrespekt in Aktion.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-24",
      "text": "Mach es nicht, weil du Lust hast. Mach es, weil du es versprochen hast.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-25",
      "text": "Der Unterschied zwischen Traum und Ziel ist ein Datum und tägliche Arbeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-26",
      "text": "Deine Grenzen sind nur die Summe deiner bisherigen Ausreden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-27",
      "text": "Disziplin bedeutet, dein Zukunfts-Ich mehr zu lieben als dein Jetzt-Ich.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-28",
      "text": "Niemand sieht die 5 Uhr morgens, aber jeder sieht das Ergebnis.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-29",
      "text": "Stillstand fühlt sich sicher an und kostet dich am meisten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-10-16-0",
      "text": "Dein Körper ist kein Projekt für später, sondern dein Werkzeug für heute.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-16"
    },
    {
      "id": "fitness-2026-10-17-1",
      "text": "Energie ist die einzige Währung, die du dir nicht leihen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-17"
    },
    {
      "id": "fitness-2026-10-18-2",
      "text": "Wer seinen Körper vernachlässigt, verliert sein bestes Investment.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-18"
    },
    {
      "id": "fitness-2026-10-19-3",
      "text": "Kein Meeting schlägt dein Training – beides entscheidet über deinen Tag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-19"
    },
    {
      "id": "fitness-2026-10-20-4",
      "text": "Schwache Energie killt jede noch so gute Strategie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-20"
    },
    {
      "id": "fitness-2026-10-21-5",
      "text": "Dein Puls heute bestimmt deinen Fokus morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-21"
    },
    {
      "id": "fitness-2026-10-22-6",
      "text": "Muskeln lügen nicht – sie zeigen, wie ernst du es meinst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-22"
    },
    {
      "id": "fitness-2026-10-23-7",
      "text": "Bewegung ist der Zinseszins deiner Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-23"
    },
    {
      "id": "fitness-2026-10-24-8",
      "text": "Du wächst nicht über dein Limit hinaus, wenn du im Bett bleibst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-24"
    },
    {
      "id": "fitness-2026-10-25-9",
      "text": "Dein Körper zahlt zurück, was du investierst – mit Zinsen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-25"
    },
    {
      "id": "fitness-2026-10-26-10",
      "text": "Disziplin im Training ist Disziplin im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-26"
    },
    {
      "id": "fitness-2026-10-27-11",
      "text": "Wer schwitzt, denkt klarer.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-27"
    },
    {
      "id": "fitness-2026-10-28-12",
      "text": "Energie sparen bringt nichts, wenn du sie nie nutzt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-28"
    },
    {
      "id": "fitness-2026-10-29-13",
      "text": "Dein Krafttraining heute ist dein Vorsprung morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-29"
    },
    {
      "id": "fitness-2026-10-30-14",
      "text": "Ausreden verbrennen keine Kalorien.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-30"
    },
    {
      "id": "fitness-2026-10-31-15",
      "text": "Ein starker Körper trägt starke Entscheidungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-10-31"
    },
    {
      "id": "fitness-2026-11-01-16",
      "text": "Fitness ist kein Ziel, sondern dein Betriebssystem.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-01"
    },
    {
      "id": "fitness-2026-11-02-17",
      "text": "Du schuldest deinem Körper mehr als Motivation – du schuldest ihm Taten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-02"
    },
    {
      "id": "fitness-2026-11-03-18",
      "text": "Wer sich bewegt, bewegt auch seine Gedanken.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-03"
    },
    {
      "id": "fitness-2026-11-04-19",
      "text": "Dein Energielevel entscheidet, wer du um 18 Uhr noch bist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-04"
    },
    {
      "id": "fitness-2026-11-05-20",
      "text": "Kraft kommt nicht von Wünschen, sondern von Wiederholungen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-21",
      "text": "Schlaf ist dein günstigster Performance-Booster.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-22",
      "text": "Dein Körper merkt sich jede verpasste Einheit.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-23",
      "text": "Bewegung ist die billigste Form von Fokus.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-24",
      "text": "Wer stillsteht, rostet schneller, als er denkt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-25",
      "text": "Dein Training heute finanziert deine Energie von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-26",
      "text": "Ein müder Körper macht aus großen Zielen kleine Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-27",
      "text": "Du trainierst nicht für den Sommer, du trainierst für dein Niveau.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-28",
      "text": "Fitness ist der stille Zinssatz auf dein ganzes Leben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-29",
      "text": "Dein Körper ist das einzige Asset, das du nie verkaufen kannst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-10-16-0",
      "text": "Zufriedenheit ist keine Deadline, die du erreichst, sondern eine Entscheidung, die du täglich triffst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-16"
    },
    {
      "id": "gratitude-2026-10-17-1",
      "text": "Dankbarkeit ist der günstigste Produktivitäts-Hack, den du nie genutzt hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-17"
    },
    {
      "id": "gratitude-2026-10-18-2",
      "text": "Wer das Jetzt nicht wertschätzt, wird auch die Zukunft nicht genießen können.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-18"
    },
    {
      "id": "gratitude-2026-10-19-3",
      "text": "Dein Kopf wird leichter, sobald er aufhört zu vergleichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-19"
    },
    {
      "id": "gratitude-2026-10-20-4",
      "text": "Zufriedenheit steht nicht auf deiner To-Do-Liste, sie ist die Haltung, mit der du sie abarbeitest.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-20"
    },
    {
      "id": "gratitude-2026-10-21-5",
      "text": "Du jagst Ergebnissen hinterher und übersiehst, was du längst erreicht hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-21"
    },
    {
      "id": "gratitude-2026-10-22-6",
      "text": "Dankbarkeit kostet nichts und zahlt sich trotzdem täglich aus.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-22"
    },
    {
      "id": "gratitude-2026-10-23-7",
      "text": "Wer nie zufrieden ist mit dem Weg, wird es auch nicht mit dem Ziel sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-23"
    },
    {
      "id": "gratitude-2026-10-24-8",
      "text": "Erfolg ohne Dankbarkeit ist nur eine lautere Form von Leere.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-24"
    },
    {
      "id": "gratitude-2026-10-25-9",
      "text": "Dein Fortschritt zählt mehr als dein Vergleich mit anderen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-25"
    },
    {
      "id": "gratitude-2026-10-26-10",
      "text": "Zufriedenheit beginnt dort, wo dein Ego aufhört zu rechnen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-26"
    },
    {
      "id": "gratitude-2026-10-27-11",
      "text": "Du bist weiter, als du vor einem Jahr für möglich gehalten hättest.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-27"
    },
    {
      "id": "gratitude-2026-10-28-12",
      "text": "Dankbarkeit sind die Zinsen, die dein Leben auf Geduld zahlt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-28"
    },
    {
      "id": "gratitude-2026-10-29-13",
      "text": "Wer ständig mehr will, verpasst, was er schon hat.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-29"
    },
    {
      "id": "gratitude-2026-10-30-14",
      "text": "Zufriedenheit ist die Energie, mit der nachhaltiger Erfolg gebaut wird.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-30"
    },
    {
      "id": "gratitude-2026-10-31-15",
      "text": "Du musst nicht alles erreicht haben, um stolz auf dich zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-10-31"
    },
    {
      "id": "gratitude-2026-11-01-16",
      "text": "Dankbarkeit macht aus genug ein Gefühl, nicht aus einer Zahl.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-01"
    },
    {
      "id": "gratitude-2026-11-02-17",
      "text": "Dein heutiges Leben war vor fünf Jahren dein Traumszenario.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-02"
    },
    {
      "id": "gratitude-2026-11-03-18",
      "text": "Zufriedenheit ist kein Stillstand, sondern der Start für mehr.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-03"
    },
    {
      "id": "gratitude-2026-11-04-19",
      "text": "Wer das Haben nicht würdigt, wird das Wollen nie stillen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-04"
    },
    {
      "id": "gratitude-2026-11-05-20",
      "text": "Dankbarkeit ist die einzige Investition, die sofort Rendite bringt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-21",
      "text": "Du vergleichst dein Kapitel drei mit dem Kapitel zwanzig von jemand anderem.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-22",
      "text": "Zufriedenheit heißt nicht aufhören zu wachsen, sondern aufhören zu leiden.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-23",
      "text": "Dein Fortschritt braucht keine Bestätigung von außen, um real zu sein.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-24",
      "text": "Dankbarkeit verwandelt Druck in Perspektive.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-25",
      "text": "Wer zufrieden mit sich selbst ist, verhandelt nicht mehr um fremde Anerkennung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-26",
      "text": "Du bist nicht spät dran, du bist genau da, wo dein Weg dich hinführt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-27",
      "text": "Zufriedenheit ist der Soundtrack deiner Ambition, nicht ihre Pause.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-28",
      "text": "Dankbarkeit macht aus Druck Motivation und aus Angst Klarheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-29",
      "text": "Dein größter Flex ist, zufrieden zu sein mit dem, was du dir selbst aufgebaut hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    }
  ]
}