{
  "generatedAt": "2026-11-05",
  "quotes": [
    {
      "id": "mindset-2026-11-05-0",
      "text": "Deine Ausreden klingen gut, aber dein Leben hört trotzdem nicht zu.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-05"
    },
    {
      "id": "mindset-2026-11-06-1",
      "text": "Motivation ist ein Gast, Disziplin ist dein Mitbewohner.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-06"
    },
    {
      "id": "mindset-2026-11-07-2",
      "text": "Du musst dich nicht gut fühlen, um gut zu performen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-07"
    },
    {
      "id": "mindset-2026-11-08-3",
      "text": "Schwache Momente sind erlaubt, schwache Standards nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-08"
    },
    {
      "id": "mindset-2026-11-09-4",
      "text": "Dein Kopf erzählt dir morgens Geschichten über Müdigkeit, glaub ihm nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-09"
    },
    {
      "id": "mindset-2026-11-10-5",
      "text": "Comfort Zone ist kein Zuhause, sondern nur ein Zwischenstopp.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-10"
    },
    {
      "id": "mindset-2026-11-11-6",
      "text": "Wer auf das richtige Gefühl wartet, wartet sein Leben lang.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-11"
    },
    {
      "id": "mindset-2026-11-12-7",
      "text": "Dein zukünftiges Ich zahlt die Rechnung für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-12"
    },
    {
      "id": "mindset-2026-11-13-8",
      "text": "Stärke zeigt sich nicht im Erfolg, sondern im Montagmorgen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-13"
    },
    {
      "id": "mindset-2026-11-14-9",
      "text": "Du bist nicht müde, du bist unmotiviert. Kenn den Unterschied.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-14"
    },
    {
      "id": "mindset-2026-11-15-10",
      "text": "Niemand rettet deinen Tag außer dir selbst, hör auf zu warten.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-15"
    },
    {
      "id": "mindset-2026-11-16-11",
      "text": "Druck ist kein Feind, Druck ist dein Trainingspartner.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-16"
    },
    {
      "id": "mindset-2026-11-17-12",
      "text": "Dein Mindset entscheidet, bevor der Tag überhaupt beginnt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-17"
    },
    {
      "id": "mindset-2026-11-18-13",
      "text": "Wer ständig Ausnahmen macht, baut kein System, sondern Chaos.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-18"
    },
    {
      "id": "mindset-2026-11-19-14",
      "text": "Vergleich stiehlt deine Energie, Fokus gibt sie dir zurück.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-19"
    },
    {
      "id": "mindset-2026-11-20-15",
      "text": "Du wächst nicht, wenn es leicht ist, sondern wenn es unbequem wird.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-20"
    },
    {
      "id": "mindset-2026-11-21-16",
      "text": "Dein Gehirn sucht den leichten Weg, du musst ihm widersprechen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-21"
    },
    {
      "id": "mindset-2026-11-22-17",
      "text": "Klarheit kommt nicht vom Denken, sondern vom Handeln.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-22"
    },
    {
      "id": "mindset-2026-11-23-18",
      "text": "Zweifel sind laut, aber sie haben kein Stimmrecht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-23"
    },
    {
      "id": "mindset-2026-11-24-19",
      "text": "Jeder Tag ohne Disziplin ist ein Tag gegen dein Zukunfts-Ich.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-24"
    },
    {
      "id": "mindset-2026-11-25-20",
      "text": "Schwache Tage gehören dazu, eine schwache Identität nicht.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-25"
    },
    {
      "id": "mindset-2026-11-26-21",
      "text": "Du bist nicht das Opfer deiner Laune, du bist der Chef davon.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-26"
    },
    {
      "id": "mindset-2026-11-27-22",
      "text": "Konsequenz schlägt Intensität, jedes einzelne Mal.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-27"
    },
    {
      "id": "mindset-2026-11-28-23",
      "text": "Dein Standard ist das, was du akzeptierst, wenn niemand hinschaut.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-28"
    },
    {
      "id": "mindset-2026-11-29-24",
      "text": "Angst vor dem Scheitern ist teurer als das Scheitern selbst.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-29"
    },
    {
      "id": "mindset-2026-11-30-25",
      "text": "Du brauchst keine perfekten Bedingungen, nur den ersten Schritt.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-11-30"
    },
    {
      "id": "mindset-2026-12-01-26",
      "text": "Dein innerer Kritiker hat nie etwas erreicht, hör trotzdem nicht auf ihn.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-01"
    },
    {
      "id": "mindset-2026-12-02-27",
      "text": "Großes Mindset beginnt mit kleinen, unbequemen Entscheidungen.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-02"
    },
    {
      "id": "mindset-2026-12-03-28",
      "text": "Wer sich selbst motivieren kann, braucht niemanden mehr dafür.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-03"
    },
    {
      "id": "mindset-2026-12-04-29",
      "text": "Dein Verstand testet dich jeden Tag, bestehe den Test leise.",
      "author": null,
      "category": "mindset",
      "dateKey": "2026-12-04"
    },
    {
      "id": "business-2026-11-05-0",
      "text": "Disziplin ist der Zins, den du heute zahlst, damit Freiheit später zinst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-05"
    },
    {
      "id": "business-2026-11-06-1",
      "text": "Deine To-Do-Liste interessiert niemanden – dein Output schon.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-06"
    },
    {
      "id": "business-2026-11-07-2",
      "text": "Wer auf Motivation wartet, verliert gegen den, der einfach anfängt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-07"
    },
    {
      "id": "business-2026-11-08-3",
      "text": "Zwischen Idee und Umsetzung liegt der ganze Unterschied zu deinem Konkurrenten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-08"
    },
    {
      "id": "business-2026-11-09-4",
      "text": "Ausreden sind die teuerste Währung, die du besitzt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-09"
    },
    {
      "id": "business-2026-11-10-5",
      "text": "Baue heute an dem Leben, das dein zukünftiges Ich nicht in Frage stellt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-10"
    },
    {
      "id": "business-2026-11-11-6",
      "text": "Dein Kalender zeigt, wie ernst du es wirklich meinst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-11"
    },
    {
      "id": "business-2026-11-12-7",
      "text": "Comfort Zone ist nur ein anderes Wort für Stillstand mit Komfort.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-12"
    },
    {
      "id": "business-2026-11-13-8",
      "text": "Niemand bewundert den Plan – alle bewundern das Ergebnis.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-13"
    },
    {
      "id": "business-2026-11-14-9",
      "text": "Zeit ist das einzige Investment, das du nicht nachkaufen kannst.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-14"
    },
    {
      "id": "business-2026-11-15-10",
      "text": "Dein Netzwerk wächst nicht durch Warten, sondern durch Zeigen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-15"
    },
    {
      "id": "business-2026-11-16-11",
      "text": "Konsequenz schlägt Talent, wenn Talent sich nicht anstrengt.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-16"
    },
    {
      "id": "business-2026-11-17-12",
      "text": "Wer immer erst alles versteht, bevor er handelt, handelt nie.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-17"
    },
    {
      "id": "business-2026-11-18-13",
      "text": "Die besten Deals entstehen, bevor alle anderen das Problem überhaupt sehen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-18"
    },
    {
      "id": "business-2026-11-19-14",
      "text": "Fokus ist die neue Superpower in einer Welt voller Benachrichtigungen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-19"
    },
    {
      "id": "business-2026-11-20-15",
      "text": "Dein Umsatz ist nur die Quittung für deine Entscheidungen von gestern.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-20"
    },
    {
      "id": "business-2026-11-21-16",
      "text": "Risiko ist kein Gegner, sondern die Eintrittskarte zum nächsten Level.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-21"
    },
    {
      "id": "business-2026-11-22-17",
      "text": "Wer nur Feedback von Zuschauern sucht, wird nie Unternehmer.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-22"
    },
    {
      "id": "business-2026-11-23-18",
      "text": "Plane dein Jahr wie ein CEO, lebe deinen Tag wie ein Praktikant, der liefern will.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-23"
    },
    {
      "id": "business-2026-11-24-19",
      "text": "Geld folgt Klarheit, nicht Hoffnung.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-24"
    },
    {
      "id": "business-2026-11-25-20",
      "text": "Du verhandelst nicht mit dem Markt, du passt dich an oder gehst unter.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-25"
    },
    {
      "id": "business-2026-11-26-21",
      "text": "Die Rechnung für Aufschieberitis kommt immer mit Zinseszins.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-26"
    },
    {
      "id": "business-2026-11-27-22",
      "text": "Dein größter Konkurrent ist dein Zustand von vor drei Monaten.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-27"
    },
    {
      "id": "business-2026-11-28-23",
      "text": "Erfolg lässt sich nicht buchen, nur bauen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-28"
    },
    {
      "id": "business-2026-11-29-24",
      "text": "Jede ungenutzte Stunde ist eine stille Investition in deine Konkurrenz.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-29"
    },
    {
      "id": "business-2026-11-30-25",
      "text": "Strategien ändern sich, Disziplin bleibt die Konstante.",
      "author": null,
      "category": "business",
      "dateKey": "2026-11-30"
    },
    {
      "id": "business-2026-12-01-26",
      "text": "Wer skaliert, bevor er verstanden hat, skaliert nur seine Fehler.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-01"
    },
    {
      "id": "business-2026-12-02-27",
      "text": "Dein Pitch ist erst gut, wenn er ohne dich funktioniert.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-02"
    },
    {
      "id": "business-2026-12-03-28",
      "text": "Null Ausreden, volle Pipeline – so entstehen Imperien.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-03"
    },
    {
      "id": "business-2026-12-04-29",
      "text": "Die Zukunft gehört denen, die heute die unbequeme Aufgabe zuerst erledigen.",
      "author": null,
      "category": "business",
      "dateKey": "2026-12-04"
    },
    {
      "id": "discipline-2026-11-05-0",
      "text": "Disziplin ist der Zins, den du auf deine Ziele zahlst.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-05"
    },
    {
      "id": "discipline-2026-11-06-1",
      "text": "Motivation ist Zufall, Disziplin ist ein System.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-06"
    },
    {
      "id": "discipline-2026-11-07-2",
      "text": "Du musst nicht wollen, du musst einfach machen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-07"
    },
    {
      "id": "discipline-2026-11-08-3",
      "text": "Durchhalten schlägt Talent, wenn Talent nicht durchhält.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-08"
    },
    {
      "id": "discipline-2026-11-09-4",
      "text": "Gewohnheiten bauen das Leben, das Motivation nur verspricht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-09"
    },
    {
      "id": "discipline-2026-11-10-5",
      "text": "Jeder Tag ohne Ausrede ist ein Tag näher am Ziel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-10"
    },
    {
      "id": "discipline-2026-11-11-6",
      "text": "Disziplin fühlt sich nie gut an, bis sie dein Leben verändert hat.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-11"
    },
    {
      "id": "discipline-2026-11-12-7",
      "text": "Du bist nicht müde, du bist unentschlossen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-12"
    },
    {
      "id": "discipline-2026-11-13-8",
      "text": "Konsequenz schlägt Intensität, jedes Mal.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-13"
    },
    {
      "id": "discipline-2026-11-14-9",
      "text": "Dein zukünftiges Ich zahlt den Preis für deine heutige Bequemlichkeit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-14"
    },
    {
      "id": "discipline-2026-11-15-10",
      "text": "Disziplin ist die Sprache, die Ergebnisse verstehen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-15"
    },
    {
      "id": "discipline-2026-11-16-11",
      "text": "Wer aufgibt, wenn's unbequem wird, war nie wirklich im Spiel.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-16"
    },
    {
      "id": "discipline-2026-11-17-12",
      "text": "Routine ist der leise Vorteil, den niemand sieht.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-17"
    },
    {
      "id": "discipline-2026-11-18-13",
      "text": "Du brauchst keine Inspiration, du brauchst einen Plan und Sturheit.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-18"
    },
    {
      "id": "discipline-2026-11-19-14",
      "text": "Der Unterschied zwischen Traum und Ziel ist ein Datum und Disziplin.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-19"
    },
    {
      "id": "discipline-2026-11-20-15",
      "text": "Disziplin ist, wenn dein Handeln lauter ist als deine Laune.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-20"
    },
    {
      "id": "discipline-2026-11-21-16",
      "text": "Kleine Pflichten heute verhindern große Reue morgen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-21"
    },
    {
      "id": "discipline-2026-11-22-17",
      "text": "Comfort Zones bauen keine Erfolge, sie verwalten Durchschnitt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-22"
    },
    {
      "id": "discipline-2026-11-23-18",
      "text": "Wer jeden Tag ein Prozent liefert, überholt irgendwann jeden Talentierten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-23"
    },
    {
      "id": "discipline-2026-11-24-19",
      "text": "Du verlierst nicht gegen andere, du verlierst gegen deine Ausreden.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-24"
    },
    {
      "id": "discipline-2026-11-25-20",
      "text": "Disziplin ist unsichtbare Arbeit mit sichtbaren Ergebnissen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-25"
    },
    {
      "id": "discipline-2026-11-26-21",
      "text": "Zeig mir deinen Kalender, ich zeig dir deine Prioritäten.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-26"
    },
    {
      "id": "discipline-2026-11-27-22",
      "text": "Durchhalten ist die Fähigkeit, langweilig zu sein, wenn es zählt.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-27"
    },
    {
      "id": "discipline-2026-11-28-23",
      "text": "Dein Standard ist das, was du akzeptierst, wenn niemand hinschaut.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-28"
    },
    {
      "id": "discipline-2026-11-29-24",
      "text": "Wer Pausen vor Fortschritt stellt, bekommt am Ende keins von beidem.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-29"
    },
    {
      "id": "discipline-2026-11-30-25",
      "text": "Disziplin ist Selbstrespekt in Aktion.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-11-30"
    },
    {
      "id": "discipline-2026-12-01-26",
      "text": "Es gibt keinen Tag X, es gibt nur heute.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-01"
    },
    {
      "id": "discipline-2026-12-02-27",
      "text": "Konstanz schlägt Genie, das nicht erscheint.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-02"
    },
    {
      "id": "discipline-2026-12-03-28",
      "text": "Du trainierst nicht deinen Körper, du trainierst deinen Willen.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-03"
    },
    {
      "id": "discipline-2026-12-04-29",
      "text": "Erfolg ist das, was übrig bleibt, wenn Motivation längst weg ist.",
      "author": null,
      "category": "discipline",
      "dateKey": "2026-12-04"
    },
    {
      "id": "fitness-2026-11-05-0",
      "text": "Dein Körper ist kein Projekt für morgen, sondern dein Werkzeug für heute.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-05"
    },
    {
      "id": "fitness-2026-11-06-1",
      "text": "Energie leihst du dir nicht, du erzeugst sie – jede Wiederholung zählt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-06"
    },
    {
      "id": "fitness-2026-11-07-2",
      "text": "Disziplin im Training ist die Quittung für Klarheit im Kopf.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-07"
    },
    {
      "id": "fitness-2026-11-08-3",
      "text": "Wer seinen Körper trainiert, trainiert seine Entscheidungen von morgen.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-08"
    },
    {
      "id": "fitness-2026-11-09-4",
      "text": "Schwitzen ist die Steuer, die du für ein scharfes Mindset zahlst.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-09"
    },
    {
      "id": "fitness-2026-11-10-5",
      "text": "Keine Motivation heute? Dann bau dir Struktur statt Ausreden.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-10"
    },
    {
      "id": "fitness-2026-11-11-6",
      "text": "Dein Puls nach oben, deine Zweifel nach unten.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-11"
    },
    {
      "id": "fitness-2026-11-12-7",
      "text": "Bewegung ist der günstigste Produktivitäts-Hack, den es gibt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-12"
    },
    {
      "id": "fitness-2026-11-13-8",
      "text": "Jeder Satz im Training ist ein Investment in deine Zukunftsenergie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-13"
    },
    {
      "id": "fitness-2026-11-14-9",
      "text": "Wer sich körperlich fordert, lernt mental nicht aufzugeben.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-14"
    },
    {
      "id": "fitness-2026-11-15-10",
      "text": "Müdigkeit lügt öfter als dein Körper zugibt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-15"
    },
    {
      "id": "fitness-2026-11-16-11",
      "text": "Dein Workout heute entscheidet, wie klar dein Kopf morgen denkt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-16"
    },
    {
      "id": "fitness-2026-11-17-12",
      "text": "Kraft baust du nicht im Ruhemodus, sondern im Widerstand.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-17"
    },
    {
      "id": "fitness-2026-11-18-13",
      "text": "Ein starker Körper fragt nicht um Erlaubnis, er handelt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-18"
    },
    {
      "id": "fitness-2026-11-19-14",
      "text": "Bewegung ist die billigste Form von Selbstrespekt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-19"
    },
    {
      "id": "fitness-2026-11-20-15",
      "text": "Du trainierst nicht für den Sommer, du trainierst für dein Level.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-20"
    },
    {
      "id": "fitness-2026-11-21-16",
      "text": "Dein Durchhaltevermögen im Gym ist dein Vorsprung im Alltag.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-21"
    },
    {
      "id": "fitness-2026-11-22-17",
      "text": "Wer still sitzt, verliert Energie. Wer sich bewegt, erschafft sie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-22"
    },
    {
      "id": "fitness-2026-11-23-18",
      "text": "Dein Körper merkt sich jede Ausrede – und jede Überwindung auch.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-23"
    },
    {
      "id": "fitness-2026-11-24-19",
      "text": "Schmerz im Training ist temporär, Stärke danach bleibt.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-24"
    },
    {
      "id": "fitness-2026-11-25-20",
      "text": "Du bist nicht müde, du bist unterfordert von deinem eigenen Potenzial.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-25"
    },
    {
      "id": "fitness-2026-11-26-21",
      "text": "Fitness ist kein Ziel, es ist der Zustand, aus dem du alles andere baust.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-26"
    },
    {
      "id": "fitness-2026-11-27-22",
      "text": "Trainier den Körper, der deine Ideen tragen muss.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-27"
    },
    {
      "id": "fitness-2026-11-28-23",
      "text": "Konsequenz im Training schlägt Motivation jedes Mal.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-28"
    },
    {
      "id": "fitness-2026-11-29-24",
      "text": "Energie kommt nicht von außen, sie entsteht durch Bewegung.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-29"
    },
    {
      "id": "fitness-2026-11-30-25",
      "text": "Ein wacher Körper denkt schneller als ein müder Geist.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-11-30"
    },
    {
      "id": "fitness-2026-12-01-26",
      "text": "Du kannst nicht alles kontrollieren, aber deine nächste Wiederholung schon.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-01"
    },
    {
      "id": "fitness-2026-12-02-27",
      "text": "Fitness ist die stille Grundlage für laute Erfolge.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-02"
    },
    {
      "id": "fitness-2026-12-03-28",
      "text": "Wer sich heute bewegt, verhandelt morgen mit mehr Energie.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-03"
    },
    {
      "id": "fitness-2026-12-04-29",
      "text": "Dein Körper ist der Zinseszins deiner täglichen Disziplin.",
      "author": null,
      "category": "fitness",
      "dateKey": "2026-12-04"
    },
    {
      "id": "gratitude-2026-11-05-0",
      "text": "Dankbarkeit ist der Zinseszins für dein Mindset.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-05"
    },
    {
      "id": "gratitude-2026-11-06-1",
      "text": "Du kannst nicht gleichzeitig jagen und genießen – lern beides zu timen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-06"
    },
    {
      "id": "gratitude-2026-11-07-2",
      "text": "Zufriedenheit ist kein Ziel, sondern ein Nebeneffekt von bewusstem Leben.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-07"
    },
    {
      "id": "gratitude-2026-11-08-3",
      "text": "Wer nie dankbar ist, verpasst die Hälfte seines eigenen Erfolgs.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-08"
    },
    {
      "id": "gratitude-2026-11-09-4",
      "text": "Mehr wollen ist okay. Weniger wertschätzen nicht.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-09"
    },
    {
      "id": "gratitude-2026-11-10-5",
      "text": "Dein jetziges Leben war mal dein größter Traum. Behandle es so.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-10"
    },
    {
      "id": "gratitude-2026-11-11-6",
      "text": "Ambition ohne Dankbarkeit ist nur eine andere Form von Unzufriedenheit.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-11"
    },
    {
      "id": "gratitude-2026-11-12-7",
      "text": "Du optimierst dein Portfolio. Optimier auch deine Wahrnehmung des Status quo.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-12"
    },
    {
      "id": "gratitude-2026-11-13-8",
      "text": "Zufrieden sein heißt nicht aufhören. Es heißt klarer weitermachen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-13"
    },
    {
      "id": "gratitude-2026-11-14-9",
      "text": "Dankbarkeit kostet nichts und bringt mehr als die meisten Investments.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-14"
    },
    {
      "id": "gratitude-2026-11-15-10",
      "text": "Du jagst dem nächsten Level hinterher und übersiehst, auf welchem du stehst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-15"
    },
    {
      "id": "gratitude-2026-11-16-11",
      "text": "Erfolg ohne Dankbarkeit fühlt sich erstaunlich leer an.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-16"
    },
    {
      "id": "gratitude-2026-11-17-12",
      "text": "Genug ist keine Schwäche. Es ist ein Machtwort gegen den Vergleichsdruck.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-17"
    },
    {
      "id": "gratitude-2026-11-18-13",
      "text": "Du feierst jeden Kontostand-Screenshot, aber nie den Moment selbst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-18"
    },
    {
      "id": "gratitude-2026-11-19-14",
      "text": "Dankbarkeit ist das einzige Investment, das sofort Rendite bringt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-19"
    },
    {
      "id": "gratitude-2026-11-20-15",
      "text": "Wer immer nur das Nächste sieht, verpasst das, was schon da ist.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-20"
    },
    {
      "id": "gratitude-2026-11-21-16",
      "text": "Zufriedenheit ist die stille Währung, die keiner auf LinkedIn zeigt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-21"
    },
    {
      "id": "gratitude-2026-11-22-17",
      "text": "Dein Hunger nach mehr darf bleiben. Dein Blick fürs Jetzt auch.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-22"
    },
    {
      "id": "gratitude-2026-11-23-18",
      "text": "Du bist nicht spät dran. Du bist genau da, wo deine Lektionen gerade sitzen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-23"
    },
    {
      "id": "gratitude-2026-11-24-19",
      "text": "Dankbarkeit macht aus einem guten Tag einen unvergesslichen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-24"
    },
    {
      "id": "gratitude-2026-11-25-20",
      "text": "Manche verwechseln Rastlosigkeit mit Ambition. Lern den Unterschied.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-25"
    },
    {
      "id": "gratitude-2026-11-26-21",
      "text": "Du hast heute das, wofür du vor einem Jahr gebetet hast.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-26"
    },
    {
      "id": "gratitude-2026-11-27-22",
      "text": "Zufriedenheit ist kein Stillstand. Sie ist die Basis für nachhaltigen Antrieb.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-27"
    },
    {
      "id": "gratitude-2026-11-28-23",
      "text": "Dankbarkeit schlägt jede Motivationsrede, die du dir morgens anhörst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-28"
    },
    {
      "id": "gratitude-2026-11-29-24",
      "text": "Du vergleichst dein Kapitel 3 mit dem Kapitel 20 von jemand anderem.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-29"
    },
    {
      "id": "gratitude-2026-11-30-25",
      "text": "Wachstum ohne Wertschätzung ist nur Bewegung ohne Richtung.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-11-30"
    },
    {
      "id": "gratitude-2026-12-01-26",
      "text": "Dein Leben jetzt ist Material für die Geschichte, die du später erzählst.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-01"
    },
    {
      "id": "gratitude-2026-12-02-27",
      "text": "Zufriedenheit ist der ruhige Ort, von dem aus die besten Entscheidungen kommen.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-02"
    },
    {
      "id": "gratitude-2026-12-03-28",
      "text": "Dankbar sein heißt nicht aufgeben zu wollen. Es heißt klar zu sehen, was schon zählt.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-03"
    },
    {
      "id": "gratitude-2026-12-04-29",
      "text": "Du brauchst keinen neuen Erfolg, um stolz auf dich zu sein. Nur einen neuen Blick.",
      "author": null,
      "category": "gratitude",
      "dateKey": "2026-12-04"
    }
  ]
}